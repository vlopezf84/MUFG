using Aplicacion.Enums;
using MUFG_T24.Comunes;
using MUFG_T24.Comunes.Helpers;
using MUFG_T24.Modelos;
using System;
using System.Threading.Tasks;

/// <summary>
/// Clase utilitaria para manejar los errores
/// </summary>
public sealed class ControlError
{
    #region Propiedades
    private bool ConErrorPrevio { get; set; }
    private DateTime FechaInicio { get; set; }
    private DateTime? FechaMail { get; set; }
    private string Mensaje { get; set; }
    #endregion

    #region Singleton
    private static ControlError _instanciaControl;

    /// <summary>
    /// Constructor privado
    /// </summary>
    private ControlError() { }

    public static ControlError Instancia
    {
        get
        {
            if (_instanciaControl == null)
                _instanciaControl = new ControlError();

            return _instanciaControl;
        }
    }
    #endregion

    #region Metodos de Control

    /// <summary>
    /// Maneja los errores y envia correo de ser necesario
    /// </summary>
    /// <param name="controlError"></param>
    /// <param name="e"></param>
    public async Task RealizaControlError(Exception e)
    {
        bool EnviaCorreo = false;

        if (_instanciaControl.ConErrorPrevio)
        {
            //Se valida si es el mismo error
            if (_instanciaControl.Mensaje == e.Message)
            {
                if (_instanciaControl.FechaInicio.AddMinutes(Constantes.MINUTOS_PRIMERO) <= DateTime.Now)
                {
                    //10 minutos o mas con el mismo error
                    if (_instanciaControl.FechaMail == null)
                    {
                        Config.EscribirLog(Constantes.LogMensaje.INFO_CTRL_ERRROR_PRIMER_MAL);
                        EnviaCorreo = true;
                    }
                    else
                    {
                        if (_instanciaControl.FechaMail.Value.AddMinutes(Constantes.MINUTOS_REPETIR) <= DateTime.Now)
                        {
                            Config.EscribirLog(Constantes.LogMensaje.INFO_CTRL_ERRROR_ERROR_RECURSIVO);
                            EnviaCorreo = true;
                        }
                    }
                }
            }
            else
            {
                //Nuevo error (no se envia correo y se marca como nuevo error
                _instanciaControl.FechaInicio = DateTime.Now;
                _instanciaControl.FechaMail = null;
                _instanciaControl.Mensaje = e.Message;
            }
        }
        else
        {
            Config.EscribirLog(Constantes.LogMensaje.INFO_CTRL_ERRROR_INICIO_CONTROL);

            //Primera vez que ocurre el error
            _instanciaControl.ConErrorPrevio = true;
            _instanciaControl.FechaInicio = DateTime.Now;
            _instanciaControl.Mensaje = e.Message;
            _instanciaControl.FechaMail = null;
        }

        if (EnviaCorreo)
        {
            Config.EscribirLog(Constantes.LogMensaje.INFO_TRATA_ENVIO_CORREO);

            //Envio de correo
            try
            {
                string mailPara, mailConCopia, mensaje;

                //Destinatarios
                mailPara = Constantes.MAIL_PARA;

                mensaje = Constantes.DescripcionError.ERROR_COMISIONES + _instanciaControl.Mensaje;

                //Envio de Correo
                await CorreoHelper.EnviarCorreoAsync(new MensajeCorreo
                {
                    CorreoOrigen = Constantes.CTRL_ERROR_CORREO_ORIGEN,
                    NombreOrigen = Constantes.CTRL_ERROR_NOMBRE_ORIGEN,
                    Para = mailPara,
                    Asunto = Constantes.CTRL_ERROR_ASUNTO,
                    Mensaje = mensaje,
                });

                Config.EscribirLog(Constantes.LogMensaje.INFO_CORREO_ENVIADO);

                //Actualizo como correo enviado
                _instanciaControl.FechaMail = DateTime.Now;
            }
            catch (Exception exMail)
            {
                Config.EscribirLog(Constantes.LogMensaje.INFO_CTRL_ERROR_EXCEPCION + exMail.Message);
            }
        }
    }

    #endregion

}


using Aplicacion.Enums;
