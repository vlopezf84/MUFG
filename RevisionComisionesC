using MUFG_T24.Comunes;
using MUFG_T24.Configuracion_utilidades;
using MUFG_T24.Enums_utilidades;
using MUFG_T24.Interfaces_utilidades;
using System;
using System.Threading;
using System.Threading.Tasks;

namespace Aplicacion
{
    /// <summary>
    /// Servicio que maneja la lógica del negocio.
    /// </summary>
    public class OperacionServicio
    {
        #region Propiedades

        private readonly Configuracion _configuracion;
        private readonly IControlServicio _controlServicio;
        private readonly IAlertas _alertas;
        private readonly IParametrizacion _parametrizacion;
        private readonly IActualizaComisiones _actualizaComisiones;

        #endregion

        #region Constructor

        /// <summary>
        /// Constructor
        /// </summary>
        /// <param name="configuracion"></param>
        /// <param name="controlServicio"></param>
        /// <param name="alertas"></param>
        /// <param name="parametrizacion"></param>
        /// <param name="actualizaComisiones"></param>
        public OperacionServicio(Configuracion configuracion,
                                IControlServicio controlServicio,
                                IAlertas alertas,
                                IParametrizacion parametrizacion,
                                IActualizaComisiones actualizaComisiones)
        {
            _configuracion = configuracion;
            _controlServicio = controlServicio;
            _alertas = alertas;
            _parametrizacion = parametrizacion;
            _actualizaComisiones = actualizaComisiones;
        }

        #endregion

        #region Métodos

        /// <summary>
        /// Control del flujo del servicio
        /// </summary>
        public async Task<bool> EjecutarProcedimientosAsync(CancellationToken ct)
        {
            try
            {
                #region Validaciones Principales

                ct.ThrowIfCancellationRequested();

                //Marca la ejecucion del servicio
                var result = await _controlServicio.ActualizaEJecucion(_configuracion.NombreServicio, ct);
                if (!result.Exito)
                    Config.EscribirLog(result.Exito ? "INFO|ActualizaEjecución|Actualiza Ejecucion" : $"ERROR|ActualizaEjecución|{result.MensajeError}");

                //Obtiene los parámetros del sistema
                _configuracion.FechaSistema = await _parametrizacion.ObtenerFechaSistemaAsync(ct);
                _configuracion.EsDiaHabil = await _controlServicio.EsDiaHabil(ct);
                _configuracion.ParametrosSistema
                    = await _parametrizacion.ObtenerParametrosSistemaAsync(Constantes.PARAMETRO_SISTEMA, ct);

                //Valida que sea día habil
                if (!_configuracion.EsDiaHabil.Value)
                {
                    Config.EscribirLog(Constantes.LogMensaje.ERROR_DIA_HABIL);

                    if (!await _alertas.InsertarAlerta(Utilidades.GenerarAlerta(
                        _configuracion, Constantes.ERROR,
                        Constantes.DescripcionError.DIA_INHABIL,
                        new Exception(Constantes.DescripcionError.DIA_INHABIL))))
                    {
                        Config.EscribirLog("ERROR|EjecutaProcedimientosAsync|No se pudo insertar la alerta");
                    }

                    return false;
                }

                //Valida Horario de la operación
                TimeSpan timeHoraSistema = _parametrizacion.ObtenerHoraSistema();
                if (TimeSpan.TryParse(_configuracion.ParametrosSistema[ConstantesGenerales.HoraSaldoInicio], out TimeSpan horaInicio)
                    && TimeSpan.TryParse(_configuracion.ParametrosSistema[ConstantesGenerales.HoraSaldoFin], out TimeSpan horaFin))
                {
                    if (timeHoraSistema < horaInicio || timeHoraSistema > horaFin)
                    {
                        Config.EscribirLog(Constantes.LogMensaje.ERROR_FUERRA_HORARIO);
                        Exception e = new Exception($"El servicio '{_configuracion.NombreServicio}' está fuera de horario.");

                        if (!await _alertas.InsertarAlerta(Utilidades.GenerarAlerta(
                            _configuracion,
                            Constantes.ERROR,
                            Constantes.DescripcionError.FUERA_HORARIO, e)))
                        {
                            Config.EscribirLog("ERROR|EjecutaProcedimientosAsync|No se pudo insertar la alerta");
                        }

                        return false;
                    }
                }
                else
                {
                    Config.EscribirLog($"ERROR|Ejecuta_Procedimientos|{Constantes.DescripcionError.HORA_FORMATO_INCORRECTO}");
                    Exception e = new Exception(Constantes.DescripcionError.HORA_FORMATO_INCORRECTO);

                    if (await _alertas.InsertarAlerta(Utilidades.GenerarAlerta(
                        _configuracion,
                        Constantes.ERROR,
                        Constantes.DescripcionError.HORA_FORMATO_INCORRECTO, e)))
                    {
                        Config.EscribirLog("ERROR|EjecutaProcedimientosAsync|No se pudo insertar la alerta");
                    }

                    return false;
                }

                //Valida debug completo
                bool datoAnterior = Utilidades.DebugCompleto;
                Utilidades.DebugCompleto = (_configuracion.ParametrosSistema[Constantes.PARAMETRO_SALDOS_DEBUG] == Constantes.STRING_1) ? true : false;

                if (datoAnterior != Utilidades.DebugCompleto)
                    Config.EscribirLog($"INFO|obtenerParametrosSistema|Saldos Debug Completo '{Utilidades.DebugCompleto}'.");

                #endregion

                //Ejecuta validaciones y proceso principal
                if (!await ActualizaComisionesAsync())
                    return false;

                //Fin de procesos a relizar
                var terminacion = await _controlServicio.ActualizaTerminacion(_configuracion.NombreServicio);
                Config.EscribirLog(terminacion.Exito ? "INFO|ActualizaTerminación|Actualización Correcta" : $"ERROR|ActualizaTerminación|Error: {result.MensajeError}");

                return true;
            }
            catch (OperationCanceledException)
            {
                Config.EscribirLog("INFO|EjecutaProcedimientos|Operación cancelada.");
                return false;
            }
            catch (Exception ex)
            {
                Config.EscribirLog(Constantes.LogMensaje.ERROR_EXCEPCION_PROCEDIMIENTO + ex);
                await _alertas.InsertarAlerta(
                    Utilidades.GenerarAlerta(_configuracion, Constantes.CRITICO, null, ex),
                    ct);

                await ControlError.Instancia.RealizaControlError(ex);
                return false;
            }
            finally
            {
                await _controlServicio.ActualizaTerminacion(_configuracion.NombreServicio, CancellationToken.None);
            }
        }

        /// <summary>
        /// Método que ejecuta proceso principal y las validaciones
        /// </summary>
        /// <returns></returns>
        private async Task<bool> ActualizaComisionesAsync()
        {
            try
            {
                DateTime periodoActual = Utilidades.ConvertirFecha(_configuracion.FechaSistema);
                DateTime periodoAnterior = Utilidades.ObtenerPeriodoAnterior(periodoActual);

                Config.EscribirLog(Constantes.LogMensaje.INFO_ACTUALIZA_COMISIONES
                    + periodoActual.ToString("yyyyMMdd") + ". periodo_anterior: " + periodoAnterior.ToString("yyyyMMdd"));

                Config.EscribirLog(await _actualizaComisiones.ProcesoComisionesCliente());

                Config.EscribirLog(await _actualizaComisiones.ProcesoComisionesEsquemas());

                Config.EscribirLog(await _actualizaComisiones.ProcesoComisionesCobradas(periodoActual));

                Config.EscribirLog(await _actualizaComisiones.ProcesoComisionesVolumen(periodoActual, periodoAnterior));

                Config.EscribirLog(await _actualizaComisiones.ProcesoComisionesPendientes());

                return true;
            }
            catch (Exception ex)
            {
                Config.EscribirLog(Constantes.LogMensaje.ERROR_ACTUALIZA_COMISIONES + ex.ToString());
                await ControlError.Instancia.RealizaControlError(ex);
                return false;
            }
        }

        #endregion
    }
