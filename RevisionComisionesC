namespace Infraestructura.Repositorios
{
    /// <summary>
    /// Implementacion del servicio para manejar BD (bot)
    /// </summary>
    public class CMSRepository : RepositorioMaestro, ICMS
    {
        #region Constructor

        /// <summary>
        /// Constructor servicio
        /// </summary>
        /// <param name="configuracion"></param>
        public CMSRepository() : base(BasedatosProveedor.SqlServer, NombreBasedatos.CMS, null, null)
        { }

        #endregion

        #region Métodos

        /// <summary>
        /// Funcion principal donde procesa los datos obtenidos y los envia hacia BD (bot)
        /// </summary>
        /// <param name="storedProcedure"></param>
        /// <param name="xmlDatos"></param>
        /// <param name="parametros"></param>
        /// <returns></returns>
        /// <exception cref="RepositorioException"></exception>
        public async Task<string> ProcesarComisiones(
            string storedProcedure,
            string xmlDatos,
            List<Parametros> parametros = null)
        {
            //Crea parametro de salida, Registros Insertados
            var salidaRegistrosAgregados = basedatosConexion
                .CrearParametroSalida(Constantes.PARAMETRO_REGISTROS_AGREGADOS_SALIDA, DbType.Int32);

            //Ejecuta procedimiento
            var resultado = await EjecutarStoredProceduredNonQuery(storedProcedure, cmd =>
            {
                //Agrega los parametros de entrada y salida base
                cmd.Parameters.Add(salidaRegistrosAgregados);
                cmd.Parameters.Add(basedatosConexion.CrearParametro(Constantes.PARAMETRO_XML_ENTRADA, xmlDatos));
                cmd.CommandTimeout = 60;

                //Si cuenta con parametros de entrada los agrega...
                foreach (var parametro in parametros ?? Enumerable.Empty<Parametros>())
                    cmd.Parameters.Add(basedatosConexion.CrearParametro(parametro.NombreParametro, parametro.Valor));
            });

            if (resultado.Exito)
            {
                if (salidaRegistrosAgregados.Value == null || salidaRegistrosAgregados.Value == DBNull.Value)
                    throw new InvalidOperationException(Constantes.DescripcionError.PROCEDIMIENTO_VALOR_NO_ESPERADO);

                if (!string.IsNullOrEmpty(salidaRegistrosAgregados.Value.ToString()))
                    return salidaRegistrosAgregados.Value.ToString();
                else
                    throw new RepositorioException(Constantes.DescripcionError.ERROR_VALOR_NULO);
            }
            else
                throw new RepositorioException($"Se produjo un error: {resultado.MensajeError}");
        }
        #endregion
    }
}

