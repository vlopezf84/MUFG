namespace Infraestructura.Repositorios
{
    /// <summary>
    /// Implementacion del servicio para manejar BD (VT24)
    /// </summary>
    public class VT24Repository : RepositorioMaestro, IVT24
    {
        #region Constructor

        /// <summary>
        /// Constructor servicio
        /// </summary>
        /// <param name="configuracion"></param>
        public VT24Repository() : base(BasedatosProveedor.SqlServer, NombreBasedatos.T24_VW, null, null)
        { }

        #endregion

        #region Métodos

        /// <summary>
        /// Método principal para consultas a BD (VT24)
        /// Recibe parámetros de manera dinámica acorde al proceso
        /// </summary>
        /// <param name="StoredProcedure"></param>
        /// <param name="parametros"></param>
        /// <returns></returns>
        /// <exception cref="RepositorioException"></exception>
        public async Task<string> ObtenerComisiones(string StoredProcedure, List<Parametros> parametros = null)
        {
            //Creamos salida de datos XML
            var salidaXML = basedatosConexion
                .CrearParametroSalida(Constantes.PARAMETRO_XML_SALIDA, DbType.String, -1);
            salidaXML.Size = -1;

            //Ejecuta procedimientos
            var resultado = await EjecutarStoredProceduredNonQuery(StoredProcedure, cmd =>
            {
                //Agrega los parametros de salida
                cmd.Parameters.Add(salidaXML);
                cmd.CommandTimeout = 90;

                //Si cuenta con parametros de entrada los agrega...
                foreach (var parametro in parametros ?? Enumerable.Empty<Parametros>())
                    cmd.Parameters.Add(basedatosConexion.CrearParametro(parametro.NombreParametro, parametro.Valor));
            });

            if (resultado.Exito)
            {
                if (salidaXML.Value != null)
                    return salidaXML.Value.ToString();
                else
                    throw new RepositorioException(Constantes.DescripcionError.XML_VALOR_NULL);
            }
            else
                throw new RepositorioException($"Se produjo un error: {resultado.MensajeError}");

        }
        #endregion
    }
}


