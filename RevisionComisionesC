using MUFG_T24.Configuracion_utilidades;
using MUFG_T24.Modelos;
using System;
using System.Globalization;

/// <summary>
/// Clase para hacer conversiones y procesos fuera de la logica del negocio
/// </summary>
public static class Utilidades
{
    public static bool DebugCompleto { get; set; } = true;

    /// <summary>
    /// Método que genera un objeto generico de tipo AlertaDTO
    /// </summary>
    /// <param name="config"></param>
    /// <param name="clave"></param>
    /// <param name="descripcion"></param>
    /// <param name="excepcion"></param>
    /// <returns></returns>
    public static AlertaDTO GenerarAlerta(Configuracion config, string clave,
        string descripcion, Exception excepcion)
    {
        return new AlertaDTO
        {
            Folio = null,
            TipoOPeracion = null,
            Servicio = config.NombreServicio,
            ClaveAviso = clave,
            Descipcion = descripcion,
            PId = config.Pid.Value,
            NombreProceso = config.NombreProceso,
            Exception = excepcion
        };
    }

    /// <summary>
    /// Convertir una fecha de tipo string a una de tipo DateTime
    /// </summary>
    /// <param name="fechaString"></param>
    /// <returns></returns>
    public static DateTime ConvertirFecha(string fechaString)
    {
        if (DateTime.TryParseExact(fechaString, "yyyyMMdd", CultureInfo.InvariantCulture,
            DateTimeStyles.None, out DateTime fecha))
        {
            return fecha;
        }

        throw new FormatException("La fecha no contiene un formato esperado");
    }

    /// <summary>
    /// Generar periodo anterior a una fecha
    /// </summary>
    /// <param name="periodo"></param>
    /// <returns></returns>
    public static DateTime ObtenerPeriodoAnterior(DateTime periodo)
    {
        int anio = periodo.Year;
        int mes = periodo.Month;
        mes -= 1;

        if (mes == 0)
        {
            mes = 12;
            anio -= 1;
        }

        return new DateTime(anio, mes, 1);
    }
}

