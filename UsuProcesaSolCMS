 Private Sub Procesa_Solicitud_CMS()
     Dim lrsDatos As DbDataReader
     Dim laListaFolios As ArrayList
     Dim lsFolio As String
     Dim laValores_Formato(28) As Object
     Dim liResultado As Integer

     Try
         ' Buscamos las solicitudes
         laListaFolios = New ArrayList()
         lrsDatos = goTOMI_Database.Execute_Query("SELECT id_solicitud FROM tomser.dbo.solicitudes_usuarios_cms WHERE status='CONFIRMADO'")
         If Not IsNothing(lrsDatos) Then
             Do While lrsDatos.Read
                 laListaFolios.Add(lrsDatos.Item(0))
             Loop
             lrsDatos.Close()
             lrsDatos = Nothing
         End If

         ' Analizamos las solicitudes
         For Each lsFolio In laListaFolios
             write_Log("INFO|Procesa_Solicitud_CMS|Procesando solicitudes de Usuario: " & lsFolio)
             lrsDatos = goTOMI_Database.Execute_Query("SELECT * FROM tomser.dbo.solicitudes_usuarios_cms WHERE id_solicitud=" & lsFolio)
             If Not IsNothing(lrsDatos) Then
                 Do While lrsDatos.Read
                     laValores_Formato(1) = lrsDatos.Item(0)     'ID_SOLICITUD
                     laValores_Formato(2) = lrsDatos.Item(1)     'ID_SOLICITUD_DOCUMENTO
                     laValores_Formato(3) = lrsDatos.Item(2)     'SATM04COD
                     laValores_Formato(4) = lrsDatos.Item(3)     'SATM04LOG
                     laValores_Formato(5) = lrsDatos.Item(4)     'SATM04APA
                     laValores_Formato(6) = lrsDatos.Item(5)     'SATM04AMA
                     laValores_Formato(7) = lrsDatos.Item(6)     'SATM04NOM
                     laValores_Formato(8) = lrsDatos.Item(7)     'SATM04COR
                     laValores_Formato(9) = lrsDatos.Item(8)     'SATM04EMA
                     laValores_Formato(10) = lrsDatos.Item(9)    'SATM04NUMSERTOKEN
                     laValores_Formato(11) = lrsDatos.Item(10)   'DESCRIPCION
                     laValores_Formato(12) = lrsDatos.Item(11)   'FECHA_SOL
                     laValores_Formato(13) = lrsDatos.Item(12)   'HORA_SOL
                     laValores_Formato(14) = lrsDatos.Item(13)   'USUARIO_CAPT
                     laValores_Formato(15) = lrsDatos.Item(14)   'FECHA_AUT
                     laValores_Formato(16) = lrsDatos.Item(15)   'HORA_AUT
                     laValores_Formato(17) = lrsDatos.Item(16)   'USUARIO_AUT
                     laValores_Formato(18) = lrsDatos.Item(17)   'FECHA_CANC
                     laValores_Formato(19) = lrsDatos.Item(18)   'HORA_CANC
                     laValores_Formato(20) = lrsDatos.Item(19)   'USUARIO_CANC
                     laValores_Formato(21) = lrsDatos.Item(20)   'STATUS
                     laValores_Formato(22) = lrsDatos.Item(21)   'OPERACION
                     laValores_Formato(23) = lrsDatos.Item(22)   'FECHA_CONF
                     laValores_Formato(24) = lrsDatos.Item(23)   'HORA_CONF
                     laValores_Formato(25) = lrsDatos.Item(24)   'USUARIO_CONF
                     laValores_Formato(26) = lrsDatos.Item(25)   'SATM04CLAVE_ACTIVACION
                     laValores_Formato(27) = lrsDatos.Item(26)   'MOTIVO_CANC
                     laValores_Formato(28) = lrsDatos.Item(29)   'Login a Eliminar
                 Loop
                 lrsDatos.Close()
                 lrsDatos = Nothing
             End If
             write_Log("INFO|Procesa_Beneficiarios|Procesando plantilla: " & lsFolio)
             liResultado = Procesa_Usuario_CMS(laValores_Formato)
             If liResultado > 0 Then
                 liResultado = goTOMI_Database.Execute_Command("UPDATE tomser.dbo.solicitudes_usuarios_cms SET status='PROCESADO' WHERE id_solicitud=" & laValores_Formato(1))
                 write_Log("INFO|Procesa_Solicitud_CMS|Se termina procesamiento de Formato: " & lsFolio)
             Else
                 write_Log("ERROR|Procesa_Solicitud_CMS|Error en procesamiento de Formato: " & lsFolio)
             End If
         Next
         laListaFolios.Clear()
     Catch lexUsuariosCMS As Exception
         write_Log("ERROR|Procesa_Solicitud_CMS|Ocurre exception: " & lexUsuariosCMS.ToString)
     End Try
 End Sub

Private Sub Actualiza_Permisos_Plantillas(usuario As String, cliente As String, formato As String)
