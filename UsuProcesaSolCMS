    lsSQL = "INSERT INTO tomser.dbo.beneficiarios_hist SELECT getDate() AS fec_cambio,* FROM tomser.dbo.beneficiarios WHERE id_cliente=" & cliente & "; " & _
            "INSERT INTO tb_bilun_beneficiarios_hist SELECT getDate() AS fec_cambio,* FROM tb_bilun_beneficiarios WHERE id_cliente=" & cliente & ";"
    goTOMI_Database.Execute_Command(lsSQL)
    ''' ADICION Captura
    ' CMS
    lsSQL = "UPDATE beneficiarios" & _
            " SET UsuariosCaptura=CONCAT(UsuariosCaptura,'|" & usuario & "')" & _
