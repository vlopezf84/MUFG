ALTER PROCEDURE [dbo].[usp_SWF_INSERT_MQ_MSG]
 @tipo_operacion VARCHAR(10),   
 @mq_msg TEXT

AS
BEGIN
 DECLARE @header		VARCHAR(258)
 DECLARE @txt_icn		VARCHAR(25)
 DECLARE @num_regs		INT
 SET @header		= CAST(@mq_msg AS VARCHAR(258))
 SET @txt_icn		= REPLACE(RTRIM(LTRIM(SUBSTRING(@header, 1, 17))),' ','')  -- Por MQ el ICN es solo de 15 caracteres. 
 IF @txt_icn<>'' BEGIN
  SELECT @num_regs=COUNT(1) FROM TB_SRV_SWF_PLAN_TRABAJO_MAESTRO WHERE folio=@txt_icn AND tipo_operacion=@tipo_operacion;
  IF @num_regs=0
     INSERT INTO TB_SRV_SWF_PLAN_TRABAJO_MAESTRO (folio,cve_estatus,fec_inicio,tipo_operacion) VALUES (@txt_icn,'READ',getDate(),@tipo_operacion);
  SELECT @num_regs=COUNT(1) FROM TB_SRV_SWF_TRABAJO WHERE NF_FOLIO=@txt_icn AND NF_TIPO = @tipo_operacion ;
  IF @num_regs=0
     INSERT INTO TB_SRV_SWF_TRABAJO (NF_FOLIO,NF_MQ_MSG,NF_FECHA_INICIO,NF_TIPO) VALUES (@txt_icn,@mq_msg,getDate(),@tipo_operacion);
 END
 SELECT @txt_icn
END
