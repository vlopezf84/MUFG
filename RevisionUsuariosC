namespace AplicacionUsuarios.Orquestador.ProcesosGenerales
{
    /// <summary>
    /// Implementacíón del Proceso de Reemplazo de tokens
    /// </summary>
    public class ReemplazoTokensProceso : IProcesosGenerales
    {
        private readonly ITomiTokenRepository _tomiToken;
        private readonly ICmsUsuarioRepository _cmsUsuario;
        private readonly ITomserUsuarioRepository _tomserUsuario;
        private readonly ILoggerService _log;
        public int Orden => 5;


        /// <summary>
        /// Constructor
        /// </summary>
        /// <param name="tomiToken"></param>
        /// <param name="cmsUsuario"></param>
        /// <param name="tomserUsuario"></param>
        public ReemplazoTokensProceso(
            ITomiTokenRepository tomiToken,
            ICmsUsuarioRepository cmsUsuario,
            ITomserUsuarioRepository tomserUsuario,
            ILoggerService logger
        )
        {
            _tomiToken = tomiToken;
            _cmsUsuario = cmsUsuario;
            _tomserUsuario = tomserUsuario;
            _log = logger;
        }


        /// <summary>
        /// Método que implementa el proceso de Reemplazo de tokens
        /// </summary>
        /// <returns></returns>
        public async Task<bool> EjecutarAsync() {
            try
            {
                _log.Info("ReemplazoTokens|Buscando tokens por activar");

                var tokens = await _tomiToken.ObtieneTokensConfirmadosAsync();

                if (!tokens.Any())
                {
                    _log.Info("ReemplazoTokens|No se encontraron tokens por activar.");
                    return true;
                }

                _log.Info("ReemplazoTokens|Busqueda terminada, comienza la asignacion en CMS y TOMI");


                foreach (var token in tokens)
                {                    
                    await _cmsUsuario.UpdateTokenAsync(token.SATM04NUMSERTOKEN_NUEVO, token.SATM04LOG);

                    await _tomserUsuario.UpdateTokenAsync(token.SATM04NUMSERTOKEN_NUEVO, token.SATM04LOG);

                    await _tomiToken.UpdateStatusProcesadoAsync(token.SATM04LOG);
                }

                

                return true;
            }
            catch (Exception ex)
            {
                _log.Error($"ReemplazoTokens|Ocurre exception: {ex.Message}");
                return false;
            }
            finally
            {
                _log.Info("ReemplazoTokens|Se termina procesamiento de tokens");
            }
        }



    }
}


