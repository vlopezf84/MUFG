namespace AplicacionUsuarios.Orquestador.ProcesosGenerales
{
    /// <summary>
    /// Implementacíón del Proceso de Actualización de Cuentas
    /// </summary>
    public class ActualizaCuentasProceso : IProcesosGenerales
    {
        private readonly ITomserCuentaRepository _tomserCuenta;
        private readonly ICmsCuentaRepository _cmsCuenta;
        private readonly ITomiCuentaRepository _tomiCuenta;
        private readonly ILoggerService _log;
        public int Orden => 3;
        /// <summary>
        /// Constructor
        /// </summary>
        /// <param name="tomserCuenta"></param>
        /// <param name="cmsCuenta"></param>
        /// <param name="tomiCuenta"></param>
        public ActualizaCuentasProceso(
            ITomserCuentaRepository tomserCuenta,
            ICmsCuentaRepository cmsCuenta,
            ITomiCuentaRepository tomiCuenta,
            ILoggerService logger
        )
        {
            _tomserCuenta = tomserCuenta;
            _cmsCuenta = cmsCuenta;
            _tomiCuenta = tomiCuenta;
            _log = logger;
        }


        /// <summary>
        /// Método que implementa el proceso de Actualización de Cuentas
        /// </summary>
        /// <returns></returns>
        public async Task<bool> EjecutarAsync()
        {
            try
            {
                _log.Info("ActulizaCuentas|Inicio");
                _log.Info("ActulizaCuentas|BuscaCuentas");
                var cuentas = await _tomserCuenta.ObtenerCuentasAsync();
                _log.Info("ActulizaCuentas|Cuentas encontradas {cuentas.Count}");
                foreach (var cuenta in cuentas)
                {
                    _log.Info("Actualiza_Cuentas|Procesando Cuenta: {cuenta.Satm03cta}");

                    await Task.WhenAll(
                        _cmsCuenta.DeleteAsync(cuenta.Satm03cta),
                        _cmsCuenta.InsertAsync(cuenta),
                        _tomiCuenta.UpdateAsync(cuenta.Satm03cta),
                        _tomserCuenta.UpdateAsync(cuenta.Satm03cta)
                     );
                    _log.Info("Actualiza_Cuentas||Se termina procesamiento Cuenta: {cuenta.Satm03cta}");
                }
                
                return true;
            }
            catch (Exception ex)
            {
                _log.Error($"ActualizaCuentas|| exception: {ex.Message}");
                return false;
            }
            finally
            {
                _log.Info("ActulizaCuentas|Fin");
            }
        }


    }
}

