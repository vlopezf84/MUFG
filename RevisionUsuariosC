using System;
using System.Collections.Generic;

namespace AplicacionUsuarios.Comunes
{
    public static class Extensiones
    {
        /// <summary>
        /// Metodo para obtener un valor de un objeto de tipo diccionario
        /// devolviendo el valor por default en caso de que no exista
        /// </summary>
        /// <typeparam name="TKey"></typeparam>
        /// <typeparam name="TValue"></typeparam>
        /// <param name="dict"></param>
        /// <param name="key"></param>
        /// <param name="defaultValue"></param>
        /// <returns></returns>
        public static string GetValueStringOrDefault<TKey, TValue>(
                this Dictionary<TKey, TValue> dict,
                TKey key,
                string defaultValue = "")
        {
            return dict.TryGetValue(key, out var value) ? value.ToString() : defaultValue;
        }

        /// <summary>
        /// Metodo de extension para parsear una cadena a entero un elemento del Diccionario o
        /// tomar el valor pode fdefaul en caso de error
        /// </summary>
        /// <typeparam name="TKey"></typeparam>
        /// <typeparam name="TValue"></typeparam>
        /// <param name="dict"></param>
        /// <param name="key"></param>
        /// <param name="defaultValue"></param>
        /// <returns></returns>
        public static TimeSpan GetValueTimeSpanOrDefault<TKey, TValue>(
                this Dictionary<TKey, TValue> dict,
                TKey key,
                string defaultValue = "00:00"
        )
        {

            if (dict.TryGetValue(key, out var valor) && TimeSpan.TryParse(valor?.ToString(), out var result))
            {
                return result;
            }

            return TimeSpan.TryParse(defaultValue, out var resultDefault) ? resultDefault : TimeSpan.Zero;
        }


        /// <summary>
        /// Metodo de externsión para devolver un entero de un elemento del Dictionario
        /// </summary>
        /// <typeparam name="TKey"></typeparam>
        /// <typeparam name="TValue"></typeparam>
        /// <param name="dict"></param>
        /// <param name="key"></param>
        /// <param name="defaultValue"></param>
        /// <returns></returns>
        public static int GetValueIntOrDefault<TKey, TValue>(
            this Dictionary<TKey, TValue> dict,
            TKey key,
            int defaultValue = 0
        )
        {
            if (dict.TryGetValue(key, out var valor) && int.TryParse(valor?.ToString(), out var result))
            {
                return result;
            }
            return defaultValue;
        }


    }
}

using Aplicacion.Interfaces.Repositorios.Cms;
