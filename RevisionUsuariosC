namespace AplicacionUsuarios.Orquestador.ProcesosGenerales
{
    /// <summary>
    /// Implementacion del proceso para procesar scripts
    /// </summary>
    public class ProcesarScriptsProceso : IProcesosGenerales
    {
        private readonly ICmsScriptsEjecutaRepository _scriptEjecuta;
        private readonly ITomiScriptsRepository _scriptObtiene;
        private readonly ILoggerService _log;
        public int Orden => 7;

        /// <summary>
        /// Contructor principal e injeccion de dependencias necesarios
        /// </summary>
        /// <param name="scriptEjecuta"></param>
        /// <param name="scriptObtiene"></param>
        public ProcesarScriptsProceso(
            ICmsScriptsEjecutaRepository scriptEjecuta
            ,ITomiScriptsRepository scriptObtiene
            ,ILoggerService logger
        )
        {
            _scriptEjecuta = scriptEjecuta;
            _scriptObtiene = scriptObtiene;
            _log = logger;
        }

        /// <summary>
        /// Metodo principal para ejecutar y procesar los scripts pendientes
        /// </summary>
        /// <returns></returns>
        public async Task<bool> EjecutarAsync() 
        {
            try
            {

                _log.Info("ProcesarScripts|INICIO");

                _log.Info("ProcesarScripts|Buscando scripts pendientes de procesar");
                var resultado = await _scriptObtiene.ObtieneScriptsPendientesAplicarAsync();

                if (resultado.Count == 0 )
                {
                    _log.Info("ProcesarScripts|No se encontraron  scripts pendientes de procesar.");
                    return true;
                }

                _log.Info("ProcesarScripts|Scripts a procesar [{resultado.Count}]");

                foreach(var item in resultado)
                {                                        
                    var sqlExecute = ValidarSqlScript(item.Script);
                    var struccionRecortada = string.Empty;
                    if (sqlExecute.DtExecutedOk.Rows.Count>0)
                    {
                        var result = await _scriptEjecuta.EjecutaScriptsPendientesAsync(sqlExecute.DtExecutedOk);
                        if (result.Count>0)
                        {
                            _log.Info("ProcesarScripts|Scripts a procesar|Se proceso el script con id [{item.Id_Script}]");
                            await _scriptObtiene.UpdateAplicadoAsync(item.Id_Script);
                            //Registra en el log las sentencias ejecutadas
                            foreach (var executed in result)
                            {                                
                                if (executed.TipoOperacion == "INSERT")
                                {
                                    
                                    int pos = executed.Sentencia.IndexOf("VALUES", StringComparison.OrdinalIgnoreCase);
                                    if (pos > 0)
                                    {
                                        struccionRecortada = $"{executed.Sentencia.Substring(0, pos-1)}..." ;
                                    }
                                    else
                                    {
                                        struccionRecortada = executed.Sentencia;
                                    }
                                }
                                else
                                {
                                    if (executed.Sentencia.Length > 100)
                                    {
                                        struccionRecortada = executed.Sentencia.Substring(0, 100);
                                    }
                                    else
                                    {
                                        struccionRecortada = executed.Sentencia;
                                    }
                                } 
                                _log.Info("ProcesarScripts|ScriptProcesado|Registros afectados:[{executed.FilasAfectadas}], Operacion : [{executed.TipoOperacion}], SENTENCIA :[{struccionRecortada}], Estatus: [{executed.Estado}], Error: [{executed.ErrorMensaje}] en Bd:[{NombreBasedatos.CMS}]");
                            }
                        }
                        else
                        {
                            _log.Info("ProcesarScripts|Scripts a procesar|No se proceso el script con id [{item.Id_Script}]");
                        }
                    }

                    if (sqlExecute.NoExecuted.Count > 0)
                    {
                        //registrar en el log las instrucciones que no estan permitidas
                        foreach (var inst in sqlExecute.NoExecuted)
                        {
                            _log.Info("ProcesarScripts|ScriptsNoProcesados|TipoOperacion:[{inst.TipoOperacion}], Sentencia:[{inst.Sentencia}], Mensaje:[{inst.ErrorMensaje}]");
                        }                        
                    }
                }
                return true;
            }
            catch (Exception ex)
            {
                _log.Error($"ProcesarScripts| Exception: {ex.Message}");
                return false;
            }
            finally
            {
                _log.Info("ProcesarScripts|FIN");
            }
        }


        /// <summary>
        /// Metodo para validar los scripts que se va a ejecutar en el servidor
        /// </summary>
        /// <param name="sql"> cadena que contiene una serie de insutrucciones sql</param>
        /// <returns></returns>
        private static ResultExecutedLog ValidarSqlScript(string sql)
        {
            DataTable dt = new DataTable();
            dt.Columns.Add("Id", typeof(int));
            dt.Columns.Add("Sentencia", typeof(string));
            dt.Columns.Add("TipoOperacion", typeof(string));

            //quita comentarios de bloque
            var sql1 = Regex.Replace(sql, @"/\*.*?\*/", "", RegexOptions.Singleline);
            //quita comentarios de linea
            var sql2 = Regex.Replace(sql1, @"--.*?$", "", RegexOptions.Multiline);
            //quita instrucciones GO
            var sql3 = Regex.Replace(sql2, @"^\s*GO\s*$", "", RegexOptions.Multiline | RegexOptions.IgnoreCase);
            
            //dividir script por ";" y ademas tolerar lineas vacias
            var statements = sql3.Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries)
                .Select(s => s.Trim())
                .Where(s => !string.IsNullOrWhiteSpace(s))
                .ToList();
            
            int indexOk = 1;
            int indexErr = 1;
            var sqlNoPermitidas = new List<SqlExecuteScriptsLog>();

            foreach (var statement in statements)
            {                
                var command = statement.Trim();
                if (string.IsNullOrEmpty(command))
                    continue;

                //quitar espacios innecesarios.....
                var sqlEnd = Regex.Replace(command, @"\s+", " ").Trim();

                //obtener la primera palabra para saber que tipo de instruccion es                
                var Instruccion = sqlEnd.Split(new[] { ' ', '\r', '\n', '\t' }, StringSplitOptions.RemoveEmptyEntries).FirstOrDefault()?.ToUpperInvariant() ?? "";
                
                string[] InstruccionesPermitidas = new[] { "INSERT", "UPDATE", "DELETE" };
                //Validamos si el comando es uno permitido                
                if (!InstruccionesPermitidas.Contains(Instruccion))
                {
                    //registrar sentencia no permitidas:
                    sqlNoPermitidas.Add(new SqlExecuteScriptsLog { Id = indexErr++, TipoOperacion = Instruccion, Sentencia = command, ErrorMensaje = "SENTENCIA NO PERMITIDA" });
                }
                else
                {                                                        
                    dt.Rows.Add(indexOk++, statement, Instruccion);             
                }
            }
            ResultExecutedLog result = new ResultExecutedLog()
            {
                DtExecutedOk = dt,
                NoExecuted = sqlNoPermitidas
            };

            return result;
        }






    }
}


using Aplicacion.Interfaces.Repositorios.Cms;
using Aplicacion.Interfaces.Repositorios.Tomser;
