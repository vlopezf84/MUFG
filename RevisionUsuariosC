    public partial class ServiceHost : WindowsServiceHostBase
    {

        private Container _containerDI;
        private Configuracion _configuracionBase;

        protected override string NombreServicioLog => NombreServicio.Usuarios.ToString();
        protected override bool TimerEnabled => _configuracionBase?.TimerEnabled == true;
        protected override double TimerIntervalMs => _configuracionBase?.TimerInterval ?? 300000;


        /// <summary>
        /// Constructor.
        /// </summary>
        public ServiceHost() {
            this.ServiceName = NombreServicio.Usuarios.ToString();
        }

        /// <summary>
        /// Realiza la inyección y establece un timer
        /// que ejecutará su delegado por tick del intervalo.
        /// </summary>
        protected override void Inicializacion(string[] args, CancellationToken ct)
        {
            ct.ThrowIfCancellationRequested();


            //Inicializa la obtención de la configuración general y las rutas del log...            {
            _configuracionBase = new Configuracion();

            LecturaConfguracionGeneral.Inicializar();
            ServicioConfiguracionSettings servicioMainConfiguracion = LecturaConfguracionGeneral.ObtenerServicio(NombreServicio.Usuarios.ToString());

            _configuracionBase.NombreServicio = servicioMainConfiguracion.NombreServicio;
            _configuracionBase.PathLog = servicioMainConfiguracion.Log;
            _configuracionBase.TimerEnabled = servicioMainConfiguracion.TimerEnable;            
            _configuracionBase.TimerInterval = servicioMainConfiguracion.Timer;
            _configuracionBase.TamanoMaximoArchivoLogKB = servicioMainConfiguracion.TamanoMaximoArchivoLogKB.ToString();
            _configuracionBase.ForzaEjecucionServicios = servicioMainConfiguracion.ForzaEjecucionServicios;
            

            RutasConfiguracion rutas = new RutasConfiguracion()
            {
                MUFG_Servicios_Path_Log = _configuracionBase.PathLog
            };
            _log.Init(rutas, servicioMainConfiguracion.NombreServicio, servicioMainConfiguracion.TamanoMaximoArchivoLogKB);
            _log.Write("INFO|OnStart|Leyendo archivo de configuración.");


            //Realiza la configuracion del contenedor DI...
            _containerDI = new SimpleInjector.Container();
            _containerDI.Options.DefaultScopedLifestyle = new AsyncScopedLifestyle();
            _containerDI.Register<IAlertas>(() => new Alertas(BasedatosProveedor.SqlServer, NombreBasedatos.TOMI, null, null), Lifestyle.Singleton);
            _containerDI.Register<IControlServicio, ControlServicio>();
            _containerDI.Register<IParametrizacion, Parametrizacion>();

            //Registra la configuracion como Transient + Factory (lazy)...
            _containerDI.Register<Configuracion>(() => _configuracionBase.Clone(), Lifestyle.Singleton);

            //Registra los componentes...
            _containerDI.Register<IEjecucionServicio, OperacionServicio>(Lifestyle.Scoped);

            // Orquestador
            _containerDI.Register<IOperacionPrincipal, OrquestadorProcesos>(Lifestyle.Scoped);

            //para registro de log con interface
            _containerDI.Register<ILoggerService, LoggerService>(Lifestyle.Singleton);

            //Procesos generales
            _containerDI.Collection.Register<IProcesosGenerales>(
                new[]
                {
                    typeof(SolicitudesConfirmadasProceso),
                    typeof(ActualizaClientesProceso),
                    typeof(ActualizaCuentasProceso),
                    typeof(ActualizaEmailProceso),
                    typeof(ReemplazoTokensProceso),
                    typeof(DesbloquearIPsProceso),
                    typeof(ProcesarScriptsProceso)
                },
                Lifestyle.Scoped
            );


            _containerDI.Collection.Register<ISubProcesosUsuarios>(
                new[]
                {
                    typeof(AltaUsuarioSubProceso),
                    typeof(ReposicionTokenSubProceso),
                    typeof(ModificacionUsuarioSubProceso),
                    typeof(TraspasoTokenSubProceso)
                },
                Lifestyle.Scoped
            );
            _containerDI.Register<IOperacionSubProcesos, SolicitudesConfirmadasSubProcesos>(Lifestyle.Scoped);


            //Procesos incian Servicio
            _containerDI.Collection.Register<IProcesosIniciandoServicio>(
                new[]
                {
                    typeof(LongevidadUsuarioProceso),
                    typeof(LongevidadUsuarioCancelacionProceso),
                    typeof(LongevidadUsuarioPasswordProceso),
                    typeof(LongevidadUsuarioPasswordCambioProceso),
                    typeof(ValidaReglasUsuariosProceso)
                },
                Lifestyle.Scoped
            );

            //Repositorios
            _containerDI.Register<ICmsSolicitudRepository, CmsSolicitudRepository>(Lifestyle.Scoped);
            _containerDI.Register<ICmsUsuarioRepository, CmsUsuarioRepository>(Lifestyle.Scoped);
            _containerDI.Register<ICmsUsuarioPermisoRepository, CmsUsuarioPermisoRepository>(Lifestyle.Scoped);
            _containerDI.Register<ICmsBeneficiarioRepository, CmsBeneficiarioRepository>(Lifestyle.Scoped);


            _containerDI.Register<ITomiBeneficiarioRepositorio, TomiBeneficiarioRepositorio>(Lifestyle.Scoped);
            _containerDI.Register<ITomiPermisoRepository, TomiPermisoRepository>(Lifestyle.Scoped);
            _containerDI.Register<ITomiUsuarioRepository, TomiUsuarioRepository>(Lifestyle.Scoped);

            _containerDI.Register<ITomserBeneficiarioRepository, TomserBeneficiarioRepositorio>(Lifestyle.Scoped);
            _containerDI.Register<ITomserPermisoRepository, TomserPermisoRepository>(Lifestyle.Scoped);
            _containerDI.Register<ITomserSolicitudRepository, TomserSolicitudRepository>(Lifestyle.Scoped);
            _containerDI.Register<ITomserUsuarioRepository, TomserUsuarioRepository>(Lifestyle.Scoped);
            _containerDI.Register<ITomserBeneficiarioHistRepository, TomserBeneficiarioHistRepository>(Lifestyle.Scoped);
            _containerDI.Register<ITomserCmsLongevidadRepository, TomserCmsLongevidadRepository>(Lifestyle.Scoped);



            // Repositorios de clientes
            _containerDI.Register<ITomserClienteRepository, TomserClienteRepository>(Lifestyle.Scoped);
            _containerDI.Register<ICmsClienteRepository, CmsClienteRepository>(Lifestyle.Scoped);
            _containerDI.Register<ITomiClienteRepository, TomiClienteRepository>(Lifestyle.Scoped);
            
            _containerDI.Register<ITomserCuentaRepository, TomserCuentaRepository>(Lifestyle.Scoped);
            _containerDI.Register<ICmsCuentaRepository, CmsCuentaRepository>(Lifestyle.Scoped);
            _containerDI.Register<ITomiCuentaRepository, TomiCuentaRepository>(Lifestyle.Scoped);

            _containerDI.Register<ICmsSolicitudesUsuarioMailRepository, CmsSolicitudesUsuarioMailRepository>(Lifestyle.Scoped);
            _containerDI.Register<ITomiTokenRepository, TomiTokenRepository>(Lifestyle.Scoped);
            _containerDI.Register<ITomiParametrosSistemaRepository, TomiParametrosSistemaRepository>(Lifestyle.Scoped);
            _containerDI.Register<ICmsIpRepository, CmsIpRepository>(Lifestyle.Scoped);
            
            //EjecutaScripts
            _containerDI.Register<ITomiScriptsRepository, TomiScriptsRepository>(Lifestyle.Scoped);
            _containerDI.Register<ICmsScriptsEjecutaRepository, CmsScriptsEjecutaRepository>(Lifestyle.Scoped);
            


            _containerDI.Register<IPlantillaService, PlantillaService>(Lifestyle.Scoped);
            _containerDI.Register<IEmailService, EmailService>(Lifestyle.Scoped);




            _containerDI.Register<EstadoServicio>(Lifestyle.Singleton);
            //Parametros 
            _containerDI.Register<ParametrosConfiguracion>(Lifestyle.Singleton);

            _containerDI.Verify();

        }

        /// <summary>
        /// Realiza la obtención inicial de parámetros (una sola vez).
        /// </summary>
        protected override async Task ParametrizacionesAsync(CancellationToken ct)
        {
            try
            {
                ct.ThrowIfCancellationRequested();

                //Obtiene el proceso actual...
                IParametrizacion _parametrizacion = _containerDI.GetInstance<IParametrizacion>();
                _configuracionBase = await _parametrizacion.ObtenerProcesoActualAsync(_configuracionBase);

                //Marca el servicio en uso...
                IControlServicio _controlServicio = _containerDI.GetInstance<IControlServicio>();
                await _controlServicio.MarcarPuertoEnUsoAsync(_configuracionBase.Pid.Value, _configuracionBase.NombreProceso, _configuracionBase.NombreDisplay, _configuracionBase.NombreServicio,ct);
            }
            catch (Exception ex)
            {
                _log.Error($"ParametrizacionesAsync|Se presenta exception: {ex}");
                throw;
            }
        }

        /// <summary>
        /// Ejecuta el funcionamiento principal del servicio en cada tick.
        /// </summary>  
        protected override async Task OnTimerAsync(CancellationToken ct)
        {
            try
            {
                _log.Info("=============================");
                _log.Info("|Timer|Inicio de ciclo");

                //Ejecuta el procedimiento principal del servicio...
                using (AsyncScopedLifestyle.BeginScope(_containerDI))
                {
                    var operacionServicio = _containerDI.GetInstance<IEjecucionServicio>();
                    _= await operacionServicio.EjecutarServicioAsync(ct).ConfigureAwait(false);
                }
            }
            catch (Exception ex)
            {
                _log.Error($"Realiza_timer|Se presenta exception: {ex}");
            }
            finally
            {
                _log.Info("Timer|Fin de ciclo");
                _log.Info("============================="); 
            }
        }

        /// <summary>
        /// Realiza ciertas operaciones antes de finalizar el servicio.
        /// </summary>
        protected override async Task TerminacionAsync(CancellationToken waitCt, CancellationToken cleanupCt, Task startupTask, Task runningTask)
        {
            _log.Info("|OnStop|Finalizando Servicio.");

            try
            {
                if (_containerDI == null || _configuracionBase == null)
                {
                    _log.Info("|OnStop|Terminación omitida por inicialización incompleta.");
                    return;
                }

                using (AsyncScopedLifestyle.BeginScope(_containerDI))
                {
                    IControlServicio _controlServicio = _containerDI.GetInstance<IControlServicio>();

                    await _controlServicio.EsperarTareaActivaAsync(startupTask, ConstantesSistema.ParametrizacionInicial, waitCt).ConfigureAwait(false);
                    await _controlServicio.EsperarTareaActivaAsync(runningTask, ConstantesSistema.ProcesamientoActivo, waitCt).ConfigureAwait(false);

                    //Marca el servicio en uso...
                    await _controlServicio.MarcarPuertoEnUsoAsync(null, null, null, _configuracionBase.NombreServicio, cleanupCt).ConfigureAwait(false);

                    //Marca el termino del servicio...
                    await _controlServicio.ActualizaTerminacion(_configuracionBase.NombreServicio, cleanupCt).ConfigureAwait(false);

                    _log.Info("|OnStop|Terminación exitosa de bases de datos.");
                }
            }
            catch (Exception ex)
            {                
                _log.Error($"TerminacionAsync|Se presenta exception: {ex}");                
            }
            finally
            {
                _containerDI?.Dispose();
            }

        }

    }
}

