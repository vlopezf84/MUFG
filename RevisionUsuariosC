namespace Infraestructura.Repositorios.cms
{
    /// <summary>
    /// Implementación de método para la ejecución de scripts en base de datos
    /// </summary>
    public class CmsScriptsEjecutaRepository : RepositorioMaestro, ICmsScriptsEjecutaRepository
    {
        private readonly ILoggerService _log;
        /// <summary>
        /// Constructor
        /// </summary>
        public CmsScriptsEjecutaRepository(ILoggerService logger) : base(BasedatosProveedor.SqlServer, NombreBasedatos.CMS, null, null) 
        {
            _log = logger;
        }

        /// <summary>
        /// Ejecuta script en base de datos
        /// </summary>
        /// <param name="dt"></param>
        /// <returns></returns>
        public async Task<List<SqlExecuteScriptsLog>> EjecutaScriptsPendientesAsync(DataTable dt)        
        {            
            var paraTableType = new SqlParameter("@tblScriptsPendientesType", SqlDbType.Structured)
            {
                TypeName = "dbo.ScriptsPendientesType",
                Value = dt
            };

            var result = await EjecutarStoredProcedureQuery<SqlExecuteScriptsLog>(ConstantesSpsCms.uspEjecutaScriptPendiente, cmd =>
            {
                cmd.Parameters.Add(paraTableType);
            });

            if (!string.IsNullOrEmpty(result.MensajeError))
            {
                _log.Error($"Mensaje: {result.MensajeError}");
            }
            return result.Data;


        }

    }
}

using System.Threading;

namespace AplicacionUsuarios.Services
{
    /// <summary>
    /// Clase que almacena el estado de ejecución de inicialización del servicio para validar se ejecute uba sola vez
    /// </summary>
    public class EstadoServicio
    {
        private int _init = 0;


        /// <summary>
        /// Devuelve true SOLO la primera vez que se ejecuta el servicio.
        /// Después siempre devuelve false.
        /// Thread-safe.
        /// </summary>
        public bool EstadoInicializacion()
        {
            return Interlocked.CompareExchange(ref _init, 1, 0) == 0;
        }


    }
}

