using MUFG_T24.Configuracion_utilidades;
using MUFG_T24.Interfaces_utilidades;
using MUFG_T24.Modelos;
using System;
using System.Threading;
using System.Threading.Tasks;

namespace Aplicacion.Services
{
    /// <summary>
    /// Implementación del proceso principal del servicio
    /// </summary>
    public class OperacionServicio : IEjecucionServicio  //IOperacionServicio
    {
        private readonly Configuracion _configuracion;
        private readonly IControlServicio _controlServicio;
        private readonly IAlertas _alertas;
        private readonly IParametrizacion _parametrizacion;
        private readonly IOperacionPrincipal _operaciones;
        private readonly ParametrosConfiguracion _paramConfig;
        private readonly EstadoServicio _estado;
        private readonly ILoggerService _log;


        /// <summary>
        /// Constructor
        /// </summary>
        /// <param name="configuracion"></param>
        /// <param name="controlServicio"></param>
        /// <param name="alertas"></param>
        /// <param name="parametrizacion"></param>
        /// <param name="operaciones"></param>
        /// <param name="estado"></param>
        /// <param name="paramConfig"></param>
        public OperacionServicio(
            Configuracion configuracion
            , IControlServicio controlServicio
            , IAlertas alertas
            , IParametrizacion parametrizacion
            , IOperacionPrincipal operaciones
            , EstadoServicio estado
            , ParametrosConfiguracion paramConfig
            , ILoggerService logger
            )
        {
            _configuracion = configuracion;
            _controlServicio = controlServicio;
            _alertas = alertas;
            _parametrizacion = parametrizacion;
            _operaciones = operaciones;
            _estado = estado;
            _paramConfig = paramConfig;
            _log = logger;
        }

        /// <summary>
        /// Método principal del servicio, carga y validación de parametros
        /// </summary>
        /// <returns></returns>
        public async Task<bool> EjecutarServicioAsync(CancellationToken ct)
        {
            try
            {
                _log.Info("Ejecuta_Procedimientos|Inicio");
                //Marca la ejecución del servicio...
                await _controlServicio.ActualizaEJecucion(_configuracion.NombreServicio,ct);
                //Obtiene los parámetros del sistema...
                _configuracion.FechaSistema = await _parametrizacion.ObtenerFechaSistemaAsync(ct);
                _configuracion.EsDiaHabil = await _controlServicio.EsDiaHabil(ct);
                _configuracion.ParametrosSistema = await _parametrizacion.ObtenerParametrosSistemaAsync(ConstantesServicio.ParametrosSistema,ct);

                #region ExtraeValoresParametros

                //Validar y cargar valores de parametros a clase
                _paramConfig.AsignarDesde(MapearValidarParametros.Parametros(_configuracion.ParametrosSistema));

                #endregion

                //Valida que sea día hábil...
                #region ValidaDiaHabil
                if (!_configuracion.EsDiaHabil.Value)
                {
                    _log.Error("Ejecuta_Procedimientos|Hoy es un día inhábil.");
                    await _alertas.InsertarAlerta(new AlertaDTO()
                    {
                        Folio = null,
                        TipoOPeracion = null,
                        Servicio = _configuracion.NombreServicio,
                        ClaveAviso = "ERROR",
                        Descipcion = "Hoy es un día inhábil",
                        PId = _configuracion.Pid.Value,
                        NombreProceso = _configuracion.NombreProceso,
                        Exception = new Exception($"Hoy es un día inhábil.")
                    },ct);
                    return false;
                }
                #endregion

                #region ValidaHorarioOperacion
                TimeSpan timeHoraSistema = _parametrizacion.ObtenerHoraSistema();
                if (timeHoraSistema < _paramConfig.HORA_OP_INICIO || timeHoraSistema > _paramConfig.HORA_OP_FIN)
                {
                    _log.Error("Ejecuta_Procedimientos|El servicio está fuera de horario.");
                    await _alertas.InsertarAlerta(new AlertaDTO()
                    {
                        Folio = null,
                        TipoOPeracion = null,
                        Servicio = _configuracion.NombreServicio,
                        ClaveAviso = "ERROR",
                        Descipcion = "El servicio está fuera de horario",
                        PId = _configuracion.Pid.Value,
                        NombreProceso = _configuracion.NombreProceso,
                        Exception = new Exception($"El servicio '{_configuracion.NombreServicio}' está fuera de horario.")
                    },ct);
                    return false;
                }
                #endregion


                //Inicia Proceso....                                
                _ = await _operaciones.EjecutaAsync(_estado.EstadoInicializacion());


                //Marca el termino del servicio...
                await _controlServicio.ActualizaTerminacion(_configuracion.NombreServicio,ct);
                _log.Info("Ejecuta_Procedimientos|Fin");
                return true;
            }
            catch (Exception ex)
            {
                _log.Error($"Ejecuta_Procedimientos|Se presenta exception: {ex}");
                await _alertas.InsertarAlerta(new AlertaDTO()
                {
                    Folio = null,
                    TipoOPeracion = null,
                    Servicio = _configuracion.NombreServicio,
                    ClaveAviso = "CRITICO",
                    Descipcion = null,
                    PId = _configuracion.Pid.Value,
                    NombreProceso = _configuracion.NombreProceso,
                    Exception = ex
                },ct);
            }

            return false;

        }
    }

}


using AplicacionUsuarios.Interfaces.OperacionPrincipal;
using AplicacionUsuarios.Interfaces.Orquestador;
using AplicacionUsuarios.Interfaces.Servicios;
using System.Collections.Generic;
using System.Linq;
using System.Threading.Tasks;

namespace AplicacionUsuarios.Orquestador
{
    /// <summary>
    /// Implementación para ejecutar los procesos del servicio
    /// </summary>
    public class OrquestadorProcesos : IOperacionPrincipal
    {

        private readonly IEnumerable<IProcesosGenerales> _procesosGenerales;
        private readonly IEnumerable<IProcesosIniciandoServicio> _procesosIniciales;
        private readonly ILoggerService _log;
        /// <summary>
        /// Constructor
        /// </summary>
        /// <param name="procesosGenerales"></param>
        /// <param name="procesosIniciales"></param>
        public OrquestadorProcesos(
            IEnumerable<IProcesosGenerales> procesosGenerales,
            IEnumerable<IProcesosIniciandoServicio> procesosIniciales,
            ILoggerService logger
        )
        {
            _procesosGenerales = procesosGenerales;
            _procesosIniciales = procesosIniciales;
            _log = logger;
        }

        /// <summary>
        /// Método que ejecuta cada proceso del servicio en el orden establecido
        /// </summary>
        /// <param name="iniciandoServicio"></param>
        /// <returns></returns>
        public async Task<bool> EjecutaAsync(bool iniciandoServicio)
        {

            _log.Info("Inicia Ejecucion de procesos");
            // Procesos principales ejecutados en orden
            foreach (var proceso in _procesosGenerales.OrderBy(x => x.Orden))
            {
                await proceso.EjecutarAsync();
            }
            _log.Info("Finaliza Ejecucion de procesos");


            //  Procesos iniciales, solo se ejecutan al cargar el servicio
            if (iniciandoServicio)
            {
                _log.Info("Inicia Ejecucion de procesos iniciales");
                foreach (var pIni in _procesosIniciales.OrderBy(x => x.Orden))
                {
                    await pIni.EjecutarAsync();
                }
                _log.Info("Finaliza Ejecucion de procesos iniciales");
            }


            return true;
        }

    }
}
