namespace AplicacionUsuarios.Services.Plantilla
{
    /// <summary>
    /// Implementación de los procesos para las plantillas
    /// </summary>
    public class PlantillaService : IPlantillaService
    {

        private readonly ICmsBeneficiarioRepository _cms;
        private readonly ITomserBeneficiarioRepository _tomser;
        private readonly ITomiBeneficiarioRepositorio _tomi;
        private readonly ITomserBeneficiarioHistRepository _hist;

        /// <summary>
        /// Constructor
        /// </summary>
        /// <param name="cms"></param>
        /// <param name="tomser"></param>
        /// <param name="tomi"></param>
        /// <param name="hist"></param>
        public PlantillaService(
                ICmsBeneficiarioRepository cms,
                ITomserBeneficiarioRepository tomser,
                ITomiBeneficiarioRepositorio tomi,
                ITomserBeneficiarioHistRepository hist)
        {
            _cms = cms;
            _tomser = tomser;
            _tomi = tomi;
            _hist = hist;
        }


        /// <summary>
        /// Método que ejecuta operación de actualización e inserción de plantilas en diferentes bases de datos
        /// </summary>
        /// <param name="login"></param>
        /// <param name="cliente"></param>
        /// <param name="formato"></param>
        /// <returns></returns>
        public async Task ActualizarPlantillasAsync(string login, long cliente, string formato)
        {
            // 1. Respaldo
            await Task.WhenAll(
                _hist.InsertRespaldoFormatoAsync(cliente, formato),
                _tomi.InsertHistoricoFormatoAsync(cliente, formato)
            );
            

            // 2. Captura
            await Task.WhenAll(
                _cms.UpdateCapturaAsync(cliente, login, formato),
                _tomser.UpdateCapturaAsync(cliente, login, formato),
                _tomi.UpdateCapturaAsync(cliente, login, formato)
            );

            // 3. Autorización
            await Task.WhenAll(
                _cms.UpdateAutorizacionAsync(cliente, login, formato),
                _tomser.UpdateAutorizacionAsync(cliente, login, formato),
                _tomi.UpdateAutorizacionAsync(cliente, login, formato)
            );

            // 4. Baja Captura
            await Task.WhenAll(
                _cms.UpdateBajaCapturaAsync(cliente, login, formato),
                _tomser.UpdateBajaCapturaAsync(cliente, login, formato),
                _tomi.UpdateBajaCapturaAsync(cliente, login, formato)
            );

            // 5. Baja Autorización
            await Task.WhenAll(
                _cms.UpdateBajaAutorizacionAsync(cliente, login, formato),
                _tomser.UpdateBajaAutorizacionAsync(cliente, login, formato),
                _tomi.UpdateBajaAutorizacionAsync(cliente, login, formato)
            );
        }

        /// <summary>
        /// Método que elimina usuarios de plantillas en diferentes bases de datos
        /// </summary>
        /// <param name="usuario"></param>
        /// <param name="cliente"></param>
        /// <returns></returns>
        public async Task EliminaUsuarioPlantillasAsync(string usuario, long cliente)
        {
            // 1. Respaldo
            await Task.WhenAll(
                _hist.InsertRespaldoPlantillasAsync(cliente),
                _tomi.InsertHistoricoPlantillasAsync(cliente)
            );

            // 2. Captura
            await Task.WhenAll(
                _cms.UpdateBeneficiarioCapturasAsync(cliente, usuario),
                _tomser.UpdateBeneficiariosCapturaAsync(cliente, usuario),
                _tomi.UpdateBeneficiariosCapturaAsync(usuario, cliente)
            );

            // 3. Autorización
            await Task.WhenAll(
                _cms.UpdateBeneficiariosAutorizacionAsync(cliente, usuario ),
                _tomser.UpdateBeneficiariosAutorizacionAsync(cliente, usuario),
                _tomi.UpdateBeneficiariosAutorizacionAsync(usuario, cliente)
            );

        }
    }
}


