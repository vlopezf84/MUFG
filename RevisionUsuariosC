{
    /// <summary>
    /// Implementacíón del Proceso de Solicitudes confirmadas
    /// </summary>
    public class SolicitudesConfirmadasProceso : IProcesosGenerales
    {
        private readonly ITomserSolicitudRepository _tomserSolicitudesRepository;        
        private readonly ICmsSolicitudRepository _cmsSolicitud;
        private readonly IOperacionSubProcesos _solConfSubprocesos;
        private readonly ILoggerService _log;
        public int Orden => 1;


        /// <summary>
        /// Constructor
        /// </summary>
        /// <param name="tomserSolicitudesRepository"></param>
        /// <param name="cmsSolicitud"></param>
        /// <param name="solConfSubprocesos"></param>
        public SolicitudesConfirmadasProceso(
            ITomserSolicitudRepository tomserSolicitudesRepository
            , ICmsSolicitudRepository cmsSolicitud
            , IOperacionSubProcesos solConfSubprocesos
            , ILoggerService logger
        )
        {
            _tomserSolicitudesRepository = tomserSolicitudesRepository;
            _cmsSolicitud = cmsSolicitud;
            _solConfSubprocesos = solConfSubprocesos;
            _log = logger;
        }


        /// <summary>
        /// Método que implementa el proceso de Solicitudes confirmadas
        /// </summary>
        /// <returns></returns>
        public async Task<bool> EjecutarAsync()
        {
            try
            {
                _log.Info("Proceso|SolicitudesConfirmadas|Inicia");                
                _log.Info("SolicitudesConfirmadas|Busca solicitudes");
                var solicitudes = await _tomserSolicitudesRepository.ObtenerSolicitudesConfirmadasAsync();
                if (solicitudes.Count > 0)
                {
                    foreach (var item in solicitudes)
                    {
                        _log.Info("SolicitudesConfirmadas|Procesando|idSolicitud:{item.ID_SOLICITUD}|Descripcion:{item.DESCRIPCION},Operacion:{item.OPERACION}");
                        
                        var inserted = await _cmsSolicitud.InsertAsync(item);
                        _log.Info("SolicitudesConfirmadas|Procesando|Alta Usuario|Solicitud insertada:{inserted}");
                        if (!inserted) return false;
                        //aqui ejecuta por tipo de PROCESO[Descripcion] "ALTA USUARIO, MODIFICACION USUARIO, REPOSICION TOKEN y TRASPASO TOKEN"
                        var result = await _solConfSubprocesos.EjecutaAsync(item);

                        if (result)
                        {
                            await _tomserSolicitudesRepository.UpdateEstatusProcesadoAsync(item.ID_SOLICITUD);
                            _log.Info("Procesa_Solicitud_CMS|Se termina procesamiento de Formato: {item.ID_SOLICITUD}");
                        }
                        else
                        {
                            _log.Error($"Procesa_Solicitud_CMS|Error en procesamiento de Formato: {item.ID_SOLICITUD}");
                        }
                    }
                }
                else
                {
                    _log.Info("SolicitudesConfirmadas|Busca solicitudes|No se encontraron solicitudes a procesar");
                }
                return true;
            }
            catch(Exception ex)
            {
                _log.Error($"Procesa_Solicitud_CMS|Exception: {ex.Message}");
            }
            finally
            {
                _log.Info("Proceso|SolicitudesConfirmadas|Termina");
            }

            return false;
        }


    }
}

using AplicacionUsuarios.Comunes;
using AplicacionUsuarios.Enums;
using AplicacionUsuarios.Interfaces.EjecucionServicio;
using AplicacionUsuarios.Interfaces.OperacionPrincipal;
using AplicacionUsuarios.Interfaces.Servicios;
using AplicacionUsuarios.Modelos;
