namespace Aplicacion.Servicios
{
    /// <summary>
    /// Clase principal de operaciones servicios.
    /// </summary>
    public class OperacionServicio : Aplicacion.Interfaces.IOperacionServicio
    {
        // Sistema Interfaces.
        private readonly ConfiguracionServicio _configuracion;
       

        // OUT_PK_DB Interfaces.
        private readonly IParametrosOperaciones _IparametrosOperaciones;
        private readonly IParametrizacion _iParametrizacion;
        private readonly IOperacionesOUTPK _iOperacionesOUTPK;

        /// <summary>
        /// Constructor.
        /// </summary>
        /// <param name="configuracion"></param>
        /// <param name="iParametrizacion"></param>
        /// <param name="iparametrosOperaciones"></param>
        /// <param name="iOperacionesOUTPK"></param>
        public OperacionServicio(ConfiguracionServicio configuracion, IParametrizacion iParametrizacion, IParametrosOperaciones iparametrosOperaciones, IOperacionesOUTPK iOperacionesOUTPK)
        {
            _configuracion = configuracion;
            _IparametrosOperaciones = iparametrosOperaciones;
            _iParametrizacion = iParametrizacion;
            _iOperacionesOUTPK = iOperacionesOUTPK;
        }



        /// <summary>
        /// Procedimiento principal para el procesamiento de las operaciones.
        /// </summary>
        public async Task EjecutaProcedimientosAsync()
        {
            // Actualiza ejecucion
            await _IparametrosOperaciones.MarcarServicioEnEjecucion(_configuracion.NombreServicio);

            // Obtiene los parametros del sistema del Servicio Entradas.
            var dicParametrosSistema = await _IparametrosOperaciones.parametrosSistema();

            // Obtiene la fecha de la base de datos.
            _configuracion.fechaServicio = await _IparametrosOperaciones.ObtenerFechaSistemaAsync();
            Config.EscribirLog($"INFO|Fecha actual de la base de datos: {_configuracion.fechaServicio}");

            //Valida los horarios de operación...
            TimeSpan timeHoraSistema = _iParametrizacion.ObtenerHoraSistema();

            //Pregunta a la base de datos si el dia es habil segun el registro en base de datos.

            _configuracion.EsDiaHabil = await _IparametrosOperaciones.BEsDiaHabil();

            try
            {
                //Carga la configuración de los parámetros para el inicio de operaciones de la base de datos.

                foreach (var paramSistema in dicParametrosSistema)
                {
                    if(!Enum.TryParse(paramSistema.Key, out ParametrosSistema parametro)) continue; // Cambia el tipo string a un enum
                    switch (parametro)
                    {
                        case ParametrosSistema.HORA_OP_INICIO:
                            if (paramSistema.Value == null) throw new Exception("No se especifica la hora de inicio de operaciones");
                            _configuracion.StrHoraOperacionesInicio = ConversionHelper.ParseTimeSpanRequerido(paramSistema.Value, ParametrosSistema.HORA_OP_INICIO.ToString());
                            Config.EscribirLog("INFO|obtenerParametrosSistema|Hora de inicio de operaciones '" + paramSistema.Value + "'.", NombreServicio.Swf_OUT_PK_DB.ToString());
                            break;

                        case ParametrosSistema.HORA_OP_FIN:
                            if (paramSistema.Value == null) throw new Exception("No se especifica la hora de finalización de operaciones");
                            _configuracion.StrHoraOperacionesFin = ConversionHelper.ParseTimeSpanRequerido(paramSistema.Value, ParametrosSistema.HORA_OP_FIN.ToString());
                            Config.EscribirLog("INFO|obtenerParametrosSistema|Hora de finalización de operaciones '" + paramSistema.Value + "'.", NombreServicio.Swf_OUT_PK_DB.ToString());
                            break;

                        case ParametrosSistema.SWF_OUT_GET_MT_BATCH:
                            int.TryParse(paramSistema.Value, out var valor);
                            _configuracion.BoMensajesBatch = valor == 1;
                            Config.EscribirLog($"INFO|obtenerParametrosSistema|Obtención de mensajes batch MT-9xx {_configuracion.BoMensajesBatch}.", NombreServicio.Swf_OUT_PK_DB.ToString());
                            break;

                    }
                }

                //Validamos el horario de las operaciones, indicara si la bandera es falso o verdadero. 
                bool boHoraOperacionInicio = (timeHoraSistema >= _configuracion.StrHoraOperacionesInicio && timeHoraSistema <= _configuracion.StrHoraOperacionesFin);
                Config.EscribirLog($"INFO|Ejecuta_Procedimientos|{(boHoraOperacionInicio ? "inicio" : "Termina")} horario de operaciones, HoraSistema='{timeHoraSistema:hh\\:mm}'.", NombreServicio.Swf_OUT_PK_DB.ToString());


                // Obtencion de la fecha del sistema.
                var horaActual = DateTime.Now;
                _configuracion.StrFechaSistema = new TimeSpan(horaActual.Hour, horaActual.Minute, 0);

                bool estaEnHorarioOperacion = _configuracion.StrFechaSistema >= _configuracion.StrHoraOperacionesInicio && _configuracion.StrFechaSistema <= _configuracion.StrHoraOperacionesFin;

                if (estaEnHorarioOperacion) // Inicio Horario
                {
                    if (!_configuracion.BHorarioLectura)
                    {
                        _configuracion.BHorarioLectura = true;
                        Config.EscribirLog($"INFO|Ejecuta_Procedimientos| Inicio horario de operaciones, HoraSistema='{timeHoraSistema:hh\\:mm}'.", NombreServicio.Swf_OUT_PK_DB.ToString());
                    }
                }
                else // Termina Horario
                {
                    if (_configuracion.BHorarioLectura) 
                    {   
                        _configuracion.BHorarioLectura = false;
                        Config.EscribirLog($"INFO|Ejecuta_Procedimientos| Termina horario de operaciones, HoraSistema='{timeHoraSistema:hh\\:mm}'.", NombreServicio.Swf_OUT_PK_DB.ToString());
                    }
                }

                if (!estaEnHorarioOperacion) // Fuera de Horario
                {
                    Config.EscribirLog($"INFO|Ejecuta_Procedimientos| El Servicio esta fuera de Horario.", NombreServicio.Swf_OUT_PK_DB.ToString());

                    await _IparametrosOperaciones.EnviaAlerta(new AlertaDTO
                    {
                        TipoOPeracion = null,
                        Folio = null,
                        Servicio = _configuracion.NombreServicio,
                        ClaveAviso = ConstantesClaveAviso.Critico,
                        Descipcion = "Error en ejecuta_procedimientos",
                        PId = (int)_configuracion.Pid,
                        NombreProceso = _configuracion.NombreProceso,
                        Exception = new Exception("El servicio '" + _configuracion.NombreServicio + "' está fuera de horario.")
                    });
                    return;
                }

                //Inicia los servicios asincronos segun el horario de operacion de cada uno.

            

                    if ((bool)_configuracion.EsDiaHabil)  // Valido que sea día hábil
                    {
                        //Aqui empieza el servicio
                        await _iOperacionesOUTPK.InsertaMensajesPKDB();
                    }
                    else
                    {
                        Config.EscribirLog($"ERROR|Ejecuta_Procedimientos| Hoy es un día inhábil.", NombreServicio.Swf_OUT_PK_DB.ToString());
                    }


            }
            catch (Exception ex) 
            {
                Config.EscribirLog("ERROR|Ejecuta_Procedimientos|Se presenta exception: " + ex.Message);

                await _IparametrosOperaciones.EnviaAlerta(new AlertaDTO
                {
                    TipoOPeracion = null,
                    Folio = null,
                    Servicio = _configuracion.NombreServicio,
                    ClaveAviso = ConstantesClaveAviso.Critico,
                    Descipcion = "Error en ejecuta_procedimientos",
                    PId = (int)_configuracion.Pid,
                    NombreProceso = _configuracion.NombreProceso,
                    Exception = ex
                });

                
                Config.EscribirLog("ERROR|Ejecuta_Procedimientos|Se forza la finalización del servicio.", NombreServicio.Swf_OUT_PK_DB.ToString());

            }
            finally
            {
                try
                {
                    // Fin de los procesos a realizar 
                    await _IparametrosOperaciones.MarcarServicioEnFinalizacion(_configuracion.NombreServicio);
                }
                catch (Exception exFinally)
                {
                    Config.EscribirLog($"ERROR|Ejecuta_Procedimientos|no fue posible maracar el servicio en finalización: {exFinally}", NombreServicio.SPID_Accionistas.ToString());
                }
            }
        }
    }
}
