using Aplicacion.DTOs;
using Aplicacion.Enums;
using Aplicacion.Interfaces;
using Aplicacion.Modelos;
using MUFG_T24.Comunes;
using MUFG_T24.Comunes.Helpers;
using MUFG_T24.Repositorios;
using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading.Tasks;

namespace Infraestructura.Repositorio
{
    /// <summary>
    /// Operaciones OUTPK.
    /// </summary>
    public class OperacionesOUTPK : RepositorioMaestro, IOperacionesOUTPK
    {
        /// <summary>
        /// Constructor.
        /// </summary>
        public OperacionesOUTPK() : base(BasedatosProveedor.SqlServer, NombreBasedatos.TOMI, null, null) 
        {
        }

        private bool _writeLog = true;
        private int _idxNoLog = 0;

        /// <summary>
        /// Busca las operaciones proximas a insertar en PK_DB
        /// </summary>
        /// <returns></returns>
        public async Task InsertaMensajesPKDB()
        {
            try
            {
                var operaciones = await BuscarOperacionesInsertar();

                if (operaciones.Any())
                {
                    foreach (DOperaciones operacion in operaciones)
                    {
                        try
                        {
                            Config.EscribirLog($"INFO|InsertaMensajesPKDB| *** Inicio analisis de folio: {operacion.Folio}, tipo operacion: {operacion.TipoOperacion}", NombreServicio.Swf_OUT_PK_DB.ToString());
                            Config.EscribirLog($"INFO|InsertaMensajesPKDB| A colocar el mensaje en el PK_DB", NombreServicio.Swf_OUT_PK_DB.ToString());

                            await InsertarOperacionPKDB(operacion.Folio, operacion.TipoOperacion);

                            Config.EscribirLog($"INFO|InsertaMensajesPKDB| Proceso terminado", NombreServicio.Swf_OUT_PK_DB.ToString());
                        } 
                        catch (Exception ex)
                        {
                            Config.EscribirLog($"ERROR|Interpreta_MensajesPKDB| {ex}", NombreServicio.Swf_OUT_PK_DB.ToString());
                        }
                    }
                    Config.EscribirLog($"INFO|InsertaMensajesPKDB| Termina conexión", NombreServicio.Swf_OUT_PK_DB.ToString());
                }

                _idxNoLog += 1;

                if (_idxNoLog >= 24) _writeLog = true;
                if (_writeLog)
                {
                    Config.EscribirLog($"INFO|InsertaMensajesPKDB| Se insertaron {operaciones.Count} operaciones.", NombreServicio.Swf_OUT_PK_DB.ToString());
                    _writeLog = false;
                    _idxNoLog = 0;
                }

            }
            catch (Exception ex)
            {
                Config.EscribirLog($"ERROR|InsertaMensajesPKDB| {ex}", NombreServicio.Swf_OUT_PK_DB.ToString());
                throw;
            }
        }

        /// <summary>
        /// Busca operaciones a insertar.
        /// </summary>
        /// <returns></returns>
        private async Task<IReadOnlyList<DOperaciones>> BuscarOperacionesInsertar() 
        {
            var resultado = await EjecutarStoredProcedureQuery<DOperaciones>(ConstantesServicio.sp_BuscarOperacionesInsertarSWFOUTPKDB, cmd =>
            {
                cmd.Parameters.Add(basedatosConexion.CrearParametro("@tipoOperacion", ConstantesServicio.TipoOperacion));
            });
           return resultado?.Data?.ToList() ?? new List<DOperaciones>();
        }

        /// <summary>
        /// Inserta operacion en PK DB.
        /// </summary>
        /// <param name="icn"></param>
        /// <param name="tipoOperacion"></param>
        /// <returns></returns>
        private async Task InsertarOperacionPKDB(string icn, string tipoOperacion)
        {
            Config.EscribirLog($"INFO|termina_operacion_swf|A aceptar la operacion con folio: {icn}.", NombreServicio.Swf_OUT_PK_DB.ToString());

            var resultado = await EjecutarStoredProcedureQuery<DOperaciones>(ConstantesServicio.usp_swf_inserta_pk_db, cmd =>
            {
                cmd.Parameters.Add(basedatosConexion.CrearParametro("@icn", icn));
                cmd.Parameters.Add(basedatosConexion.CrearParametro("@tipo_operacion", tipoOperacion));
            });

            if (resultado != null && !resultado.Exito) throw new Exception($"ERROR|InsertarOperacionPKDB| {resultado.MensajeError}");
        }
    }
}
