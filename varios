        /// <returns></returns>
        public async Task<bool> RealizaOperacionesAsync(CancellationToken ct)
        {
            _ctasClientes = await ObtenerCuentasAsync(ct);
            if (!await ObtenerFechasTOMIAsync(ct))
            {
                return false;
            }

            await ObtenerFechaJulianaAsync(ct);

            _paramConfig.FechaServidor = DateTime.Today;
            TimeSpan lsHoraSistema = DateTime.Now.TimeOfDay;
            _log.Info($"RealizaOperaciones|Fecha Sistema: [{_paramConfig.FechaSistema}], Fecha Anterior [{_paramConfig.FechaAnterior}], Fecha Servidor [{_paramConfig.FechaServidor.ToString(General.FORMATO_FECHA_SQL)}]");
            
            _ = await ObtenerCuentasCMSAsync(ct);

            if (_paramConfig.IniciandoServicio)
            {
                _log.Info("RealizaOperaciones|Ejecuta operaciones iniciales del servicio");
                _ = await BorrarOperacionesSinFondosTOMIAsync(ct);                    
                _ = await ActualizarSaldosCuentasCMSAsync(ct);
