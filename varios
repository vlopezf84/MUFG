                _ = await ActualizarCashPoolingAccountsAsync(ct);                    
                _ = await ActualizarCashPoolingTrxAsync(ct);
                _log.Info("RealizaOperaciones|Finaliza Ejecucion de operaciones iniciales del servicio");
            }

            _ = await MonitoreoBBVAAsync(ct);
            _ = await ValidarOperacionesEnviadasAsync(ct);
            var lbRet_Cuentas = await ActualizarCuentasAsync(ct);
            var lbRet_ops_CEP = await ActualizarOpsCepSPEIAsync(ct);
            var lbRet_ops_CEP_SPID = await ActualizarOpsCepSPIDAsync(ct);
            _ = await InsertarTimeDepositEspecialAsync(ct);
            _ = await ActualizarTimeDepositEspecialAsync(ct);
            var lbRet_CuentasCMS = await ActualizarInfoCuentasAsync(ct);
            var lbRet_Clientes_SPID = await ActualizarClientesSPIDAsync(ct);                            
            _ = await ActualizarClientesTMDAsync(ct);
            var lbRet_ECRate = await ActualizarECRateAsync(ct);            
            _ = await ActualizarMarginRateAsync(ct);
            var lbRet_TasaRetencion = await ActualizarTasaRetencionAsync(ct);
            var lbRet_ClientesISR = await ActualizarClientesSinISRAsync(ct);            
            _ = await ActualizarMontosMinimosTMDAsync(ct);            
            _ = await ActualizarClientesNonResidenceTMDAsync(ct);

            #region ACTUALIZACIONES SPEI
            //' Actualizacion de listas SPEI
            if (lsHoraSistema.Hours == _paramConfig.SPEI_HORA_ACT_PARTICIPANTES.Hours)
            {
                if (!_paramConfig.GbYaActualiceListaParticipantesSPEI)
                {
                    if (await ActualizaListaParticipantesSPEIAsync(ct))
                    {
                        //' Marco como que la lista ya fue actualizada
                        _paramConfig.UltimaActualizacionParticipantesSPEI = DateTime.Now;
                        _paramConfig.GbYaActualiceListaParticipantesSPEI = true;
                    }
                }
            }

            //' Actualización de lista de participantes SPEI por intervalo
            if ((lsHoraSistema > _paramConfig.SPEI_HORA_ACT_PARTICIPANTES) && (lsHoraSistema < _paramConfig.SPEI_HORA_FIN_ACT_PARTICIPANTES) && (_paramConfig.SPEI_INTERVALO_ACTUALIZACION > 0))
            {
                if (_paramConfig.UltimaActualizacionParticipantesSPEI.AddSeconds(_paramConfig.SPEI_INTERVALO_ACTUALIZACION) < DateTime.Now)
                {
                    if (await ActualizaListaParticipantesSPEIAsync(ct))
                    {
                        _paramConfig.UltimaActualizacionParticipantesSPEI = DateTime.Now;
                    }
                }
            }

            #endregion


            #region ACTUALIZACIONES SPID
            //' Actualizacion de listas SPID
            if (lsHoraSistema.Hours == _paramConfig.SPID_HORA_ACT_PARTICIPANTES.Hours)
            {
                if (!_paramConfig.GbYaActualiceListaParticipantesSPID)
                {
                    //Actualizar listas SPID
                    if (await ActualizaListaParticipantesSPIDAsync(ct))
                    {
                        _paramConfig.UltimaActualizacionParticipantesSPID = DateTime.Now;
                        _paramConfig.GbYaActualiceListaParticipantesSPID = true;
                    }

                }
            }
            
            //Actualización de lista de participantes SPID por intervalo
            if (lsHoraSistema > _paramConfig.SPID_HORA_ACT_PARTICIPANTES && lsHoraSistema < _paramConfig.SPID_HORA_FIN_ACT_PARTICIPANTES  && _paramConfig.SPID_INTERVALO_ACTUALIZACION != 0)
            {
                if (_paramConfig.UltimaActualizacionParticipantesSPID.AddSeconds(_paramConfig.SPID_INTERVALO_ACTUALIZACION) < DateTime.Now)
                {
                    if(await ActualizaListaParticipantesSPIDAsync(ct))
                    {
                        //' Marco como que la lista ya fue actualizada
                        _paramConfig.UltimaActualizacionParticipantesSPID= DateTime.Now;
                    }
                }

            }

            #endregion

            
            //'Actualización de operaciones pendientes.
            if (lsHoraSistema > _paramConfig.HORA_OP_FIN)
            {
                _ = await ActualizaOperacionesPendientesAsync(ct);                
            }

            //'Actualiza Conciliacion de Operaciones CMS
            _ = await ActualizarCMSConciliacionAsync(ct);

            //'Actualiza Conciliacion de Operaciones Interfaces
            _ = await ActualizarInterfacesConciliacionAsync(ct);

            //'Actualiza Conciliacion de Operaciones Swift IN
            _ = await ActualizarSwiftInConciliacionAsync(ct);

            //'Actualiza Conciliacion de Operaciones TAS
            _ = await ActualizarTASConciliacionAsync(ct);

            //'Actualiza Conciliacion de Operaciones T24
            _ = await ActualizarT24ConciliacionAsync(ct);

            //'Actualiza Cuentas TEF
            _ = await ActualizarCuentasT24TEFAsync(ct);

            if(_paramConfig.IniciandoServicio && lbRet_Cuentas && lbRet_ops_CEP && lbRet_ops_CEP_SPID && lbRet_CuentasCMS && lbRet_Clientes_SPID && lbRet_ECRate && lbRet_TasaRetencion && lbRet_ClientesISR)
            {
                _log.Info("RealizaOperaciones|A actualizar la bandera de IniciandoServicio a False.");
                _paramConfig.IniciandoServicio = false;
            }
            else
            {
                _log.Info("RealizaOperaciones|Fin de ciclo de actualización.");
            }            
            return true;
        }
        #endregion

