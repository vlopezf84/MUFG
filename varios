    /// <summary>
    /// Metodos para accesar/ejecutar sp´s en bd VT24
    /// </summary>
    public class RepositorioVT24 : RepositorioMaestro, IDAO_VT24
    {

        private readonly Configuracion _configuracion;
        private readonly IControlErrorService _controlErrorService;
        private readonly IExtensionAlerta _extAlerta;
        private readonly ILoggerService _log;

        #region Constructor
        /// <summary>
        /// Constructor servicio
        /// </summary>
        /// <param name="configuracion"></param>
        public RepositorioVT24(
            Configuracion configuracion
            , IControlErrorService controlErrorService
            , IExtensionAlerta extAlerta
            , ILoggerService log
            ) : base(BasedatosProveedor.SqlServer, NombreBasedatos.T24_VW, null, null)
        {
            _configuracion = configuracion;
            _controlErrorService = controlErrorService;
            _extAlerta = extAlerta;
            _log = log;
        }
        #endregion

        /// <summary>
        /// Metodo para validar conexión con base de datos
        /// </summary>
        /// <returns></returns>
        public async Task<bool> ValidaAccesoBdAsync(CancellationToken ct)
        {
            try
            {
                _log.Info("RepositorioVT24|ValidaAccesoBd|Inicio");

                var cnn = ConexionBasedatosFactory.CrearConexion(BasedatosProveedor.SqlServer, NombreBasedatos.T24_VW);
                using (var cn = cnn.CrearConexion())
                {
                    await cn.OpenAsync(ct);
                    _log.Info($"Base de datos {NombreBasedatos.T24_VW} iniciada correctamente");
                    if (cn.State == ConnectionState.Open)
                    {
                        // Base ok
                        _controlErrorService.LimpiaControlError(3);
                        return true;
                    }
                }
            }
            catch (Exception ex)
            {
                _log.Error($"RepositorioVT24|ValidaAccesoBd|Se presenta exception general ex:{ex}");
                await _controlErrorService.ControlErrorAsync(3, ex);
                //Registra alerta
                await _extAlerta.RegistraCriticoAsync("Error en la apertura de la base VT24", ex,ct);
            }
            finally
            {
                _log.Info("RepositorioVT24|ValidaAccesoBd|Fin");
            }
            return false;
        }





        /// <summary>
        /// Mpetodo general para obtener datos de la bd
        /// </summary>
        /// <param name="storedProcedure"></param>
        /// <param name="parametros"></param>
        /// <returns></returns>
        public async Task<DatosXML> ObtenerDatosAsync(string storedProcedure, CancellationToken ct, List<SqlParameter> parametros = null)
        {
            // Creamos salida de datos XML
            SqlParameter salidaXML = null;

            // Ejecuta el procedimiento
            var resultado = await EjecutarStoredProceduredNonQuery(storedProcedure, cmd =>
            {
                // Agrega los parametros de salida
                cmd.Parameters.Clear();
                salidaXML = cmd.AddOutPutMaxString(ConstantesServicio.General.PARAMETRO_TABLA_XML);
                cmd.AddParameters(parametros);
                cmd.CommandTimeout = 60;

            },ct);

            if (!string.IsNullOrEmpty(resultado.MensajeError))
            {
                _log.Error($"{MsgLog.ERROR_PROCESO_ENBD}: {resultado.MensajeError}");
                throw new Exception(resultado.MensajeError);
            }

            string data = salidaXML.GetValueOrDefault<string>();
            DatosXML dataXml = Utilidades.IsValidXML(data);
            if (!dataXml.Exito || !string.IsNullOrEmpty(dataXml.MsgGeneral))
            {
                _log.Info("No se recibió contenido XML en la salida del procedimiento.");
            }

            return dataXml;
        }

        public async Task<string> ObtenerDatoAsync(string storedProcedure, CancellationToken ct, List<SqlParameter> parametros = null)
        {
            // Creamos salida de datos XML
            SqlParameter fechaProceso = null;
            // Ejecuta el procedimiento
            var resultado = await EjecutarStoredProceduredNonQuery(storedProcedure, cmd =>
            {             
                fechaProceso = cmd.AddOutPutString("@ProcessDate", 8);
                cmd.CommandTimeout = 60;
                cmd.AddParameters(parametros);
            },ct);

            if (!string.IsNullOrEmpty(resultado.MensajeError))
            {
                _log.Error($"{MsgLog.ERROR_PROCESO_ENBD}: {resultado.MensajeError}");
                throw new Exception(resultado.MensajeError);
            }

            return fechaProceso.GetValueOrDefault<string>();
        }

        /// <summary>
        /// Obtener datos de conciliacion 
        /// </summary>
        /// <returns></returns>

        public async Task<List<ConciliacionT24Dto>> ObtenerDataVwT24Account(string storedProcedure, CancellationToken ct, List<SqlParameter> parametros = null)
        {
            StoredProcedureResult<ConciliacionT24Dto> resultado =
                await EjecutarStoredProcedureQuery<ConciliacionT24Dto>(
                storedProcedure, cmd =>
                {
                    cmd.CommandTimeout = 60;
                    cmd.AddParameters(parametros);
                }, ct);

            if (!string.IsNullOrEmpty(resultado.MensajeError))
            {
                _log.Error($"{MsgLog.ERROR_PROCESO_ENBD}: {resultado.MensajeError}");
                throw new Exception(resultado.MensajeError);
            }

            return resultado.Data;
        }

        /// <summary>
        /// Obtiene Fecha Juliana
        /// </summary>
        /// <param name="storedProcedure"></param>
        /// <param name="parametros"></param>
        /// <returns></returns>
        public async Task<DatosFechaJuliana> ObtenerFechaJuliana(string storedProcedure, CancellationToken ct)
        {
            StoredProcedureResult<DatosFechaJuliana> resultado =
                await EjecutarStoredProcedureQuery<DatosFechaJuliana>(
                storedProcedure, cmd =>
                {
                    cmd.CommandTimeout = 60;
                },ct);

            if (!string.IsNullOrEmpty(resultado.MensajeError))
            {
                _log.Error($"{MsgLog.ERROR_PROCESO_ENBD}: {resultado.MensajeError}");
                throw new Exception(resultado.MensajeError);
            }

            return resultado.Data?.FirstOrDefault();
        }
    }
