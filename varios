        /// <summary>
        /// Método para realizar peticiones a servicio BBVA
        /// </summary>
        /// <returns></returns>
        public async Task<bool> RealizarPeticionBBVAAsync(CancellationToken ct)
        {
            string psw, hexPsw, key, hexKey;
            bool peticionOK;
            GenerateTSEC objectTSECToSend;
            TSECResponse objectTSECResponse;
            try
            {
                _log.Info("RealizaOperaciones|MonitoreoBBVA|HSM-PSW.procesaOperacio|RealizarPeticionBBVA|Inicio");

                //Obtenemos los parametros de BBVA 
                var paramsDictBBVA = await _daoTomi.ObtenerParametrosBBVAAsync(Tomi.uspObtenerParametrosBBVA,ct);
                //valida los parametros BBVA
                var _paramsBBVA = AsignaValidaParametros.ParametrosBBVA(paramsDictBBVA,_log);


                // Se descifra el password del llavero (PKC12) por medio del HSM.
                hexPsw = await HSM_Common.DecryptParametersStoreAsync(
                    _paramsBBVA.PASSWORD_P12_BBVA
                    , _paramsBBVA.CLAVE_HSM_PASSWORD_P12_BBVA
                    , _paramsBBVA.HSM_PUERTO_UP
                    , _paramsBBVA.HSM_SERVIDOR_UP
                    , _paramsBBVA.KCV_HSM_PASSWORD_P12_BBVA
                    , _paramsBBVA.TIMEOUT_TSEC_BBVA
                    , ct
                    );

                psw = HSM_Common.Hex2Ascii(hexPsw);                
                _log.Info("RealizaOperaciones|MonitoreoBBVA|HSM-PSW.procesaOperacion|Término el descifrado de la password del llavero.");

                // Se descifra la llave digital por medio del HSM.
                hexKey = await HSM_Common.DecryptParametersStoreAsync(
                    _paramsBBVA.LLAVE_DIGITAL_BBVA
                    , _paramsBBVA.CLAVE_HSM_LLAVE_DIGITAL_BBVA
                    , _paramsBBVA.HSM_PUERTO_UP
                    , _paramsBBVA.HSM_SERVIDOR_UP
                    , _paramsBBVA.KCV_HSM_LLAVE_DIGITAL_BBVA
                    , _paramsBBVA.TIMEOUT_TSEC_BBVA
                    , ct
                    );

                key = HSM_Common.Hex2Ascii(hexKey);
                _log.Info("RealizaOperaciones|MonitoreoBBVA|HSM-KEY.procesaOperacion|Término el descifrado de la llave digital.");
                
                // Se genera el objeto a envíar.
                objectTSECToSend = Funciones.ValidarYMapearObjetoAEnviarTSEC(_paramsBBVA.NUMERO_CONTRATO_BBVA, key);

                objectTSECResponse = await _tsecClient.GenerateTsec(
                    _paramsBBVA.URI_BBVA_GENERATE_TSEC
                    , objectTSECToSend
                    , _paramsBBVA.RUTA_P12_BBVA
                    , psw
                    , _paramsBBVA.TIMEOUT_TSEC_BBVA
                );

                peticionOK = objectTSECResponse.Success;
            }
            catch (Exception ex)
            {
                peticionOK = false;
                _log.Error($"RealizaOperaciones|MonitoreoBBVA|Error al realizar la petición a BBVA:: {ex.Message}");
            }
            finally
            {
                _log.Info("RealizaOperaciones|MonitoreoBBVA|HSM-PSW.procesaOperacio|RealizaOperaciones|RealizarPeticionBBVA|Fin");
            }

            return peticionOK;
        }

        /// <summary>
        /// Metodo que obtiene las operaciones detenidas y las notifica por Email
        /// </summary>
        /// <returns></returns>
        public async Task<bool> ValidarOperacionesEnviadasAsync(CancellationToken ct)
        {
            try
            {                
                _log.Info("RealizaOperaciones|ValidarOperacionesEnviadas|Inicio");
             
                var fecha = _configuracion.FechaSistema.StringToDate();                
                var parametros = new List<SqlParameter>().AddDateTimeParameter("@FechaSistema", fecha);

                var data = await _daoCms.ObtenerOperacionesCanceladas(Cms.uspObtenerOperacionesCanceladasCMS,ct, parametros);
                if (string.IsNullOrEmpty(data))
                {
                    _log.Info($"RealizaOperaciones|ValidarOperacionesEnviadas|No se encontraron");
                    return false;
                }
                var TablaXML = $"Las siguientes operaciones tienen mas de 5 minutos de haber sido enviadas a MUFG : <br> {data} ";

                var mailSubDev = ConfigExtension.GetValorConfig("MAIL_SUBJECT");
                var mailSenderDev = ConfigExtension.GetValorConfig("MAIL_SENDER_TEST");
                var mailToDev = ConfigExtension.GetValorConfig("MAIL_TO");
                var mailCCDev = ConfigExtension.GetValorConfig("MAIL_CC");


                string mailToProd = _configuracion.ParametrosSistema.GetValueStringOrDefault("REPLICAS_EMAIL_TO", "");
                string mailSenderProd = _configuracion.ParametrosSistema.GetValueStringOrDefault("REPLICAS_EMAIL_FROM", "");
                string mailCCProd = _configuracion.ParametrosSistema.GetValueStringOrDefault("REPLICAS_EMAIL_CC", "");
                bool boolEnviarmail = true;

                if (string.IsNullOrEmpty(mailToProd))
                {
                    _log.Info("ERROR|RealizaOperaciones|ValidarOperacionesEnviadasAsync|EnvíoEmail| No esta configurado el mail destino en parametros del sistema");
                    boolEnviarmail = false;
                }

                if (string.IsNullOrEmpty(mailSenderProd))
                {
                    _log.Info("ERROR|RealizaOperaciones|ValidarOperacionesEnviadasAsync|EnvíoEmail| No esta configurado el mail emisor en parametros del sistema");
                    boolEnviarmail = false;
                }

                if (string.IsNullOrEmpty(TablaXML))
                {
                    _log.Info("ERROR|RealizaOperaciones|ValidarOperacionesEnviadasAsync|EnvíoEmail| No se encontraron operaciones detenidas para ser notificadas por Email");
                    boolEnviarmail = false;
                }


                //Envio de Correo
                if (!string.IsNullOrEmpty(data) && boolEnviarmail)
                {

                    string mailFrom = string.IsNullOrEmpty(mailSenderDev) ? mailToProd : mailSenderDev;
                    string mailPara = string.IsNullOrEmpty(mailToDev) ? mailToProd : mailToDev;
                    string mailConCopia = string.IsNullOrEmpty(mailCCDev) ? mailCCProd : mailCCDev;
                    string mailSubject = string.IsNullOrEmpty(mailSubDev) ? EnvioCorreo.ASUNTO_VALIDAR_OPERACIONES : $"{mailSubDev}-{EnvioCorreo.ASUNTO_VALIDAR_OPERACIONES}";
                    
                    var result = await _emailService.EnviarAsync(new MensajeCorreo
                    {
                        CorreoOrigen = mailFrom,
                        NombreOrigen = EnvioCorreo.EMISOR_NOMBRE,
                        Para = mailPara,
                        ConCopia = mailConCopia,
                        Asunto = mailSubject,
                        Mensaje = TablaXML
                    });
                    if (!result)
                    {
                        _log.Error($"RealizaOperaciones|ValidarOperacionesEnviadas|EnvíoEmail|No se pudo enviar el email, mailTo: {mailPara}, mailFrom: {mailFrom}");
                        await _ctrlErrorService.ControlErrorAsync(0, new Exception($"No se pudo enviar el email, mailTo: {mailPara}, mailFrom: {mailFrom}"));
                    }
                    else
                    {
                        _log.Info($"RealizaOperaciones|ValidarOperacionesEnviadas|EnvíoEmail|Correo enviado");
                        _ctrlErrorService.LimpiaControlError(0);
                    }
                }
                
                return true;
            }
            catch(Exception ex)
            {
                _log.Error($"RealizaOperaciones|ValidarOperacionesEnviadas|Se presenta exception: {ex.Message}");
                await _ctrlErrorService.ControlErrorAsync(0, ex);
            }
            finally
            {
                _log.Info("RealizaOperaciones|ValidarOperacionesEnviadas|Fin");
            }
            return false;

        }
    }
