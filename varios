using AplicacionReplicas.Comunes;
using AplicacionReplicas.Interfaces;
using AplicacionReplicas.Modelos;
using MUFG_T24.Configuracion_utilidades;
using MUFG_T24.Interfaces_utilidades;
using System;
using System.Collections.Generic;
using System.Threading;
using System.Threading.Tasks;

using static AplicacionReplicas.Enums.ConstantesServicio;

namespace AplicacionReplicas
{

    /// <summary>
    /// OperacionServicio - clase que contiene el flujo principal del procesamiento (equivalente a Definiciones).
    /// </summary>
    public class OperacionServicio : IEjecucionServicio

    {
        #region Propiedades
        private readonly Configuracion _configuracion;
        private readonly IControlServicio _controlServicio;
        private readonly IAlertas _alertas;
        private readonly IParametrizacion _parametrizacion;
        private readonly IProcesoServicio _procesoServicio;
        private readonly ParametrosConfiguracion _paramConfig;
        private readonly IControlErrorService _ctrlErrorService;
        private readonly ILoggerService _log;
        private readonly IExtensionAlerta _extAlerta;
        private readonly IDAO_TOMI _repTomi;

        #endregion

        /// <summary>
        /// Constructor.
        /// </summary>
        public OperacionServicio(
            Configuracion configuracion
            , IControlServicio controlServicio
            , IAlertas alertas
            , IParametrizacion parametrizacion
            , IProcesoServicio procesoServicio
            , ParametrosConfiguracion paramConfig
            , IControlErrorService ctrlErrorService
            , ILoggerService log
            , IExtensionAlerta extAlerta
            , IDAO_TOMI repTomi
         )
        {
            _configuracion = configuracion;
            _controlServicio = controlServicio;
            _alertas = alertas;
            _parametrizacion = parametrizacion;
            _procesoServicio = procesoServicio;
            _paramConfig = paramConfig;
            _ctrlErrorService = ctrlErrorService;
            _log = log;
            _extAlerta = extAlerta;
            _repTomi = repTomi;
        }

        /// <summary>
        /// Control del flujo principal del procesamiento.
        /// </summary>
        public async Task<bool> EjecutarServicioAsync(CancellationToken ct)
        {
            bool ejecutaServicio = false;
            Dictionary<string, string> ParametrosSistema = null;
            try
            {
                _log.Info(MsgLog.EjecutaServicio.Inicio);
                // Marca que el servicio está en ejecución
                await _controlServicio.ActualizaEJecucion(_configuracion.NombreServicio);
                _configuracion.FechaSistema = await _parametrizacion.ObtenerFechaSistemaAsync();

                if (_paramConfig.HORA_REPLICA_INICIO == TimeSpan.Zero)
                    ParametrosSistema = await _parametrizacion.ObtenerParametrosSistemaAsync(stringParametros, ct);

                //Validaciones de parametros y horarios de operacion                  
                if (await AsignaValidaParametros.ParametrosAsync(_configuracion, ParametrosSistema, _paramConfig, _repTomi, ct, _log))
                    ejecutaServicio = true;
               

                // Proceso principal                
                if (ejecutaServicio)
                {
                    var result = await _procesoServicio.RealizaOperacionesAsync(ct);
                    if (!result)
                        throw new ApplicationException(MsgLog.EjecutaServicio.ErrorEjecucionServicio);
                }
                return true;

            }
            catch (Exception ex) when (ex.GetType() != typeof(Exception))
            {
                if (ex is InvalidOperationException)
                {
                    _log.Info($"{MsgLog.EjecutaServicio.Exception}:{ex.Message}");
                }
                else
                {
                    //solo manda alerta para errores criticos
                    _log.Error($"{MsgLog.EjecutaServicio.Exception}:{ex.Message}");
                    await _extAlerta.RegistraErrorAsync(ex.Message, ct);
                }
            }
            catch (Exception ex)
            {                
                _log.Error($"{MsgLog.EjecutaServicio.Exception}:{ex.Message}");
                await _extAlerta.RegistraCriticoAsync(ex,ct);
                await _ctrlErrorService.ControlErrorAsync(0, ex);
            }
            finally
            {
                // Marca el fin de la ejecucion del servicio.
               await _controlServicio.ActualizaTerminacion(_configuracion.NombreServicio,ct);                
                _log.Info(MsgLog.EjecutaServicio.Fin);
            }

            return false;
        }


    }
}


