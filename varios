        /// <summary>
        /// Metodo para validar servicio API BBVA
        /// </summary>
        /// <returns></returns>
        public async Task<bool> MonitoreoBBVAAsync(CancellationToken ct)
        {
            try
            {
                _log.Info("RealizaOperaciones|MonitoreoBBVA|Inicio");
                string checkApiBbva;
                bool apiBbvaActiva;
                checkApiBbva = "0";
                List<SqlParameter> parametros = new List<SqlParameter>().AddStringParameter("@idParametro", General.CHECK_API_BBVA);
                List<ParametroCmsDTO> _parametrosCmsDTO = await _daoCms.LeerParametroAsync(Cms.uspCMSObtenerParametro,ct, parametros);

                if (_parametrosCmsDTO != null && _parametrosCmsDTO.Count > 0)
                {
                    checkApiBbva = _parametrosCmsDTO[0].Valor;                 
                }
                bool result = false;
                if (checkApiBbva == "1")
                {
                    apiBbvaActiva = await RealizarPeticionBBVAAsync(ct);
                    parametros.Clear();
                    parametros.AddStringParameter("@idParametro", General.API_BBVA_ACTIVE, 30)
                        .AddStringParameter("@Valor", ((apiBbvaActiva) ? "1" : "0"),240);
                                     
                    _log.Info("RealizaOperaciones|MonitoreoBBVA|Se actualiza parametro de verificación del servicio BBVA");
                    result = await _daoCms.ActualizarParametroAsync(Cms.uspCMSActualizarParametro,ct, parametros);
                    if (result)
                    {
                        parametros.Clear();
                        parametros.AddStringParameter("@idParametro", General.CHECK_API_BBVA)
                            .AddStringParameter("@Valor", "0");

                        _log.Info($"RealizaOperaciones|MonitoreoBBVA|Se actualiza parametro de verificación de {General.CHECK_API_BBVA} , con valor: [0]");
                        result = await _daoCms.ActualizarParametroAsync(Cms.uspCMSActualizarParametro,ct, parametros);
                    }
                }
                else
                {
                    _log.Info("RealizaOperaciones|MonitoreoBBVA|El monitoreo de verificación la Api BBVA se encuentra apagado en parametros");
                }
                _log.Info("RealizaOperaciones|MonitoreoBBVA|Se realizo el monitoreo completo.");
                _ctrlErrorService.LimpiaControlError(0);
                return result;
            }
            catch (Exception ex)
            {
                _log.Error($"RealizaOperaciones|MonitoreoBBVA|Se presenta exception: {ex.Message}");
                await _ctrlErrorService.ControlErrorAsync(0, ex);
            }
            finally
            {
                _log.Info("RealizaOperaciones|MonitoreoBBVA|Fin");
            }
            return false;
        }

