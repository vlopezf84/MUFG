{
    /// <summary>
    /// Metodos para accesar/ejecutar sp´s en bd CMs
    /// </summary>
    public class RepositorioCMS : RepositorioMaestro, IDAO_CMS
    {
        private readonly Configuracion _configuracion;
        private readonly IControlErrorService _controlErrorService;
        private readonly IExtensionAlerta _extAlerta;
        private readonly ILoggerService _log;


        #region Constructor
        /// <summary>
        /// Constructor servicio
        /// </summary>
        /// <param name="configuracion"></param>
        public RepositorioCMS(
            Configuracion configuracion
            , IControlErrorService controlErrorService
            , IExtensionAlerta extAlerta
            , ILoggerService log
            ) : base(BasedatosProveedor.SqlServer, NombreBasedatos.CMS, null, null)
        {
            _configuracion = configuracion;
            _controlErrorService = controlErrorService;
            _extAlerta = extAlerta;
            _log = log;
        }
        #endregion

        /// <summary>
        /// Metodo para validar el acceso a la bdCMS
        /// </summary>
        /// <returns></returns>
        public async Task<bool> ValidaAccesoBdAsync(CancellationToken ct)
        {
            try
            {
                _log.Info("RepositorioCMS|ValidaAccesoBd|Inicio");

                var cnn = ConexionBasedatosFactory.CrearConexion(BasedatosProveedor.SqlServer, NombreBasedatos.CMS);
                using (var cn = cnn.CrearConexion())
                {
                    await cn.OpenAsync(ct);
                    _log.Info($"RepositorioCMS|ValidaAccesoBd|Base de datos {NombreBasedatos.CMS} iniciada correctamente");
                    if (cn.State == ConnectionState.Open)
                    {
                        // Base ok
                        _controlErrorService.LimpiaControlError(2);
                        return true;
                    }
                }
            }
            catch (Exception ex)
            {
                _log.Error($"RepositorioCMS|ValidaAccesoBd|Se presenta exception general ex:{ex}");
                await _controlErrorService.ControlErrorAsync(2, ex);
                //Registra alerta                
                await _extAlerta.RegistraCriticoAsync("Error en la apertura de la base CMS", ex,ct);               
            }
            finally
            {
                _log.Info("RepositorioCMS|ValidaAccesoBd|Fin");
            }
            return false;
        }



        /// <summary>
        /// Método general que uctualiza información 
        /// </summary>
        /// <param name="storedProcedure">Nombre del sp</param>
        /// <param name="parametros">parametros de actualización, filtrado y valores de retorno</param>
        /// <returns>Total de registros actualizados</returns>
        public async Task<ResultadoSp> ActualizarAsync(string storedProcedure, CancellationToken ct, List<SqlParameter> parametros = null)
        {
            // Creamos parámetros de salida.
            SqlParameter paramActualizados = null;
            // Ejecuta el procedimiento
            var resultado = await EjecutarStoredProceduredNonQuery(storedProcedure, cmd =>
            {                                
                paramActualizados = cmd.AddOutPutInt(ConstantesServicio.General.PARAMETRO_ACTUALIZADOS);
                cmd.CommandTimeout = 60;
                cmd.AddParameters(parametros);
            },ct);

            if (!string.IsNullOrEmpty(resultado.MensajeError))
            {
                _log.Error($"{MsgLog.ERROR_PROCESO_ENBD}: {resultado.MensajeError}");
                throw new Exception(resultado.MensajeError);
            }


            int actualizados = paramActualizados.GetValueOrDefault<int>();

            return new ResultadoSp(0, 0, actualizados, resultado.Exito);
        }


        /// <summary>
        /// Método por el cual se actualizan registros ademas de agregar nuevos registros
        /// </summary>
        /// <param name="storedProcedure">Nombre del sp</param>
        /// <param name="parametros">Parametros de actualización, filtrado y valores de retorno</param>
        /// <returns>total de registros agregados y actualizados</returns>
        public async Task<ResultadoSp> ActualizarAgregarAsync(string storedProcedure, CancellationToken ct, List<SqlParameter> parametros = null)
        {
            SqlParameter paramAgregados = null;
            SqlParameter paramActualizados = null;

            // Ejecuta el procedimiento
            var resultado = await EjecutarStoredProceduredNonQuery(storedProcedure, cmd =>
            {
                cmd.CommandTimeout = 60;
                paramActualizados = cmd.AddOutPutInt(ConstantesServicio.General.PARAMETRO_ACTUALIZADOS);
                paramAgregados = cmd.AddOutPutInt(ConstantesServicio.General.PARAMETRO_AGREGADOS);
                cmd.AddParameters(parametros);
            },ct);

