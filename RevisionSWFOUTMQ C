using AplicacionSwfOUTMQ.Modelos;
using System.Collections.Generic;
using System.Threading.Tasks;

namespace AplicacionSwfOUTMQ.Interfaces
{
    /// <summary>
    /// Interfaz para implementar métodos de consulta a la BD InterfacesT24
    /// </summary>
    public interface IRepositorioTomi<Tipo>
    {
        /// <summary>
        /// Método para guardar mensajes en MQ.
        /// </summary>
        /// <param name="listaOperaciones"></param>
        /// <returns></returns>
        Task<bool> GuardaMensajesOutMQ(IEnumerable<OperacionSWF> listaOperaciones);
        /// <summary>
        /// Método para recuperar operaciones.
        /// </summary>
        /// <returns></returns>
