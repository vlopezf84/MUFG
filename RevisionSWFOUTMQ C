using AplicacionSwfOUTMQ.Enums;
using AplicacionSwfOUTMQ.Interfaces;
using AplicacionSwfOUTMQ.Modelos;
using MUFG_T24.Comunes;
using MUFG_T24.Configuracion_utilidades;
using MUFG_T24.Enums_utilidades;
using MUFG_T24.Interfaces_utilidades;
using MUFG_T24.Modelos;
using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading;
using System.Threading.Tasks;
using IOperacionServicio = AplicacionSwfOUTMQ.Interfaces.IOperacionServicio;

namespace AplicacionSwfOUTMQ
{
    /// <summary>
    /// Clase principal para ejecutar procedimientos.
    /// </summary>
    public class OperacionServicio : IOperacionServicio
    {
        private readonly Configuracion _configuracion;
        private readonly IControlServicio _controlServicio;
        private readonly IAlertas _alertas;
        private readonly IParametrizacion _parametrizacion;
        private readonly IRepositorioTomi<OperacionSWF> _repositorioTomi;

        /// <summary>
        /// Inicializa una nueva instancia de <see cref="OperacionServicio"/>.
        /// </summary>
        /// <param name="configuracion">Configuración general del servicio.</param>
        /// <param name="controlServicio">Servicio de control de ejecución y ciclo de vida.</param>
        /// <param name="alertas">Componente para registro de alertas operativas.</param>
        /// <param name="parametrizacion">Componente para consulta de parametrización del sistema.</param>
        /// <param name="repositorioTomi">Repositorio para acceso y persistencia de operaciones SWF.</param>
        public OperacionServicio(Configuracion configuracion,
            IControlServicio controlServicio,
            IAlertas alertas,
            IParametrizacion parametrizacion,
            IRepositorioTomi<OperacionSWF> repositorioTomi)
        {
            _configuracion = configuracion;
            _controlServicio = controlServicio;
            _alertas = alertas;
            _parametrizacion = parametrizacion;
            _repositorioTomi = repositorioTomi;
        }

        /// <summary>
        /// Ejecuta el flujo principal de procesamiento de operaciones.
        /// </summary>
        /// <param name="ct">Token de cancelación de la operación.</param>
        /// <returns><c>true</c> si el flujo termina correctamente; en caso contrario, <c>false</c>.</returns>
        public async Task<bool> EjecutarProcedimientosAsync(CancellationToken ct)
        {
            try
            {
                await InicializarContextoAsync(ct);
                var gbMensajesBatch = _configuracion.ParametrosSistema[ConstantesServicio.SWFOUTGETMTBATCH];

                if (gbMensajesBatch == null)
                {
                    LogError(ConstantesServicio.MensajeBatch);
                    return false;
                }
                if (!bool.TryParse(gbMensajesBatch.ToString(), out bool banderaBatch))
                {
                    LogError(ConstantesServicio.MensajeConfiguracionBatch);
                    return false;
                }

                var operaciones = await _repositorioTomi.RecuperaOperacionesAsync().ConfigureAwait(false);

                if (operaciones == null || !operaciones.Any())
                {
                    LogInfo(ConstantesServicio.MensajeOperaciones);
                    return false;
                }

                if (banderaBatch)
                {
                    return await ProcesarOperacionesAsync(operaciones);
                }
                else
                {
                    if (!await EsDiaHabilAsync())
                        return false;

                    if (!await EstaEnHorarioOperacionAsync())
                        return false;

                    return await ProcesarOperacionesAsync(operaciones);
                }
            }
            catch (Exception ex)
            {
                LogError($"{ConstantesClaveAviso.Error} en {ConstantesServicio.MensajeEjecuta}: {ex}");
                await RegistrarAlertaAsync(ConstantesClaveAviso.Critico, ex);
                return false;
            }
            finally
            {
                await _controlServicio.ActualizaTerminacion(_configuracion.NombreServicio, ct);
            }
        }

        #region Inicialización
        /// <summary>
        /// Inicializa el contexto de ejecución y carga parámetros del sistema.
        /// </summary>
        /// <param name="ct">Token de cancelación de la operación.</param>
        private async Task InicializarContextoAsync(CancellationToken ct)
        {
            await _controlServicio.ActualizaEJecucion(_configuracion.NombreServicio, ct);

            _configuracion.FechaSistema = await _parametrizacion.ObtenerFechaSistemaAsync(ct);
            _configuracion.EsDiaHabil = await _controlServicio.EsDiaHabil();
            _configuracion.ParametrosSistema = await _parametrizacion.ObtenerParametrosSistemaAsync(ConstantesServicio.ParametrosSistema, ConstantesServicio.ParametroWsT24MwPassword, ct);

        }

        #endregion

        #region Validaciones
        /// <summary>
        /// Método para validar si es una habil o inhabil.
        /// </summary>
        /// <returns></returns>
        private async Task<bool> EsDiaHabilAsync()
        {
            if (_configuracion.EsDiaHabil == true) return true;


            LogError(ConstantesServicio.MensajeDiaInhabil);
            await RegistrarAlertaAsync(ConstantesClaveAviso.Error, null, ConstantesServicio.MensajeDiaInhabil);

            return false;
        }
        /// <summary>
        /// Validación de horario de Operación.
        /// </summary>
        /// <returns></returns>
        private async Task<bool> EstaEnHorarioOperacionAsync()
        {
            try
            {
                var horaActual = _parametrizacion.ObtenerHoraSistema();
                var inicio = _configuracion.ParametrosSistema[ConstantesGenerales.HoraOPInicio];
                var fin = _configuracion.ParametrosSistema[ConstantesGenerales.HoraOPFin];

                if (string.IsNullOrEmpty(inicio))
                {
                    var mensajeInicio = ConstantesServicio.MensajeHoraInicio;
                    LogError(mensajeInicio);
                    return false;
                }

                if (string.IsNullOrEmpty(fin))
                {
                    var mensajeFin = ConstantesServicio.MensajeHorafin;
                    LogError(mensajeFin);
                    return false;
                }

                if (!TimeSpan.TryParse(inicio, out var inicioResult))
                {
                    var mensajeR = $"{ConstantesServicio.MensajeHoraInicioError} '{inicio}'.";
                    LogError(mensajeR);
                    return false;
                }

                if (!TimeSpan.TryParse(fin, out var finResult))
                {
                    var mensajeF = $"{ConstantesServicio.MensajeHorafinError} '{fin}'.";
                    LogError(mensajeF);
                    return false;
                }

                if (inicioResult >= finResult)
                {
                    var mensajeFueraDeHorario = $"El horario configurado no es valido'.";
                    LogError(mensajeFueraDeHorario);
                    return false;
                }

                if (horaActual >= inicioResult && horaActual <= finResult)
                    return true;

                var mensaje = $"El servicio '{_configuracion.NombreServicio}' está fuera de horario";
                LogError(mensaje);
                return false;

            }
            catch (Exception ex)
            {
                var mensaje = $"{ConstantesClaveAviso.Error}|EstaEnHorarioOperacion:|{ex.Message}";
                LogError(mensaje);
                await RegistrarAlertaAsync(ConstantesClaveAviso.Error, ex, "Validación de Horario");
                return false;
            }
        }

        #endregion

        #region Procesamiento
        /// <summary>
        /// Procesa la colección de operaciones recuperadas del origen.
        /// </summary>
        /// <param name="operaciones">Operaciones a procesar y enviar.</param>
        /// <returns><c>true</c> si el procesamiento finaliza correctamente; en caso contrario, <c>false</c>.</returns>
        private async Task<bool> ProcesarOperacionesAsync(IEnumerable<OperacionSWF> operaciones)
        {
            try
            {
                return await _repositorioTomi.GuardaMensajesOutMQ(operaciones);
            }
            catch (Exception ex)
            {
                LogError($"{ConstantesClaveAviso.Error} en GuardaMensajesOutMQ: {ex}");
                return false;
            }
        }

        #endregion

        #region Alertas y Logging
        /// <summary>
        /// Registra una alerta de operación para el servicio actual.
        /// </summary>
        /// <param name="tipo">Clave de severidad o tipo de alerta.</param>
        /// <param name="ex">Excepción asociada al evento.</param>
        /// <param name="descripcion">Descripción funcional opcional de la alerta.</param>
        private async Task RegistrarAlertaAsync(string tipo, Exception ex = null, string descripcion = null)
        {
            await _alertas.InsertarAlerta(new AlertaDTO
            {
                Servicio = _configuracion.NombreServicio,
                ClaveAviso = tipo,
                Descipcion = descripcion,
                PId = _configuracion.Pid.Value,
                NombreProceso = _configuracion.NombreProceso,
                Exception = ex
            });
        }
        /// <summary>
        /// Registra un mensaje informativo en el log del servicio.
        /// </summary>
        /// <param name="msg">Mensaje a registrar.</param>
        private void LogInfo(string msg) =>
            Config.EscribirLog($"{ConstantesServicio.MensajeINFO}|{ConstantesServicio.MensajeEjecuta}|{msg}");
        /// <summary>
        /// Registra un mensaje de error en el log del servicio.
        /// </summary>
        /// <param name="msg">Mensaje a registrar.</param>
        private void LogError(string msg) =>
            Config.EscribirLog($"{ConstantesClaveAviso.Error}|{ConstantesServicio.MensajeEjecuta}|{msg}");

        #endregion
    }
}
