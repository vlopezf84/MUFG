Code block (csharp)
var data = spEjecucion?.Data ?? new List<DLField>();
Code block (csharp)
Config.EscribirLog("INFO|ActualizaDatosFIEL|Datos Actualizados",
    NombreServicio.SPID_FIEL.ToString());
