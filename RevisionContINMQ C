        /// <summary>
        /// Obtiene los parametros del sistema necesario para la operacion del servicio
        /// </summary>
        private async Task ObtenerParametros(CancellationToken ct)
        {
            try
            {
                await _repositorioTomi.ProcesoActualizaEjecucion(
                 _configuracion.NombreServicio, (int)_configuracion.Pid, _configuracion.NombreProceso);

                _configuracion.BoEsDiaHabil = await _repositorioTomi.ValidaSiEsDiaHabil();
                await ObtenerParametrosSistema(ct);

                // Obtencion de la fecha del sistema.
                var horaActual = DateTime.Now;
                _configuracion.StrFechaSistemaServicio = new TimeSpan(horaActual.Hour, horaActual.Minute, 0);

                if (string.IsNullOrEmpty(_configuracion.HORA_OP_SWF_LU_INI.ToString()) || string.IsNullOrEmpty(_configuracion.HORA_OP_SWF_LU_FIN.ToString()))
                    MensajeThrow("No se especifica la hora de inicio/fin de operaciones LUNES");

                if (string.IsNullOrEmpty(_configuracion.HORA_OP_SWF_MA_INI.ToString()) || string.IsNullOrEmpty(_configuracion.HORA_OP_SWF_MA_FIN.ToString()))
                    MensajeThrow("No se especifica la hora de inicio/fin de operaciones MARTES");

                if (string.IsNullOrEmpty(_configuracion.HORA_OP_SWF_MI_INI.ToString()) || string.IsNullOrEmpty(_configuracion.HORA_OP_SWF_MI_FIN.ToString()))
                    MensajeThrow("No se especifica la hora de inicio/fin de operaciones MIERCOLES");

                if (string.IsNullOrEmpty(_configuracion.HORA_OP_SWF_JU_INI.ToString()) || string.IsNullOrEmpty(_configuracion.HORA_OP_SWF_JU_FIN.ToString()))
                    MensajeThrow("No se especifica la hora de inicio/fin de operaciones JUEVES");

                if (string.IsNullOrEmpty(_configuracion.HORA_OP_SWF_VI_INI.ToString()) || string.IsNullOrEmpty(_configuracion.HORA_OP_SWF_VI_FIN.ToString()))
                    MensajeThrow("No se especifica la hora de inicio/fin de operaciones VIERNES");

                if (string.IsNullOrEmpty(_configuracion.HORA_OP_SWF_SA_INI.ToString()) || string.IsNullOrEmpty(_configuracion.HORA_OP_SWF_SA_FIN.ToString()))
                    MensajeThrow("No se especifica la hora de inicio/fin de operaciones SABADO");

                if (string.IsNullOrEmpty(_configuracion.HORA_OP_SWF_DO_INI.ToString()) || string.IsNullOrEmpty(_configuracion.HORA_OP_SWF_DO_FIN.ToString()))
                    MensajeThrow("No se especifica la hora de inicio/fin de operaciones DOMINGO");
            }
            catch (Exception ex)
            {
                Config.EscribirLog($"ERROR|ObtenerParametros|Se presenta excepción: {ex}");
                throw;
            }
        }

        /// <summary>
        /// Ejecuta procedimeinto
        /// </summary>
        /// <returns></returns>
        public async Task EjecutaProcedimiento(CancellationToken ct)
        {
            Exception excepcionPrincipal = null;
            try
            {
                await ObtenerParametros(ct);
                _configuracion.EnHorarioOperaciones = false;

                if (DateTime.Now.DayOfWeek.Equals(DayOfWeek.Monday))
                {
                    _configuracion.EnHorarioOperaciones = (_configuracion.StrFechaSistemaServicio >= _configuracion.HORA_OP_SWF_LU_INI &&
                        _configuracion.StrFechaSistemaServicio <= _configuracion.HORA_OP_SWF_LU_FIN);
                }

                if (DateTime.Now.DayOfWeek.Equals(DayOfWeek.Tuesday))
                {
                    _configuracion.EnHorarioOperaciones = (_configuracion.StrFechaSistemaServicio >= _configuracion.HORA_OP_SWF_MA_INI &&
                        _configuracion.StrFechaSistemaServicio <= _configuracion.HORA_OP_SWF_MA_FIN);
                }

                if (DateTime.Now.DayOfWeek.Equals(DayOfWeek.Wednesday))
                {
                    _configuracion.EnHorarioOperaciones = (_configuracion.StrFechaSistemaServicio >= _configuracion.HORA_OP_SWF_MI_INI &&
                        _configuracion.StrFechaSistemaServicio <= _configuracion.HORA_OP_SWF_MI_FIN);
                }

                if (DateTime.Now.DayOfWeek.Equals(DayOfWeek.Thursday))
                {
                    _configuracion.EnHorarioOperaciones = (_configuracion.StrFechaSistemaServicio >= _configuracion.HORA_OP_SWF_JU_INI &&
                        _configuracion.StrFechaSistemaServicio <= _configuracion.HORA_OP_SWF_JU_FIN);
                }

                if (DateTime.Now.DayOfWeek.Equals(DayOfWeek.Friday))
                {
                    _configuracion.EnHorarioOperaciones = (_configuracion.StrFechaSistemaServicio >= _configuracion.HORA_OP_SWF_VI_INI &&
                        _configuracion.StrFechaSistemaServicio <= _configuracion.HORA_OP_SWF_VI_FIN);
                }

                if (DateTime.Now.DayOfWeek.Equals(DayOfWeek.Saturday))
                {
                    _configuracion.EnHorarioOperaciones = (_configuracion.StrFechaSistemaServicio >= _configuracion.HORA_OP_SWF_SA_INI &&
                        _configuracion.StrFechaSistemaServicio <= _configuracion.HORA_OP_SWF_SA_FIN);
                }

                if (DateTime.Now.DayOfWeek.Equals(DayOfWeek.Sunday))
                {
                    _configuracion.EnHorarioOperaciones = (_configuracion.StrFechaSistemaServicio >= _configuracion.HORA_OP_SWF_DO_INI &&
                        _configuracion.StrFechaSistemaServicio <= _configuracion.HORA_OP_SWF_DO_FIN);
                }

                Config.EscribirLog($"INFO|Ejecuta_Procedimiento|{(_configuracion.EnHorarioOperaciones ? "inicio" : "Termina")}" +
                    $"horario de operaciones, HoraSistema='{_configuracion.StrFechaSistemaServicio:hh\\:mm}'.", NombreServicio.Swf_IN_ControladorServiciosMQ.ToString());

                bool bolPuedeIniciar = _configuracion.EnHorarioOperaciones;

                Task<bool>[] tareas = new[]
                {
                        bolPuedeIniciar
                        ? _controlador.IniciaServicioAsync(EnumComunes.Swf_IN_MQ)
                        : _controlador.DetieneServicioAsync(EnumComunes.Swf_IN_MQ),

                        bolPuedeIniciar
                        ? _controlador.IniciaServicioAsync(EnumComunes.Swf_IN_MQ_MX)
                        : _controlador.DetieneServicioAsync(EnumComunes.Swf_IN_MQ_MX),
                };

                bool[] resultados = await Task.WhenAll(tareas);

                if (resultados.Any(x => !x))
                {
                    Config.EscribirLog($"ERROR|Uno o mas servicios no alcanzaron el estado deseado: " +
                        $"{_configuracion.NombreServicio}");
                }
                else
                {
                    Config.EscribirLog($"INFO|Todos los servicios alcanzaron el estado deseado: " +
                        $"{_configuracion.NombreServicio}");
                }
            }
            catch (Exception ex)
            {
                excepcionPrincipal = ex;

                Config.EscribirLog("ERROR|Ejecuta_Procedimiento|Se presenta exception: "
                    + ex, _configuracion.NombreServicio);

                await _repositorioTomi.ProcesoInsertaAlerta(new AlertaDTO()
                {
                    Folio = null,
                    TipoOPeracion = null,
                    Servicio = _configuracion.NombreServicio,
                    ClaveAviso = EnumComunes.ALERTA_ESTATUS_ERROR,
                    Descipcion = $"Error durante la evaluación de configuración o acceso a datos.",
                    PId = (int)_configuracion.Pid,
                    NombreProceso = _configuracion.NombreProceso,
                    Exception = ex
                });

                throw;
            }
            finally
            {
                try
                {
                    await _repositorioTomi.ProcesoActualizaTerminacion(
                        _configuracion.NombreServicio, (int)_configuracion.Pid, _configuracion.NombreProceso);
                }
                catch (Exception exFinally)
                {
                    Config.EscribirLog($"ERROR|Ejecuta_Procedimiento|No fue posible marcar el servicio en finalización: {exFinally}");

                    if (excepcionPrincipal == null)
                    {
                        throw;
                    }
                }
            }
        }

        /// <summary>
        /// Registra un mensaje de error y genera una excepción.
        /// </summary>
        /// <param name="mensaje">
        /// Mensaje de error a registrar.
        /// </param>
        private void MensajeThrow(string mensaje)
        {
            Config.EscribirLog(mensaje, _configuracion.NombreServicio);
            throw new InvalidOperationException(mensaje);
        }
    }
