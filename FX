Imports System
Imports System.Collections.Generic
Imports System.IO
Imports System.Net
Imports System.Text
Imports Newtonsoft.Json
Imports Newtonsoft.Json.Linq

Module Module1

    Sub Main()
        Try
            ' Configuración inicial
            Dim apiUrl As String = "https://10.10.10.10:9301/api/v1/rules?id=666999555"
            Dim username As String = "tu_usuario" ' Reemplaza con tu usuario real
            Dim password As String = "tu_contraseña" ' Reemplaza con tu contraseña real

            ' 1. Consultar el API
            Dim jsonResponse As String = GetApiResponse(apiUrl, username, password)

            ' 2. Procesar el JSON y extraer los groupingCriteria
            Dim groupingCriteriaList As List(Of String) = ExtractGroupingCriteria(jsonResponse)

            ' 3. Imprimir los resultados en consola
            Console.WriteLine("Valores de groupingCriteria encontrados:")
            For Each criteria As String In groupingCriteriaList
                Console.WriteLine(criteria)
            Next

            Console.WriteLine(vbCrLf & "Proceso completado. Presione cualquier tecla para salir...")
            Console.ReadKey()

        Catch ex As Exception
            Console.WriteLine("Error: " & ex.Message)
            Console.ReadKey()
        End Try
    End Sub

    Function GetApiResponse(apiUrl As String, username As String, password As String) As String
        ' Configurar la solicitud HTTP
        Dim request As HttpWebRequest = DirectCast(WebRequest.Create(apiUrl), HttpWebRequest)
        request.Method = "GET"
        
        ' Configurar autenticación básica (aunque dices que es "No authorization", 
        ' algunos APIs requieren credenciales en el header aunque el tipo sea "None")
        Dim authInfo As String = username + ":" + password
        authInfo = Convert.ToBase64String(Encoding.Default.GetBytes(authInfo))
        request.Headers("Authorization") = "Basic " + authInfo

        ' Configurar SSL/TLS (importante para HTTPS)
        ServicePointManager.SecurityProtocol = SecurityProtocolType.Tls12 Or SecurityProtocolType.Tls11 Or SecurityProtocolType.Tls
        ServicePointManager.ServerCertificateValidationCallback = Function(sender, certificate, chain, sslPolicyErrors) True

        ' Obtener la respuesta
        Using response As HttpWebResponse = DirectCast(request.GetResponse(), HttpWebResponse)
            Using reader As New StreamReader(response.GetResponseStream())
                Return reader.ReadToEnd()
            End Using
        End Using
    End Function

    Function ExtractGroupingCriteria(jsonResponse As String) As List(Of String)
        Dim result As New List(Of String)()

        ' Parsear el JSON
        Dim jsonArray As JArray = JArray.Parse(jsonResponse)
        
        ' Verificar si hay al menos un elemento en el array
        If jsonArray.Count > 0 Then
            ' Obtener el primer objeto (asumiendo que es el que nos interesa)
            Dim firstRule As JObject = DirectCast(jsonArray(0), JObject)
            
            ' Verificar si existe la propiedad "checks"
            If firstRule.ContainsKey("checks") Then
                Dim checksArray As JArray = DirectCast(firstRule("checks"), JArray)
                
                ' Iterar sobre cada check
                For Each check As JObject In checksArray
                    ' Verificar si existe groupingCriteria y tiene al menos un elemento
                    If check.ContainsKey("groupingCriteria") Then
                        Dim groupingCriteria As JArray = DirectCast(check("groupingCriteria"), JArray)
                        If groupingCriteria.Count > 0 Then
                            ' Agregar el primer elemento (asumiendo que es el que necesitamos)
                            result.Add(groupingCriteria(0).ToString())
                        End If
                    End If
                Next
            End If
        End If

        Return result
    End Function

End Module
