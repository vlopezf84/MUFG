Imports System
Imports System.Collections.Generic
Imports System.IO
Imports System.Net
Imports System.Text
Imports System.Data
Imports System.Data.SqlClient
Imports Newtonsoft.Json
Imports Newtonsoft.Json.Linq

Module Module3

    Sub Main()
        ' 1. Obtener los valores únicos del HashSet (ejemplo)
        Dim groupingCriteriaSet As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase) From {
            "DEUTSCHE BANK AG CD00094109",
            "OTRO BANK AG CD00094109",
            "DENSO MEXICO, S.A. DE C.V.  CD00036268"
        }

        ' 2. Construir el JSON con todos los criteria
        Dim requestBody As String = BuildRequestBody(groupingCriteriaSet)

        ' 3. Consultar la API una sola vez
        Dim apiResponse As String = QueryApi(requestBody)

        ' 4. Procesar todas las respuestas y ejecutar los SP
        ProcessApiResponse(apiResponse)
        
        Console.WriteLine("Proceso completado. Presione cualquier tecla para salir...")
        Console.ReadKey()
    End Sub

    Function BuildRequestBody(criteriaSet As HashSet(Of String)) As String
        ' Crear la estructura principal del JSON
        Dim requestBodyObj As New JObject(
            New JProperty("aggregationParamsList",
                New JArray(
                    New JObject(
                        New JProperty("ruleCodes",
                            New JArray("FxSpotAbsNotional USD")),
                        New JProperty("groupingValuesList", 
                            New JArray(BuildGroupingValuesArray(criteriaSet)))
                    )
                )
            )
        )
        
        Return requestBodyObj.ToString()
    End Function

    Function BuildGroupingValuesArray(criteriaSet As HashSet(Of String)) As JArray
        Dim groupingValuesArray As New JArray()
        
        For Each criteria In criteriaSet
            groupingValuesArray.Add(
                New JObject(
                    New JProperty("columnsWithValues",
                        New JObject(
                            New JProperty("CounterParty.Short Name", criteria)
                        )
                    )
                )
        Next
        
        Return groupingValuesArray
    End Function

    Function QueryApi(requestBody As String) As String
        Dim apiUrl As String = "https://10.10.10.10:9301/api/v1/headroom"
        Dim username As String = "tu_usuario"
        Dim password As String = "tu_contraseña"

        Dim request As HttpWebRequest = DirectCast(WebRequest.Create(apiUrl), HttpWebRequest)
        request.Method = "POST"
        request.ContentType = "application/json"
        
        ' Configurar autenticación básica
        Dim authInfo As String = username & ":" & password
        authInfo = Convert.ToBase64String(Encoding.Default.GetBytes(authInfo))
        request.Headers("Authorization") = "Basic " & authInfo

        ' Configurar SSL/TLS
        ServicePointManager.SecurityProtocol = CType(3072 Or 768, SecurityProtocolType)
        ServicePointManager.ServerCertificateValidationCallback = Function(sender, certificate, chain, sslPolicyErrors) True

        ' Escribir el cuerpo de la solicitud
        Using streamWriter As New StreamWriter(request.GetRequestStream())
            streamWriter.Write(requestBody)
            streamWriter.Flush()
        End Using

        ' Obtener la respuesta
        Using response As HttpWebResponse = DirectCast(request.GetResponse(), HttpWebResponse)
            Using reader As New StreamReader(response.GetResponseStream())
                Return reader.ReadToEnd()
            End Using
        End Using
    End Function

    Sub ProcessApiResponse(jsonResponse As String)
        Try
            Dim jsonArray As JArray = JArray.Parse(jsonResponse)
            
            For Each item As JObject In jsonArray
                Try
                    ' Extraer el nombre completo del criterio
                    Dim fullName As String = item("WARNING_VALUE").ToString()
                    
                    ' Extraer el ID (CDxxxxxxx)
                    Dim entityId As String = ExtractEntityId(fullName)
                    
                    ' Convertir los valores numéricos
                    Dim freeLimit As Decimal = ConvertFreeLimit(item("FREE_LIMIT").ToString())
                    Dim limit As Decimal = Convert.ToDecimal(item("LIMIT"))
                    
                    ' Ejecutar el stored procedure
                    ExecuteInsertSP(entityId, freeLimit, limit)
                    
                    Console.WriteLine($"Procesado exitosamente: {fullName}")
                Catch ex As Exception
                    Console.WriteLine($"Error procesando un elemento de la respuesta: {ex.Message}")
                End Try
            Next
        Catch ex As Exception
            Console.WriteLine($"Error procesando la respuesta de la API: {ex.Message}")
        End Try
    End Sub

    Function ExtractEntityId(fullName As String) As String
        Dim pattern As String = "CD\d{8}"
        Dim match = System.Text.RegularExpressions.Regex.Match(fullName, pattern)
        
        If match.Success Then
            Return match.Value
        Else
            Throw New ArgumentException($"No se pudo extraer el ID de: {fullName}")
        End If
    End Function

    Function ConvertFreeLimit(freeLimitStr As String) As Decimal
        ' Limpiar y convertir FREE_LIMIT (remover comas, símbolos y espacios)
        freeLimitStr = freeLimitStr.Replace(",", "").Replace("$", "").Replace(" ", "").Trim()
        Return Convert.ToDecimal(freeLimitStr)
    End Function

    Sub ExecuteInsertSP(entityId As String, freeLimit As Decimal, limit As Decimal)
        Dim connectionString As String = "Tu_Cadena_De_Conexion_A_SQL"
        
        Using connection As New SqlConnection(connectionString)
            Using command As New SqlCommand("Insertar", connection)
                command.CommandType = CommandType.StoredProcedure
                
                ' Agregar parámetros
                command.Parameters.Add("@EntityId", SqlDbType.VarChar, 10).Value = entityId
                command.Parameters.Add("@FreeLimit", SqlDbType.Decimal).Value = freeLimit
                command.Parameters.Add("@Limit", SqlDbType.Decimal).Value = limit
                
                ' Ejecutar el SP
                connection.Open()
                command.ExecuteNonQuery()
            End Using
        End Using
    End Sub

End Module

