using MUFG_T24.Modelos;
using System;
using System.ServiceProcess;
using System.Threading.Tasks;

namespace Aplicacion.Service
{
    /// <summary>
    /// Clase para levantar y detener servicios
    /// </summary>
    public class ControladorServicios : IControladorServicios
    {
        private readonly ConfiguracionServicio _configuracion;
        private readonly IRepositorioTomi _repositorioTomi;

        /// <summary>
        /// Inicializa una nueva instancia de la clase ControladorServicios.
        /// </summary>
        /// <param name="configuracion">
        /// Configuración general del servicio.
        /// </param>
        /// <param name="repositorioTomi">
        /// Repositorio utilizado para el registro de alertas.
        /// </param>
        public ControladorServicios(ConfiguracionServicio configuracion, IRepositorioTomi repositorioTomi)
        {
            _configuracion = configuracion;
            _repositorioTomi = repositorioTomi;
        }

        /// <param name="strNombreServicio">
        /// Nombre del servicio de Windows que se iniciará.
        /// </param>
        /// <returns>
        /// True cuando el servicio se inicia correctamente;
        /// en caso contrario, false.
        /// </returns>
        public async Task<bool> IniciaServicioAsync(string strNombreServicio)
        {
            try
            {
                using (ServiceController serviceController = new ServiceController(strNombreServicio, "."))
                {
                    serviceController.Refresh();
                    if (serviceController.Status != ServiceControllerStatus.Running)
                    {
                        Config.EscribirLog($"INFO|Ejecuta_Procedimientos|Inicialización del Servicio '{strNombreServicio}'.");
                        await Task.Run(() =>
                        {
                            serviceController.Start();
                            serviceController.WaitForStatus(ServiceControllerStatus.Running, TimeSpan.FromSeconds(30));
                        });
                        return true;
                    }
                }
            }
            catch (Exception ex)
            {
                Config.EscribirLog($"ERROR|servicioArriba|Excepcion: {ex}");

                await _repositorioTomi.ProcesoInsertaAlerta(new AlertaDTO()
                {
                    Folio = null,
                    TipoOPeracion = null,
                    Servicio = _configuracion.StrNombreServicio,
                    ClaveAviso = EnumComunes.ALERTA_ESTATUS_ERROR,
                    Descipcion = $"Error al tratar de levantar el servicio '{strNombreServicio}'",
                    PId = (int)_configuracion.Pid,
                    NombreProceso = _configuracion.StrNombreProceso,
                    Exception = ex
                });
            }
            return false;
        }

        /// <summary>
        /// Detiene un servicio de Windows.
        /// </summary>
        /// <param name="strNombreServicio"></param>
        public async Task<bool> DetieneServicioAsync(string strNombreServicio)
        {
            try
            {
                using (ServiceController serviceController = new ServiceController(strNombreServicio, "."))
                {
                    serviceController.Refresh();
                    if (serviceController.Status != ServiceControllerStatus.Stopped && serviceController.Status != ServiceControllerStatus.StopPending)
                    {
                        Config.EscribirLog($"INFO|Ejecuta_Procedimientos|Finalización del Servicio '{strNombreServicio}'.");
                        await Task.Run(() =>
                        {
                            serviceController.Stop();
                            serviceController.WaitForStatus(ServiceControllerStatus.Stopped, TimeSpan.FromSeconds(30));
                        });
                        return true;
                    }
                }
            }
            catch (Exception ex)
            {
                Config.EscribirLog($"ERROR|servicioAbajo|Excepcion: {ex.ToString()}");
                await _repositorioTomi.ProcesoInsertaAlerta(new AlertaDTO()
                {
                    Folio = null,
                    TipoOPeracion = null,
                    Servicio = _configuracion.StrNombreServicio,
                    ClaveAviso = EnumComunes.ALERTA_ESTATUS_ERROR,
                    Descipcion = $"Error al tratar de detener el servicio '{strNombreServicio}'",
                    PId = (int)_configuracion.Pid,
                    NombreProceso = _configuracion.StrNombreProceso,
                    Exception = ex
                });
            }
            return false;
        }
    }
}
