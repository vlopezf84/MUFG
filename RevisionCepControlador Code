        /// <summary>
        /// Evalúa los horarios configurados e inicia o detiene los
        /// servicios correspondientes según el estado operativo.
        /// </summary>
        public async Task EjecutaProcedimiento()
        {
            try
            {
                await _repositorioTomi.ProcesoActualizaEjecucion( _configuracion.StrNombreServicio, (int)_configuracion.Pid, _configuracion.StrNombreProceso);

                // Obtiene los parametros del sistema (variables, rutas, fechas, etc)
                await ObtenerParametros();

                ///Validamos el horario de las operaciones, indicara si la bandera es falso o verdadero. 
                _configuracion.EnHorarioOperaciones = (_configuracion.StrFechaSistemaServicio >= _configuracion.HORA_OP_INICIO && _configuracion.StrFechaSistemaServicio <= _configuracion.HORA_OP_FIN);
                Config.EscribirLog($"INFO|Ejecuta_Procedimientos|{(_configuracion.EnHorarioOperaciones ? "inicio" : "Termina")}horario de operaciones, HoraSistema='{_configuracion.StrFechaSistemaServicio:hh\\:mm}'.",NombreServicio.CEP_ControladorServicios.ToString());

                _configuracion.EnHorarioOperacionesSPID = (_configuracion.StrFechaSistemaServicio >= _configuracion.HORA_SPID_INICIO && _configuracion.StrFechaSistemaServicio <= _configuracion.HORA_SPID_CEP_FIN);
                Config.EscribirLog($"INFO|Ejecuta_Procedimientos|{(_configuracion.EnHorarioOperacionesSPID ? "inicio" : "Termina")}horario de operaciones SPID, HoraSistema='{_configuracion.StrFechaSistemaServicio:hh\\:mm}'.",NombreServicio.CEP_ControladorServicios.ToString());

                _configuracion.EnHorarioOperacionesSPIDFIEL = (_configuracion.StrFechaSistemaServicio >= _configuracion.HORA_SPID_INICIOFIEL && _configuracion.StrFechaSistemaServicio <= _configuracion.HORA_SPID_CEP_FIN);
                Config.EscribirLog($"INFO|Ejecuta_Procedimientos|{(_configuracion.EnHorarioOperacionesSPIDFIEL ? "inicio" : "Termina")}horario de operaciones SPID FIEL, HoraSistema='{_configuracion.StrFechaSistemaServicio:hh\\:mm}'.",NombreServicio.CEP_ControladorServicios.ToString());

                _configuracion.EnHorarioOperacionesSPIDACCIONISTA = (_configuracion.StrFechaSistemaServicio >= _configuracion.HORA_SPID_INICIOACCIONISTA && _configuracion.StrFechaSistemaServicio <= _configuracion.HORA_SPID_CEP_FIN);
                Config.EscribirLog($"INFO|Ejecuta_Procedimientos|{(_configuracion.EnHorarioOperacionesSPIDACCIONISTA ? "inicio" : "Termina")}horario de operaciones SPID ACCIONISTA, HoraSistema='{_configuracion.StrFechaSistemaServicio:hh\\:mm}'.",NombreServicio.CEP_ControladorServicios.ToString());


                bool bolPuedeIniciarOP = _configuracion.BoEsDiaHabil && _configuracion.EnHorarioOperaciones;
                bool bolPuedeIniciarSPID = _configuracion.BoEsDiaHabil && _configuracion.EnHorarioOperacionesSPID;
                bool bolPuedeIniciarSPIDFIEL = _configuracion.BoEsDiaHabil && _configuracion.EnHorarioOperacionesSPIDFIEL;
                bool bolPuedeIniciarACCIONISTA = _configuracion.BoEsDiaHabil && _configuracion.EnHorarioOperacionesSPIDACCIONISTA;

                //Ejecución de los SPEI SPID
                Task<bool>[] tareas = new[]
                {
                    bolPuedeIniciarOP
                    ? _controlador.IniciaServicioAsync(EnumComunes.SPEI_CEP_GEN_CDA)
                    : _controlador.DetieneServicioAsync(EnumComunes.SPEI_CEP_GEN_CDA),

                    bolPuedeIniciarSPID
                    ? _controlador.IniciaServicioAsync(EnumComunes.SPID_CEP_GEN_CDA)
                    : _controlador.DetieneServicioAsync(EnumComunes.SPID_CEP_GEN_CDA),

                    bolPuedeIniciarSPIDFIEL
                    ? _controlador.IniciaServicioAsync(EnumComunes.SPID_FIEL)
                    : _controlador.DetieneServicioAsync(EnumComunes.SPID_FIEL),

                    bolPuedeIniciarACCIONISTA
                    ? _controlador.IniciaServicioAsync(EnumComunes.SPID_Accionistas)
                    : _controlador.DetieneServicioAsync(EnumComunes.SPID_Accionistas),
                };

                await Task.WhenAll(tareas);
            }
            catch (Exception ex)
            {
                Config.EscribirLog("ERROR|Ejecuta_Procedimientos|Se presenta exception: " + ex.ToString(), _configuracion.StrNombreServicio);
                Config.EscribirLog("ERROR|Ejecuta_Procedimientos|Se forza la finalización del servicio.", _configuracion.StrNombreServicio);
                throw;
            }
            finally
            {
                try
                {
                    // Fin de los procesos a realizar
                    await _repositorioTomi.ProcesoActualizaTerminacion(_configuracion.StrNombreServicio, (int)_configuracion.Pid, _configuracion.StrNombreProceso);
                }
                catch (Exception exFinally)
                {
                    Config.EscribirLog($"ERROR|Ejecuta_Procedimientos|no fue posible maracar el servicio en finalización: {exFinally}");
                    throw;
                }
            }
        }

