using Aplicacion.Enums;
using Aplicacion.Interfaces;
using Aplicacion.Modelos;
using Aplicacion.Modelos.Tomi;
using MUFG_T24.Comunes;
using MUFG_T24.Modelos;
using MUFG_T24.Repositorios;
using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading.Tasks;

namespace Infraestructura.Servicio
{
    /// <summary>
    /// Clase para conectarse a BD InterfacesT24 
    /// </summary>
    public class RepositorioTomi : RepositorioMaestro, IRepositorioTomi
    {
        private readonly ConfiguracionServicio _configuracion;
        private readonly Alertas _alertas;
        public RepositorioTomi(Alertas alertas, ConfiguracionServicio configuracion)
            : base(BasedatosProveedor.SqlServer, NombreBasedatos.TOMI, null, null)
        {
            _alertas = alertas;
            _configuracion = configuracion;
        }

        /// <summary>
        /// Marca como disponible el puerto asociado al servicio indicado.
        /// </summary>
        /// <param name="strServicio">
        /// Nombre del servicio que liberará el puerto.
        /// </param>
        public async Task ActualizaPuertoLibre(string strServicio)
        {
            StoredProcedureResult resultadoSP =await EjecutarStoredProceduredNonQuery(
                EnumProcedimientosAlmacenados.usp_MarcaPuertoLibre, cmd =>
                {
                    cmd.Parameters.Add(basedatosConexion.CrearParametro("@Servicio", strServicio));
                });

            if (resultadoSP == null || !resultadoSP.Exito)
            {
                MensajeThrow($"Error: no se completo actualizacion del puerto: {resultadoSP?.MensajeError}");
            }
        }

        /// <summary>
        /// Marca puerto en uso
        /// </summary>
        /// <param name="intpId"></param>
        /// <param name="strNombreProceso"></param>
        /// <param name="strNombreServicio"></param>
        /// <param name="strServicio"></param>
        /// <returns></returns>
        /// <exception cref="Exception"></exception>
        public async Task ActualizaPuertoEnUso(
            int intpId, string strNombreProceso, string strNombreServicio, string strServicio)
        {
            StoredProcedureResult resultadoSP =await EjecutarStoredProceduredNonQuery(
                EnumProcedimientosAlmacenados.usp_MarcaPuertoEnEso, cmd =>
                {
                    cmd.Parameters.Add(basedatosConexion.CrearParametro("@PId", intpId));
                    cmd.Parameters.Add(basedatosConexion.CrearParametro("@NombreProceso", strNombreProceso, 50));
                    cmd.Parameters.Add(basedatosConexion.CrearParametro("@NombreServicio", strNombreServicio, 50));
                    cmd.Parameters.Add(basedatosConexion.CrearParametro("@Servicio", strServicio, 50));
                });

            if (resultadoSP == null || !resultadoSP.Exito)
            {
                MensajeThrow($"Error: no se completo actualizacion del puerto: {resultadoSP?.MensajeError}");
            }
        }

        /// <summary>
        /// Obtiene las fechas del sistema.
        /// </summary>
        /// <returns>string</returns>
        public async Task<string> ObtenerFechaSistema()
        {
            try
            {
                StoredProcedureResult<MapearCamposGenerales> strFecha =
                await EjecutarStoredProcedureQuery<MapearCamposGenerales>(EnumProcedimientosAlmacenados
                .usp_ConsultaFechaSistema);

                if (strFecha?.Data == null ||
                    strFecha.Data.Count == 0 ||
                    strFecha.MensajeError != null)
                {
                    MensajeThrow($"Error: {strFecha?.MensajeError}");
                }

                string strFechaFormateada = strFecha.Data.FirstOrDefault()?.Fecha.ToString(EnumParametrosGenerales.FECHA_BD);
                return strFechaFormateada;
            }
            catch (Exception ex)
            {
                Config.EscribirLog($"ERROR|ObtenerFechaSistema|{ex}", _configuracion.StrNombreServicio);
                throw;
            }

        }

        /// <summary>
        /// Inserta alertas
        /// </summary>
        /// <param name="alerta"></param>
        /// <returns></returns>
        public async Task ProcesoInsertaAlerta(AlertaDTO alerta)
        {
            try
            {
                bool boAlertaInsertada = await _alertas.InsertarAlerta(alerta);
                if (!boAlertaInsertada)
                {
                    MensajeThrow($"Error: no se completo la insercion de la Alerta");
                }
            }
            catch (Exception ex)
            {
                Config.EscribirLog($"ERROR|ProcesoInsertaAlerta|{ex}", _configuracion.StrNombreServicio);
                throw;
            }
        }

        /// <summary>
        /// Obtiene los parametros del sistema necesario para la operacion del servicio, incluye horarios de inicio y finalizacion de operaciones
        /// </summary>
        /// <returns>Dictionary<string, string></returns>
        public async Task<bool> ValidaSiEsDiaHabil()
        {
            try
            {
                return await EsDiaHabil();
            }
            catch (Exception ex)
            {
                Config.EscribirLog($"Error: no se pudo recuperar dia habil. Excepcion: {ex.ToString()}", _configuracion.StrNombreServicio);
                throw;
            }
        }

        /// <summary>
        /// Obtiene los parametros del sistema necesario para la operacion del servicio, incluye horarios de inicio y finalizacion de operaciones
        /// </summary>
        /// <returns>Dictionary<string, string></returns>
        public async Task<Dictionary<string, string>> ObtenerParametrosSistema()
        {
            try
            {
                StoredProcedureResult<MapearCamposGenerales> resultadoSp = await EjecutarStoredProcedureQuery<MapearCamposGenerales>(EnumProcedimientosAlmacenados.usp_ParametrosSistema);

                if (resultadoSp?.Data == null) return new Dictionary<string, string>();

                return resultadoSp.Data
                    .Where(x => x != null && !string.IsNullOrWhiteSpace(x.Id_parametro))
                    .GroupBy(x => x.Id_parametro)
                    .ToDictionary(
                        x => x.Key,
                        x => x.LastOrDefault()?.Valor ?? string.Empty
                    );

            }
            catch (Exception ex)
            {
                Config.EscribirLog($"ERROR|ObtenerParametrosSistema|{ex}", _configuracion.StrNombreServicio);
                throw;
            }
        }

        /// <summary>
        /// Actualiza ejecucion del servicio INICIO
        /// </summary>
        /// <param name="strFolio"></param>
        /// <returns></returns>
        /// <exception cref="Exception"></exception>
        public async Task ProcesoActualizaEjecucion(string strNombreServicio, int intgpId, string strNombreProceso)
        {
            try
            {
                StoredProcedureResult resultActualizaEjec = await ActualizaEJecucion(strNombreServicio);
                if (resultActualizaEjec == null || !resultActualizaEjec.Exito)
                {
                    MensajeThrow($"Error al ejecutar consulta. gpId:{intgpId}, proceso:{strNombreProceso}, Ex: {resultActualizaEjec?.Exception}, Mensaje: {resultActualizaEjec?.MensajeError}");
                }
            }
            catch (Exception ex)
            {
                Config.EscribirLog("ERROR|ProcesoActualizaEjecucion|Error al ejecutar proceso: " + ex.ToString(), _configuracion.StrNombreServicio);
                throw;
            }
        }

        /// <summary>
        /// Actualiza terminacion del proceso
        /// </summary>
        /// <param name="strNombreServicio"></param>
        /// <param name="intgpId"></param>
        /// <param name="strNombreProceso"></param>
        /// <returns></returns>
        /// <exception cref="Exception"></exception>
        public async Task ProcesoActualizaTerminacion(string strNombreServicio, int intgpId, string strNombreProceso)
        {
            try
            {
                StoredProcedureResult resultActualizaTerm = await ActualizaTerminacion(strNombreServicio);
                if (!resultActualizaTerm?.Exito ?? false)
                {
                    MensajeThrow($"Error al ejecutar consulta. gpId:{intgpId}, proceso:{strNombreProceso}, Ex: {resultActualizaTerm?.Exception}, Mensaje: {resultActualizaTerm?.MensajeError}");
                }
            }
            catch (Exception ex)
            {
                Config.EscribirLog($"ERROR|ProcesoActualizaTerminacion|{ex}", _configuracion.StrNombreServicio);
                throw;
            }
        }

        /// <summary>
        /// Registra un mensaje de error y genera una excepción.
        /// </summary>
        /// <param name="mensaje">
        /// Mensaje de error a registrar.
        /// </param>
        private void MensajeThrow(string mensaje)
        {
            Config.EscribirLog(mensaje, _configuracion.StrNombreServicio);
            throw new Exception(mensaje);
        }

    }
}

