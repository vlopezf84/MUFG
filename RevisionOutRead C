    RIGHT(REPLICATE('0', 8) + A.CUSTOMER_ID, 8)                  AS id_customer,
    SUBSTRING(B.NAME_1, 1, 34)                                   AS txt_customer_name,
    ISNULL('100' + REPLACE(L.legacy_loan_id, '-', ''), A.[@ID])  AS cod_bank_reference,
    A.CURRENCY                                                   AS cod_currency,
    A.DRAWDOWN_NET_AMT                                           AS amnt_original_principal,
    A.AMOUNT                                                     AS amnt_current_principal,
    NULL                                                         AS date_contract,
