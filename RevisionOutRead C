using Aplicacion_OutRead.DTOs;
using Aplicacion_OutRead.Enums;
using Aplicacion_OutRead.Interfaces;
using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading;
using System.Threading.Tasks;
using IOperacionServicio = Aplicacion_OutRead.Interfaces.IOperacionServicio;
using MUFG_T24.Configuracion_utilidades;
using MUFG_T24.Enums_utilidades;
using MUFG_T24.Interfaces_utilidades;
using System.Globalization;

namespace Aplicacion_OutRead
{
    /// <summary>
    /// Clase que contiene el flujo principal del procesamiento (equivalente a Definiciones).
    /// </summary>
    public class OperacionServicio : IOperacionServicio
    {
        private readonly Configuracion _configuracion;
        private readonly IControlServicio _controlServicio;
        private readonly IParametrizacion _parametrizacion;
        private readonly IAppLogger _appLogger;
        private readonly IReglasNegocio _reglasNegocio;

        /// <summary>
        /// Constructor.
        /// </summary>
        public OperacionServicio(Configuracion configuracion, IControlServicio controlServicio, IParametrizacion parametrizacion, IAppLogger appLogger, 
            IReglasNegocio reglasNegocio)
        {
            _configuracion = configuracion;
            _controlServicio = controlServicio;
            _parametrizacion = parametrizacion;
            _appLogger = appLogger;
            _reglasNegocio = reglasNegocio;
        }

        /// <summary>
        /// Control del flujo principal del procesamiento.
        /// </summary>
        public async Task<bool> EjecutarProcedimientosAsync(CancellationToken ct)
        {
            try
            {
                await _controlServicio.ActualizaEJecucion(_configuracion.NombreServicio);

                await CargarConfiguracionAsync();

                var (ejecutar, getMtBatch) = await DebeEjecutarOperacionesAsync();
                if (!ejecutar)
                    return false;

                await _reglasNegocio.ProcesarMensajesAsync(getMtBatch, ct);

                return true;
            }
            catch (Exception ex)
            {
                await _appLogger.ManejarErrorAsync(ex, "Error en ejecución");
                return false;
            }
            finally
            {
                await _controlServicio.ActualizaTerminacion(_configuracion.NombreServicio);
            }
        }

        /// <summary>
        /// Se cargan las principales configuraciones del sistema.
        /// </summary>
        private async Task CargarConfiguracionAsync()
        {
            _configuracion.FechaSistema = await _parametrizacion.ObtenerFechaSistemaAsync();
            _configuracion.ParametrosSistema = await _parametrizacion.ObtenerParametrosSistemaAsync(ConstantesServicio.ParametrosSistema);
        }

        /// <summary>
        /// Se evalua si se ejecutan las operaciones.
        /// </summary>
        private async Task<(bool ejecutar, bool getMtBatch)> DebeEjecutarOperacionesAsync()
        {
            var parametros = _configuracion.ParametrosSistema;
            bool getMtBatch = ParseBool(parametros[ConstantesServicio.SWFOutGetMtBatch]);
            _appLogger.Log(TipoLog.INFO, $"valor de getMtBatch: { getMtBatch }");

            if (getMtBatch)
                return (true, true);

            string horaInicioOperaciones = parametros[ConstantesServicio.HoraInicioRead];
            string horaFinOperaciones = parametros[ConstantesServicio.HoraFinRead];
            bool ejecuta = await EsDiaYHoraValidaAsync(horaInicioOperaciones, horaFinOperaciones);

            return (ejecuta, false);
        }

        /// <summary>
        /// Evalua la cadena como posible valor booleano.
        /// </summary>
        private bool ParseBool(string valor)
        {
            if (string.IsNullOrWhiteSpace(valor))
                return false;

            return valor == "1" || valor.Equals("true", StringComparison.OrdinalIgnoreCase);
        }

        /// <summary>
        /// Evalúa los parámetros de día hábil y horario de operación.
        /// </summary>
        private async Task<bool> EsDiaYHoraValidaAsync(string horaInicioOperaciones, string horaFinOperaciones)
        {
            if (!await ValidarDiaHabilAsync())
                return false;

            return await ValidarHorarioOperacionAsync(horaInicioOperaciones, horaFinOperaciones);
        }

        /// <summary>
        /// Evalúa si es día hábil.
        /// </summary>
        public async Task<bool> ValidarDiaHabilAsync()
        {
            _configuracion.EsDiaHabil = await _controlServicio.EsDiaHabil();

            //Valida que sea día hábil...
            if (!_configuracion.EsDiaHabil.Value)
            {
                await _appLogger.LogAsync(
                            TipoLog.WARNING,
                            "Hoy es un día inhábil.",
                            generarAlerta: true,
                            claveAviso: ConstantesClaveAviso.Error
                        );

                return false;
            }
            return true;
        }

        /// <summary>
        /// Evalúa el horario de operación.
        /// </summary>
        public async Task<bool> ValidarHorarioOperacionAsync(string horaInicioOperaciones, string horaFinOperaciones)
        {
            //Valida el horario de operación...
            TimeSpan timeHoraSistema = _parametrizacion.ObtenerHoraSistema();

            if (!TimeSpan.TryParse(horaInicioOperaciones, CultureInfo.InvariantCulture, out var horaIniValidada)
                || !TimeSpan.TryParse(horaFinOperaciones, CultureInfo.InvariantCulture, out var horaFinValidada))
            {
                await _appLogger.LogAsync(
                            TipoLog.WARNING,
                            $"Formato de horario inválido.",
                            generarAlerta: true,
                            claveAviso: ConstantesClaveAviso.Error
                        );

                return false;
            }

            bool dentroHorario = horaIniValidada <= horaFinValidada
                ? timeHoraSistema >= horaIniValidada && timeHoraSistema <= horaFinValidada
                : timeHoraSistema >= horaIniValidada || timeHoraSistema <= horaFinValidada;

            if (!dentroHorario)
            {
                await _appLogger.LogAsync(
                            TipoLog.WARNING,
                            $"El servicio '{_configuracion.NombreServicio}' está fuera de horario.",
                            generarAlerta: true,
                            claveAviso: ConstantesClaveAviso.Error
                        );

                return false;
            }

            return true;
        }
    }
}

