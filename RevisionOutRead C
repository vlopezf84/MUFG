namespace Infraestructura_OutRead.Comun
{
    public class AppLogger : IAppLogger
    {

        private readonly IAlertas _alertas;
        private readonly Configuracion _configuracion;

        public AppLogger(IAlertas alertas, Configuracion configuracion)
        {
            _alertas = alertas;
            _configuracion = configuracion;
        }

        /// <summary>
        /// Método para uso de logs.
        /// Ej. Log INFO o WARNING: Log(TipoLog.INFO, "Proceso iniciado");
        /// </summary>
        public void Log(
            TipoLog tipo,
            string mensaje,
            [CallerMemberName] string metodo = "")
        {
            Config.EscribirLog($"{tipo}|{metodo}|{mensaje}");
        }

        /// <summary>
        /// Método para uso de logs asincrono.
        /// Ej. Log INFO o WARNING: await LogAsync(TipoLog.INFO, "Proceso iniciado");
        /// Ej. Log Error: await LogAsync(TipoLog.ERROR, "Error en procesamiento", ex, generarAlerta: true, claveAviso: ConstantesClaveAviso.Critico); 
        /// </summary>
        public async Task LogAsync(
            TipoLog tipo,
            string mensaje,
            Exception ex = null,
            bool generarAlerta = false,
            string claveAviso = null,
            [CallerMemberName] string metodo = "")
        {
            var texto = $"{tipo}|{metodo}|{mensaje}";

            if (ex != null)
                texto += $" | Exception: {ex}";

            Config.EscribirLog(texto);

            if (generarAlerta)
            {
                try
                {
                    await _alertas.InsertarAlerta(new AlertaDTO
                    {
                        Servicio = _configuracion.NombreServicio,
                        ClaveAviso = claveAviso ?? tipo.ToString(),
                        Descipcion = mensaje,
                        PId = _configuracion.Pid.Value,
                        NombreProceso = _configuracion.NombreProceso,
                        Exception = ex
                    });
                }
                catch (Exception alertaEx)
                {
                    Config.EscribirLog($"ERROR|{metodo}|Error insertando alerta: {alertaEx.Message}");
                }
            }
        }

        /// <summary>
        /// Método para manejo de excepciones
        /// EJ: await ManejarErrorAsync(ex, "Error en procesamiento");
        /// </summary>
        public Task ManejarErrorAsync(
            Exception ex,
            string descripcion,
            string claveAviso = ConstantesClaveAviso.Critico,
            [CallerMemberName] string metodo = "")
        {
            return LogAsync(
                TipoLog.ERROR,
                descripcion,
                ex,
                generarAlerta: true,
                claveAviso: claveAviso,
                metodo: metodo
            );
        }

    }
}

