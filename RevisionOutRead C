    CONVERT(VARCHAR, A.FIN_MAT_DATE, 112)                        AS date_maturity,
    NULL                                                         AS date_interest_rate,
    NULL                                                         AS cycle_interest_rate,
    CONVERT(VARCHAR, A.FIN_MAT_DATE, 112)                        AS date_next_interest_paymnt,
    'MATURITY'                                                   AS cycle_interest_paymnt,
    A.TOT_INTEREST_AMT                                           AS amnt_next_interest_paymnt,
    CAST(
			CONVERT(NUMERIC(10,4), A.INTEREST_RATE) +
			CONVERT(NUMERIC(10,4), A.INTEREST_SPREAD)
