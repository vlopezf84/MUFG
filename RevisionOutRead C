        private readonly IRecuperacionDatos<SwiftMessagesDTO> _mensajesSwift;
        private readonly IMensajesSwift998 _mensajesSwift998;
        private readonly IUsuariosTimeDeposits _usuariosTimeDeposits;

        public ReglasNegocioService(IAppLogger appLogger, IRecuperacionDatos<SwiftMessagesDTO> mensajesSwift, IMensajesSwift998 mensajesSwift998, 
            IUsuariosTimeDeposits usuariosTimeDeposits)
        {
            _appLogger = appLogger;
            _mensajesSwift = mensajesSwift;
            _mensajesSwift998 = mensajesSwift998;
            _usuariosTimeDeposits = usuariosTimeDeposits;
        }

        /// <summary>
        /// Método intermedio que obtiene el listado de todos los mensajes swift, y los envía a procesar e insertar
        /// </summary>
        public async Task ProcesarMensajesAsync(bool incluirBatch, CancellationToken ct)
        {
            try
            {
                var mensajes = await ObtenerMensajesAsync(incluirBatch);
                var headersMarcados = await ProcesarEInsertarMensajesAsync(mensajes, ct);

                await MarcarMensajesAsync(headersMarcados);
            }
            catch (Exception ex)
            {
                await _appLogger.ManejarErrorAsync(ex, "Error al procesar mensajes");
            }
        }

        /// <summary>
        /// Método que obtiene lista de mensajes SwiftT24 y Swift998, los mezcla en una sola lista
        /// </summary>
        private async Task<List<SwiftMessagesDTO>> ObtenerMensajesAsync(bool incluirBatch)
        {
            var mensajes = await _mensajesSwift.ObtenerInfoSwiftAsync() ?? new List<SwiftMessagesDTO>();
            _appLogger.Log(TipoLog.INFO, $"existen {mensajes.Count()} mensajesT24 para procesar.");


            if (!incluirBatch)
                return mensajes.ToList();

            try
            {
                var mensajes998 = await LeerMensajesSwift998Async();
                _appLogger.Log(TipoLog.INFO, $"existen {mensajes998.Count()} mensajes998 para procesar.");
                return mensajes.Concat(mensajes998).ToList();
            }
            catch (Exception ex)
            {
                await _appLogger.LogAsync(TipoLog.WARNING, "No se pudieron obtener mensajes 998", ex, true);

                return mensajes.ToList();
            }
        }

        /// <summary>
        /// Método intermedio para el procesamiento de la lista de mensajes obtenidos 
        /// </summary>
        private async Task<Dictionary<string, string>> ProcesarEInsertarMensajesAsync(IEnumerable<SwiftMessagesDTO> mensajes, CancellationToken ct)
        {
            var headers = new Dictionary<string, string>();

            // Validación defensiva
            if (mensajes == null || !mensajes.Any())
            {
                _appLogger.Log(TipoLog.INFO, "No existen mensajes para procesar.");
                return headers;
            }

            foreach (var message in mensajes)
            {
                ct.ThrowIfCancellationRequested();
                await ProcesarMensajeAsync(message, headers);
            }

            return headers;
        }

        /// <summary>
        /// Método que llama a MarcarMensajesSwiftT24 para marcar cada mensaje Swift
        /// </summary>
        private async Task MarcarMensajesAsync(Dictionary<string, string> headers)
        {
            if (!headers.Any())
                return;

            var procesados = await _mensajesSwift.MarcarMensajesSwiftT24(headers);

            if (!procesados)
            {
                await _appLogger.LogAsync(TipoLog.ERROR, "No fue posible marcar los mensajes SWIFT como procesados.", generarAlerta: true);
            }

            _appLogger.Log(TipoLog.INFO, $"Headers marcados correctamente={procesados}");
        }

        /// <summary>
        /// Método que envía los mensajes Swift998 mediante time deposits
        /// </summary>
        public async Task<List<SwiftMessagesDTO>> LeerMensajesSwift998Async()
        {
            try
            {
                await _appLogger.LogAsync(TipoLog.INFO, "Obteniendo parametrización cliente-swift");

                var listaSwift = await _mensajesSwift998.ObtenerMensajesSwift998();

                var clienteSwiftMap = new Dictionary<string, string>();
                foreach (var parametro in listaSwift)
                {
                    if (clienteSwiftMap.ContainsKey(parametro.cliente))
                    {
                        Config.EscribirLog($"{ConstantesClaveAviso.Error}|LeerMensajesSwift998Async|El cliente '{parametro.cliente}' está duplicado en la base de datos.");
                        continue;
                    }

                    clienteSwiftMap.Add(parametro.cliente, parametro.swift);
                }

                var listaClientes = string.Join(",", clienteSwiftMap.Keys);

                var usuarios = await _usuariosTimeDeposits.ObtenerUsuariosTimeDeposits(listaClientes);

                return usuarios
                    .Select(u => MapearMensaje998(u, clienteSwiftMap))
                    .Where(x => x != null)
                    .ToList();
            }
            catch (Exception ex)
            {
                await _appLogger.ManejarErrorAsync(ex, "Error al leer mensajes 998");
                throw;
            }
        }

        /// <summary>
        /// Método para formato e inserción de mensajes Swift
        /// </summary>
        public async Task ProcesarMensajeAsync(SwiftMessagesDTO message, Dictionary<string, string> headers)
        {
            if (message == null)
                throw new ArgumentNullException(nameof(message));

            if (headers == null)
                throw new ArgumentNullException(nameof(headers));

            var messageType = $"MT-{message.MESSAGE_TYPE}";

            _appLogger.Log(TipoLog.INFO, $"Insertando ID={message.MSG_ID}, Header={message.HEADER_ID}, Tipo={messageType}");

            var insertado = await _mensajesSwift998.InsertarMensajeSwiftAsync(message, ConstantesServicio.TipoOperacion);

            if (!insertado)
            {
                _appLogger.Log(TipoLog.WARNING, $"Ocurrió un error al insertar el mensaje ID={message.MSG_ID}");
                return;
            }

            ValidarTipoMensaje(messageType, message);

            headers[message.HEADER_ID] = message.HEADER_ID;
        }

        /// <summary>
        /// Método para dar formato a mensajes Swift 998
        /// </summary>
        private SwiftMessagesDTO MapearMensaje998(UsuarioTimeDepositDTO usuarioTD, Dictionary<string, string> clienteSwiftMap)
        {
            if (!clienteSwiftMap.TryGetValue(usuarioTD.customer_id, out var swift))
            {
                _appLogger.Log(TipoLog.WARNING, $"Cliente sin SWIFT: {usuarioTD.customer_id}");
                return null;
            }

            swift = FormatearSwift(swift);

            var folio = $"{usuarioTD.id}_{usuarioTD.date_report}";

            _appLogger.Log(TipoLog.INFO, $"Alta ID {usuarioTD.id}, cliente={usuarioTD.customer_id}, swift={swift}");

            return new SwiftMessagesDTO
            {
                HEADER_ID = folio,
                MSG_ID = folio,
                MESSAGE_TYPE = ConstantesServicio.MessageTypeMensajesSwift998,
                TRANSACTION_REF = usuarioTD.id,
                SWIFT_SENDER = ConstantesServicio.T24_Swift_MX_Addr,
                SWIFT_RECEIVER = swift,
                SWIFT_MSG = usuarioTD.swf_msg,
                T24_MSG = ConstruirMensaje(usuarioTD.swf_msg, swift)
            };
        }

        /// <summary>
        /// Método para validar el tipo de mensaje 
        /// </summary>
        public void ValidarTipoMensaje(string messageType, SwiftMessagesDTO message)
        {
            if (!messageType.Equals(ConstantesServicio.MessageTypeKeySwift998))
            {
                _appLogger.Log(TipoLog.WARNING, $"Error al intentar marcar la operación swift_out como terminada en T24 Message: {messageType}, ID={message.MSG_ID}");
            }
        }

        /// <summary>
        /// Método que formatea el valor de swift para LeerMensajesSwift998
        /// </summary>
        private string FormatearSwift(string swift)
        {
            if (string.IsNullOrWhiteSpace(swift))
                return string.Empty;

            if (swift.Length == 11)
                swift = swift.Insert(8, "A");

            return swift.PadRight(12, 'X');
        }

        /// <summary>
        /// Método que genera string para lista de mensajes Swift 998
        /// </summary>
        private string ConstruirMensaje(string swfMsg, string swift)
        {
            return $@"{{1:{ConstantesServicio.SecuenciaMensajeT24}.SN...ISN.}}{{2:I998{swift}N}}{{3:{{108:xxxxx}}}}{{4:{swfMsg}}}";
        }
    }
}
