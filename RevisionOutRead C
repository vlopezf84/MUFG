        + REPLACE(CAST(A.DRAWDOWN_NET_AMT AS VARCHAR), '.', ',') + CHAR(13) + CHAR(10)
        + REPLACE(CAST(A.AMOUNT AS VARCHAR), '.', ',') + CHAR(13) + CHAR(10)
        + '' + CHAR(13) + CHAR(10)
        + CONVERT(VARCHAR, A.VALUE_DATE, 112) + CHAR(13) + CHAR(10)
        + CONVERT(VARCHAR, A.FIN_MAT_DATE, 112) + CHAR(13) + CHAR(10)
        + '' + CHAR(13) + CHAR(10)
        + '' + CHAR(13) + CHAR(10)
        + CONVERT(VARCHAR, A.FIN_MAT_DATE, 112) + CHAR(13) + CHAR(10)
        + 'MATURITY' + CHAR(13) + CHAR(10)
        + REPLACE(CAST(A.TOT_INTEREST_AMT AS VARCHAR), '.', ',') + CHAR(13) + CHAR(10)
        + REPLACE(
            CAST(
                CONVERT(NUMERIC(10,4), A.INTEREST_RATE) 
                + CONVERT(NUMERIC(10,4), A.INTEREST_SPREAD) AS VARCHAR
            ), '.', ','
          ) + CHAR(13) + CHAR(10)
        + '' + CHAR(13) + CHAR(10)
        + '' + CHAR(13) + CHAR(10)
        + '' + CHAR(13) + CHAR(10)
        + '' + CHAR(13) + CHAR(10)
        + '1' + CHAR(13) + CHAR(10)
        + '1' + CHAR(13) + CHAR(10)
        + '1' + CHAR(13) + CHAR(10)
        + '0' + CHAR(13) + CHAR(10)
        + '-'
    AS VARCHAR(MAX)) AS swf_msg

	FROM BS.BNK_LD_LOANS_AND_DEPOSITS A   --VW_RPT_T24_LOANS_AND_DEPOSITS
	LEFT JOIN BS.BNK_LD_LOANS_AND_DEPOSITS_LocalRef L 
	ON A.[@ID] = L.[@ID]
	LEFT JOIN BS.BNK_CUSTOMER B    --[dbo].[VW_RPT_T24_CUSTOMER]
    ON A.CUSTOMER_ID = B.[@ID]

	WHERE  A.CATEGORY BETWEEN 21003 AND 21007
    AND A.FIN_MAT_DATE > A.MIS_DATE
	AND A.CUSTOMER_ID IN (
		SELECT LTRIM(RTRIM(T.c.value('.', 'VARCHAR(20)')))
		FROM (
			SELECT CAST('<x>' + REPLACE(@listaClientes, ',', '</x><x>') + '</x>' AS XML) AS xmlData
		) AS A
		CROSS APPLY xmlData.nodes('/x') AS T(c)
	)";


    }
}

