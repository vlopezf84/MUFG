    NULL                                                         AS rate_tax,
    NULL                                                         AS amnt_tax,
    NULL                                                         AS amnt_next_current_interest,
    NULL                                                         AS num_account,
    CAST(1 AS VARCHAR(10))										 AS trans_ref_num_5n,
    CAST(1 AS VARCHAR(10))                                       AS num_related_reference,
    CAST(1 AS VARCHAR(10))                                       AS num_maximum_related_ref,
    CAST(0 AS VARCHAR(10))                                       AS flag_daytime,

    CAST(
          ':20:' + 'CAMSLINK' 
        + ISNULL(
            RIGHT(REPLICATE('0', 8) + SUBSTRING(L.legacy_loan_id, 5, 8), 8),
            RIGHT(A.[@ID], 8)
        ) + CHAR(13) + CHAR(10)

        + ':12:999' + CHAR(13) + CHAR(10)
        + ':77E:' + CHAR(13) + CHAR(10)

        + 'CI,' + RIGHT(REPLICATE('0', 8) + A.CUSTOMER_ID, 8) + CHAR(13) + CHAR(10)
        + 'RI,OETD0' + CHAR(13) + CHAR(10)
        + CONVERT(VARCHAR, A.MIS_DATE, 112) + CHAR(13) + CHAR(10)
        + RIGHT(REPLICATE('0', 8) + A.CUSTOMER_ID, 8) + CHAR(13) + CHAR(10)
        + SUBSTRING(B.NAME_1, 1, 34) + CHAR(13) + CHAR(10)
        + ISNULL('100' + REPLACE(L.legacy_loan_id, '-', ''), A.[@ID]) + CHAR(13) + CHAR(10)
