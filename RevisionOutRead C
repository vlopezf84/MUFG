using System;
using System.Collections.Generic;
using System.Data;
using System.Linq;

namespace Infraestructura_OutRead
{
    public static class DataContextHelpers
    {
        /// <summary>
        /// Método que convierte de un DataTable a Entity
        /// </summary>
        /// <typeparam name="T"></typeparam>
        /// <param name="dt"></param>
        /// <returns></returns>
        public static List<T> ToListEntity<T>(this DataTable dt) where T : new()
        {
            var propiedades = typeof(T).GetProperties();

            return dt.AsEnumerable().Select(row =>
            {
                var obj = new T();

                foreach (var prop in propiedades)
                {
                    if (!dt.Columns.Contains(prop.Name) || row[prop.Name] == DBNull.Value)
                        continue;

                    var valor = row[prop.Name];

                    var tipoDestino = Nullable.GetUnderlyingType(prop.PropertyType) ?? prop.PropertyType;

                    var valorConvertido = Convert.ChangeType(valor, tipoDestino);

                    prop.SetValue(obj, valorConvertido);
                }

                return obj;
            }).ToList();
        }
    }
}
