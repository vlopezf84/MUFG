namespace Infraestructura_OutRead.Repositorios
{
    public class MensajesSwift998Dao : RepositorioMaestro, IMensajesSwift998
    {
        public MensajesSwift998Dao() : base(BasedatosProveedor.SqlServer, NombreBasedatos.TOMI, null, null)
        {
        }

        /// <summary>
        /// Obtiene lista de Mensajes Swift 998
        /// </summary>
        /// <returns></returns>
        public async Task<IEnumerable<SwiftMessages998DTO>> ObtenerMensajesSwift998(CancellationToken ct = default)
        {
            var resultado = await EjecutarStoredProcedureQuery<SwiftMessages998DTO>(ConstantesServicio.uspObtenerMensajesSwift998, cmd => { }, ct);

            if (!resultado.Exito)
            {
                throw resultado.Exception ?? new Exception(resultado.MensajeError);
            }

            return resultado.Data;
        }

        /// <summary>
        /// Realiza la inserción de lista de mensajes T24 y 998
        /// </summary>
        public async Task<bool> InsertarMensajeSwiftAsync(
            SwiftMessagesDTO swiftMensajeDto,
            string tipoOperacion,
            CancellationToken ct = default)
        {
            swiftMensajeDto.TRANSACTION_REF = DameTexto(swiftMensajeDto.TRANSACTION_REF);

            var resultado = await EjecutarStoredProceduredNonQuery(
                ConstantesServicio.uspInsertMessagesT24,
                cmd =>
                {
                    cmd.Parameters.Add(basedatosConexion.CrearParametro("@folio", swiftMensajeDto.MSG_ID));
                    cmd.Parameters.Add(basedatosConexion.CrearParametro("@tipo_operacion", tipoOperacion));
                    cmd.Parameters.Add(basedatosConexion.CrearParametro("@cve_mensaje", swiftMensajeDto.MESSAGE_TYPE));
                    cmd.Parameters.Add(basedatosConexion.CrearParametro("@transaction_ref", swiftMensajeDto.TRANSACTION_REF));
                    cmd.Parameters.Add(basedatosConexion.CrearParametro("@swf_msg", swiftMensajeDto.SWIFT_MSG));
                }, ct);

            if (!resultado.Exito)
            {
                throw resultado.Exception ?? new Exception(resultado.MensajeError);
            }

            return resultado.Exito;
        }



        /// <summary>
        /// Método de apoyo para cadena.
        /// </summary>
        private string DameTexto(object valor, int largo = 0)
        {
            var texto = valor?.ToString() ?? string.Empty;

            if (largo > 0 && texto.Length > largo)
                return texto.Substring(0, largo);

            return texto;
        }
    }
}

