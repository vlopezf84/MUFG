using System.Collections.Generic;
using System.Linq;
using System.Threading;
using System.Threading.Tasks;
using static Aplicacion_ETL.Constantes.ConstantesSwift;

namespace Aplicacion_ETL.Reglas.Implementaciones
{
    /// <summary>
    /// Clase que contiene las reglas d enegocio específicas para la clave de mensaje MT103
    /// </summary>
    public class ReglaMT103 : ReglaSwiftBase
    {
        private readonly IOperacionesSwift _operacionesSwift;

        /// <summary>
        /// Constructor.
        /// </summary>
        public ReglaMT103(IOperacionesTomi operacionesTomi, IOperacionesT24 operacionesT24, ICorrespondentService correspondentService, SwiftMessageHelper messageHelper,
            IAppLogger appLogger, IOperacionesSwift operacionesSwift)
            : base(operacionesTomi, operacionesT24, correspondentService, messageHelper, appLogger)
        {
            _operacionesSwift = operacionesSwift;
        }

        /// <summary>
        /// Variable que sirve para validar  que determinada reglas utiliza que clase para su validación
        /// </summary>
        public override bool Aplica(string claveMensaje)
                    => claveMensaje.ToEnum() == TipoMensajeSwift.MT103;

        /// <summary>
        /// Método para validar cual regla se va a aplicar al mensaje
        /// </summary>
        public override async Task Ejecutar(
            OperacionETLDTO op,
            Dictionary<string, object> variables,
            MensajeParseadoDTO mensaje,
            IEnumerable<DestinoDTO> destinos,
            ContextoETL contexto,
            CancellationToken ct = default)
        {
            ct.ThrowIfCancellationRequested();
            // =========================================
            // 1. Variables clave
            // =========================================
            var moneda = ObtenerValor(variables, SwiftVariableKeys.CurrencyCode);
            var monto = ObtenerValor(variables, SwiftVariableKeys.OperationAmount);

            // ========================================================
            // 2. AJUSTE DE FECHA VALOR
            // ========================================================
            AjustarFechaValor(variables, mensaje, moneda);

            // ========================================================
            // 3. ELIMINAR TAG 56A (TOHNET)
            // ========================================================
            var bancoIntermediario = ObtenerValor(variables, SwiftVariableKeys.ReceivingCorrespondent);

            if (moneda == SwiftCurrencies.USD && bancoIntermediario == SwiftBics.MUFG_US)
            {
                mensaje.MensajeContenido = _messageHelper.EliminarTag(mensaje.MensajeContenido, SwiftTags.Tag56A);
                _appLogger.Log(TipoLog.INFO, $"MT103|Eliminando TAG 56A");
            }

            // ========================================================
            // 4. ENHANCE TAG 57D
            // ========================================================
            await ProcesarTag57D(variables, mensaje, contexto);

            // ========================================================
            // 5. PROCESA TAG 53A Y 54A
            // ========================================================
            await ProcesarTags53y54(variables, mensaje, mensaje.ClaveMensajeFinal);


            // ========================================================
            // 6. PROCESA END2END Reference
            // ========================================================
            await ProcesarEndToEndReference(variables, mensaje);


            // ========================================================
            // 7. FORZAR FORMATO F EN TAGS 50 Y 59 (MT103)
            // ========================================================;
            _appLogger.Log(TipoLog.INFO, $"MT103|Aplicando formato F en tags 50 y 59");

            if (!string.IsNullOrEmpty(mensaje.MensajeContenido))
            {
                mensaje.MensajeContenido = mensaje.MensajeContenido
                    .Replace($":{SwiftTags.Tag50K}:", $":{SwiftTags.Tag50F}:")
                    .Replace($":{SwiftTags.Tag59}:", $":{SwiftTags.Tag59F}:");
            }



            // ========================================================
            // LOG FINAL
            // ========================================================
            _appLogger.Log(TipoLog.INFO, $"Folio:{op.nf_folio}|Moneda:{moneda}|Monto:{monto}");
            ct.ThrowIfCancellationRequested();
        }

        /// <summary>
        /// Método para validar cual regla va a aplicar para el mensaje para obtener el destino requerido.
        /// </summary>
        public override string ResolverDestino(
            Dictionary<string, object> variables,
            string headerOriginal,
            IEnumerable<DestinoDTO> destinos,
            CancellationToken ct = default)
        {
            ct.ThrowIfCancellationRequested();
            // 1. respetar header existente
            var header = ObtenerHeaderSiExiste(variables);
            if (!string.IsNullOrEmpty(header))
                return header;

            var moneda = ObtenerValor(variables, SwiftVariableKeys.CurrencyCode);

            if (string.IsNullOrEmpty(moneda))
                throw new Exception("currency_code es requerido para MT-103");

            switch (moneda)
            {
                case SwiftCurrencies.USD:
                    return SwiftBics.CHASE_US;
                case SwiftCurrencies.EUR:
                case SwiftCurrencies.GBP:
                    return SwiftBics.CHASE_UK;
                case SwiftCurrencies.JPY:
                    return SwiftBics.CHASE_JP;
                case SwiftCurrencies.CAD:
                    return SwiftBics.CHASE_CA;
                case ConstantesServicio.MonedaDefault:
                    var bic = ObtenerValor(variables, SwiftVariableKeys.InstitutionAccount);
                    return bic;
            }

            ct.ThrowIfCancellationRequested();
            throw new Exception($"Moneda desconocida='{moneda}'");

        }

        /// <summary>
        /// Ajusta valor de fecha y moneda para el TAG 32A
        /// </summary>
        private void AjustarFechaValor(
            Dictionary<string, object> variables,
            MensajeParseadoDTO mensaje,
            string moneda)
        {
            if (moneda != SwiftCurrencies.EUR &&
                moneda != SwiftCurrencies.JPY)
                return;

            var valueDate = ObtenerValor(variables, SwiftVariableKeys.ValueDate);

            if (string.IsNullOrWhiteSpace(valueDate) || valueDate.Length != 6)
                return;

            try
            {
                if (!int.TryParse("20" + valueDate.Substring(0, 2), out var year)
                    || !int.TryParse(valueDate.Substring(2, 2), out var month)
                    || !int.TryParse(valueDate.Substring(4, 2), out var day))
                {
                    throw new Exception($"Fecha valor inválida '{valueDate}'");
                }

                var fecha = new DateTime(
                    year,
                    month,
                    day
                );

                fecha = fecha.AddDays(1);

                if (fecha.DayOfWeek == DayOfWeek.Saturday)
                    fecha = fecha.AddDays(2);
                else if (fecha.DayOfWeek == DayOfWeek.Sunday)
                    fecha = fecha.AddDays(1);

                var nuevaFecha = fecha.ToString("yyMMdd");

                variables[SwiftVariableKeys.ValueDate] = nuevaFecha;

                mensaje.MensajeContenido = mensaje.MensajeContenido.Replace(
                    $":{SwiftTags.Tag32A}:{valueDate}{moneda}",
                    $":{SwiftTags.Tag32A}:{nuevaFecha}{moneda}"
                );

                _appLogger.Log(TipoLog.INFO, $"MT103|Ajuste fecha valor: {valueDate} -> {nuevaFecha}");

            }
            catch (Exception ex)
            {
                throw new Exception($"Error al ajustar fecha valor '{valueDate}'", ex);
            }
        }

        /// <summary>
        /// Realiza las reglas de procesamiento para el TAG 57D
        /// </summary>
        private async Task ProcesarTag57D(
            Dictionary<string, object> variables,
            MensajeParseadoDTO mensaje,
            ContextoETL contexto)
        {
            if (!contexto.EnhanceTag57DFeature)
                return;

            if (!mensaje.MensajeContenido.Contains($":{SwiftTags.Tag57D}:"))
                return;

            // =========================================
            // 1. CASO LEGACY //FW
            // =========================================

            if (mensaje.MensajeContenido.Contains($":{SwiftTags.Tag57D}://FW"))
            {
                await ProcesarTag57D_Fw(variables, mensaje, contexto);

                _appLogger.Log(TipoLog.INFO, "MT103|TAG57D procesado con FW legacy");
                return; // IMPORTANTE: no seguir
            }
        }

        /// <summary>
        /// Realiza las reglas de procesamiento para el TAG 57D
        /// </summary>
        private async Task ProcesarTag57D_Fw(
            Dictionary<string, object> variables,
            MensajeParseadoDTO mensaje,
            ContextoETL contexto)
        {
            var accInstName = ObtenerValor(variables, SwiftVariableKeys.AccountInstitutionName);

            if (string.IsNullOrWhiteSpace(accInstName) || accInstName.Length <= 3)
                return;

            var identifier = accInstName.Substring(3);

            if (!int.TryParse(identifier, out var id))
                return;

            var instituciones = await _operacionesTomi
                .ObtenerInstitucionFinancieraPorIdAsync(id);

            var institucion = instituciones?.FirstOrDefault();

            if (institucion == null)
                return;

            string Limitar(string txt) =>
                string.IsNullOrEmpty(txt) ? "" :
                txt.Substring(0, Math.Min(txt.Length, 35));

            var nuevoContenido =
                Limitar(institucion.FinancialInstitutionName) + "\r\n" +
                Limitar(institucion.FinancialInstitutionTownName) + "\r\n" +
                Limitar(institucion.FinancialInstitutionCountryCode) + "\r\n";

            mensaje.MensajeContenido =
                _messageHelper.ReemplazarTag(
                    mensaje.MensajeContenido,
                    SwiftTags.Tag57D,
                    $"\r\n{nuevoContenido}"
                );

            _appLogger.Log(TipoLog.INFO, $"MT103|TAG57D enriquecido");

        }


        

    }
}
