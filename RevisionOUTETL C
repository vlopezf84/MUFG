namespace Infraestructura_ETL.Repositorios
{
    public class CuentasNativasDao : RepositorioMaestro, ICuentasNativas
    {
        private readonly IAppLogger _appLogger;

        /// <summary>
        /// Constructor.
        /// </summary>
        public CuentasNativasDao(IAppLogger appLogger) : base(BasedatosProveedor.SqlServer, NombreBasedatos.TOMI, null, null)
        {
            _appLogger = appLogger;
        }

        /// <summary>
        /// Método para obtener las cuentas nativas 
        /// </summary>
        /// <returns></returns>
        public async Task<Dictionary<string, string>> ObtenerCuentasNativasAsync()
        {
            try
            {
                var resultado = await EjecutarStoredProcedureQuery<CuentaNativaDTO>(
                    ConstantesServicio.uspObtenerCuentasNativas,
                    null,
                    false // TOMI
                );

                if (resultado?.Data == null || !resultado.Data.Any())
                    return new Dictionary<string, string>();

                var cuentasNativas = new Dictionary<string, string>();

                foreach (var cuenta in resultado.Data.Where(x => !string.IsNullOrWhiteSpace(x.cuenta)))
                {
                    if (cuentasNativas.ContainsKey(cuenta.cuenta))
                    {
                        Config.EscribirLog($"{ConstantesClaveAviso.Error}|ObtenerCuentasNativasAsync|La cuenta '{cuenta.cuenta}' está duplicada en la base de datos.");
                        continue;
                    }

                    var cuentaNativa = string.IsNullOrWhiteSpace(cuenta.cuenta_nativa)
                        ? cuenta.cuenta
                        : cuenta.cuenta_nativa;

                    cuentasNativas.Add(cuenta.cuenta, cuentaNativa);
                }

                return cuentasNativas;

            }
            catch (Exception ex)
            {
                _appLogger.Log(TipoLog.ERROR, $"Ocurrió un error al obtener cuentas nativas: {ex}");
                throw;
            }
        }

    }
}
