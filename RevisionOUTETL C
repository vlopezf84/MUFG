        /// Realiza la validación de los datos cuenta, moneda, fecha, importe y que sean válidos para la cuenta T24
        /// </summary>
        public async Task<(bool EsValido, string Error)> ValidarDatosCoreAsync(
            string folio,
            string claveMensaje,
            Dictionary<string, object> variables,
            Dictionary<string, string> camposActualizar,
            CancellationToken ct = default)
        {
            ct.ThrowIfCancellationRequested();
            _appLogger.Log(TipoLog.INFO, "Inicia proceso Validar datos Core");
            try
            {
                // =========================================
                // Inicialización
                // =========================================

                if (camposActualizar == null)
                    camposActualizar = new Dictionary<string, string>();

                // =========================================
                // 1. Obtener mapeo
                // =========================================
                _appLogger.Log(TipoLog.INFO, "Inicia proceso Obtener mapeo campos");
                var mapeoCampos = await _operacionesTomi.ObtenerMapeoCamposAsync(claveMensaje);

                // =========================================
                // 2. Estado de validación
                // =========================================
                var estado = new EstadoValidacion();

                bool mensajeErroneo = false;
                string razonRechazo = null;

                _appLogger.Log(TipoLog.INFO, $"Inicio validación core folio:{folio}");

                // =========================================
                // 3. MAPEO DINÁMICO (equivalente VB loop)
                // =========================================
                foreach (var campo in mapeoCampos)
                {
                    var nombreVariable = campo.cve_swf_var;
                    var campoBD = campo.cve_campo_bd;
                    var estatus = campo.cve_estatus;
                    var funciones = campo.cve_fun_conv ?? "";

                    var valor = ObtenerValor(variables, nombreVariable);

                    // =========================================
                    // FUNCIONES DE CONVERSIÓN (equivalente VB)
                    // =========================================

                    valor = AplicarFunciones(
                        valor,
                        funciones,
                        ref mensajeErroneo,
                        ref razonRechazo);


                    if (mensajeErroneo)
                        return (false, razonRechazo);

                    // =========================================
                    // MAPEO A VARIABLES CORE
                    // =========================================

                    switch (campoBD)
                    {
                        case ConstantesCore.Cuenta:
                            estado.Cuenta = valor;
                            estado.CuentaMandatoria = estatus == ConstantesServicio.CampoMandatorio;
                            break;

                        case ConstantesCore.Fecha:
                            estado.Fecha = valor;
                            estado.FechaMandatoria = estatus == ConstantesServicio.CampoMandatorio;

                            if (estado.FechaMandatoria && string.IsNullOrEmpty(estado.Fecha))
                            {
                                estado.Fecha = _configuracion.FechaSistema;
                                valor = estado.Fecha;
                            }
                            break;

                        case ConstantesCore.Moneda:
                            estado.Moneda = MonedaHelper.ValidarMoneda(valor, ConstantesServicio.MonedaDefault);

                            estado.MonedaMandatoria = estatus == ConstantesServicio.CampoMandatorio;
                            break;

                        case ConstantesCore.Importe:
                            estado.Importe = valor;
                            estado.ImporteMandatoria = estatus == ConstantesServicio.CampoMandatorio;
                            break;
                    }

                    if (funciones.Contains(ConstantesCore.ValidaCuentaBTMUM))
                    {
                        estado.ValidarCuentaBTMUM = true;
                    }

                    // =========================================
                    // CAMPOS PARA UPDATE
                    // =========================================
                    if (!string.IsNullOrEmpty(campoBD) && !string.IsNullOrEmpty(valor))
                    {
                        camposActualizar[campoBD] = valor;
                    }
                }

                // =========================================
                // VALIDACIONES BÁSICAS (equivalente VB)
                // =========================================

                var error = ValidarRequerido(estado.Cuenta, estado.CuentaMandatoria, "La cuenta no pudo ser leída desde el mensaje Swift.") ??
                    ValidarRequerido(estado.Importe, estado.ImporteMandatoria, "El importe no pudo ser leído desde el mensaje Swift.");

                if (error != null)
                    return (false, error);


                // Validación fecha
                if (!string.IsNullOrEmpty(estado.Fecha))
                {

                    // 1. Validar formato
                    if (!DateTime.TryParseExact(estado.Fecha, "yyyyMMdd", null, DateTimeStyles.None, out var fechaMsg))
                    {
                        return (false, $"Formato de fecha inválido: {estado.Fecha}");
                    }

                    // 2. Convertir fecha sistema
                    if (!DateTime.TryParseExact(_configuracion.FechaSistema, "yyyyMMdd", null, DateTimeStyles.None, out var fechaSistema))
                    {
                        return (false, "Fecha de sistema inválida");
                    }

                    // 3. Validar regla de negocio
                    if (fechaMsg < fechaSistema)
                    {
                        return (false, $"Fecha anterior no permitida: {estado.Fecha}");
                    }

                }

                // =========================================
                // VALIDACIÓN T24
                // =========================================
                if (estado.ValidarCuentaBTMUM)
                {
                    _appLogger.Log(TipoLog.INFO, "Inicia proceso Validar Cuenta T24");
                    var resultado = await ValidarCuentaT24(
                                    estado,
                                    variables,
                                    camposActualizar
                                );

                    if (!resultado.EsValido)
                        return resultado;
                }

                _appLogger.Log(TipoLog.INFO, $"Validación exitosa folio:{folio}");
                ct.ThrowIfCancellationRequested();
                return (true, null);
            }
            catch (Exception ex)
            {
                _appLogger.Log(TipoLog.ERROR, $"CORE|Folio:{folio}|Error: {ex.Message}");
                return (false, "Error interno en validación");
            }
        }

        // ===========================
        // HELPERS
        // ===========================

        /// <summary>
        /// Obtiene determinado valor del Diccionario por medio de una keyy
        /// </summary>
        /// <param name="variables"></param>
        /// <param name="key"></param>
        /// <returns></returns>
        private string ObtenerValor(Dictionary<string, object> variables, string key)
        {

            if (!variables.TryGetValue(key, out var value))
                return null;

            if (value is List<string> lista)
                return lista.FirstOrDefault();

            return value.ToString().Trim();

        }

        /// <summary>
        /// Valida formato de fecha
        /// </summary>
        private bool EsFechaValida(string fecha)
        {
            return DateTime.TryParseExact(
                fecha,
                "yyyyMMdd",
                null,
                System.Globalization.DateTimeStyles.None,
                out _
            );
        }

        /// <summary>
        /// Aplica diferentes funciones de corrección 
        /// </summary>
        private string AplicarFunciones(
            string valor,
            string funciones,
            ref bool error,
            ref string razon)
        {
            if (funciones.Contains(ConstantesCore.ConvertirFecha))
            {
                if (!string.IsNullOrEmpty(valor))
                    valor = "20" + valor;

                if (!EsFechaValida(valor))
                {
                    error = true;
                    razon = $"Fecha inválida: {valor}";
                }
            }

            if (funciones.Contains(ConstantesCore.ConvertirImporte))
            {
                valor = valor?.Replace(",",
                    CultureInfo.CurrentCulture.NumberFormat.CurrencyDecimalSeparator);
            }

            if (funciones.Contains(ConstantesCore.ConvertirEntero))
            {
                if (!int.TryParse(valor, out var entero))
                {
                    error = true;
                    razon = $"No se puede convertir a entero: {valor}";
                }
                else
                {
                    valor = entero.ToString();
                }
            }

            return valor;
        }

        /// <summary>
        /// valida que la variable tenga valor
        /// </summary>
        private string ValidarRequerido(string valor, bool requerido, string mensaje)
        {
            if (requerido && string.IsNullOrWhiteSpace(valor))
                return mensaje;

            return null;
        }

        /// <summary>
        /// Valida cuenta y cliente para enriquecer cuenta T24
        /// </summary>
        private async Task<(bool EsValido, string Error)> ValidarCuentaT24(
            EstadoValidacion estado,
            Dictionary<string, object> variables,
            Dictionary<string, string> camposActualizar)
        {
            var cuenta = estado.Cuenta;

            if (string.IsNullOrWhiteSpace(cuenta))
                return (false, "No existe el dato de la cuenta a validar en T24");

            if (!long.TryParse(cuenta, out _))
                return (false, $"La cuenta {cuenta} no es numérica");

            if (cuenta.Contains(" "))
                return (false, $"La cuenta {cuenta} es inválida");

            _appLogger.Log(TipoLog.INFO, $"CORE|Validando cuenta T24: {cuenta}");


            // =========================================
            // CONSULTA CUENTA T24
            // =========================================
            var cuentaData = await _operacionesT24.ObtenerCuentaAsync(cuenta);

            if (cuentaData == null)
            {

                _appLogger.Log(TipoLog.WARNING, $"CORE|Cuenta no existe en T24: {cuenta}");
                return (false, $"Cuenta no existe en T24: {cuenta}");
            }
                

            var clienteData = await _operacionesT24.ObtenerClienteAsync(cuentaData.CUSTOMER);

            if (clienteData == null)
            {
                _appLogger.Log(TipoLog.WARNING, $"CORE|Cliente no existe en T24: {cuenta}");
                return (false, $"Cliente no existe en T24");
            }

            // =========================================
            // VALIDACIÓN MONEDA
            // =========================================
            var monedaCuenta = MonedaHelper.ValidarMoneda(
                cuentaData.CURRENCY,
                ConstantesServicio.MonedaDefault);

            if (estado.MonedaMandatoria && string.IsNullOrWhiteSpace(estado.Moneda))
            {
                estado.Moneda = monedaCuenta;
                camposActualizar[ConstantesCore.Moneda] = estado.Moneda;
            }

            if (!string.Equals(monedaCuenta, estado.Moneda, StringComparison.OrdinalIgnoreCase))
            {
                return (false,
                    $"Diferencia de moneda. Cuenta:{monedaCuenta} vs Mensaje:{estado.Moneda}");
            }

            // Enriquecimiento
            EnriquecerCuentaT24(cuentaData, clienteData, variables, camposActualizar);

            return (true, null);
        }

        /// <summary>
        /// Agrega diferentes valores obtenidos a partir de cliente y cuenta al diccionario de valores
        /// </summary>
        private void EnriquecerCuentaT24(
            CuentaDTO cuentaData,
            ClienteDTO clienteData,
            Dictionary<string, object> variables,
            Dictionary<string, string> camposActualizar)
        {
            if (clienteData == null)
            {
                return;
            }

            var nombreCliente = clienteData.NAME_1;

            if (!string.IsNullOrEmpty(nombreCliente) && nombreCliente.Length > 100)
                nombreCliente = nombreCliente.Substring(0, 100);

            camposActualizar[ConstantesCore.NumCliente] = cuentaData.CUSTOMER;
            camposActualizar[ConstantesCore.NombreCliente] = nombreCliente;
            camposActualizar[ConstantesCore.NumCDL] = clienteData.CUSTOMER_CODE;

            variables[ConstantesCore.BtmumNumCliente] = cuentaData.CUSTOMER;
            variables[ConstantesCore.BtmumNombreCliente] = nombreCliente;
            variables[ConstantesCore.BtmumNumCdl] = clienteData.CUSTOMER_CODE;
        }

    }
