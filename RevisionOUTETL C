using Aplicacion_ETL.DTOs;
using Aplicacion_ETL.Enums;
using Aplicacion_ETL.Excepciones;
using Aplicacion_ETL.Interfaces;
using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading.Tasks;

namespace Aplicacion_ETL.Servicios
{
    /// <summary>
    /// Clase de servicio que permite guardar valores del mensaje a BD
    /// </summary>
    public class PersistenciaSwiftService : IPersistenciaSwiftService
    {

        private readonly IOperacionesTomi _operacionesTomi;
        private readonly IOperacionesT24 _operacionesT24;
        private readonly ISwiftOutDetalleService _swiftOutDetalleService;
        private readonly IAppLogger _appLogger;

        /// <summary>
        /// Constructor.
        /// </summary>
        public PersistenciaSwiftService(IOperacionesTomi operacionesTomi, IOperacionesT24 operacionesT24, ISwiftOutDetalleService swiftOutDetalleService, IAppLogger appLogger)
        {
            _operacionesTomi = operacionesTomi;
            _operacionesT24 = operacionesT24;
            _swiftOutDetalleService = swiftOutDetalleService;
            _appLogger = appLogger;
        }

        /// <summary>
        /// Actualiza los valores de Control y detalle para los campos del diccionario
        /// </summary>
        public async Task<string> GuardarValoresABaseAsync(
            OperacionETLDTO operacion,
            string claveMensaje,
            Dictionary<string, object> variables)
        {
            _appLogger.Log(TipoLog.INFO, "Inicia proceso Guardar valores a base");

            // 1. Obtener o generar referencia
            var referencia = await ObtenerOGenerarReferencia(operacion.nf_folio);
            _appLogger.Log(TipoLog.INFO, $"Valor de referencia obtenido: {referencia}");

            if (string.IsNullOrWhiteSpace(referencia))
                throw new Exception("Referencia inválida");

            try
            {
                var detalle = await _swiftOutDetalleService.GenerarDetalleAsync(claveMensaje, referencia, variables);

                if (detalle == null || !detalle.Any())
                {
                    throw new Exception("No hay datos del mensaje swift a insertar.");
                }

                // 2. Normalizar mensaje (quitar MT-)
                var mensajeBD = NormalizarMensaje(claveMensaje);
                _appLogger.Log(TipoLog.INFO, $"Valor de mensaje normalizado: {mensajeBD}");

                // 3. Insertar CONTROL
                _appLogger.Log(TipoLog.INFO, "Inicia proceso de Insertar Control");
                await _operacionesTomi.InsertarControlAsync(mensajeBD, referencia);

                // 4. Insertar DETALLE (SOLO lo que define el SP)
                _appLogger.Log(TipoLog.INFO, "Inicia proceso de Insertar detalle");
                foreach (var campo in detalle)
                {
                    if (campo == null)
                    {
                        continue;
                    }

                    await _operacionesTomi.InsertarDetalleAsync(
                        NormalizarMensaje(campo.Mensaje),
                        campo.Referencia,
                        campo.Campo,
                        campo.Valor
                    );
                }

            }
            catch (OperacionNoProcesableException ex)
            {
                _appLogger.Log(TipoLog.INFO, $"Persistencia|Operacion no procesable: {ex.Message}");
                await _operacionesTomi.ActualizarPlanMaestroAsync(operacion.nf_folio);
                throw;
            }
            catch(Exception ex)
            {
                _appLogger.Log(TipoLog.ERROR, $"Persistencia|Folio:{operacion?.nf_folio}|{ex}");
                throw;
            }

            _appLogger.Log(TipoLog.INFO, $"Persistencia|Folio:{operacion.nf_folio}|Guardado exitoso");

            return referencia;
        }

        /// <summary>
        /// Obtiene el valor de referencia
        /// </summary>
        private async Task<string> ObtenerOGenerarReferencia(string folio)
        {
            var fechaJuliana = await _operacionesT24.ObtenerFechaJulianaAsync();
            var referencia = await _operacionesTomi.ObtenerOGenerarReferenciaAsync(folio, fechaJuliana);
            return referencia;
        }

        /// <summary>
        /// S eliminan separadores y se normaliza a mayúsculas para homologar el formato MT103 antes de persistirlo
        /// </summary>
        private string NormalizarMensaje(string mensaje)
        {
            return mensaje?
                    .Replace("-", "")
                    .ToUpper();
        }

    }
}
