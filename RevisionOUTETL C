        /// <summary>
        /// Método auxiliar de procesamiento multilinea para manejo de información de mensaje por Tags
        /// </summary>
        private void ProcesarMultilinea(
            string groupName,
            string rawValue,
            string tag,
            Dictionary<string, object> variables)
        {
            var lineas = rawValue
                .Split(new[] { "\r\n", "\n" }, StringSplitOptions.RemoveEmptyEntries)
                .Select(x => x.Trim())
                .ToList();

            int idx = 1;

            foreach (var linea in lineas)
            {
                var matchLinea = Regex.Match(linea, @"^(\d)/(.*)");

                if (matchLinea.Success)
                {
                    variables[$"{groupName}{idx}_{tag}"] =
                        matchLinea.Groups[2].Value.Trim();
                    idx++;
                }
                else
                {
                    variables[$"{groupName}_{tag}"] = linea;
                }
            }
        }

        /// <summary>
        /// Método auxiliar de procesamiento simple para manejo de información de mensaje por Tags
        /// </summary>
        private void ProcesarValorSimple(
            string groupName,
            string rawValue,
            string tag,
            Dictionary<string, object> variables)
        {
            var value = rawValue.Replace("\r", "").Replace("\n", "").Trim();
            var key = $"{groupName}_{tag}";

            if (!variables.ContainsKey(key))
            {
                variables[key] = value;
            }
            else if (variables[key] is List<string> list)
            {
                list.Add(value);
            }
            else
            {
                variables[key] = new List<string>
                {
                    variables[key].ToString(),
                    value
                };
            }
        }


