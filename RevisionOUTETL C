using Aplicacion_ETL.DTOs;
using Aplicacion_ETL.Enums;
using Aplicacion_ETL.Excepciones;
using Aplicacion_ETL.Extensiones;
using Aplicacion_ETL.Helpers;
using Aplicacion_ETL.Interfaces;
using Aplicacion_ETL.Modelos;
using System.Collections.Generic;
using System.Globalization;
using System.Linq;
using System.Threading.Tasks;
using static Aplicacion_ETL.Constantes.ConstantesSwift;

namespace Aplicacion_ETL.Servicios
{
    /// <summary>
    /// Clase de servicio que permite aplicar reglas de procesamiento para cada Tag
    /// </summary>
    public class SwiftOutDetalleService : ISwiftOutDetalleService
    {

        private readonly IOperacionesTomi _operaciones;
        private readonly CuentasNativasHelper _cuentasNativasHelper;
        private readonly IAppLogger _appLogger;

        /// <summary>
        /// Constructor.
        /// </summary>
        public SwiftOutDetalleService(IOperacionesTomi operaciones, CuentasNativasHelper cuentasNativasHelper, IAppLogger appLogger)
        {
            _operaciones = operaciones;
            _cuentasNativasHelper = cuentasNativasHelper;
            _appLogger = appLogger;
        }

        /// <summary>
        /// Valida que se obtenga la lista de campos swift siempre y cuando el tipo de mensaje no sea MT202 COV
        /// </summary>
        public async Task<List<DetalleSwiftDTO>> GenerarDetalleAsync(
            string claveMensaje,
            string referencia,
            Dictionary<string, object> variables)
        {
            _appLogger.Log(TipoLog.INFO, "Inicia proceso Generar detalle");
            var tipoMensaje = claveMensaje.ToEnum();
            // CASO ESPECIAL: mensaje no permitido
            if (tipoMensaje == TipoMensajeSwift.MT202COV)
            {
                _appLogger.Log(TipoLog.INFO, "Mensaje MT-202COV no debe salir");
                throw new OperacionNoProcesableException("Mensaje MT-202COV no permitido");
            }

            _appLogger.Log(TipoLog.INFO, "Inicia proceso Obtener lista campos Swift");
            var campos = await _operaciones.ObtenerlistaCamposSwiftAsync(claveMensaje);

            var resultado = new List<DetalleSwiftDTO>();

            foreach (var campo in campos)
            {
                ProcesarCampo(campo, variables, tipoMensaje, referencia, resultado);
            }

            return resultado;
        }

        /// <summary>
        /// Procesa el listado de campos obtenidos en el diccionario para enviarlos a BD
        /// </summary>
        private void ProcesarCampo(
            CamposSwiftDTO campo,
            Dictionary<string, object> variables,
            TipoMensajeSwift tipoMensaje,
            string referencia,
            List<DetalleSwiftDTO> resultado)
        {
            var nombreBD = campo.nm_field;
            var nombre = StringHelper.NormalizarCampo(nombreBD);
            var regla = campo.regla;
            var utilizar = campo.utilizar;

            _appLogger.Log(TipoLog.INFO, $"Se procesa campo|Nombre: {nombre} regla: {regla}");

            // 1. Multivalor primero
            if (variables.TryGetValue(nombre, out var raw) && raw is List<string> lista)
            {
                ProcesarMultivalor(nombreBD, lista, regla, tipoMensaje.ToString(), referencia, resultado);
                return;
            }

            // 2. Valor simple
            var valor = ObtenerValor(variables, nombre);

            if (string.IsNullOrEmpty(valor))
            {
                if (utilizar == ConstantesServicio.CampoMandatorio)
                {
                    valor = StringHelper.TextoSQL(campo.val_field);
                }
                else
                {
                    return;
                }
            }

            // CASO ESPECIAL CUENTAS
            if ((tipoMensaje == TipoMensajeSwift.MT940 || tipoMensaje == TipoMensajeSwift.MT950)
                && nombre == SwiftVariableKeys.AccountIdentification)
            {
                valor = _cuentasNativasHelper.ObtenerCuenta(valor);
            }

            // Aplicar regla
            valor = AplicarRegla(regla, valor);


            // forzar multivalor si utilizar contiene "1"
            if (!string.IsNullOrEmpty(utilizar) && utilizar.Contains(ConstantesServicio.MultivalorFlag))
            {
                nombreBD = $"{nombreBD}1";
            }

            resultado.Add(new DetalleSwiftDTO
            {
                Mensaje = tipoMensaje.ToSwiftString(),
                Referencia = referencia,
                Campo = nombreBD,
                Valor = valor
            });
        }

        /// <summary>
        /// Obtiene un valor determinado del diccionario a partir de una key
        /// </summary>
        private string ObtenerValor(Dictionary<string, object> variables, string key)
        {

            if (!variables.TryGetValue(key, out var value) || value == null)
                return null;

            if (value is List<string> lista)
                return lista.FirstOrDefault();

            return value.ToString().Trim();

        }

        /// <summary>
        /// Aplica reglas de formato a la cadena obtenida del diccionario
        /// </summary>
        private string AplicarRegla(string regla, string valor)
        {
            if (string.IsNullOrEmpty(regla))
                return valor;

            if (valor == null)
                return null;

            // REPLACE '%valor%'
            if (regla.StartsWith("REPLACE("))
            {
                // caso: REPLACE('%valor%',':','')
                if (regla.Contains("':'"))
                    return valor.Replace(":", "");

                // caso: REPLACE('%valor%',',','.')
                if (regla.Contains("','.'"))
                    return valor.Replace(",", ".");
            }

            // FORMATO MONTO
            if (regla.Contains("FORMAT") && regla.Contains("MONEY"))
            {
                var limpio = valor.Replace(",", ".");

                if (decimal.TryParse(
                    limpio,
                    System.Globalization.NumberStyles.Any,
                    System.Globalization.CultureInfo.InvariantCulture,
                    out var numero))
                {
                    return numero.ToString("0.##", CultureInfo.InvariantCulture);
                }
            }

            return valor;
        }

        /// <summary>
        /// Genera una lista de DetalleSwiftDTO como resultado de la cadena obtenida
        /// </summary>
        private void ProcesarMultivalor(
            string nombreBD,
            List<string> lista,
            string regla,
            string claveMensaje,
            string referencia,
            List<DetalleSwiftDTO> resultado)
        {
            if (lista == null || !lista.Any())
            {
                return;
            }

            int i = 1;

            foreach (var item in lista)
            {
                resultado.Add(new DetalleSwiftDTO
                {
                    Mensaje = claveMensaje,
                    Referencia = referencia,
                    Campo = $"{nombreBD}{i}",
                    Valor = AplicarRegla(regla, item)
                });

                i++;
            }
        }


    }
}
