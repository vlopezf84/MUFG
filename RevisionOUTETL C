namespace Aplicacion_ETL.Reglas.Base
{
    /// <summary>
    /// Clase que contiene los métodos comunes de negocio para diferentes claves de mensaje
    /// </summary>
    public abstract class ReglaSwiftBase : IReglaSwift
    {
        protected readonly IOperacionesTomi _operacionesTomi;
        protected readonly IOperacionesT24 _operacionesT24;
        protected readonly ICorrespondentService _correspondentService;
        protected readonly SwiftMessageHelper _messageHelper;
        protected readonly IAppLogger _appLogger;

        /// <summary>
        /// Constructor.
        /// </summary>
        public ReglaSwiftBase(IOperacionesTomi operacionesTomi, IOperacionesT24 operacionesT24, ICorrespondentService correspondentService, SwiftMessageHelper messageHelper, IAppLogger appLogger)
        {
            _operacionesTomi = operacionesTomi;
            _operacionesT24 = operacionesT24;
            _correspondentService = correspondentService;
            _messageHelper = messageHelper;
            _appLogger = appLogger;
        }

        /// <summary>
        /// Variable que sirve para validar  que determinada reglas utiliza que clase para su validación
        /// </summary>
        public abstract bool Aplica(string claveMensaje);

        /// <summary>
        /// Método para validar cual regla se va a aplicar al mensaje
        /// </summary>
        public abstract Task Ejecutar(
                OperacionETLDTO op,
                Dictionary<string, object> variables,
                MensajeParseadoDTO mensaje,
                IEnumerable<DestinoDTO> destinos,
                ContextoETL contexto,
                CancellationToken ct = default);

        /// <summary>
        /// Método para validar cual regla va a aplicar para el mensaje para obtener el destino requerido.
        /// </summary>
        public abstract string ResolverDestino(
                Dictionary<string, object> variables,
                string headerOriginal,
                IEnumerable<DestinoDTO> destinos,
                CancellationToken ct = default);


        // ===== MÉTODOS COMUNES =====

        /// <summary>
        /// Método que permite obtener determinado valor del diccionario de datos
        /// </summary>
        protected string ObtenerValor(Dictionary<string, object> variables, string key)
        {
            if (!variables.TryGetValue(key, out var value))
                return null;

            if (value is List<string> lista)
                return lista.FirstOrDefault();

            return value?.ToString()?.Trim();
        }

        /// <summary>
        /// Valida si el arreglo ya cuenta con una variable tipo Header
        /// </summary>
        protected bool YaTieneHeader(Dictionary<string, object> variables)
        {
            variables.TryGetValue(SwiftVariableKeys.HeaderSwiftId, out var headerObj);
            var headerActual = headerObj?.ToString();

            return !string.IsNullOrEmpty(headerActual);
        }

        /// <summary>
        /// Obtiene el campo header si existe dentro del diccionario
        /// </summary>
        public string ObtenerHeaderSiExiste(Dictionary<string, object> variables)
        {
            if (!YaTieneHeader(variables))
                return null;

            var header = ObtenerValor(variables, SwiftVariableKeys.HeaderSwiftId);

            if (string.IsNullOrWhiteSpace(header))
                return null;

            return header.StartsWith("S:")
                ? header.Substring(2)
                : header;
        }

        /// <summary>
        /// Realiza validaciones de negocio para los Tags 53 y 54
        /// </summary>
        protected async Task ProcesarTags53y54(
            Dictionary<string, object> variables,
            MensajeParseadoDTO mensaje,
            string claveMensaje)
        {
            var moneda = ObtenerValor(variables, SwiftVariableKeys.CurrencyCode);

            // eliminar siempre TAG53
            mensaje.MensajeContenido =
                _messageHelper.EliminarTag(mensaje.MensajeContenido, SwiftTags.Tag53A);


            if (moneda != ConstantesServicio.MonedaDefault)
            {
                // ELIMINAR 53A Y 54A
                mensaje.MensajeContenido =
                                    _messageHelper.EliminarTag(mensaje.MensajeContenido, SwiftTags.Tag54A);

                _appLogger.Log(TipoLog.INFO, $"Eliminación TAG53 y 54 para FX, clave mensaje: { claveMensaje}.");
                return;
            }

            var beneficiaryBank = ObtenerValor(variables, SwiftVariableKeys.InstitutionAccount);
            var intermediaryBank = ObtenerValor(variables, SwiftVariableKeys.ReceivingCorrespondent);

            _appLogger.Log(TipoLog.INFO, $"{claveMensaje}|MXN -> Beneficiary:{beneficiaryBank} Intermediary:{intermediaryBank}");

            if (mensaje.MensajeContenido.Contains($":{SwiftTags.Tag54A}:"))
            {
                var nuevoTag54 = await _correspondentService
                        .ConstruirTag54Async(intermediaryBank, beneficiaryBank);


                mensaje.MensajeContenido =
                                _messageHelper.ReemplazarTag(
                                    mensaje.MensajeContenido,
                                    SwiftTags.Tag54A,
                                    nuevoTag54
                                );

                _appLogger.Log(TipoLog.INFO, $"{claveMensaje}|TAG54 reconstruido");
            }
        }

        /// <summary>
        /// Método que procesa una referencia End 2 End 
        /// </summary>
        protected async Task ProcesarEndToEndReference(
            Dictionary<string, object> variables,
            MensajeParseadoDTO mensaje)
        {
            var transactionRef = ObtenerValor(variables, SwiftVariableKeys.TransactionRef);
            var folio = ObtenerValor(variables, SwiftVariableKeys.Folio);
            var tipoOperacion = ConstantesServicio.TipoOperacion;

            _appLogger.Log(TipoLog.INFO, $"{mensaje.ClaveMensajeFinal}|Buscando SW_END2END_REF ref:'{transactionRef}', tipo:'{tipoOperacion}', folio:'{folio}'");

            // =========================================================
            // BUSCAR REFERENCIA
            // =========================================================
            var endToEndRef = await _operacionesT24.BuscaSwEnd2EndRefAsync(
                string.Empty,
                transactionRef,
                string.Empty,
                string.Empty,
                string.Empty,
                tipoOperacion,
                folio
            );

            if (!string.IsNullOrWhiteSpace(endToEndRef))
            {
                _appLogger.Log(TipoLog.INFO, $"{mensaje.ClaveMensajeFinal}|Se encontró SW_END2END_REF:{endToEndRef}");

                await _operacionesT24.ActualizaSwEnd2EndRefAsync(
                    endToEndRef,
                    transactionRef,
                    string.Empty,
                    string.Empty,
                    string.Empty,
                    tipoOperacion,
                    folio
                );
            }
            else
            {
                endToEndRef = await _operacionesT24.GeneraSwEnd2EndRefAsync(
                    string.Empty,
                    transactionRef,
                    string.Empty,
                    string.Empty,
                    string.Empty,
                    tipoOperacion,
                    folio,
                    mensaje.ClaveMensajeFinal
                );

                _appLogger.Log(TipoLog.INFO, $"{mensaje.ClaveMensajeFinal}|Se generó SW_END2END_REF:{endToEndRef}");
            }

            // =========================================================
            // INSERTAR {121}
            // =========================================================

            if (mensaje.MensajeContenido.Length > 64)
            {
                mensaje.MensajeContenido =
                                mensaje.MensajeContenido.Substring(0, 64) +
                                "{121:" + endToEndRef + "}" +
                                mensaje.MensajeContenido.Substring(64);

                mensaje.MensajeContenido += "{121:" + endToEndRef + "}"; 
            }
            else
            {
                mensaje.MensajeContenido += "{121:" + endToEndRef + "}";
            }

            // =========================================================
            // LIMPIEZA TOHNET EXTRA
            // =========================================================
            mensaje.MensajeContenido = mensaje.MensajeContenido.Replace(
                ConstantesServicio.Tag56A_BancoIntermediarioMUFG,
                string.Empty
            );

            _appLogger.Log(TipoLog.INFO, $"{mensaje.ClaveMensajeFinal}|END2END aplicado correctamente");
        }

    }
}
