namespace Infraestructura_ETL.Repositorios
{
    public class ParserSintaxisDao : RepositorioMaestro, IParserSintaxis
    {
        private readonly IAppLogger _appLogger;

        /// <summary>
        /// Constructor.
        /// </summary>
        public ParserSintaxisDao(IAppLogger appLogger)
                : base(BasedatosProveedor.SqlServer, NombreBasedatos.TOMI, null, null)
        {
            _appLogger = appLogger;
        }

        /// <summary>
        /// Método que obtiene la sintaxis a utilizar para los mensajes
        /// </summary>
        public async Task<Dictionary<string, List<SintaxisTagDTO>>> ObtenerSintaxisAsync(
                string tipoOperacion,
                string claveMensaje,
                string tags,
                bool completo)
        {
            try
            {
                claveMensaje = claveMensaje?.Trim().ToUpper();

                var resultado = await EjecutarStoredProcedureQuery<SintaxisTagDTO>(
                    ConstantesServicio.uspObtenerTipoSwift,
                    cmd =>
                    {
                        cmd.Parameters.Add(basedatosConexion.CrearParametro("@tipo_operacion", tipoOperacion));
                        cmd.Parameters.Add(basedatosConexion.CrearParametro("@cve_mensaje", claveMensaje));
                        cmd.Parameters.Add(basedatosConexion.CrearParametro("@tags", tags));
                        cmd.Parameters.Add(basedatosConexion.CrearParametro("@completo", completo));
                    },
                    false
                );

                if (resultado?.Data == null || !resultado.Data.Any())
                {
                    return new Dictionary<string, List<SintaxisTagDTO>>();
                }

                return resultado.Data
                            .Where(x => !string.IsNullOrWhiteSpace(x.cve_tag))
                            .GroupBy(x => x.cve_tag)
                            .ToDictionary(
                                g => g.Key,
                                g => g.ToList()
                            );

            }
            catch (Exception ex)
            {
                _appLogger.Log(TipoLog.ERROR, $"ParserSintaxisDao|{ex}");
                throw;
            }

        }
    }


}

