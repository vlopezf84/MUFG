using Aplicacion_ETL.DTOs;
using Aplicacion_ETL.Interfaces;
using System;
using System.Collections.Generic;
using System.Linq;
using System.Text.RegularExpressions;

namespace Aplicacion_ETL.Servicios
{
    /// <summary>
    /// Clase de servicio que ejecuta las validaciones sobre los Tags para cada clave del mensaje
    /// </summary>
    public class SwiftParserService : ISwiftParserService
    {
        private static readonly Regex TagsRegex = new Regex(@":[0-9]{2}[A-Z]{0,2}:", RegexOptions.Compiled);

        /// <summary>
        /// Obtiene una lista de strings generada a partir de la cadena del mensaje
        /// </summary>
        public List<string> ObtenerTagsComoString(string mensaje)
        {
            return TagsRegex.Matches(mensaje)
                .Cast<Match>()
                .Select(m => m.Value.Replace(":", ""))
                .Distinct()
                .ToList();
        }

        /// <summary>
        /// Obtiene el regex de conversión que se va a aplicar a la regla MT, y aplica sus validaciones
        /// </summary>
        public string ObtenerSintaxis(string tag, Dictionary<string, List<SintaxisTagDTO>> patrones)
        {
            if (!patrones.ContainsKey(tag))
                throw new Exception($"No existe definición del TAG '{tag}'");

            var dato = patrones[tag].First();

            if (string.IsNullOrEmpty(dato.des_regexp))
            {
                var contenido = dato.des_content ?? "";
                var regexConvertido = ConvertirMTaRegex(contenido);

                return $"(:{dato.cve_tag}:{regexConvertido}\\r?\\n?)";
            }

            return $"(:{dato.cve_tag}:{dato.des_regexp}\\r?\\n?)";
        }

        /// <summary>
        /// Método intermedio para ejecutar método ObtenerPartesMensaje
        /// </summary>
        public List<string> ObtenerContenido(string tag, string mensaje)
        {
            return ObtenerPartesMensaje(tag, mensaje);
        }

        /// <summary>
        /// Obtiene las diferentes partes o segmentos que contiene el mensaje, incluyendo encabenzado, contenido de mensaje y footer
        /// </summary>
        public List<string> ObtenerPartesMensaje(string tag, string mensaje)
        {
            var resultado = new List<string>();

            // normalizar saltos
            mensaje = mensaje.Replace("\r\n", "\n");

            string tagBuscado = $":{tag}:";
            string patronTags = @"\:[0-9]{2}[A-Z]?\:";

            var matches = Regex.Matches(mensaje, patronTags)
                    .Cast<Match>()
                    .OrderBy(m => m.Index)
                    .ToList();

            // detectar footer (-)
            var footerMatch = Regex.Match(mensaje, @"\-(?<footer>[\s\S]*)$");
            int posFinalGeneral = footerMatch.Success ? footerMatch.Index : mensaje.Length;

            for (int i = 0; i < matches.Count; i++)
            {
                var match = matches[i];

                if (match.Value == tagBuscado)
                {
                    int posInicio = match.Index;
                    int posFinal;

                    // si hay siguiente tag, ese define el limite
                    if (i + 1 < matches.Count)
                    {
                        posFinal = matches[i + 1].Index;
                    }
                    else
                    {
                        posFinal = (posFinalGeneral > posInicio)
                                            ? posFinalGeneral
                                            : mensaje.Length;
                    }

                    // PROTECCIÓN CRÍTICA
                    if (posFinal <= posInicio)
                    {
                        posFinal = mensaje.Length;
                    }


                    var bloque = mensaje.Substring(posInicio, posFinal - posInicio).Trim();
                    resultado.Add(bloque);
                }
            }

            return resultado;
        }

        /// <summary>
        /// Aplica todas las reglas de validación Regex para validar la información contenida en el mensaje
        /// </summary>
        /// <param name="contenido"></param>
        /// <returns></returns>
        private string ConvertirMTaRegex(string contenido)
        {
            if (string.IsNullOrWhiteSpace(contenido))
                return contenido;


            // 0. ESCAPAR // (casos tipo //16x)
            contenido = contenido.Replace("//", @"\/\/");

            // 1. Convertir opcionales SWIFT [ ... ] -> (?: ... )?
            contenido = Regex.Replace(contenido, @"\[(.*?)\]", m =>
            {
                var inner = m.Groups[1].Value;
                // si contiene grupo nombrado, respetar
                if (inner.Contains("?<"))
                    return $"({inner})?";

                return $"(?:{inner})?";
            });

            var resultado = contenido;

            // Buscar TODOS los grupos
            var matches = Regex.Matches(contenido, @"\(\?<(?<name>.*?)>(?<pattern>.*?)\)");

            foreach (Match match in matches)
            {
                var groupName = match.Groups["name"].Value;
                var pattern = match.Groups["pattern"].Value;

                var converted = pattern;

                // 6!n -> \d{6}
                converted = Regex.Replace(converted, @"(\d+)!n", m =>
                {
                    var len = m.Groups[1].Value;
                    return $@"\d{{{len}}}";
                });

                // 3!a -> [A-Z]{3}
                converted = Regex.Replace(converted, @"(\d+)!a", m =>
                {
                    var len = m.Groups[1].Value;
                    return $@"[A-Z]{{{len}}}";
                });


                // 2!c, 3!c -> [A-Z0-9]{len}
                converted = Regex.Replace(converted, @"(\d+)!c", m =>
                {
                    var len = m.Groups[1].Value;
                    return $@"[A-Z0-9]{{{len}}}";
                });


                // soporte tipo "z" (texto SWIFT libre)
                converted = Regex.Replace(converted, @"(\d+)z", m =>
                {
                    var len = m.Groups[1].Value;
                    return $@".{{1,{len}}}";
                });

                // MULTILINEA SWIFT (ANTES de procesar x)
                converted = Regex.Replace(converted, @"(\d+)\*(\d+)x", m =>
                {
                    if (!int.TryParse(m.Groups[1].Value, out var maxLines)
                        || !int.TryParse(m.Groups[2].Value, out var maxLen))
                    {
                        throw new FormatException("No se pudo interpretar el patrón multilinea SWIFT.");
                    }

                    return $@"(.{{1,{maxLen}}}\r?\n?){{0,{maxLines}}}";
                });

                // 15d -> decimal variable
                converted = Regex.Replace(converted, @"(\d+)d", m =>
                {
                    var len = m.Groups[1].Value;
                    return $@"[0-9,\.]{{1,{len}}}";
                });

                // 16x -> texto SWIFT
                converted = Regex.Replace(converted, @"(\d+)x", m =>
                {
                    var len = m.Groups[1].Value;
                    return $@"[A-Za-z0-9\s,.\-\/\?\:\(\)\'+]{{1,{len}}}";
                });


                // Caso especial BIC
                if (converted == @"[A-Z]{4}[A-Z]{2}[A-Z0-9]{2}[A-Z0-9]{3}")
                {
                    converted = @"[A-Z]{4}[A-Z]{2}[A-Z0-9]{2}([A-Z0-9]{3})?";
                }

                // reconstruir grupo
                var nuevoGrupo = $"(?<{groupName}>{converted})";

                // reemplazar en resultado FINAL
                resultado = resultado.Replace(match.Value, nuevoGrupo);
            }

            // NUEVO 1: PROCESAR PATRONES FUERA DE GRUPOS (CLAVE)
            resultado = Regex.Replace(resultado, @"(\d+)\*(\d+)x", m =>
            {
                if (!int.TryParse(m.Groups[1].Value, out var maxLines)
                    || !int.TryParse(m.Groups[2].Value, out var maxLen))
                {
                    throw new FormatException("No se pudo interpretar el patrón multilinea SWIFT.");
                }

                return $@"(.{{1,{maxLen}}}\r?\n?){{0,{maxLines}}}";
            });

            resultado = Regex.Replace(resultado, @"(\d+)x", m =>
            {
                var len = m.Groups[1].Value;
                return $@"[A-Za-z0-9\s,.\-\/\?\:\(\)\'+]{{1,{len}}}";
            });

            resultado = Regex.Replace(resultado, @"(\d+)d", m =>
            {
                var len = m.Groups[1].Value;
                return $@"[0-9,\.]{{1,{len}}}";
            });

            // RELAJAR SALTOS DE LÍNEA (evita fallas en mensajes reales)
            resultado = resultado.Replace(@"\r?\n", @"\s*");

            // FIX ESPECÍFICO PARA TAG 53B (SIN TOCAR BD)
            if (contenido.Contains("53B"))
            {
                resultado = resultado.Replace(
                    @"(?:/[A-Za-z0-9\s]{1,34})\s*(.{1,35}\s*){0,4}",
                    @"(?<tag53B>[A-Za-z0-9/\s]{1,50})"
                    );
            }

            // FIX TAG 56A (CORREGIDO)
            if (contenido.Contains("interÑBIC") && contenido.Contains("interÑid_party"))
            {
                resultado = @"(?<tag56A>.*)";
            }

            // FIX TAG 57A
            if (contenido.Contains("accnt_instÑBIC"))
            {
                resultado = @"(?<tag57A>.*)";
            }


            // si NO hay grupos nombrados -> envolver en group default
            if (!resultado.Contains("(?<"))
            {
                resultado = $"(?<value>{resultado})";
            }


            return resultado;
        }


    }
}
