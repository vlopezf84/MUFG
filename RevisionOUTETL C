        public async Task AceptarOperacionAsync(string folio, string folioUnico, string claveMensaje, string xmlVariables, 
            Dictionary<string, string> camposActualizar, CancellationToken ct = default)
        {
            try
            {
                ct.ThrowIfCancellationRequested();
                var resultado = await EjecutarStoredProceduredNonQuery(
                    ConstantesServicio.uspSwfQualifyAuto,
                    cmd =>
                    {
                        // 1
                        cmd.Parameters.Add(basedatosConexion.CrearParametro("@icn", folio));
                        // 2
                        cmd.Parameters.Add(basedatosConexion.CrearParametro("@tipo_operacion", ConstantesServicio.TipoOperacion));
