        /// <summary>
        /// Obtiene los tags a procesar del mensaje, la sintaxis, y el resultado del procesamiento del mensaje por cada tag
        /// </summary>
        protected virtual async Task<ResultadoParsing> ProcesarParsingAsync(
            OperacionETLDTO op,
            ContextoProcesamiento contexto)
        {
            try
            {
                _appLogger.Log(TipoLog.INFO, "Procesando Parcing.");
                var variables = new Dictionary<string, object>();

                _appLogger.Log(TipoLog.INFO, "Se obtienen Tags como string.");
                var tags = _swiftParserService.ObtenerTagsComoString(contexto.MensajeOriginal);

                if (tags == null || !tags.Any())
                    return ResultadoParsing.Falla("Mensaje sin TAGs");

                _appLogger.Log(TipoLog.INFO, "Se obtienen Tags como string.");
                var sintaxis = await ObtenerSintaxisAsync(contexto, tags);

                if (sintaxis == null || sintaxis.Count == 0)
                    return ResultadoParsing.Falla("No hay sintaxis configurada");

                //Regresa el diccionario ya con los campos
                var resultado = ProcesarTags(op, contexto, tags, sintaxis, variables);

                return resultado;
            }
            catch (Exception ex)
            {
                await _appLogger.LogAsync(
                    TipoLog.WARNING,
                    "Ocurrió un error al Procesar Parsing",
                    ex
                );
                throw;
            }
        }

        /// <summary>
        /// Realiza el procesamiento del mensaje por cada Tag, retornando un diccionario con los valores de cada campo
        /// </summary>
        private ResultadoParsing ProcesarTags(
            OperacionETLDTO op,
            ContextoProcesamiento contexto,
            IEnumerable<string> tags,
            Dictionary<string, List<SintaxisTagDTO>> sintaxis,
            Dictionary<string, object> variables)
        {
            try
            {
                foreach (var tag in tags)
                {
                    _appLogger.Log(TipoLog.INFO, $"Procesando tag {tag}.");
                    var resultado = ProcesarTag(op, contexto, tag, sintaxis, variables);

                    if (!resultado.EsValido)
                        return resultado;
                }

                return ResultadoParsing.Ok(variables);
            }
            catch (Exception ex)
            {
                _appLogger.Log(TipoLog.ERROR, $"Ocurrió un error en Procesar Tags. | {ex.Message}");
                throw;
            }
        }

        /// <summary>
        /// Se ejecuta para cada tag procesado, descomponiendo el mensaje mediante la sintaxis y obteniendo el valor correspondiente
        /// </summary>
        private ResultadoParsing ProcesarTag(
            OperacionETLDTO op,
            ContextoProcesamiento contexto,
            string tag,
            Dictionary<string, List<SintaxisTagDTO>> sintaxis,
            Dictionary<string, object> variables)
        {
            try
            {
                var mensaje = contexto.MensajeOriginal;
                _appLogger.Log(TipoLog.INFO, "Se obtienen partes de mensaje.");
                var partes = _swiftParserService.ObtenerPartesMensaje(tag, mensaje);

                if (partes == null || partes.Count == 0)
                    return ResultadoParsing.Falla($"TAG {tag} sin contenido");

                //6.1 Obtener sintaxis
                _appLogger.Log(TipoLog.INFO, "Se obtiene Sintaxis.");
                var patron = _swiftParserService.ObtenerSintaxis(tag, sintaxis);
                //var patron = @"(:57D:(/(?<acc_instÑname>[A-Za-z0-9\s,.-/?:'+]{1,34}))?)";

                //6.2 Obtener contenido del mensaje (VB exacto)
                _appLogger.Log(TipoLog.INFO, "Se obtiene Contenido del mensaje.");
                var contenido = _swiftParserService.ObtenerContenido(tag, mensaje);

               _appLogger.Log(TipoLog.INFO, $"TAG:{tag}|Content:{contenido}|Patron:{patron}");

                var regex = new Regex($"^{patron}$", RegexOptions.Multiline);

                foreach (var parteOriginal in partes)
                {
                    _appLogger.Log(TipoLog.INFO, $"Se obtiene parte original del mensaje {parteOriginal}.");
                    var parte = parteOriginal;
                    if (contexto.TipoMensaje == TipoMensajeSwift.MT103 && tag == "50K")
                    {
                        parte = parte.Replace("\r\n\r\n", "\r\n");
                    }

                    var match = regex.Match(parte);

                    if (!match.Success)
                    {
                        return ResultadoParsing.Falla($"No se pudo interpretar la información con la sintaxis obtenida para el TAG: {tag}.");
                    }

                    // 6.3 Capturar grupos (equivalente agrega_valor_xml)
                    foreach (var groupName in regex.GetGroupNames())
                    {
                        if (int.TryParse(groupName, out _))
                            continue;

                        var group = match.Groups[groupName];

                        if (!group.Success)
                            continue;


                        var rawValue = group.Value;

                        if (string.IsNullOrWhiteSpace(rawValue))
                            continue;

                        // DETECTAR CAMPOS MULTILÍNEA (50F / 59F)
                        if (groupName.Contains(SwiftVariableKeys.OrderingCustomer) || groupName.Contains(SwiftVariableKeys.BeneficiaryCustomer))
                        {
                            _appLogger.Log(TipoLog.INFO, "Se procesa mensaje por método multilinea.");
                            ProcesarMultilinea(groupName, rawValue, tag, variables);
                        }
                        else
                        {
                            _appLogger.Log(TipoLog.INFO, "Se procesa mensaje por método de valor simple.");
                            ProcesarValorSimple(groupName, rawValue, tag, variables);
                        }

                    }
                }

                return ResultadoParsing.Ok();
            }
            catch (Exception ex)
            {
                return ResultadoParsing.Falla(ex.Message);
            }
        }

        /// <summary>
        /// Se encarga de resolver todas las reglas de negocio de cada una de las reglas MT, e inicia con la persistencia de datos
        /// </summary>
        protected virtual async Task<ResultadoNegocio> ProcesarNegocioAsync(
            OperacionETLDTO op,
            ContextoProcesamiento contexto,
            ResultadoParsing parsing,
            IEnumerable<DestinoDTO> destinos)
        {
            try
            {
                _appLogger.Log(TipoLog.INFO, "Inicia Procesar negocio.");
                // =========================================
                // 1. Variables base
                // =========================================

                var variables = parsing.Variables;
                var mensaje = contexto.MensajeOriginal;
                var variablesNormalizadas = SwiftVariablesNormalizer.NormalizarGenerico(variables);

                // =========================================
                // 2. Obtener regla de negocio
                // =========================================
                _appLogger.Log(TipoLog.INFO, $"Se obtiene regla a aplicar para {contexto.ClaveMensaje}.");
                var regla = _swiftFactory.ObtenerReglaAplicar(contexto.ClaveMensaje);

                if (regla == null)
                    return ResultadoNegocio.Falla($"No hay regla para {contexto.ClaveMensaje}");

                // =========================================
                // 3. RESOLVER DESTINO
                // =========================================
                _appLogger.Log(TipoLog.INFO, "Se obtiene destino.");
                var destino = regla.ResolverDestino(
                            variablesNormalizadas,
                            contexto.HeaderId,
                            destinos
                        );
                _appLogger.Log(TipoLog.INFO, $"El destino obtenido es: {destino}.");

                if (string.IsNullOrWhiteSpace(destino))
                {
                    _appLogger.Log(TipoLog.INFO, $"No se obtuvo un destino para {contexto.ClaveMensaje}.");
                    // Caso especial VB: MT940 / MT950
                    if (contexto.TipoMensaje == TipoMensajeSwift.MT940 ||
                        contexto.TipoMensaje == TipoMensajeSwift.MT950)
                    {
                        _appLogger.Log(TipoLog.INFO, $"Folio:{op.nf_folio}|Mensaje no parametrizado, se cancela");

                        await _operacionesTomi.MarcarCanceladoNoParametrizadoAsync(
                            contexto.ClaveMensaje,
                            _configuracion.FechaSistema,
                            op.nf_folio
                        );

                        return ResultadoNegocio.Falla(
                            "Mensaje cancelado por no parametrización"
                        );
                    }
                    else
                    {
                        throw new Exception("Mensaje sin dirección swift destino");
                    }
                }


                // =========================================
                // 4. Asignar header_swift_id
                // =========================================

                variablesNormalizadas[SwiftVariableKeys.HeaderSwiftId] =
                            destino.StartsWith("S:")
                                ? destino
                                : "S:" + destino;


                // =========================================
                // 5. Reemplazo de header en mensaje
                // =========================================
                _appLogger.Log(TipoLog.INFO, "Se obtiene header desde el diccionario");
                if(!variablesNormalizadas.TryGetValue(SwiftVariableKeys.HeaderSwiftId, out var headerObj) || headerObj == null)
                {
                    throw new Exception("HeaderSwiftId no disponible");
                }

                var headerSwift = headerObj.ToString();
                _appLogger.Log(TipoLog.INFO, $"El header obtenido es: {headerSwift}.");

                var mensajeConHeader = ReemplazarHeaderSwift(
                    mensaje,
                    headerSwift
                );

                contexto.Parsed.MensajeContenido = mensajeConHeader;
                _appLogger.Log(TipoLog.INFO, $"El mensaje con header obtenido es: {contexto.Parsed.MensajeContenido}");

                // =========================================
                // 6. Ejecutar regla de negocio
                // =========================================
                _appLogger.Log(TipoLog.INFO, $"Se ejecutan las reglas de negocio para {contexto.ClaveMensaje}");
                await regla.Ejecutar(op, variablesNormalizadas, contexto.Parsed, destinos, _contextoETL);

                // =========================================
                // 7. Persistencia
                // =========================================

                var camposActualizar = new Dictionary<string, string>();

                _appLogger.Log(TipoLog.INFO, "Se ejecuta proceso Guardar Valores a base");
                var folioUnico = await _persistenciaSwiftService.GuardarValoresABaseAsync(
                    op,
                    contexto.ClaveMensaje,
                    variablesNormalizadas
                );
                _appLogger.Log(TipoLog.INFO, $"Valor de folio unico generado al guardar valores a base: {folioUnico}");

                _appLogger.Log(TipoLog.INFO, "Se ejecuta proceso Actualizar mensajes swift ETL");
                await _operacionesTomi.ActualizarMensajeSwiftETLAsync(op.nf_folio, contexto.Parsed.MensajeContenido);

                // =========================================
                // 8. Validación CORE
                // =========================================
                _appLogger.Log(TipoLog.INFO, "Se ejecuta Validar datos Core");
                var resultadoCore = await _coreValidator.ValidarDatosCoreAsync(
                    op.nf_folio,
                    contexto.ClaveMensaje,
                    variablesNormalizadas,
                    camposActualizar
                );

                if (!resultadoCore.EsValido)
                {
                    await _operacionesTomi.RechazarOperacionAsync(op.nf_folio, resultadoCore.Error);
                    return ResultadoNegocio.Falla(resultadoCore.Error);
                }

                // =========================================
                // 9. Generar XML final
                // =========================================
                _appLogger.Log(TipoLog.INFO, "Inicia proceso para Generar XML");
                var xmlFinal = XmlBuilderHelper.GenerarXml(variablesNormalizadas, op.nf_folio);
                _appLogger.Log(TipoLog.DEBUG, $"Folio:{op.nf_folio}|XML:{xmlFinal}");

                // =========================================
                // 🔥 10. Categoría MT
                // =========================================
                _appLogger.Log(TipoLog.INFO, "Inicia proceso Set MT Category");
                await SetMtCategoryAsync(op.nf_cve_mensaje, op.nf_folio);

                // =========================================
                // 🔥 11. Resultado exitoso
                // =========================================

                return ResultadoNegocio.Ok(
                        folioUnico,
                        contexto.ClaveMensaje,
                        xmlFinal,
                        camposActualizar
                    );
            }
            catch (Exception ex)
            {
                await _appLogger.LogAsync(
                    TipoLog.WARNING,
                    "Ocurrió un error al Procesar Negocio",
                    ex
                );
                throw;
            }
        }

