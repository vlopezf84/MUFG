    public class CorrespondentService : ICorrespondentService
    {
        private readonly IOperacionesTomi _operacionesTomi;

        /// <summary>
        /// Constructor.
        /// </summary>
        public CorrespondentService(IOperacionesTomi operacionesTomi)
        {
            _operacionesTomi = operacionesTomi;
        }

        /// <summary>
        /// Obtiene el tipo de cuenta dependiendo del valor de BIC
        /// </summary>
        public async Task<string> ConstruirTag54Async(string correspondentBic, string beneficiaryBic)
        {

            if (string.IsNullOrWhiteSpace(correspondentBic))
                return string.Empty;

            var sb = new StringBuilder();

            if (string.IsNullOrWhiteSpace(beneficiaryBic))
            {
                sb.AppendLine(correspondentBic);
                return sb.ToString();
            }

            if (int.TryParse(beneficiaryBic, out _))
            {
                sb.AppendLine(correspondentBic);
                return sb.ToString();
            }

            var bic = StringHelper.SanitizeBic11(beneficiaryBic);

            if (string.IsNullOrEmpty(correspondentBic) ||
                !correspondentBic.Contains(SwiftBics.MUFG_MX))
            {
                var result = await _operacionesTomi
                    .ObtenerCuentaCorrespondienteAsync(ConstantesServicio.MonedaDefault, bic);

                if (result == null)
                {
                    sb.AppendLine(correspondentBic);
                    return sb.ToString();
                }

                sb.AppendLine("/" + result.BeneficiaryAccount);
                sb.AppendLine(correspondentBic);
            }
            else
            {
                var nostro = await _operacionesTomi
                    .ObtenerCuentaNostroAsync(ConstantesServicio.MonedaDefault, bic);

                if (string.IsNullOrEmpty(nostro))
                {
                    sb.AppendLine(correspondentBic);
                    return sb.ToString();
                }

                sb.AppendLine("/" + nostro);
                sb.AppendLine(correspondentBic);
            }

            return sb.ToString();
        }


        
    }

