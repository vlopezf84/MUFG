    /// <summary>
    /// Clase que contiene toda la configuración inicial
    /// </summary>
    public partial class ServiceHost : WindowsServiceHostBase
    {
        private SimpleInjector.Container _containerDI;
        private Configuracion _configuracionBase;

        protected override string NombreServicioLog => NombreServicio.Swf_OUT_ETL.ToString();
        protected override bool TimerEnabled => _configuracionBase?.TimerEnabled == true;
        protected override double TimerIntervalMs => _configuracionBase?.TimerInterval ?? 10000;

        /// <summary>
        /// Constructor.
        /// </summary>
        public ServiceHost()
        {
        }

        /// <summary>
        /// Realiza la inyección y establece un timer
        /// que ejecutará su delegado por tick del intervalo.
        /// </summary>
        protected override void Inicializacion(string[] args, CancellationToken ct)
        {
            ct.ThrowIfCancellationRequested();

            //Realiza la configuracion del contenedor DI...
            _containerDI = new SimpleInjector.Container();
            _containerDI.Options.DefaultScopedLifestyle = new AsyncScopedLifestyle();
            _containerDI.Register<MUFG_T24.Interfaces_utilidades.IAlertas>(() => new Alertas(BasedatosProveedor.SqlServer, NombreBasedatos.TOMI, null, null), Lifestyle.Singleton);
            _containerDI.Register<IControlServicio, ControlServicio>();
            _containerDI.Register<IParametrizacion, Parametrizacion>();
            _containerDI.Register<ConexionT24Mw>(() => new ConexionT24Mw(BasedatosProveedor.SqlServer, NombreBasedatos.TOMI, BasedatosProveedor.SqlServer, NombreBasedatos.T24_VW), Lifestyle.Singleton);
            _containerDI.Register<IAppLogger, AppLogger>(Lifestyle.Scoped);

            //Carga la configuracion propia del servicio (appsettings.json)...
            //Objeto que almacena la configuración necesaria para el funcionamiento del servicio.
            _configuracionBase = new Configuracion();

            //Establece las rutas de log...
            {
                ConfiguracionEncriptadaHelper.Inicializar();
                ServicioConfiguracionSettings servicioMainConfiguracion = ConfiguracionEncriptadaHelper.ObtenerServicio(NombreServicio.Swf_OUT_ETL.ToString());
                _configuracionBase.NombreServicio = servicioMainConfiguracion.NombreServicio;
                _configuracionBase.PathLog = servicioMainConfiguracion.Log;
                _configuracionBase.TimerEnabled = servicioMainConfiguracion.TimerEnable;
                _configuracionBase.TimerInterval = servicioMainConfiguracion.Timer;
                _configuracionBase.TamanoMaximoArchivoLogKB = servicioMainConfiguracion.TamanoMaximoArchivoLogKB.ToString();
                _configuracionBase.ForzaEjecucionServicios = servicioMainConfiguracion.ForzaEjecucionServicios;
                _configuracionBase.CorreoSenderTest = ConfiguracionEncriptadaHelper.ObtenerValorGeneral(ConstantesServicio.SenderTest);
                _configuracionBase.CorreoParaDefault = ObtenerValorConfiguracionSeguro(ConstantesServicio.MailTo);
                _configuracionBase.CorreoCopiaDefault = ObtenerValorConfiguracionSeguro(ConstantesServicio.MailToCC);
                _configuracionBase.SujetoDefault = ObtenerValorConfiguracionSeguro(ConstantesServicio.Subject);


                RutasConfiguracion rutas = new RutasConfiguracion()
                {
                    MUFG_Servicios_Path_Log = _configuracionBase.PathLog
                };
                Logging.Init(rutas, servicioMainConfiguracion.NombreServicio, servicioMainConfiguracion.TamanoMaximoArchivoLogKB);
                Logging.Write("INFO|OnStart|Leyendo archivo de configuración.");
            }

            //Registra la configuracion como Transient + Factory (lazy)...
            _containerDI.Register<Configuracion>(() => _configuracionBase.Clone(), Lifestyle.Scoped);
            _containerDI.Register<EstadoHorarioOperacion>(Lifestyle.Singleton);

            _containerDI.Register<CuentasNativasHelper>(Lifestyle.Scoped);
            //Registra las Reglas
            _containerDI.Collection.Register<IReglaSwift>(new[]
            {
                typeof(ReglaMT199),
                typeof(ReglaMT103),
                typeof(ReglaMT202),
                typeof(ReglaMT400),
                typeof(ReglaMT410),
                typeof(ReglaMT412),
                typeof(ReglaMT700),
                typeof(ReglaDefault),
            });
            _containerDI.Register<ReglaSwiftFactory>(Lifestyle.Singleton);
            _containerDI.Register<SwiftMessageHelper>(Lifestyle.Singleton);
            _containerDI.Register<ContextoETL>(Lifestyle.Scoped);
            _containerDI.Register<SwiftStandardReleaseSanitize>(Lifestyle.Singleton);
            //Registra los componentes
            _containerDI.Register<Aplicacion_ETL.Interfaces.IOperacionServicio, OperacionServicio>();
            _containerDI.Register<ICuentasNativas, CuentasNativasDao>();
            _containerDI.Register<IOperacionesETL, OperacionesETLDao>();
            _containerDI.Register<IParserSintaxis, ParserSintaxisDao>();
            _containerDI.Register<IOperacionesT24, OperacionesT24Dao>();
            _containerDI.Register<IOperacionesTomi, OperacionesTomiDao>();
            _containerDI.Register<IOperacionesSwift, OperacionesSwiftDao>();
            _containerDI.Register<ISwiftParserService, SwiftParserService>();
            _containerDI.Register<ICoreValidatorService, CoreValidatorService>();
            _containerDI.Register<IPersistenciaSwiftService, PersistenciaSwiftService>();
            _containerDI.Register<ISwiftOutDetalleService, SwiftOutDetalleService>();
            _containerDI.Register<INotificacionErrorService, NotificacionErrorService>();
            _containerDI.Register<ICorrespondentService, CorrespondentService>();

            _containerDI.Verify();
            _containerDI.GetInstance<ReglaSwiftFactory>();
        }

        /// <summary>
        /// Realiza la obtención inicial de parámetros (una sola vez).
        /// </summary>
        protected override async Task ParametrizacionesAsync(CancellationToken ct)
        {
            try
            {
                //Obtiene el proceso actual...
                IParametrizacion _parametrizacion = _containerDI.GetInstance<IParametrizacion>();
                _configuracionBase = await _parametrizacion.ObtenerProcesoActualAsync(_configuracionBase, ct);

                //Marca el servicio en uso...
                IControlServicio _controlServicio = _containerDI.GetInstance<IControlServicio>();
                await _controlServicio.MarcarPuertoEnUsoAsync(_configuracionBase.Pid.Value, _configuracionBase.NombreProceso, _configuracionBase.NombreDisplay, _configuracionBase.NombreServicio, ct);

                using (AsyncScopedLifestyle.BeginScope(_containerDI))
                {
                    var helper = _containerDI.GetInstance<CuentasNativasHelper>();
                    await helper.InicializarAsync(ct);
                }
            }
            catch (Exception ex)
            {
                Config.EscribirLog($"ERROR|ParametrizacionesAsync|{ex}");
                throw;
            }
        }

        /// <summary>
        /// Ejecuta el funcionamiento principal del servicio en cada tick.
        /// </summary>  
        protected override async Task OnTimerAsync(CancellationToken ct)
        {
            try
            {
                //Ejecuta el procedimiento principal del servicio...
                using (AsyncScopedLifestyle.BeginScope(_containerDI))
                {
                    var operacionServicio = _containerDI.GetInstance<Aplicacion_ETL.Interfaces.IOperacionServicio>();
                    await operacionServicio.EjecutarProcedimientosAsync(ct).ConfigureAwait(false);
                }
            }
            catch (OperationCanceledException)
            {
                Config.EscribirLog("INFO|Realiza_timer|Operación cancelada.");
            }
            catch (Exception ex)
            {
                Config.EscribirLog($"ERROR|Realiza_timer|Se presenta exception: {ex}");
            }
        }

        /// <summary>
        /// Realiza ciertas operaciones antes de finalizar el servicio.
        /// </summary>
        protected override async Task TerminacionAsync(CancellationToken ct, CancellationToken cleanupCt, Task startupTask, Task runningTask)
        {
            Config.EscribirLog("INFO|OnStop|Finalizando Servicio.");

            try
            {
                if (_containerDI == null || _configuracionBase == null)
                {
                    Config.EscribirLog("INFO|OnStop|Terminación omitida por inicialización incompleta.");
                    return;
                }

                using (AsyncScopedLifestyle.BeginScope(_containerDI))
                {
                    Configuracion _configuracion = _containerDI.GetInstance<Configuracion>();
                    IControlServicio _controlServicio = _containerDI.GetInstance<IControlServicio>();

                    await _controlServicio.EsperarTareaActivaAsync(startupTask, ConstantesSistema.ParametrizacionInicial, ct).ConfigureAwait(false);
                    await _controlServicio.EsperarTareaActivaAsync(runningTask, ConstantesSistema.ProcesamientoActivo, ct).ConfigureAwait(false);

                    //Marca el servicio en uso...
                    await _controlServicio.MarcarPuertoEnUsoAsync(null, null, null, _configuracion.NombreServicio, cleanupCt).ConfigureAwait(false);

                    //Marca el termino del servicio...
                    await _controlServicio.ActualizaTerminacion(_configuracion.NombreServicio, cleanupCt).ConfigureAwait(false);

                    Config.EscribirLog("INFO|OnStop|Terminación exitosa de bases de datos.");
                }
            }
            catch (OperationCanceledException)
            {
                //Apagado normal
            }
            catch (Exception ex)
            {
                Config.EscribirLog($"ERROR|TerminacionAsync|{ex}");
            }
            finally
            {
                _containerDI?.Dispose();
            }
        }

        /// <summary>
        /// Método de apoyo para obtener configuracion extra
        /// </summary>
        private string ObtenerValorConfiguracionSeguro(string llave)
        {
            try
            {
                return ConfiguracionEncriptadaHelper.ObtenerValorGeneral(llave);
            }
            catch(Exception ex)
            {
                Config.EscribirLog($"WARNING|No fue posible obtener configuración [{llave}]|{ex.Message}");
                return string.Empty;
            }
        }
    }
}
