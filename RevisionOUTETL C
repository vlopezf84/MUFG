using System;
using System.Collections.Generic;
using System.Threading;
using System.Threading.Tasks;
using static Aplicacion_ETL.Constantes.ConstantesSwift;

namespace Aplicacion_ETL.Reglas.Implementaciones
{
    /// <summary>
    /// Clase que contiene las reglas d enegocio específicas para la clave de mensaje MT202
    /// </summary>
    public class ReglaMT202 : ReglaSwiftBase
    {
        /// <summary>
        /// Constructor.
        /// </summary>
        public ReglaMT202(IOperacionesTomi operacionesTomi, IOperacionesT24 operacionesT24, ICorrespondentService correspondentService, SwiftMessageHelper messageHelper, IAppLogger appLogger) 
            : base(operacionesTomi, operacionesT24, correspondentService, messageHelper, appLogger)
        {
        }

        /// <summary>
        /// Variable que sirve para validar  que determinada reglas utiliza que clase para su validación
        /// </summary>
        public override bool Aplica(string claveMensaje)
        {
            var tipo = claveMensaje.ToEnum();
            return tipo == TipoMensajeSwift.MT202 || tipo == TipoMensajeSwift.MT202COV;
        }

        /// <summary>
        /// Método para validar cual regla se va a aplicar al mensaje
        /// </summary>
        public override async Task Ejecutar(
            OperacionETLDTO op,
            Dictionary<string, object> variables,
            MensajeParseadoDTO mensaje,
            IEnumerable<DestinoDTO> destinos,
            ContextoETL contexto,
            CancellationToken ct = default)
        {
            ct.ThrowIfCancellationRequested();
            // =========================================
            // 1. Validación MT202COV
            // =========================================
            var tipoMensaje = mensaje.ClaveMensajeFinal.ToEnum();
            if (tipoMensaje == TipoMensajeSwift.MT202COV && !contexto.SwfOutMT202COV)
            {
                throw new Exception("MT-202COV no está permitido por configuración");
            }

            // =========================================
            // 2. Enriquecer beneficiario
            // =========================================
            await EnriquecerBeneficiario(variables, mensaje.ClaveMensajeFinal);

            // =========================================
            // 3. Regla fija (ordering institution)
            // =========================================
            variables[SwiftVariableKeys.OrderingInstitutionBic] = SwiftBics.MUFG_MX;

            // ========================================================
            // 4. PROCESA TAG 53A Y 54A
            // ========================================================
            await ProcesarTags53y54(variables, mensaje, mensaje.ClaveMensajeFinal);

            // ========================================================
            // 5. PROCESA END2END
            // ========================================================
            await ProcesarEndToEndReference(variables, mensaje);
            ct.ThrowIfCancellationRequested();
        }

        /// <summary>
        /// Método para validar cual regla va a aplicar para el mensaje para obtener el destino requerido.
        /// </summary>
        public override string ResolverDestino(
            Dictionary<string, object> variables,
            string headerOriginal,
            IEnumerable<DestinoDTO> destinos,
            CancellationToken ct = default)
        {
            ct.ThrowIfCancellationRequested();

            // 1. respetar header existente
            var header = ObtenerHeaderSiExiste(variables);
            if (!string.IsNullOrEmpty(header))
                return header;

            var moneda = ObtenerValor(variables, SwiftVariableKeys.CurrencyCode);

            if (string.IsNullOrEmpty(moneda))
                throw new Exception("currency_code es requerido para MT-202");

            ct.ThrowIfCancellationRequested();

            switch (moneda)
            {
                case SwiftCurrencies.USD:
                    return SwiftBics.CHASE_US;
                case SwiftCurrencies.EUR:
                case SwiftCurrencies.GBP:
                    return SwiftBics.CHASE_UK;
                case SwiftCurrencies.JPY:
                    return SwiftBics.CHASE_JP;
                case SwiftCurrencies.CAD:
                    return SwiftBics.CHASE_CA;
                default:
                    throw new Exception($"Moneda desconocida='{moneda}'");
            }

        }

        /// <summary>
        /// Obtiene el valor del beneficiario y lo agrega al diccionario de variables
        /// </summary>
        private async Task EnriquecerBeneficiario(
            Dictionary<string, object> variables,
            string claveMensaje)
        {
            var bic = ObtenerValor(
                variables,
                SwiftVariableKeys.BeneficiaryInstitutionBIC
            );

            if (!string.IsNullOrEmpty(bic))
            {
                var nombre = await _operacionesTomi.BuscarBeneficiarioAsync(bic);

                if (!string.IsNullOrEmpty(nombre))
                {
                    _appLogger.Log(TipoLog.INFO, $"MT202|Agregando nombre beneficiario='{nombre}'");

                    // equivalente a agrega_valor_xml
                    variables[SwiftVariableKeys.BeneficiaryInstitutionName] = nombre;
                }
            }
        }

    }
}
