    {
        private readonly IAppLogger _appLogger;
        private readonly Configuracion _configuracion;

        /// <summary>
        /// Constructor.
        /// </summary>
        public NotificacionErrorService(IAppLogger appLogger, Configuracion configuracion)
        {
            _appLogger = appLogger;
            _configuracion = configuracion;
        }

        /// <summary>
        /// Realiza la función de envío de correo cuando el mensaje no se transfirió correctamente
        /// </summary>
        public async Task NotificarErrorAsync(
            OperacionETLDTO op,
            string mensajeOriginal,
            string razon,
            string mailErrorBD,
            string mailErrorCCBD,
            string subjectMailError)
        {
            try
            {
                // =========================================
                // 1. SUBJECT
                // =========================================
                var subject = subjectMailError;

                // =========================================
                // 2. BODY
                // =========================================
                var body =
                    $"Error en servicio SWIFT_OUT-ETL\n" +
                    $"Folio: {op.nf_folio}\n\n" +
                    $"Mensaje:\n{mensajeOriginal}\n\n" +
                    $"Razón:\n{razon}";

                // =========================================
                // 3. DESTINATARIOS DESDE BD
                // =========================================
                var listaTo = ObtenerCorreos(mailErrorBD);
                var listaCC = ObtenerCorreos(mailErrorCCBD);

                if (!listaTo.Any())
                {
                    Config.EscribirLog(
                        $"WARN|EMAIL|Folio:{op.nf_folio}|Sin destinatarios configurados"
                    );
                    return;
                }

                // convertir a string (CLAVE)
                var to = string.Join(",", listaTo);
                var cc = string.Join(",", listaCC);


                // =========================================
                // 4. ENVIO (Mufg_DLL)
                // =========================================
                CorreoHelper.EnviarCorreo(new MensajeCorreo
                {
                    CorreoOrigen = _configuracion.CorreoSenderTest,
                    NombreOrigen = ConstantesServicio.nombreCorreoOrigen, // ojo case exacto
                    Para = to,
                    ConCopia = cc,
                    Asunto = subject,
                    Mensaje = body
                });

                await _appLogger.LogAsync(
                            TipoLog.INFO,
                            $"EMAIL|Folio:{op.nf_folio}|Correo enviado correctamente");
            }
            catch (Exception ex)
            {
                await _appLogger.LogAsync(
                            TipoLog.ERROR,
                             $"EMAIL|Folio:{op.nf_folio}|{ex}");
            }
        }

        /// <summary>
        /// Obtiene las destinatarios para el correo 
        /// </summary>
        private List<string> ObtenerCorreos(string correos)
        {
            if (string.IsNullOrWhiteSpace(correos))
                return new List<string>();

            return correos
                .Split(',', ';')
                .Select(c => c.Trim())
                .Where(c => !string.IsNullOrWhiteSpace(c))
                .Distinct()
                .ToList();
        }


    }
