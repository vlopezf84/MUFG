using Aplicacion_ETL.Interfaces;
using System;
using System.Collections.Generic;
using System.Threading;
using System.Threading.Tasks;

namespace Aplicacion_ETL.Helpers
{
    public class CuentasNativasHelper
    {
        private readonly ICuentasNativas _cuentasNativasDao;
        private Dictionary<string, string> _cuentas;

        public CuentasNativasHelper(ICuentasNativas cuentasNativasDao)
        {
            _cuentasNativasDao = cuentasNativasDao ?? throw new ArgumentNullException(nameof(cuentasNativasDao));
        }

        /// <summary>
        /// Inicialización (carga de datos desde DB)
        /// </summary>
        public async Task InicializarAsync(CancellationToken ct = default)
        {
            ct.ThrowIfCancellationRequested();
            _cuentas = await _cuentasNativasDao.ObtenerCuentasNativasAsync();

            if (_cuentas == null)
                _cuentas = new Dictionary<string, string>();
        }

        /// <summary>
        /// Valida que la cuenta exista
        /// </summary>
        public string ObtenerCuenta(string cuenta)
        {
            if (_cuentas == null)
                throw new InvalidOperationException("CuentasNativasHelper no ha sido inicializado");

            if (string.IsNullOrWhiteSpace(cuenta))
                return cuenta;

            return _cuentas.TryGetValue(cuenta, out var valor)
                ? valor
                : cuenta; //fallback seguro (NO lanzar excepción)
        }

    }
}
