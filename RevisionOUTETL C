using System;
using System.Collections.Generic;
using System.Data;
using System.Linq;

namespace Infraestructura_ETL.Helpers
{
    public static class DataContextHelpers
    {
        /// <summary>
        /// Método que convierte de un DataTable a List Entity
        /// </summary>
        public static List<T> ToListEntity<T>(this DataTable dt) where T : new()
        {
            var propiedades = typeof(T).GetProperties();

            return dt.AsEnumerable().Select(row =>
            {
                var obj = new T();

                foreach (var prop in propiedades)
                {
                    if (!dt.Columns.Contains(prop.Name) || row[prop.Name] == DBNull.Value)
                        continue;

                    prop.SetValue(obj, row[prop.Name]);
                }

                return obj;
            }).ToList();
        }

        /// <summary>
        /// Método que convierte de un DataTable a Entity
        /// </summary>
        public static T ToEntity<T>(this DataTable dt) where T : new()
        {
            if (dt == null || dt.Rows.Count == 0)
                return default;

            var row = dt.Rows[0];
            var propiedades = typeof(T).GetProperties();

            var obj = new T();

            foreach (var prop in propiedades)
            {
                if (!dt.Columns.Contains(prop.Name) || row[prop.Name] == DBNull.Value)
                    continue;

                prop.SetValue(obj, row[prop.Name]);
            }

            return obj;
        }

    }
}
