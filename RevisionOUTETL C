                        // 5 XML completo (CRÍTICO)
                        cmd.Parameters.Add(basedatosConexion.CrearParametro("@variables_xml", xmlVariables));
                        // 6 - 16 (enchufe directo VB)
                        cmd.Parameters.Add(basedatosConexion.CrearParametro("@num_cliente", Get(camposActualizar, "num_cliente")));

                        cmd.Parameters.Add(basedatosConexion.CrearParametro("@nombre_cliente", Get(camposActualizar, "nombre_cliente")));

                        cmd.Parameters.Add(basedatosConexion.CrearParametro("@num_cdl", Get(camposActualizar, "num_cdl")));

                        cmd.Parameters.Add(basedatosConexion.CrearParametro("@num_cuenta", Get(camposActualizar, "num_cuenta")));

                        cmd.Parameters.Add(basedatosConexion.CrearParametro("@cve_moneda", Get(camposActualizar, "cve_moneda")));

                        cmd.Parameters.Add(basedatosConexion.CrearParametro("@des_importe", Get(camposActualizar, "des_importe")));

                        cmd.Parameters.Add(basedatosConexion.CrearParametro("@fec_valor", Get(camposActualizar, "fec_valor")));

                        cmd.Parameters.Add(basedatosConexion.CrearParametro("@num_cif_emisor", Get(camposActualizar, "num_cif_emisor")));

                        cmd.Parameters.Add(basedatosConexion.CrearParametro("@cta_vostro_emisor", Get(camposActualizar, "cta_vostro_emisor")));

                        cmd.Parameters.Add(basedatosConexion.CrearParametro("@cve_swift_emisor", Get(camposActualizar, "cve_swift_emisor")));

                        cmd.Parameters.Add(basedatosConexion.CrearParametro("@nombre_emisor", Get(camposActualizar, "nombre_emisor")));
                    }
                );

                if (!resultado.Exito)
                {
                    throw new InvalidOperationException($"Error al aceptar operacion: {resultado.MensajeError}");
                }
                ct.ThrowIfCancellationRequested();
            }
            catch (Exception ex)
            {
                _appLogger.Log(TipoLog.ERROR, $"Ocurrió un error al Aceptar operación: {ex}");
                throw;
            }
        }

