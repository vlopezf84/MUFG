    public class OperacionServicio : IOperacionServicio
    {
        private enum MensajeT24ParseErrorCode
        {
            EmptyMessage,
            RegexNoMatch,
            EmptyHeader,
            EmptyContent
        }

        private sealed class MensajeT24ParseException : Exception
        {
            public MensajeT24ParseErrorCode ErrorCode { get; }

            public MensajeT24ParseException(MensajeT24ParseErrorCode errorCode, string message)
                : base(message)
            {
                ErrorCode = errorCode;
            }
        }

        private readonly Configuracion _configuracion;
        private readonly IControlServicio _controlServicio;
        private readonly IParametrizacion _parametrizacion;
        private readonly IAppLogger _appLogger;
        private readonly IOperacionesETL _operacionesDao;
        private readonly IParserSintaxis _parserSintaxis;
        private readonly ISwiftParserService _swiftParserService;
        private readonly ContextoETL _contextoETL;
        public readonly ReglaSwiftFactory _swiftFactory;
        private readonly ICoreValidatorService _coreValidator;
        private readonly IPersistenciaSwiftService _persistenciaSwiftService;
        private readonly IOperacionesTomi _operacionesTomi;
        private readonly INotificacionErrorService _notificacionErrorService;

        /// <summary>
        /// Constructor.
        /// </summary>
        public OperacionServicio(Configuracion configuracion, IControlServicio controlServicio, IParametrizacion parametrizacion, IAppLogger appLogger, 
            IOperacionesETL operacionesDao, IParserSintaxis parserSintaxis, ISwiftParserService swiftParserService, ReglaSwiftFactory swiftFactory,
            ICoreValidatorService coreValidator, IPersistenciaSwiftService persistenciaSwiftService, IOperacionesTomi operacionesTomi, 
            INotificacionErrorService notificacionErrorService, ContextoETL contextoETL)
        {
            _configuracion = configuracion;
            _controlServicio = controlServicio;
            _parametrizacion = parametrizacion;
            _appLogger = appLogger;
            _operacionesDao = operacionesDao;
            _parserSintaxis = parserSintaxis;
            _swiftParserService = swiftParserService;
            _contextoETL = contextoETL;
            _swiftFactory = swiftFactory;
            _coreValidator = coreValidator;
            _persistenciaSwiftService = persistenciaSwiftService;
            _operacionesTomi = operacionesTomi;
            _notificacionErrorService = notificacionErrorService;
        }

        /// <summary>
        /// Método principal del servicio, Valida si es posible ejecutar el servicio por temas de horario, día, ejecuta el procesamiento, 
        /// y ejecuta la terminación del mismo
        /// </summary>
        public async Task<bool> EjecutarProcedimientosAsync(CancellationToken ct)
        {
            try
            {
                await _controlServicio.ActualizaEJecucion(_configuracion.NombreServicio);

                await CargarConfiguracionAsync();

                var (ejecutar, esBatch) = await DebeEjecutarOperacionesAsync();
                if (!ejecutar)
                    return false;

                await ProcesarETLAsync(esBatch, ct);

                return true;
            }
            catch (Exception ex)
            {
                await _appLogger.ManejarErrorAsync(ex, "Error en ejecución ETL");
                return false;
            }
            finally
            {
                await _controlServicio.ActualizaTerminacion(_configuracion.NombreServicio);
            }
        }

        /// <summary>
        /// Se cargan las principales configuraciones del sistema.
        /// </summary>
        private async Task CargarConfiguracionAsync()
        {
            _configuracion.FechaSistema = await _parametrizacion.ObtenerFechaSistemaAsync();
            _configuracion.ParametrosSistema = await _parametrizacion.ObtenerParametrosSistemaAsync(ConstantesServicio.ParametrosSistema);
        }

        /// <summary>
        /// Se evalua si se ejecutan las operaciones.
        /// </summary>
        private async Task<(bool ejecutar, bool getMtBatch)> DebeEjecutarOperacionesAsync()
        {
            var parametros = _configuracion.ParametrosSistema;

            string horaInicio = parametros[ConstantesGenerales.HoraOPInicio];
            string horaFin = parametros[ConstantesGenerales.HoraOPFin];


            _contextoETL.CriterioCompleto = ParseBool(parametros[ConstantesServicio.SWFCriterioCompleto]);
            _contextoETL.AllCurrenciesFeature = ParseBool(parametros[ConstantesServicio.AllCurrenciesFeature]);
            _contextoETL.SwfOutMT202COV = ParseBool(parametros[ConstantesServicio.SwfOutMT202COV]);
            _contextoETL.EnhanceTag57DFeature = ParseBool(parametros[ConstantesServicio.EnhanceFeatureFlag]);
            _contextoETL.ConfiguracionCorreoError = ObtenerConfiguracionCorreo(parametros);

            bool getMtBatch = ParseBool(parametros[ConstantesServicio.SWFOutGetMtBatch]);

            if (getMtBatch)
                return (true, true);

            bool ejecuta = await EsDiaYHoraValidaAsync(horaInicio, horaFin);
            return (ejecuta, false);
        }

        /// <summary>
        /// Método que parametriza la configuración para envío de correo, en caso de ser Dev y QA, se deben obtener los parametros desde archivo de configuración,
        /// En caso de ser prod, los parametros se obtienen desde BD.
        private ConfiguracionCorreoErrorDTO ObtenerConfiguracionCorreo(Dictionary<string, string> parametros)
        {
            bool existeConfiguracionLocal =
                !string.IsNullOrWhiteSpace(_configuracion.CorreoParaDefault);

            //Para ambientes de Dev y QA, se buscan los parametros desde el archivo de configuración.
            if (existeConfiguracionLocal)
            {
                return new ConfiguracionCorreoErrorDTO
                {
                    Para = _configuracion.CorreoParaDefault,
                    CC = _configuracion.CorreoCopiaDefault,
                    Subject = _configuracion.SujetoDefault
                };
            }

            //Si no encuentra los parametros en el archivo de configuración, toma la información productiva (BD)
            return new ConfiguracionCorreoErrorDTO
            {
                Para = parametros[ConstantesServicio.MailToFromDB],
                CC = parametros[ConstantesServicio.MailToCCFromDB],
                Subject = parametros[ConstantesServicio.SubjectFromDB]
            };
        }

        /// <summary>
        /// Evalua la cadena como posible valor booleano.
        /// </summary>
        private bool ParseBool(string valor)
        {
            if (string.IsNullOrWhiteSpace(valor))
                return false;

            return valor == "1" ||
                   valor.Equals("true", StringComparison.OrdinalIgnoreCase);
        }

        /// <summary>
        /// Evalúa los parámetros de día hábil y horario de operación.
        /// </summary>
        private async Task<bool> EsDiaYHoraValidaAsync(string horaInicio, string horaFin)
        {
            if (!await ValidarDiaHabilAsync())
                return false;

            return await ValidarHorarioOperacionAsync(horaInicio, horaFin);
        }

        /// <summary>
        /// Evalúa si es día hábil.
        /// </summary>
        public async Task<bool> ValidarDiaHabilAsync()
        {
            _configuracion.EsDiaHabil = await _controlServicio.EsDiaHabil();

            //Valida que sea día hábil...
            if (!_configuracion.EsDiaHabil.Value)
            {
                await _appLogger.LogAsync(
                            TipoLog.WARNING,
                            "Hoy es un día inhábil.",
                            generarAlerta: true,
                            claveAviso: ConstantesClaveAviso.Error
                        );

                return false;
            }
            return true;
        }

        /// <summary>
        /// Evalúa el horario de operación.
        /// </summary>
        public async Task<bool> ValidarHorarioOperacionAsync(string HorarioInicio, string HorarioFin)
        {
            //Valida el horario de operación...
            TimeSpan timeHoraSistema = _parametrizacion.ObtenerHoraSistema();

            if (!TimeSpan.TryParse(HorarioInicio, out var horaIni)
                || !TimeSpan.TryParse(HorarioFin, out var horaFin))
            {
                await _appLogger.LogAsync(
                            TipoLog.WARNING,
                            $"El servicio '{_configuracion.NombreServicio}' está fuera de horario.",
                            generarAlerta: true,
                            claveAviso: ConstantesClaveAviso.Error
                        );

                return false;
            }

            if (!(timeHoraSistema >= horaIni && timeHoraSistema <= horaFin))
            {
                await _appLogger.LogAsync(
                            TipoLog.WARNING,
                            $"El servicio '{_configuracion.NombreServicio}' está fuera de horario.",
                            generarAlerta: true,
                            claveAviso: ConstantesClaveAviso.Error
                        );

                return false;
            }

            return timeHoraSistema >= horaIni && timeHoraSistema <= horaFin;
        }

        /// <summary>
        /// Inicia el proceso de manejo de mensajes, obtiene los mensajes y procesa cada uno.
        /// </summary>
        private async Task ProcesarETLAsync(bool esBatch, CancellationToken ct)
        {
            _appLogger.Log(TipoLog.INFO, "Obteniendo operaciones a procesar.");
            var operaciones = await _operacionesDao.ObtenerOperacionesAsync(ConstantesServicio.TipoOperacion);

            if (!operaciones.Any())
            {
                _appLogger.Log(TipoLog.INFO, "No hay operaciones a procesar.");
                return;
            }

            _appLogger.Log(TipoLog.INFO, "Obteniendo destinos a procesar.");
            var destinos = await _operacionesTomi.ObtenerDestinosSwiftAsync();

            foreach (var op in operaciones)
            {
                if (ct.IsCancellationRequested)
                    break;

                try
                {
                    _appLogger.Log(TipoLog.INFO, $"Procesando operación| Folio: {op.nf_folio} Clave: {op.nf_cve_mensaje}.");
                    await ProcesarOperacionAsync(op, destinos);
                }
                catch (Exception ex)
                {
                    await _appLogger.ManejarErrorAsync(ex, $"Error al Procesar operaciones| Folio: {op.nf_folio}");
                }
            }
        }

        /// <summary>
        /// Método que lleva a cabo todos los pasos del procesamiento del ETL
        /// </summary>
        private async Task ProcesarOperacionAsync(
            OperacionETLDTO op,
            IEnumerable<DestinoDTO> destinos)
        {
            try
            {
                _appLogger.Log(TipoLog.INFO, $"Inicio Procesar operación folio {op.nf_folio}");

                var contexto = PrepararContextoAsync(op);

                var resultadoParsing = await ProcesarParsingAsync(op, contexto);

                if (!resultadoParsing.EsValido)
                {
                    //Manejar Excepcion
                    await _operacionesTomi.AgregarAlertaAsync(op.nf_folio, resultadoParsing.Error);
                    await ManejarErrorParsing(op, contexto.MensajeOriginal, resultadoParsing.Error);
                    return;
                }

                var resultadoNegocio = await ProcesarNegocioAsync(op, contexto, resultadoParsing, destinos);

                if (!resultadoNegocio.EsValido)
                {
                    _appLogger.Log(TipoLog.ERROR, $"Procesar Negocio obtuvo un resultado NO Válido: {op.nf_folio} | {contexto.MensajeOriginal} | {resultadoNegocio.Error}");
                    await ManejarErrorParsing(op, contexto.MensajeOriginal, resultadoNegocio.Error);
                    return;
                }

                _appLogger.Log(TipoLog.INFO, $"Inicio Proceso Finalizar operación");
                await FinalizarOperacionAsync(op, resultadoNegocio);
                _appLogger.Log(TipoLog.INFO, $"Fin procesamiento folio {op.nf_folio}");
            }
            catch (Exception ex)
            {
                await ManejarExcepcionAsync(op, ex);
                await _appLogger.ManejarErrorAsync(ex, "Error al procesar operación");
            }
        }

        /// <summary>
        /// Permite normalizar el mensaje corrigiendo header inválido.
        /// </summary>
        private string NormalizarMensajeT24(string mensaje)
        {
            _appLogger.Log(TipoLog.INFO, "Normalizando mensaje T24.");
            if (string.IsNullOrWhiteSpace(mensaje))
                return mensaje;

            //Reemplazo de caracteres especiales (VB)
            mensaje = mensaje.Replace("þ", Environment.NewLine);

            //Corrección de header inválido T24
            mensaje = mensaje.Replace(
                "{1:F01DEMOGBPXXXXX.SN...ISN.}",
                "{1:F01BOTKMXMXXXXX0000000000}"
            );

            return mensaje;
        }

        /// <summary>
        /// Realiza el parseo de mensaje T24 y extrae valores de Header y contenido correspondiente
        /// </summary>
        private MensajeParseadoDTO ParsearMensajeT24(string mensajeT24, string claveMensaje)
        {
            _appLogger.Log(TipoLog.INFO, "Parseando mensaje T24.");
            var claveMensajeEnum = claveMensaje.ToEnum();
            if (string.IsNullOrWhiteSpace(mensajeT24))
            {
                throw new MensajeT24ParseException(MensajeT24ParseErrorCode.EmptyMessage, "Mensaje T24 vacío");
            }
                

            try
            {
                string patron;

                //1. Selección de patrón (igual VB)
                if (claveMensajeEnum == TipoMensajeSwift.MT199)
                {
                    patron = @"^\{1\:[A-Z0-9\.]+\}" +
                             @"\{2\:[A-Z0-9]{4}(?<header_swift_id>[A-Z0-9]{11})[A-Z0-9]{2}\}" +
                             @"\{3\:\{[A-Za-z0-9\:]+\}\{121\:[A-Za-z0-9\-]{36}\}\}" +
                             @"\{4\:\r?\n(?<swf>[0-9A-Za-z '()+,\-./:?\n\r\{\}]+)\}$";
                }
                else
                {
                    //patron = @"^\{1\:[A-Z0-9\.]+\}" +
                    //         @"\{2\:[A-Z0-9]{4}(?<header_swift_id>[A-Z0-9]{11})[A-Z0-9]{2}\}" +
                    //         @"\{3\:\{[A-Za-z0-9\:]+\}(?<is_cov>\{119:COV\})?\}" +
                    //         @"\{4\:\r?\n(?<swf>[0-9A-Za-z '()+,\-./:?\n\r\{\}]+)\}$";

                    patron = @"^\{1\:[A-Z0-9\.]+\}\{2\:[A-Z0-9]{4}(?<header_swift_id>[A-Z0-9]{11})[A-Z0-9]{2}\}\{3\:\{[A-Za-z0-9\:]+\}(?<is_cov>\{119:COV\})?\}\{4\:\r\n(?<swf>[0-9A-Za-z '()+,-./:?\n\r\{\}]+)\}$";
                }

                var regex = new Regex(patron, RegexOptions.Singleline);
                var match = regex.Match(mensajeT24);

                //Si no hace match, error crítico
                if (!match.Success)
                {
                    throw new MensajeT24ParseException(MensajeT24ParseErrorCode.RegexNoMatch, "No se pudo establecer el mensaje T24");

                }

                //2. Extraer valores
                var headerId = match.Groups[SwiftVariableKeys.HeaderSwiftId].Value;
                var contenido = match.Groups["swf"].Value;

                //3. Detectar MT-202COV
                if (!string.IsNullOrWhiteSpace(match.Groups["is_cov"].Value) && claveMensajeEnum == TipoMensajeSwift.MT202)
                {
                    claveMensajeEnum = TipoMensajeSwift.MT202COV;
                    claveMensaje = claveMensajeEnum.ToSwiftString();
                }

                //Validaciones adicionales (recomendadas)
                if (string.IsNullOrEmpty(headerId))
                    throw new MensajeT24ParseException(MensajeT24ParseErrorCode.EmptyHeader, "HeaderSwiftId vacío");

                if (string.IsNullOrEmpty(contenido))
                    throw new MensajeT24ParseException(MensajeT24ParseErrorCode.EmptyContent, "Contenido SWIFT vacío");

                return new MensajeParseadoDTO
                {
                    HeaderSwiftId = headerId,
                    MensajeContenido = contenido,
                    ClaveMensajeFinal = claveMensaje,
                    RawMensaje = mensajeT24
                };
            }
            catch (Exception ex)
            {
                if (ex is MensajeT24ParseException parseEx)
                {
                    _appLogger.Log(TipoLog.ERROR, $"Ocurrió un error al parsear mensaje T24 [{parseEx.ErrorCode}]: {parseEx.Message}");
                }
                else
                {
                    _appLogger.Log(TipoLog.ERROR, $"Ocurrió un error al parsear mensaje T24: {ex.Message}");
                }

                throw;
            }
        }

        /// <summary>
        /// Método intermedio que valida el tipo de parseo de mensaje si es MT-199 o cualquier otro
        /// </summary>
        public MensajeParseadoDTO ProcesarSegunTipo(string mensaje, string clave)
        {
            _appLogger.Log(TipoLog.INFO, "Procesando mensaje según tipo.");
            var claveMensajeEnum = clave.ToEnum();
            if (claveMensajeEnum == TipoMensajeSwift.MT199)
            {
                return ParsearMensajePlano(mensaje, clave);
            }

            return ParsearMensajeT24(mensaje, clave);
        }

        /// <summary>
        /// Método que retorna MensajeParseadoDTO, donde no existe header
        /// </summary>
        private MensajeParseadoDTO ParsearMensajePlano(string mensaje, string clave)
        {
            _appLogger.Log(TipoLog.INFO, "Parseando mensaje plano.");
            return new MensajeParseadoDTO
            {
                HeaderSwiftId = string.Empty,
                MensajeContenido = mensaje,
                ClaveMensajeFinal = clave,
                RawMensaje = mensaje
            };
        }

        /// <summary>
        /// Reemplaza el contenido en header del mensaje
        /// </summary>
        private string ReemplazarHeaderSwift(
            string mensajeT24,
            string headerSwiftId)
        {
            _appLogger.Log(TipoLog.INFO, "Inicia proceso de Reemplazar Header Swift.");
            if (string.IsNullOrEmpty(headerSwiftId))
                throw new Exception("header_swift_id vacío");

            // 1. quitar prefijo S:
            var headerEnv = headerSwiftId.StartsWith("S:")
                ? headerSwiftId.Substring(2)
                : headerSwiftId;

            // 2. si tiene branch (11 chars)
            if (headerEnv.Length == 11)
            {
                headerEnv = headerEnv.Substring(0, 8) + "X" + headerEnv.Substring(8);
            }

            // 3. normalizar a 12 chars
            headerEnv = headerEnv.PadRight(12, 'X');

            _appLogger.Log(TipoLog.INFO, $"Header reemplazado='{headerEnv}'.");

            // 4. reemplazo EXACTO como VB
            if (mensajeT24.Length < 48)
                throw new Exception("Mensaje T24 inválido para reemplazo de header");

            return mensajeT24.Substring(0, 36)
                 + headerEnv
                 + mensajeT24.Substring(48);
        }

        /// <summary>
        /// Asigna y actualiza la categoría de mensaje de acuerdo al Tipo de MT del proceso
        /// </summary>
        public async Task SetMtCategoryAsync(
            string messageType,
            string folio)
        {
            try
            {
                var claveMensajeEnum = messageType.ToEnum();
                // =========================================
                // 1. Categoría por default
                // =========================================
                var messageCategory = MessageCategory.NoCat;

                // =========================================
                // 2. Lógica de asignación
                // =========================================
                switch (claveMensajeEnum)
                {
                    case TipoMensajeSwift.MT103:
                        messageCategory = MessageCategory.IntEqCurrency;
                        break;

                    case TipoMensajeSwift.MT191:
                        //Tenemos que obtener la cuenta de control del cliente puesta en T24, despues de esto comprobar que tanto 
                        //la cuenta a debitar (que es la cuenta que el cliente pide se tomen las comisiones) y la moneda a cobrar la 
                        //comision coincidan, de igual manera si la comision es pedida en MXN puede salir como SPEI. Por el momento 
                        //los mensajes se dejan en NO_CAT ya que aun no se recibe
                        break;

                    case TipoMensajeSwift.MT940:
                    case TipoMensajeSwift.MT950:
                    case TipoMensajeSwift.MT998B:
                    case TipoMensajeSwift.MT998:
                        messageCategory = MessageCategory.Inf;
                        break;
                }

                _appLogger.Log(TipoLog.INFO, $"Categoría asignada: '{messageCategory}' para folio:{folio}");

                // =========================================
                // 3. UPDATE BD (equivalente VB)
                // =========================================
                await _operacionesTomi.ActualizaCategoriaMTAsync(
                    folio,
                    (int)messageCategory
                );
            }
            catch (Exception ex)
            {
                _appLogger.Log(TipoLog.ERROR, $"Ocurrió un error en Set MT Category {folio}: {ex.Message}");
                throw;
            }
        }

