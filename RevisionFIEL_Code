namespace Aplicacion.Servicios
{
    /// <summary>
    /// Operacion principal del servicio.
    /// </summary>
    public class OperacionServicio : Interfaces.IOperacionServicio
    {
        // Sistema Interfaces.
        private readonly ConfiguracionServicio _configuracion;


        // SPIDFIEL Interfaces.
        private readonly IParametrizacion _iParametrizacion;
        private readonly IParametrosOperaciones _IparametrosOperaciones;
        private readonly IOperacionesSpidFiel _IOperacionesSpidFiel;

        bool horaInicioConfigurada = false;
        bool horaFinConfigurada = false;

        /// <summary>
        /// Inicializa una nueva instancia del servicio principal de operaciones SPID FIEL.
        /// </summary>
        /// <param name="configuracion">Configuración del servicio.</param>
        /// <param name="iParametrizacion">Componente de parametrización.</param>
        /// <param name="iparametrosOperaciones">Repositorio de parámetros y operaciones.</param>
        /// <param name="iOperacionesSpidFiel">Operaciones SPID FIEL.</param>
        public OperacionServicio(ConfiguracionServicio configuracion, IParametrizacion iParametrizacion, IParametrosOperaciones iparametrosOperaciones, IOperacionesSpidFiel iOperacionesSpidFiel)
        {
            _configuracion = configuracion;
            _IparametrosOperaciones = iparametrosOperaciones;
            _IOperacionesSpidFiel = iOperacionesSpidFiel;
            _iParametrizacion = iParametrizacion;
        }


        /// <summary>
        /// Procedimiento principal para el procesamiento de las operaciones.
        /// </summary>
        public async Task EjecutaProcedimientosAsync()
        {
            // Actualiza ejecucion //COMENTAR PARA DEBUG
            await _IparametrosOperaciones.MarcarServicioEnEjecucion(_configuracion.NombreServicio);

            // Obtiene los parametros del sistema del Servicio SPIDFIEL.
            var dicParametrosSistema = await _IparametrosOperaciones.parametrosSistema();

            //Valida los horarios de operación...
            TimeSpan timeHoraSistema = _iParametrizacion.ObtenerHoraSistema();

            //Pregunta a la base de datos si el dia es habil segun el registro en base de datos.
            _configuracion.BoEsDiaHabil = await _IparametrosOperaciones.BEsDiaHabil();

            if (dicParametrosSistema == null) throw new Exception("No se encontraron los parametros del sistema.");

            //Carga la configuración de los parámetros para el inicio de operaciones de la base de datos.
            foreach (var paramSistema in dicParametrosSistema)
            {
                if(!Enum.TryParse(paramSistema.Key, out ParametrosSistema parametro)) continue; // Cambia el tipo string a un enum
                switch (parametro)
                {
                    case ParametrosSistema.HORA_LECTURA_INICIO:
                        _configuracion.StrHoraLecturaInicio = ConversionHelper.ParseTimeSpanRequerido(paramSistema.Value, ParametrosSistema.HORA_LECTURA_INICIO.ToString());
                        Config.EscribirLog("INFO|obtenerParametrosSistema|Hora de inicio de lectura '" + paramSistema.Value + "'.", NombreServicio.SPID_FIEL.ToString());
                        break;

                    case ParametrosSistema.HORA_LECTURA_FIN:
                        _configuracion.StrHoraLecturaFin = ConversionHelper.ParseTimeSpanRequerido(paramSistema.Value, ParametrosSistema.HORA_LECTURA_FIN.ToString());
                        Config.EscribirLog("INFO|obtenerParametrosSistema|Hora de finalización de lectura '" + paramSistema.Value + "'.", NombreServicio.SPID_FIEL.ToString());
                        break;

                    case ParametrosSistema.HORA_OP_INICIO:
                        _configuracion.StrHoraOperacionesInicio = ConversionHelper.ParseTimeSpanRequerido(paramSistema.Value, ParametrosSistema.HORA_OP_INICIO.ToString());
                        horaInicioConfigurada = true;
                        Config.EscribirLog("INFO|obtenerParametrosSistema|Hora de inicio de operaciones '" + paramSistema.Value + "'.", NombreServicio.SPID_FIEL.ToString());
                        break;

                    case ParametrosSistema.HORA_OP_FIN:
                        _configuracion.StrHoraOperacionesFin = ConversionHelper.ParseTimeSpanRequerido(paramSistema.Value, ParametrosSistema.HORA_OP_FIN.ToString());
                        horaFinConfigurada = true;
                        Config.EscribirLog("INFO|obtenerParametrosSistema|Hora de finalización de operaciones '" + paramSistema.Value + "'.", NombreServicio.SPID_FIEL.ToString());
                        break;

                    case ParametrosSistema.SPID_WEBSERVICE_FORMAT:
                        _configuracion.StrWebServiceFormato = paramSistema.Value;
                        Config.EscribirLog("INFO|obtenerParametrosSistema|Formato WebService SPID '" + paramSistema.Value + "'.", NombreServicio.SPID_FIEL.ToString());
                        break;

                    case ParametrosSistema.SPID_WEBSERVICE_NS:
                        _configuracion.StrWebServiceNS = paramSistema.Value;
                        Config.EscribirLog("INFO|obtenerParametrosSistema|URL Dominio WebService SPID '" + paramSistema.Value + "'.", NombreServicio.SPID_FIEL.ToString());
                        break;

                    case ParametrosSistema.SPID_WEBSERVICE_OPERATION:
                        _configuracion.StrWebServiceOperacion = paramSistema.Value;
                        Config.EscribirLog("INFO|obtenerParametrosSistema|Operación WebService SPID '" + paramSistema.Value + "'.", NombreServicio.SPID_FIEL.ToString());
                        break;

                    case ParametrosSistema.SPID_WEBSERVICE_TIMEOUT:
                        _configuracion.StrWebServiceTimeout = paramSistema.Value;
                        Config.EscribirLog("INFO|obtenerParametrosSistema|Timeout Conexión WebService SPID '" + paramSistema.Value + "'.", NombreServicio.SPID_FIEL.ToString());
                        break;

                    case ParametrosSistema.SPID_WEBSERVICE_URL:
                        _configuracion.StrURLWebService = paramSistema.Value;
                        //PARA PRUEBA LOCAL //_configuracion.StrURLWebService = "http://localhost:8080/Service.asmx?op=consultaCertificado?wsdl";//para prueba local
                        Config.EscribirLog("INFO|obtenerParametrosSistema|URL WebService SPID '" + paramSistema.Value + "'.", NombreServicio.SPID_FIEL.ToString());
                        break;
                }
            }

            ///Valida que los parametros obtenidos de la base dedatos de las horas de ejecución no vengan vacios, de lo contrario enviara una excepcion.

            if (!horaInicioConfigurada)  throw new Exception("No se especifica la hora de inicio de operaciones");
            if (!horaFinConfigurada) throw new Exception("No se especifica la hora de finalización de operaciones");
            

            ///Validamos el horario de las operaciones, indicara si la bandera es falso o verdadero. 
            bool boHoraOperacionInicio = (timeHoraSistema >= _configuracion.StrHoraOperacionesInicio && timeHoraSistema <= _configuracion.StrHoraOperacionesFin);
            Config.EscribirLog($"INFO|Ejecuta_Procedimientos|{(boHoraOperacionInicio ? "inicio" : "Termina")}horario de operaciones, HoraSistema='{timeHoraSistema:hh\\:mm}'.", NombreServicio.SPID_FIEL.ToString());

            // Obtencion de la fecha del sistema.
            var horaActual = DateTime.Now;
            _configuracion.StrFechaSistema = new TimeSpan(horaActual.Hour, horaActual.Minute, 0);


            if (_configuracion.StrFechaSistema >= _configuracion.StrHoraLecturaInicio && _configuracion.StrFechaSistema <= _configuracion.StrHoraLecturaFin) // Inicio Horario
            {
                if (!_configuracion.BHorarioLectura)
                {
                    _configuracion.SeEnvioAlertaFueraHorario = false;
                    _configuracion.BHorarioLectura = true;
                    Config.EscribirLog($"INFO|Ejecuta_Procedimientos| Inicio horario de operaciones, HoraSistema='{timeHoraSistema:hh\\:mm}'.", NombreServicio.SPID_FIEL.ToString());
                }
            }
            else // Termina Horario
            {
                if (_configuracion.BHorarioLectura) 
                {   
                    _configuracion.BHorarioLectura = false;
                    Config.EscribirLog($"INFO|Ejecuta_Procedimientos| Termina horario de operaciones, HoraSistema='{timeHoraSistema:hh\\:mm}'.", NombreServicio.SPID_FIEL.ToString());
                }
            }

            if (!_configuracion.BHorarioLectura && !_configuracion.SeEnvioAlertaFueraHorario) // Fuera de Horario
            {
                _configuracion.SeEnvioAlertaFueraHorario = true;

                Config.EscribirLog($"INFO|Ejecuta_Procedimientos| El Servicio esta fuera de Horario.", NombreServicio.SPID_FIEL.ToString());
                await _IparametrosOperaciones.EnviaAlerta(new AlertaDTO
                {
                    TipoOPeracion = null,
                    Folio = null,
                    Servicio = _configuracion.NombreServicio,
                    ClaveAviso = "CRITICO",
                    Descipcion = "El servicio está fuera de horario",
                    PId = (int)_configuracion.Pid,
                    NombreProceso = _configuracion.NombreProceso,
                    Exception = new Exception("El servicio '" + _configuracion.NombreServicio + "' está fuera de horario.")
                });
            }

            ///Inicia los servicios asincronos segun el horario de operacion de cada uno.

            try
            {

                if ((bool)_configuracion.BoEsDiaHabil)  // Valido que sea día hábil (bool)_configuracion.BoEsDiaHabil
                {

                    if (_configuracion.StrFechaSistema >= _configuracion.StrHoraOperacionesInicio && _configuracion.StrFechaSistema <= _configuracion.StrHoraOperacionesFin) 
                    {
                        _configuracion.BenHorario = true;
                        Config.EscribirLog($"INFO|Ejecuta_Procedimientos| Inicio horario de operaciones, HoraSistema='{timeHoraSistema:hh\\:mm}'.", NombreServicio.SPID_FIEL.ToString());

                        // Ejecucion de operaciones dentro de horario de operaciones
                        List<string> respListaFiel = await _IOperacionesSpidFiel.ObtenerListaField();
                        if (respListaFiel?.Any() == true) await _IOperacionesSpidFiel.ValidaSpidFiel(respListaFiel);
                    }
                }
                else
                {
                    if ((bool)_configuracion.BenHorario) //Fuera de horario
                    {
                        _configuracion.BenHorario = false;
                        Config.EscribirLog($"INFO|Ejecuta_Procedimientos| Termina horario de operaciones, HoraSistema='{timeHoraSistema:hh\\:mm}'.", NombreServicio.SPID_FIEL.ToString());
                    }
                }

               

            }
            catch (Exception ex) 
            {
                Config.EscribirLog("ERROR|Ejecuta_Procedimientos|Se presenta exception: " + ex.Message);
                await _IparametrosOperaciones.EnviaAlerta(new AlertaDTO
                {
                    TipoOPeracion = null,
                    Folio = null,
                    Servicio = _configuracion.NombreServicio,
                    ClaveAviso = "CRITICO",
                    Descipcion = "Error en ejecuta_procedimientos",
                    PId = (int)_configuracion.Pid,
                    NombreProceso = _configuracion.NombreProceso,
                    Exception = new Exception(ex.ToString())
                });
                Config.EscribirLog("ERROR|Ejecuta_Procedimientos|Se forza la finalización del servicio.", NombreServicio.SPID_FIEL.ToString());

                throw new Exception($"ERROR|Ejecuta_Procedimientos|{ex}");
            }
            finally
            {
                try
                {
                    // Fin de los procesos a realizar 
                    await _IparametrosOperaciones.MarcarServicioEnFinalizacion(_configuracion.NombreServicio);
                }
                catch (Exception exFinally)
                {
                    Config.EscribirLog($"ERROR|Ejecuta_Procedimientos|no fue posible maracar el servicio en finalización: {exFinally}", NombreServicio.SPID_Accionistas.ToString());
                }
            }
        }
    }
}
