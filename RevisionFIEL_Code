    public static class ValidadorRespuestaFiel
    {
        /// <summary>
        /// ObtenerResultado
        /// </summary>
        /// <param name="valor0"></param>
        /// <param name="valor1"></param>
        /// <param name="valor5"></param>
        /// <returns></returns>
        public static ResultadoValidacionFielDTO ObtenerResultado(string valor0, string valor1, string valor5)
        {
            bool hayError = !int.TryParse(valor0, out var code) || code != 0;

            return new ResultadoValidacionFielDTO
            {
                FielStatus = hayError ? "ERROR" : "PROCESADO",

                EstadoConsulta = hayError ? "INVALIDO" : valor5,

                CodigoRespuesta = valor0,

                MensajeRespuesta = valor1
            };
        }
    }
