namespace Infraestructura.Repositorio
{
    /// <summary>
    /// Operaciones repositorio.
    /// </summary>
    public class OperacionesRepositorio : RepositorioMaestro, IOperacionesSpidFiel
    {
        // Sistema Interfaces.
        private readonly ConfiguracionServicio _configuracion;

        // Alertas
        private readonly Alertas _alertas;

        /// <summary>
        /// Constructor.
        /// </summary>
        /// <param name="configuracion"></param>
        /// <param name="alertas"></param>
        public OperacionesRepositorio(ConfiguracionServicio configuracion, Alertas alertas) : base(BasedatosProveedor.SqlServer, NombreBasedatos.TOMI, null, null)
        {
            _configuracion = configuracion;
            _alertas = alertas;
        }

        /// <summary>
        /// Busca Listas field PENDIENTES con un sp de consulta en la base de datos de tomi.
        /// </summary>
        /// <returns>List<string></returns>
        public async Task<List<string>> ObtenerListaField()
        {

            try
            {
                Config.EscribirLog("INFO|ObtenerListaField|Buscando FIEL de clientes para validar.", NombreServicio.SPID_FIEL.ToString());

                var spEjecucion = await EjecutarStoredProcedureQuery<DLField>(ConstantesServicio.sp_Obtener_Lista_Field);
                var data = spEjecucion?.Data ?? new List<DLField>(); //Obtiene la informacion de Data sino crea un array vacio.
                return data.Where(respSPQuery => respSPQuery.fiel_status == "PENDIENTE")
                           .Select(respSPQuery => respSPQuery.fiel)
                           .ToList();
            }
            catch (Exception ex)
            {
                Config.EscribirLog($"ERROR|ObtenerListaField|Ocurre Excepcion:{ex}", NombreServicio.SPID_FIEL.ToString());
                await _alertas.InsertarAlerta(new AlertaDTO() {
                    TipoOPeracion = null,
                    Folio = null,
                    Servicio = _configuracion.NombreServicio,
                    ClaveAviso = "ERROR",
                    Descipcion = ex.Message,
                    PId = (int)_configuracion.Pid,
                    NombreProceso = _configuracion.NombreProceso,
                    Exception = new Exception(ex.ToString())
                });
                throw new Exception($"ERROR|ObtenerListaField|{ex}");
            }
        }

        /// <summary>
        /// Valida que la lista de fiel tenga elementos y envia la informacion a la funcion ConsumeWebServiceSPID.
        /// </summary>
        /// <param name="listaFiel"></param>
        /// <returns></returns>
        public async Task ValidaSpidFiel(List<string> listaFiel)
        {
            try
            {
                if ((listaFiel?.Count ?? 0) == 0) return;

                Config.EscribirLog("INFO|ValidaFIEL|Comienza la Validación de los FIEL", NombreServicio.SPID_FIEL.ToString());



                foreach (string strFiel in listaFiel) 
                { 
 
                    string fiel = (strFiel ?? string.Empty).Trim();

                    if(String.IsNullOrEmpty(fiel)) continue;
                    
                    //LOG
                    Config.EscribirLog($"INFO|ValidaFIEL|Validando FIEL: '{fiel}'", NombreServicio.SPID_FIEL.ToString());

                    //Construccion de XML SOAP

                    XNamespace soapenv = "http://schemas.xmlsoap.org/soap/envelope/";
                    XNamespace ws = _configuracion.StrWebServiceNS;

                    var xmlSoap = new XDocument(
                        new XElement(
                            soapenv + "Envelope",
                            new XAttribute(XNamespace.Xmlns + "soapenv", soapenv),
                            new XAttribute(XNamespace.Xmlns + "ws", ws),

                            new XElement(soapenv + "Header"),

                            new XElement(
                                soapenv + "Body",
                                new XElement(
                                    ws + _configuracion.StrWebServiceOperacion,
                                    new XElement("arg0", fiel)
                                )
                            )
                        )
                    );

                    string strWebServiceXML = xmlSoap.ToString(SaveOptions.DisableFormatting);

                    //PARA PRUEBA LOCAL //strWebServiceXML = "<?xml version=\"1.0\" encoding=\"utf-8\"?>\r\n<soap:Envelope xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xmlns:xsd=\"http://www.w3.org/2001/XMLSchema\" xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\r\n  <soap:Body>\r\n    <consultaCertificado xmlns=\"http://tempuri.org/\" />\r\n  </soap:Body>\r\n</soap:Envelope>";

                    Config.EscribirLog($"INFO|ValidaFIEL|XML a Enviar: {strWebServiceXML}", NombreServicio.SPID_FIEL.ToString());

                    XmlDocument doc;
                    string error;

                    if (!XmlHelper.TryParseXmlSeguro(strWebServiceXML, out doc, out error))
                    {
                        Config.EscribirLog("ERROR|XML|XML inválido: " + error);
                        throw new Exception("ERROR|XML|XML inválido: " + error);
                    }

                    // Consume WebService
                    string xmlData = await Task.Run(() => ConsumeWebServiceSPID(_configuracion.StrURLWebService, strWebServiceXML)) ?? string.Empty;
                    Config.EscribirLog($"INFO|ValidaFIEL|Respuesta del Fiel '{strFiel}' :  {xmlData}", NombreServicio.SPID_FIEL.ToString());
                    Config.EscribirLog($"INFO|ValidaFIEL|Interpretación de la Respuesta", NombreServicio.SPID_FIEL.ToString());



                    List<DValorRegreso> objValores = new List<DValorRegreso>();
                    System.Xml.XmlDocument sysDocumento = new System.Xml.XmlDocument();
                    sysDocumento.LoadXml(xmlData);

                    var elementos = sysDocumento.GetElementsByTagName("return");

                    int intConteo = 0;
                    foreach(System.Xml.XmlNode node in elementos ) 
                    { 
                        string valor = node?.InnerText ?? string.Empty;
                        objValores.Add(new DValorRegreso($"Valor-{intConteo}", valor));
                        intConteo++;
                        
                        //LOG de valores obtenidos.
                        Config.EscribirLog($"INFO|ValidaFIEL|XML VALOR (Valor-{intConteo}) = {valor}", NombreServicio.SPID_FIEL.ToString());

                    }

                    // Actualiza BD via SP
                    bool actualizacionCorrecta = await ActualizaDatosFIELAsync(objValores, fiel, xmlData);

                    if (!actualizacionCorrecta)
                    {
                        Config.EscribirLog( $"ERROR|ValidaFIEL|No fue posible actualizar la información FIEL '{fiel}'.", NombreServicio.SPID_FIEL.ToString());
                        continue;
                    }

                    Config.EscribirLog($"INFO|ValidaFIEL|Termina Validación de FIEL '{fiel}'", NombreServicio.SPID_FIEL.ToString());
                    
                }

                Config.EscribirLog("INFO|ValidaFIEL|Termina Validación de FIEL", NombreServicio.SPID_FIEL.ToString());
            }
            catch (Exception ex)
            {
                Config.EscribirLog($"ERROR|ValidaSpidFiel|Ocurre Excepcion:{ex}", NombreServicio.SPID_FIEL.ToString());
                throw;
            }
        }

        /// <summary>
        /// Envia la infrmacion XML SOAP por una peticion POST
        /// </summary>
        /// <param name="strUrl"></param>
        /// <param name="strXml"></param>
        /// <returns> string </returns>
        private string ConsumeWebServiceSPID(string strUrl, string strXml) 
        {
            string respuestaData = "";

            try 
            {
                ServicePointManager.SecurityProtocol = SecurityProtocolType.Tls12;
                var cookieJar = new System.Net.CookieContainer();
                var encoding = Encoding.UTF8;
                byte[] postByteArray = encoding.GetBytes(strXml ?? "");

                var hwrequest = (System.Net.HttpWebRequest)System.Net.WebRequest.Create(strUrl);
                hwrequest.CookieContainer = cookieJar;
                hwrequest.Accept = "*/*";
                hwrequest.AllowAutoRedirect = true;
                hwrequest.UserAgent = "http_requester/0.1";
                hwrequest.Timeout = 60000;
                hwrequest.Method = "POST";
                hwrequest.ContentType = "text/xml; charset=utf-8";
                hwrequest.ContentLength = postByteArray.Length;

                using ( var postStream = hwrequest.GetRequestStream() ) postStream.Write(postByteArray, 0, postByteArray.Length);
                
                using (var hwresponse = (System.Net.HttpWebResponse)hwrequest.GetResponse() ) 
                    if(hwresponse.StatusCode == System.Net.HttpStatusCode.OK) 
                        using (var responseStream = new System.IO.StreamReader(hwresponse.GetResponseStream())) 
                            respuestaData = responseStream.ReadToEnd();

            }
            catch (Exception ex)
            {
                Config.EscribirLog($"ERROR|ConsumeWebServiceSPID|{ex}", NombreServicio.SPID_FIEL.ToString());
                throw;
            }

            return respuestaData;
        }

        /// <summary>
        /// Actualiza informacion Fiel mediante los valores de regreso.
        /// </summary>
        /// <param name="datos"></param>
        /// <param name="strFiel"></param>
        /// <param name="xmlData"></param>
        /// <returns>bool</returns>
        private async Task<bool> ActualizaDatosFIELAsync(List<DValorRegreso> datos, string strFiel, string xmlData)
        {
            try 
            {
                Config.EscribirLog("INFO|ActualizaDatosFIEL|Actualizando los datos", NombreServicio.SPID_FIEL.ToString());

                string valor0 = StrObtenerValor(datos, "Valor-0");
                string valor1 = StrObtenerValor(datos, "Valor-1");
                string valor5 = StrObtenerValor(datos, "Valor-5");

                var resultado = ValidadorRespuestaFiel.ObtenerResultado(valor0,valor1,valor5);
                string strEstadoConsulta = resultado.EstadoConsulta;

                string strWsRespCodigo = !string.IsNullOrEmpty(valor0) && valor0.Length > 2 ? valor0.Substring(0, 2) : valor0 ?? string.Empty;
                string strRespCodigo = valor0.Length > 2 ? valor0.Substring(0, 2) : valor0;
                string strWsRespMsg = valor1.Length > 250 ? valor1.Substring(0, 250) : valor1;
                string strMensaje = (xmlData ?? string.Empty);
                strMensaje = strMensaje.Length > 250 ? strMensaje.Substring(0, 250) : strMensaje;

                // Campos del SP
                Dictionary<string, object> DParametrosSP = new Dictionary<string, object>()
                {
                    ["@fiel"]= (strFiel ?? string.Empty).Length > 30 ? strFiel.Substring(0, 30) : strFiel ?? string.Empty,
                    ["@fiel_status"]= resultado.FielStatus,
                    ["@estado_consulta"]= strEstadoConsulta.Length > 10 ? strEstadoConsulta.Substring(0, 10): strEstadoConsulta,
                    ["@ws_resp_code"]= strWsRespCodigo,
                    ["@ws_resp_msg"] = strWsRespMsg,
                    ["@resp_code"] = strRespCodigo,
                    ["@message"]= strMensaje
                };

                // Ejecuta el SP de actualizacion de datos
                await EjecutarStoredProceduredNonQuery(ConstantesServicio.sp_Spid_Actualiza_Datos_Fiel, cmd => 
                { 
                    foreach (var parametroSP in DParametrosSP) // Asigna cada parametro con su valro correspondiente de DParametrosSP en la bd
                    {
                        var parametro = new SqlParameter();
                        var key = (parametroSP.Key ?? string.Empty).Trim();
                        object value = parametroSP.Value ?? DBNull.Value;
                        
                        parametro.ParameterName = key;

                        switch(key)
                        {
                            case "@fiel":
                                parametro.SqlDbType = System.Data.SqlDbType.VarChar;
                                parametro.Size = 30;
                                break;
                            case "@fiel_status":
                                parametro.SqlDbType = System.Data.SqlDbType.VarChar;
                                parametro.Size = 15;
                                break;
                            case "@estado_consulta":
                                parametro.SqlDbType = System.Data.SqlDbType.VarChar;
                                parametro.Size = 10;
                                break;
                            case "@ws_resp_code":
                            case "@resp_code":
                                parametro.SqlDbType = System.Data.SqlDbType.VarChar;
                                parametro.Size = 2;
                                break;
                            case "@ws_resp_msg":
                            case "@message":
                                parametro.SqlDbType = System.Data.SqlDbType.VarChar;
                                parametro.Size = 250;
                                break;
                            default:
                                parametro.SqlDbType = System.Data.SqlDbType.VarChar;
                                parametro.Size = 500;
                                break;
                        }
                        parametro.Value = value;
                        cmd.Parameters.Add(parametro);
                    }
                 

                    
                });

                Config.EscribirLog("INFO|ActualizaDatosFIEL|Datos Actualizados", NombreServicio.SPID_FIEL.ToString());
                return true;
            }
            catch ( Exception ex )
            {
                Config.EscribirLog($"ERROR|ActualizaDatosFIELAsync|Ocurre Excepcion:{ex}", NombreServicio.SPID_FIEL.ToString());
                return false;
            }
        }

        /// <summary>
        /// Busca el elemento en una lista y devuelve su valor.
        /// </summary>
        /// <param name="datos"></param>
        /// <param name="key"></param>
        /// <returns> string </returns>
        private static string StrObtenerValor(List<DValorRegreso> datos, string key) =>  datos.FirstOrDefault(strKey => strKey.Key == key)?.Value ?? "";

    }
