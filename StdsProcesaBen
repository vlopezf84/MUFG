Private Function ValidaBeneficiarios(ByRef valoresFormato() As Object, Origen As String, Operacion As String) As Boolean
    Dim lsSQL As String = ""
    Dim liRegs As Integer
    Dim lrsDatos As DbDataReader
    Dim blnAux As Boolean = False

    If Operacion <> "ALTA" Then
        Return True
    End If

    write_Log("INFO|ValidaBeneficiarios|Validando posibles duplicados en CMS")

    Select Case valoresFormato(2)
        Case "FXD", "SPD", "FXT", "SER", "TAX"
            lsSQL = "SELECT ISNULL(COUNT(1),0) CONT FROM beneficiarios WHERE Indicador_Plantilla = 0 AND Formato = '" & valoresFormato(2) & "' AND Id_Cliente = " & valoresFormato(3) & " "
            lsSQL += "AND TipoCuenta = '" & valoresFormato(8) & "' AND NoCuenta = '" & valoresFormato(9) & "'"

