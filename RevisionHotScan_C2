using MUFG_T24.Comunes;
using Aplicacion.Enums;
using Aplicacion.Interfaces;
using System;
using System.Security.Cryptography;
using System.Security.Cryptography.X509Certificates;
using System.Threading.Tasks;

namespace Aplicacion.Utileria
{
    /// <summary>
    /// Clase para generar firma digital
    /// </summary>
    public class CertificadoOperacion : ICertificadoOperacion
    {
        /// <summary>
        /// Metodo para generar firma digital            
        /// </summary>
        /// <param name="byteTramaCompleta"></param>
        /// <param name="strCredencialesCertificado"></param>
        /// <param name="strRutaCertificado"></param>
        /// <returns>string</returns>
        /// <exception cref="Exception"></exception>
        public async Task<string> GeneraFirma(byte[] byteTramaCompleta, string strCredencialesCertificado, string strRutaCertificado)
        {
            string resultBase64 = string.Empty;
            try
            {
                // Ruta certificado y credenciales
                string strDirCertificado = strRutaCertificado;
                string strCredenciales = strCredencialesCertificado;

                Config.EscribirLog("INFO|CertificadoLogic.GenerateSignAsync|strRutaCertificado : ************** " +  NombreServicio.HotScan.ToString());
                Config.EscribirLog("INFO|CertificadoLogic.GenerateSignAsync|strCredencialesCertificado : ************* " +  NombreServicio.HotScan.ToString());

                // Crea coleccion de certificado y se importa el certificado desde el archvio
                X509Certificate2Collection objColecCertificado = new X509Certificate2Collection();
                objColecCertificado.Import(strDirCertificado, strCredenciales, X509KeyStorageFlags.Exportable);

                // Se obtiene primer certificado
                X509Certificate2 certificado = objColecCertificado[0];

                // Proveedor RSA
                RSACryptoServiceProvider objClavePublica = (RSACryptoServiceProvider)certificado.PublicKey.Key;
                RSACryptoServiceProvider objClavePrivada = new RSACryptoServiceProvider();

                // Se carga la clave desde el certificado en XML
                objClavePrivada.FromXmlString(certificado.PrivateKey.ToXmlString(true));
                byte[] arrDatosFirma = byteTramaCompleta;

                // Genera firma usando SHA256
                byte[] arrFirma = await Task.Run(() => objClavePrivada.SignData(arrDatosFirma, CryptoConfig.MapNameToOID(EnumComunes.FirmaSHA256)));

                // Valida la firma usando la clave publica
                bool isValid = objClavePublica.VerifyData(arrDatosFirma, CryptoConfig.MapNameToOID(EnumComunes.FirmaSHA256), arrFirma);

                // Si es valida convierte a Base64
                if (isValid)
                {
                    resultBase64 = Convert.ToBase64String(arrFirma, 0, arrFirma.Length);
                }
            }
            catch (Exception ex)
            {
                Config.EscribirLog("ERROR|GenerateSign|Se presenta exception: " + ex.ToString());
                throw;
            }
            return resultBase64;
        }
    }
}
