        /// <summary>
        /// Obtiene tipo de transaccion del folio
        /// </summary>
        /// <param name="strFolio"></param>
        /// <param name="strTipoOperacion"></param>
        /// <returns>string</returns>
        /// <exception cref="Exception"></exception>
        private async Task<string> ObtenerTipoTransaccionAsync(string strFolio, string strTipoOperacion)
        {
            Config.EscribirLog("INFO|GetTransactionType|Inicia proceso para obtención del transaction type " + strFolio + " " + strTipoOperacion, NombreServicio.HotScan.ToString());

            if (string.IsNullOrEmpty(strTipoOperacion) || string.IsNullOrEmpty(strFolio))
                throw new Exception("El folio/tipo operacion no puede ser vacio.");

            List<string> _ltsOperaciones = new List<string>
            {
                TipoOperacion.FXD_Local,
                TipoOperacion.FXI,
                TipoOperacion.ENT_TEF,
            };

            string _strSubOperacion = string.Empty;

            // Valida que la operacion exista para procesar
            if (!_ltsOperaciones.Contains(strTipoOperacion))
            {
                switch (strTipoOperacion)
                {
                    case TipoOperacion.SPID_Local:
                        _strSubOperacion = EnumSubOperacion.Sin_Com;
                        break;
                    case TipoOperacion.NOM_FXD:
                        _strSubOperacion = EnumSubOperacion.Nom_FXD;
                        break;
                    default:
                        _strSubOperacion = EnumSubOperacion.Com_Envio;
                        break;
                }
            }
            else
            {
                switch (strTipoOperacion)
                {
                    case TipoOperacion.FXD_Local:
                        _strSubOperacion = await OperacionFxdLocal(strFolio);
                        break;
                    case TipoOperacion.FXI:
                        _strSubOperacion = await OperacionFxi(strFolio);
                        break;
                    case TipoOperacion.ENT_TEF:
                        _strSubOperacion = await OperacionEntTef(strFolio);
                        break;
                }
            }

            Config.EscribirLog("INFO|GetTransactionType|Consulta con trx_operacion ='" + strTipoOperacion + "' y  trx_sub_operacion ='" + _strSubOperacion + "'", NombreServicio.HotScan.ToString());

            Parametros strTipoOperacionTrx = await _repositorioTomi.ObtieneTipoTransaccionTrx(strTipoOperacion, _strSubOperacion);

            Config.EscribirLog("INFO|GetTransactionType|Regresa Transaction Type " + strTipoOperacionTrx, NombreServicio.HotScan.ToString());
            return strTipoOperacionTrx?.T24_trx_type;

        }

        /// <summary>
        /// Valida si existe motivo de devolicion
        /// </summary>
        /// <param name="strFolio"></param>
        /// <returns>string</returns>
        private async Task<string> OperacionEntTef(string strFolio)
        {
            // Busca cargo en tomi
            Parametros objParametros = await _repositorioTomi.ObtieneMotivoDevolucionEntTef(strFolio);
            int intMotivoDevolucion = objParametros.MotivoDevolucion;
            Config.EscribirLog("INFO|GetTransactionType|FXI se obtiene el nf_charge = " + intMotivoDevolucion, NombreServicio.HotScan.ToString());

            if (intMotivoDevolucion == 0)
            {
                Config.EscribirLog("INFO|GetTransactionType|ENT_TEF No se detectó motivo de devolución", NombreServicio.HotScan.ToString());
                return EnumSubOperacion.Com_Envio;
            }
            else
            {
                Config.EscribirLog("INFO|GetTransactionType|ENT_TEF Se detectó motivo de devolución " + intMotivoDevolucion, NombreServicio.HotScan.ToString());
                return EnumSubOperacion.Devolucion;
            }
        }

        /// <summary>
        /// Busca cargo FXI en InterfacesT24
        /// </summary>
        /// <param name="strFolio"></param>
        /// <returns></returns>
        private async Task<string> OperacionFxi(string strFolio)
        {
            // Busca cargo en tomi
            Parametros objParametros = await _repositorioTomi.ObtieneCargoFxi(strFolio);
            string strCargo = objParametros.NF_CHARGE;

            Config.EscribirLog("INFO|GetTransactionType|FXI se obtiene el nf_charge = " + strCargo, NombreServicio.HotScan.ToString());

            return strCargo == EnumComunes.TipoCargoBeneficiario
                ? EnumSubOperacion.Sin_Com
                : EnumSubOperacion.Com_Envio;
        }

        /// <summary>
        /// Proceso operacion FXD_Local
        /// Valida si es banco y si existe el folio
        /// Obtiene codigo de cliente para buscarlo en VistasT24
        /// </summary>
        /// <param name="strFolio"></param>
        /// <returns>string</returns>
        private async Task<string> OperacionFxdLocal(string strFolio)
        {
            Parametros objParametros = await _repositorioTomi.ValidacionExisteFolio(strFolio);
            int intExisteFolio = objParametros.RegSwift;

            Config.EscribirLog("INFO|GetTransactionType|Se consultó la tabla SWIFT para saber si el FXD proviene de uno. Resultado " + intExisteFolio, NombreServicio.HotScan.ToString());

            // Consulta codigo cliente
            ClienteFxdLocal objClienteFxd = await _repositorioTomi.ConsultaCodigoClienteFxdLocal(strFolio);
            string strCodigoCliente = BaseDatosHelper.ObtieneTexto(objClienteFxd.T24_CUSTOMER_CODE);
            string strCargoFxd = BaseDatosHelper.ObtieneTexto(objClienteFxd.NF_CHARGE);

            Config.EscribirLog("INFO|GetTransactionType|Datos de customerCode "
                + strCodigoCliente + " y charge " + strCargoFxd, NombreServicio.HotScan.ToString());

            // Valida es banco de VistasT24
            Parametros objParametrosEsBanco = await _repositorioTomi.ValidaEsbancoVistaT24(strCodigoCliente);
            int intEsBanco = objParametrosEsBanco.EsBanco;
            Config.EscribirLog("INFO|GetTransactionType|Resultado para saber si es banco "
                + intEsBanco, NombreServicio.HotScan.ToString());

            // Valida si es banco
            bool boolTieneFolioEsbanco = intExisteFolio > 0 || intEsBanco > 0;
            if (boolTieneFolioEsbanco)
            {
                return (strCargoFxd == EnumComunes.TipoCargoNuestro
                ? EnumSubOperacion.Sin_Com_O
                : EnumSubOperacion.Sin_Com_S);
            }
            else
            {
                return EnumSubOperacion.Com_Envio;
            }
        }

        /// <summary>
        /// Clasifica operaciones segun su origen/canal
        /// </summary>
        /// <param name="strTabla"></param>
        /// <returns>string</returns>
        private string ObtenerCanal(string strTabla)
        {
            if (string.IsNullOrWhiteSpace(strTabla))
                return string.Empty;

            // Divide texto
            string[] arrResultado = strTabla.Split('_');

            if (arrResultado.Length > 0)
            {
                // obtiene ultimo valor
                string strCanal = arrResultado[arrResultado.Length - 1]?.ToUpper();
                if (strCanal == EnumComunes.CanalGPH || strCanal == EnumComunes.CanalH2H)
                    return strCanal;

                if (strCanal == EnumComunes.CanalLocal)
                    return EnumComunes.CanalTomi;
            }
            return string.Empty;
        }
    }
