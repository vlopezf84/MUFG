        /// <summary>
        /// Proceso conversion Tercero a tercero vostro
        /// </summary>
        /// <param name="objOrderPago"></param>
        /// <param name="objConversiones"></param>
        /// <returns>OrdenPago</returns>
        private static OrdenPago TerceroATerceroVostro(OrdenPagoValor objOrderPago, OrdenPago objConversiones)
        {
            byte[] arrayZero = new byte[] { };
            objConversiones.OpFechaOper = ToDateBytes(objOrderPago.OpFechaOper);
            objConversiones.InsClaveOrd = ToIntBytes(objOrderPago.InsClaveOrd);
            objConversiones.InsClaveBen = ToIntBytes(objOrderPago.InsClaveBen);
            objConversiones.OpCveRastreo = objOrderPago.OpCveRastreo.ToString().StringToByteArray(ByteOrder.BIG_ENDIAN);
            objConversiones.OpMonto = ToMoneyBytes(objOrderPago.OpMonto);

            objConversiones.OpCuentaOrd = objOrderPago.OpCuentaOrd.ToString().StringToByteArray(ByteOrder.BIG_ENDIAN);
            objConversiones.OpCuentaBen = objOrderPago.OpCuentaBen.ToString().StringToByteArray(ByteOrder.BIG_ENDIAN);

            objConversiones.OpCuentaBen2 = arrayZero.AddZeroByte();
            objConversiones.TramaCompleta = objConversiones.OpFechaOper
                .Concat(objConversiones.InsClaveOrd)
                .Concat(objConversiones.InsClaveBen)
                .Concat(objConversiones.OpCveRastreo)
                .Concat(objConversiones.OpMonto)
                .Concat(objConversiones.OpCuentaOrd)
                .Concat(objConversiones.OpCuentaBen)
                .Concat(objConversiones.OpCuentaBen2).ToArray();
            return objConversiones;
        }

        /// <summary>
