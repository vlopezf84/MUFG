        /// <summary>
        /// Obtiene los parametros de HotScan
        /// </summary>
        /// <returns>Dictionary<string, string></returns>
        public async Task<Dictionary<string, string>> ObtenerParametrosHotScan()
        {
            List<Parametros> resultadoSp = (await EjecutarStoredProcedureQuery<Parametros>(EnumNombresProcedimientosAlmacenados.usp_ConsultaParametrosHotScan)).Data;

            if (resultadoSp.Count == 0)
            {
                Config.EscribirLog($"ERROR al ejecutar consulta|ObtenerParametrosHotScan");
                throw new Exception("Error al consultar. No se encuentran registros");
            }

            return resultadoSp
                .Where(x => x != null && !string.IsNullOrWhiteSpace(x.Cve_parametro))
                .GroupBy(x => x.Cve_parametro)
                .ToDictionary(
                    x => x.Key,
                    x => x.LastOrDefault()?.Cve_valor ?? string.Empty
                );

        }

        /// <summary>
        /// Obtiene los parametros del sistema necesario para la operacion del servicio, incluye horarios de inicio y finalizacion de operaciones
        /// </summary>
        /// <returns>Dictionary<string, string></returns>
        public async Task<Dictionary<string, string>> ObtenerParametrosSistema()
        {
            var resultadoSp = await EjecutarStoredProcedureQuery<Parametros>(EnumNombresProcedimientosAlmacenados.usp_ConsultaParametrosSistema);
            var datos = resultadoSp.Data;
            if (datos.Count == 0)
            {
                Config.EscribirLog($"ERROR al ejecutar consulta|ObtenerParametrosSistema");
                throw new Exception("Error: no se encontraron datos. No se encuentran registros");
            }

            Dictionary<string, string> diccParametros = new Dictionary<string, string>();
            foreach (Parametros parametro in datos)
            {
                if (diccParametros.ContainsKey(parametro.Id_parametro))
                {
                    Config.EscribirLog($"{ConstantesClaveAviso.Error}|obtenerParametrosSistema|El parámetro '{parametro.Id_parametro}' está duplicado en la base de datos.");
                    continue;
                }

                diccParametros.Add(parametro.Id_parametro, parametro.Valor);
            }
            return diccParametros;
        }

