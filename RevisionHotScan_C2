            LogCampo(EnumComunes.FirmaDigitalOpCuentaBen2, objOrdenPago.OpCuentaBen2);
            LogCampo(EnumComunes.FirmaDigitalOpCuentaOrd, objOrdenPago.OpCuentaOrd);
            LogCampo(EnumComunes.FirmaDigitalOpCveRastreo, objOrdenPago.OpCveRastreo);
            LogCampo(EnumComunes.FirmaDigitalOpFechaOper, objOrdenPago.OpFechaOper);
            LogCampo(EnumComunes.FirmaDigitalOpMonto, objOrdenPago.OpMonto);

            if (objOrdenPago.TramaCompleta != null && objOrdenPago.TramaCompleta.Length > 0)
            {
                Config.EscribirLog("INFO|ComunFXD.GeneraFirmaDigital|La trama armada es " + MuestraTrama(objOrdenPago.TramaCompleta), NombreServicio.HotScan.ToString());
            }
        }

        /// <summary>
        /// Auxiliar para validacion y logging
        /// </summary>
        /// <param name="strNombre"></param>
        /// <param name="arrValor"></param>
        private static void LogCampo(string strNombre, byte[] arrValor)
        {
            // solo logueamos si hay contenido
            if (arrValor != null && arrValor.Length > 0)
            {
                Config.EscribirLog($"INFO|ComunFXD.GeneraFirmaDigital|+{strNombre} {MuestraTrama(arrValor)}", NombreServicio.HotScan.ToString());
            }
        }

        /// <summary>
        /// Convierte arreglo a una representacion en string
        /// </summary>
        /// <param name="arreglo"></param>
        /// <returns></returns>
        private static string MuestraTrama(byte[] arreglo)
        {
            return arreglo == null ? string.Empty : BitConverter.ToString(arreglo);
        }

        /// <summary>
        /// Obtiene Trama
        /// </summary>
        /// <param name="objOrderPagoValor"></param>
        /// <returns>OrdenPago</returns>
        /// <exception cref="Exception"></exception>
        public static OrdenPago ObtieneTrama(OrdenPagoValor objOrderPagoValor)
        {
            OrdenPago objConversiones = new OrdenPago();
            // Conversion tipo pago a entero
            short shortTipoPago = Convert.ToInt16(objOrderPagoValor.TpPago);

            // Log valores originales
            LogValoresEntrada(objOrderPagoValor);

            try
            {
                switch (shortTipoPago)
                {
                    // Devoluciones
                    case 0:
                        Config.EscribirLog("INFO|ComunFXD.ObtieneTrama|Se inicia proceso de conversión de bytes tipo Devolucion", NombreServicio.HotScan.ToString());
                        objConversiones = Devoluciones(objOrderPagoValor, objConversiones);
                        break;
                    // Tercero Tercero
                    case 1:
                        Config.EscribirLog("INFO|ComunFXD.ObtieneTrama|Se inicia proceso de conversión de bytes tipo tercero tercero", NombreServicio.HotScan.ToString());
                        objConversiones = TerceroATercero(objOrderPagoValor, objConversiones);
                        break;
                    // Participante a tercero
                    case 5:
                        Config.EscribirLog("INFO|ComunFXD.ObtieneTrama|Se inicia proceso de conversión de bytes tipo Participante a tercero", NombreServicio.HotScan.ToString());
                        objConversiones = ParticipanteATercero(objOrderPagoValor, objConversiones);
                        break;

                    // Participante a Vostro
                    case 6:
                        Config.EscribirLog("INFO|ComunFXD.ObtieneTrama|Se inicia proceso de conversión de bytes tipo Participante a Vostro", NombreServicio.HotScan.ToString());
                        objConversiones = ParticipanteAVostro(objOrderPagoValor, objConversiones);

                        break;

                    // Participante a Participante
                    case 7:
                        // FechaOperacion + CveInstOrd + CveInstBen + CveRastreo + Monto
                        Config.EscribirLog("INFO|ComunFXD.ObtieneTrama|Se inicia proceso de conversión de bytes tipo Participante a Participante", NombreServicio.HotScan.ToString());
                        objConversiones = ParticipanteAParticipante(objOrderPagoValor, objConversiones);
                        break;

                    // Tercero a Tercero Vostro
                    case 3:
                        // FechaOperacion + CveInstOrd + CveInstBen + CveRastreo + Monto + CuentaOrd + CuentaBen + CuentaBen2
                        Config.EscribirLog("INFO|ComunFXD.ObtieneTrama|Se inicia proceso de conversión de bytes tipo Tercero a Tercero Vostro", NombreServicio.HotScan.ToString());
                        objConversiones = TerceroATerceroVostro(objOrderPagoValor, objConversiones);
                        break;
                    default:
                        throw new Exception("No existe definición para pago SPEI del tipo de pago " + shortTipoPago);
                }
                Trama.LogueoDatosTrama(objConversiones);
            }
            catch (Exception lexError)
            {
                Config.EscribirLog("ERROR|ComunFXD.ObtieneTrama|Se presenta exception: " + lexError.ToString());
                throw;
            }
            return objConversiones;
        }

