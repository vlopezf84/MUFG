                        || strTipoOperacion == TipoOperacion.ENT_SPEI_2 || strTipoOperacion == TipoOperacion.ENT_SPID)
                    {
                        int.TryParse(datosBase.MotivoDevolucion.ToString(), out intMotivoDevolucion);
                    }
                }

                // Actualiza a cancelado
                if (strEstatus == Estatus.RECC.ToString())
                {
                    Config.EscribirLog("INFO|" + strTipoOperacion + ".procesaOperacion|Se ha detectado la cancelación de una operación. ", NombreServicio.HotScan.ToString());
                    return await _repositorioTomi.ActualizaCancelacionOperacionFcm(strFolio, BaseDatosHelper.ObtieneTexto(strFolioUnico));
                }

                if (!boolBanderaEncontrado)
                {
                    Config.EscribirLog("AVISO|Analisis_FCM|No hay datos a verificar, posiblemente el estatus de la tabla de trabajo no tenga el folio o el estatus es diferente al esperado."
                        , NombreServicio.HotScan.ToString());
                    return false;
                }

                // Actualiza con nuevo estatus
                string strNuevoEstatus = string.Empty;
                if (strTipoOperacion.StartsWith(EnumComunes.TipoOpEnt) && intMotivoDevolucion > 0)
                {
                    strNuevoEstatus = EnumComunes.TipoOpCon + strEstatus.Substring(3, 1);
                    Config.EscribirLog("INFO|AnalisisAsync| Transaccion SIN alerta.", NombreServicio.HotScan.ToString());

                    bool boolResultadoEstatus = await _repositorioTomi.ActualizaNuevoEstatus(strFolio, strTablaBase, strNuevoEstatus, strCampo);
                    Config.EscribirLog("INFO|AnalisisAsync|-> Termino de escaneo del folio " + strFolio + ".", NombreServicio.HotScan.ToString());
                    return boolResultadoEstatus;
                }

                // Genera XML
                string strSolicitudXml = GeneraXmlFcm(diccValores, strTipoOperacion);
                Config.EscribirLog("INFO|Analisis_FCM|-> Genera XML Final para tipo='" + strTipoOperacion + "', base='" + strTablaBase + "', folio:" + strFolio + ".", NombreServicio.HotScan.ToString());
               
                if (_configuracion.FcmActivoBtmum)
                {
                    Config.EscribirLog("INFO|Analisis_FCM|-> Inicio Insert a TBL_FCM_INTERCAMBIO, tipo='" + strTipoOperacion + "', base='" +
                        strTablaBase + "', folio:" + strFolio + ".", NombreServicio.HotScan.ToString());

                    try
                    {
                        // Inserta xml y folio en tabla de intercambio
                        StoredProcedureResult objResultadoSp = await _repositorioTomi.InsertaFolioTablaIntercambio(strFolio, strTipoOperacion, strSolicitudXml);
                        Config.EscribirLog("INFO|Analisis_FCM| Pasaron los parametros correctamente e inicia StoreProcedure 'usp_TOMBIN_INSERT_FORMATO_FCM'.", NombreServicio.HotScan.ToString());

                        if (!objResultadoSp.Exito)
                            throw new Exception("Error al ejecutar insercion en SP.");

                        Config.EscribirLog("INFO|Analisis_HotScan| StoreProcedure ejecutado correctamente HotScan_BTMUM.", NombreServicio.HotScan.ToString());
                        Config.EscribirLog("INFO|inserta_intercambio| ID_ENVIO =" + objResultadoSp.UltimoIdRecuperado + ".", NombreServicio.HotScan.ToString());
                    }
                    catch (Exception ex)
                    {
                        Config.EscribirLog("AVISO|inserta_intercambio| Error en la ejecucion del stored procedure BTMUM:" + Environment.NewLine + ex.ToString(), NombreServicio.HotScan.ToString());
                    }

                    // Actualiza folio con nuevo estatus
                    strNuevoEstatus = "HOT" + strEstatus.Substring(3, 1);
                    await _repositorioTomi.ActualizaNuevoEstatus(strFolio, strTablaBase, strNuevoEstatus, strCampo);
                    Config.EscribirLog("INFO|Analisis_FCM|-> Termino de escaneo del folio " + strFolio + ".", NombreServicio.HotScan.ToString());
                }
                else
                {
                    Config.EscribirLog("INFO|Analisis_FCM|-> Desactivado inserción de transaccion FCM por especificacion del usuario (FCM_activo=0).", NombreServicio.HotScan.ToString());
                    strNuevoEstatus = "CON" + strEstatus.Substring(3, 1);
                    await _repositorioTomi.ActualizaNuevoEstatus(strFolio, strTablaBase, strNuevoEstatus, strCampo);
                    Config.EscribirLog("INFO|Analisis_FCM|-> Se continua el proceso sin el escaneo del folio  " + strFolio + ".", NombreServicio.HotScan.ToString());
                }

                await _repositorioTomi.ValidaControlEscaneoHotScan(strFolio, strTipoOperacion, EnumComunes.BanderaAnalizadorF);
                return true;
            }
            catch (Exception ex)
            {
                Config.EscribirLog("ERROR|Analisis_SentinelFCM|Error en la ejecución del folio " + strFolio + ", excepción: " + ex.ToString(), NombreServicio.HotScan.ToString());

                // Datos del Proceso
                await _repositorioTomi.InsertaAlerta(new MUFG_T24.Modelos.AlertaDTO
                {
                    Folio = strFolio,
                    TipoOPeracion = strTipoOperacion,
                    Servicio = NombreServicio.HotScan.ToString(),
                    ClaveAviso = EnumComunes.CLAVE_AVISO_CRITICO,
                    Descipcion = ex.Message,
                    PId = (int)_configuracion.Pid,
                    NombreProceso = _configuracion.NombreProceso,
                    Exception = ex
                });
            }
            return false;
        }
        
        /// <summary>
        /// Genera un XML de solicitud de escaneo para FCM (Formato de Comunicaciones Monetarias)
        /// </summary>
        /// <param name="diccValores"></param>
        /// <param name="strTipoOperacion"></param>
        /// <returns></returns>
        private string GeneraXmlFcm(Dictionary<string, object> diccValores, string strTipoOperacion)
        {
            // Almacena en memoria el xml
            using (MemoryStream flujoMemoria = new MemoryStream())
            {
                XmlWriterSettings configuracion = new XmlWriterSettings()
                {
                    Encoding = Encoding.UTF8,
                    Indent = true,
                };

                // Se crea el escritor xml
                using (XmlWriter escritor = XmlWriter.Create(flujoMemoria, configuracion))
                {
                    // Obtiene el tipo de mensaje y el subtipo de mensaje según el tipo de operación
                    string strTipoMensaje = ObtenerTipoMensaje(strTipoOperacion);
                    string strSubTipoMensaje = ObtenerSubTipoMensaje(strTipoOperacion);


                    // Funcion auxiliar para obtener los valores del diccionario de forma segura
                    Func<string, string> funcObtenerValor = clave =>
                        diccValores.ContainsKey(clave) && diccValores[clave] != null
                        ? diccValores[clave].ToString()
                        : string.Empty;

                    // Inicio del documento xml
                    escritor.WriteStartDocument();

                    // Escribe el encabezado del XML
                    escritor.WriteStartElement(EnumConstantesXml.ElementoRaiz);
                    escritor.WriteAttributeString(EnumConstantesXml.NombreAtributoVersion, EnumConstantesXml.ValorAtributoVersion);

                    // Escribe los elementos del XML con los valores proporcionados
                    escritor.WriteElementString(
                        EnumConstantesXml.ElementoMonto, funcObtenerValor(EnumConstantesXml.ClaveMonto).ToString());

                    escritor.WriteElementString(
                        EnumConstantesXml.ElementoIdAplicacion, ObtenerAplicacionId(funcObtenerValor(EnumConstantesXml.ClaveIdAplicacion).ToString()));

                    escritor.WriteElementString(
                        EnumConstantesXml.ElementoCodigoArea, EnumConstantesXml.ValorCodigoArea);

                    escritor.WriteElementString(
                        EnumConstantesXml.ElementoIdBroker, string.Empty);

                    escritor.WriteElementString(
                        EnumConstantesXml.ElementoCentroCosto, string.Empty);

                    escritor.WriteElementString(
                        EnumConstantesXml.ElementoDireccion,
                        strTipoOperacion.StartsWith(EnumConstantesXml.PrefijoEntrada)
                            ? EnumConstantesXml.ValorDireccionEntrada
                            : EnumConstantesXml.ValorDireccionSalida);

                    escritor.WriteElementString(
                        EnumConstantesXml.ElementoMoneda, funcObtenerValor(EnumConstantesXml.ClaveMoneda).ToString());

                    escritor.WriteElementString(
                        EnumConstantesXml.ElementoGateway, ObtenerSubTipo(strTipoOperacion));

                    escritor.WriteElementString(
                        EnumConstantesXml.ElementoId, funcObtenerValor(EnumConstantesXml.ClaveId).ToString());

                    escritor.WriteElementString(
                        EnumConstantesXml.ElementoMandante, EnumConstantesXml.ValorMandante);

                    escritor.WriteElementString(
                        EnumConstantesXml.ElementoFormatoMensaje, EnumConstantesXml.ValorFormatoMensaje);

                    escritor.WriteElementString(
                        EnumConstantesXml.ElementoSubtipoMensaje, strSubTipoMensaje);

                    escritor.WriteElementString(
                        EnumConstantesXml.ElementoTipoMensaje, strTipoMensaje);

                    escritor.WriteElementString(
                        EnumConstantesXml.ElementoPrioridad, EnumConstantesXml.ValorPrioridadUrgente);

                    escritor.WriteElementString(
                        EnumConstantesXml.ElementoFechaSolicitud, DateTime.Now.ToString(EnumConstantesXml.FormatoFechaRoundTrip));

                    escritor.WriteElementString(
                        EnumConstantesXml.ElementoTipoRiesgo, EnumConstantesXml.ValorTipoRiesgo);

                    escritor.WriteElementString(
                        EnumConstantesXml.ElementoNumeroTransaccion, funcObtenerValor(EnumConstantesXml.ClaveNumeroTransaccion).ToString());

                    escritor.WriteElementString(
                        EnumConstantesXml.ElementoReceptor, EnumConstantesXml.ValorVacio);

                    escritor.WriteElementString(
                        EnumConstantesXml.ElementoEmisor, EnumConstantesXml.ValorVacio);

                    escritor.WriteElementString(
                        EnumConstantesXml.ElementoFechaValor, funcObtenerValor(EnumConstantesXml.ClaveFechaValor).ToString());

                    escritor.WriteElementString(
                        EnumConstantesXml.ElementoIdZona, EnumConstantesXml.ValorIdZona);

                    // Construccion del contenido del payload (XML escapado)
                    string contenidoXml =
                         "<XML>" +
                             "<" + strTipoMensaje + ">" +
                                 "<folio>" + funcObtenerValor("ID") + "</folio>" +
                                 "<tipo_operacion>" + strTipoOperacion + "</tipo_operacion>" +
                                 "<folio_unico>" + funcObtenerValor("TRANSACTION_NUMBER") + "</folio_unico>" +
                                 "<ordenante>" + funcObtenerValor("SENDER") + "</ordenante>" +
                                 "<beneficiario>" + funcObtenerValor("RECEIVER") + "</beneficiario>" +
                                 "<concepto>" + funcObtenerValor("CONCEPT") + "</concepto>" +
                                 "</" + strTipoMensaje + ">" +
                         "</XML>";

                    XmlDocument doc;
                    string error;

                    if (!XmlHelper.TryParseXmlSeguro(contenidoXml, out doc, out error))
                    {
                        Config.EscribirLog("ERROR|XML|XML inválido: " + error);
                        throw new Exception("ERROR|XML|XML inválido: " + error);
                    }

                    // Nodo con CDATA
                    escritor.WriteStartElement(EnumConstantesXml.ElementoPayload);
                    escritor.WriteCData(contenidoXml);
                    escritor.WriteEndElement(); //playload

                    // Cierra el elemento raíz del XML y vacía el contenido del writer
                    escritor.WriteEndElement(); //scan_request
                    escritor.WriteEndDocument();
                    escritor.Flush();
                }
                // Convierte el MemoryStream a una cadena de texto
                flujoMemoria.Position = 0;
                using (StreamReader reader = new StreamReader(flujoMemoria, Encoding.UTF8))
                {
                    return reader.ReadToEnd();
                }
            }
        }

        /// <summary>
        /// Determina el tipo de gateway asociado a un tipo de operación específico.
        /// </summary>
        /// <param name="strTipoOperacion">El tipo de operación para el cual se debe determinar el gateway.</param>
        /// <returns>El tipo de gateway como una cadena de texto.</returns>
        public string ObtenerSubTipo(string strTipoOperacion)
        {
            if (string.IsNullOrWhiteSpace(strTipoOperacion))
                throw new Exception("Error: tipo de operacion no puede ser null");

            Dictionary<string, string> mapeadorOperacion = new Dictionary<string, string>()
            {
                // Si la operación es una entrada de SPID, TEF, SPEI o SPEI_2, el gateway es "ENT"
                { TipoOperacion.ENT_SPID, EnumComunes.SubTipoOperacionENT },
                { TipoOperacion.ENT_TEF, EnumComunes.SubTipoOperacionENT },
                { TipoOperacion.ENT_SPEI, EnumComunes.SubTipoOperacionENT },
                { TipoOperacion.ENT_SPEI_2, EnumComunes.SubTipoOperacionENT },

                // Si la operación es una de CMS (FXD, SPID, TEF, PaP_TEF, PaP_SPID, PaP_FXD, NOM_FXD, SER, TAX), el gateway es "CMS"
                { TipoOperacion.FXD, TipoOperacion.CMS },
                { TipoOperacion.SPID, TipoOperacion.CMS },
                { TipoOperacion.TEF, TipoOperacion.CMS },
                { TipoOperacion.PaP_TEF, TipoOperacion.CMS },
                { TipoOperacion.PaP_SPID, TipoOperacion.CMS },
                { TipoOperacion.PaP_FXD, TipoOperacion.CMS },
                { TipoOperacion.NOM_FXD, TipoOperacion.CMS },
                { TipoOperacion.SER, TipoOperacion.CMS },
                { TipoOperacion.TAX, TipoOperacion.CMS },

                // Si la operación es una operación local de SPID o FXD, el gateway es "MW"
                { TipoOperacion.SPID_Local, EnumComunes.SubTipoOperacionMW },
                { TipoOperacion.FXD_Local, EnumComunes.SubTipoOperacionMW },

                // Si la operación es una operación de GPH (SPID_GPH, TEF_GPH, FXD_GPH), el gateway es "GPH"
                { TipoOperacion.SPID_GPH, EnumComunes.SubTipoOperacionGPH },
                { TipoOperacion.TEF_GPH, EnumComunes.SubTipoOperacionGPH },
                { TipoOperacion.FXD_GPH, EnumComunes.SubTipoOperacionGPH },

                // Si la operación es una operación de H2H (SPID_H2H, TEF_H2H, FXD_H2H), el gateway es "H2H"
                { TipoOperacion.SPID_H2H, EnumComunes.SubTipoOperacionH2H },
                { TipoOperacion.TEF_H2H, EnumComunes.SubTipoOperacionH2H },
                { TipoOperacion.FXD_H2H, EnumComunes.SubTipoOperacionH2H },
            };

            return mapeadorOperacion.TryGetValue(strTipoOperacion, out string puertaSalida)
                ? puertaSalida
                : TipoOperacion.FT;
        }

