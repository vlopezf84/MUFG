using Aplicacion.Enums;
using Aplicacion.Interfaces;
using Aplicacion.Modelos;
using Aplicacion.Utileria;
using MUFG_T24.Comunes;
using Newtonsoft.Json;
using System;
using System.Linq;
using System.Net.Http;
using System.Net.Http.Headers;
using System.Text;
using System.Threading;
using System.Threading.Tasks;

namespace Aplicacion.Servicios
{
    /// <summary>
    /// Clase para enviode token y envio por HTTP POST
    /// </summary>
    public class ClienteConectorUt: IClienteConectorUt
    {
        private readonly IRepositorioTomi _repositorioTomi;
        private string _usuarioConectorUt;
        private string _ContrasenaConectorUt;

        private readonly HttpClient _httpClient;

        private readonly SemaphoreSlim _semaforoInicializacion = new SemaphoreSlim(1, 1);
        private bool _configuracionIniciada;

        /// <summary>
        /// Controlador.
        /// </summary>
        public ClienteConectorUt(IRepositorioTomi repositorioTomi)
        {
            _repositorioTomi = repositorioTomi;
            _httpClient = new HttpClient();
        }

        /// <summary>
        /// Obtiene token y envia solicitud conector por HTTP
        /// </summary>
        /// <param name="objRespuestaConector"></param>
        /// <returns>RespuestaConectorUt</returns>
        public async Task<RespuestaConectorUt> EnviarConectorUt(SolicitudConectorUt objRespuestaConector)
        {
            RespuestaConectorUt objRespuestaConectorUt = null;
            try
            {
                await InicializarConfiguracionAsync();

                // Serializa solicitud
                string objSolicitudJson = JsonConvert.SerializeObject(objRespuestaConector);

                // Convierte json a bytes
                Config.EscribirLog("INFO|SendUTConector|Inicia envío UTConector con request: ************** con folio: " + objRespuestaConector.Folio, NombreServicio.HotScan.ToString());
                byte[] arrSolicitud = Encoding.UTF8.GetBytes(objSolicitudJson);
                
                string url = (await _repositorioTomi.ObtenerConfiguracionGeneralHotScan(EnumComunes.CampoDireccionBaseConectorUt))?.FirstOrDefault()?.Valor + EnumComunes.ValidaPuertaSentinel;

                Config.EscribirLog("INFO|SendUTConector| CREDENCIALES UT CARGADAS " + NombreServicio.HotScan.ToString());
                Config.EscribirLog("INFO|SendUTConector|URL_API: " + url, NombreServicio.HotScan.ToString());

                // Obtiene token
                RespuestaAutenticacionConectorUt objToken = await ObtieneTokenAutorizacion(objRespuestaConector.Folio);

                // Valida que exista token
                if (objToken == null)
                {
                    Config.EscribirLog("Error|SendUTConector|GetAndValidateAuthorizationToken| " +
                        "La respuesta del servicio de autenticación es nula", NombreServicio.HotScan.ToString());
                    throw new Exception("No se recibió respuesta del servicio de autenticación");
                }
                if (string.IsNullOrWhiteSpace(objToken.Token))
                {
                    Config.EscribirLog($"Error|SendUTConector|GetAndValidateAuthorizationToken| Token vacío. Respuesta completa: " +
                        $"{JsonConvert.SerializeObject(objToken)}", NombreServicio.HotScan.ToString());
                    throw new Exception("El servicio de autenticación no devolvió un token válido");
                }

                Config.EscribirLog("INFO|SendUTConector|tokenResult.Token: " + objToken.Token, NombreServicio.HotScan.ToString());
                // Crea peticion post http
                HttpResponseMessage objRespuestaCliente = null;

                using (var request = new HttpRequestMessage(HttpMethod.Post, url))
                {
                    request.Headers.Authorization = new AuthenticationHeaderValue(EnumComunes.EsquemaToken, objToken.Token);
                    request.Content = new ByteArrayContent(arrSolicitud);
                    request.Content.Headers.ContentType = new MediaTypeHeaderValue("application/json");

                    objRespuestaCliente = await _httpClient.SendAsync(request);
                }
                
                // Valida respuesta
                if (objRespuestaCliente != null && objRespuestaCliente.StatusCode == System.Net.HttpStatusCode.OK && objRespuestaCliente.Content != null)
                {
                    Config.EscribirLog("INFO|SendUTConector|response.StatusCode: " + objRespuestaCliente.StatusCode, NombreServicio.HotScan.ToString());
                    
                    var responseContent = await objRespuestaCliente.Content.ReadAsStringAsync();
                    objRespuestaConectorUt = JsonConvert.DeserializeObject<RespuestaConectorUt>(responseContent);

                    if (objRespuestaConectorUt != null)
                    {
                        Config.EscribirLog("INFO|SendUTConector|result.ToString(): "+ objRespuestaConectorUt,NombreServicio.HotScan.ToString());

                        Config.EscribirLog("INFO|SendUTConector|result.Description: "+ objRespuestaConectorUt.Description,NombreServicio.HotScan.ToString());

                        Config.EscribirLog("INFO|SendUTConector|result.Folio: "+ objRespuestaConectorUt.Folio,NombreServicio.HotScan.ToString());
                    }

                    Config.EscribirLog("INFO|SendUTConector|response.Content.ReadAsStringAsync: " + responseContent, NombreServicio.HotScan.ToString());
                }

                Config.EscribirLog("INFO|SendUTConector|Termina envío UTConector con response: " + objRespuestaCliente.Content + " con folio: " + objRespuestaConector.Folio, NombreServicio.HotScan.ToString());
            }
            catch (Exception ex)
            {
                Config.EscribirLog("Error|SendUTConector|Exception: " + ex.Message, NombreServicio.HotScan.ToString());
                throw;
            }
            return objRespuestaConectorUt;
        }

        /// <summary>
        /// Obtiene el token de autorizacion desde el conector UT
        /// </summary>
        /// <param name="folio"></param>
        /// <returns>RespuestaAutenticacionConectorUt</returns>
        private async Task<RespuestaAutenticacionConectorUt> ObtieneTokenAutorizacion(long folio)
        {
            RespuestaAutenticacionConectorUt objRespuestaAutenticacion = null;
            try
            {
                // Carga credenciales
                string strSolicitud = JsonConvert.SerializeObject(new SolicitudAutenticacionConectorUt
                {
                    UserName = _usuarioConectorUt,
                    Password = _ContrasenaConectorUt
                });

                Config.EscribirLog("INFO|GetAuthorizationToken|Inicia solicitud de token de autorización con folio: " + folio, NombreServicio.HotScan.ToString());
                Config.EscribirLog("INFO|GetAuthorizationToken|URLAPI Authenticate: " +
                    (await _repositorioTomi.ObtenerConfiguracionGeneralHotScan(EnumComunes.CampoDireccionBaseConectorUt))?
                    .FirstOrDefault()?.Valor + EnumComunes.Autenticar, NombreServicio.HotScan.ToString());

                // Convierte el json a bytes
                byte[] arrSolicitud = Encoding.UTF8.GetBytes(strSolicitud);
                

                // Carga direccion
                string strDireccionBase = (await _repositorioTomi.ObtenerConfiguracionGeneralHotScan(EnumComunes.CampoDireccionBaseConectorUt))?
                    .FirstOrDefault()?.Valor;

                // Valida que exista url
                if (string.IsNullOrWhiteSpace(strDireccionBase))
                {
                    throw new Exception("La configuración UTConnectorBaseAdress no está definida");
                }

                // Crea peticion post http
                HttpResponseMessage objRespuestaMsj = null;
                using (var request = new HttpRequestMessage(HttpMethod.Post, strDireccionBase + EnumComunes.Autenticar))
                {
                    request.Content = new ByteArrayContent(arrSolicitud);
                    request.Content.Headers.ContentType = new MediaTypeHeaderValue("application/json");
                    objRespuestaMsj = await _httpClient.SendAsync(request);
                }

                // Valida respuesta
                if (objRespuestaMsj != null && objRespuestaMsj.StatusCode == System.Net.HttpStatusCode.OK && objRespuestaMsj.Content != null)
                {
                    objRespuestaAutenticacion = JsonConvert.DeserializeObject<RespuestaAutenticacionConectorUt>(await objRespuestaMsj.Content.ReadAsStringAsync());
                }

                Config.EscribirLog("INFO|GetAuthorizationToken|Termina solicitud de token de autorización con response: " +
                    objRespuestaMsj?.Content + " con folio: " + folio, NombreServicio.HotScan.ToString());
            }
            catch (Exception ex)
            {
                Config.EscribirLog("Error|GetAuthorizationToken|Exception: " + ex.Message, NombreServicio.HotScan.ToString());
                throw;
            }
            return objRespuestaAutenticacion;
        }

        /// <summary>
        /// Se inicializa la configuracion de usuario y contrasena UT.
        /// </summary>
        /// <returns></returns>
        private async Task InicializarConfiguracionAsync()
        {
            if (_configuracionIniciada) return;

            await _semaforoInicializacion.WaitAsync();

            try
            {
                if (_configuracionIniciada) return;
                var usuario  = await _repositorioTomi.ObtenerConfiguracionGeneralHotScan(EnumComunes.CampoUsuarioConectorUt);
                var contrasena  = await _repositorioTomi.ObtenerConfiguracionGeneralHotScan(EnumComunes.CampoContrasenaConectorUt);

                _usuarioConectorUt = GeneraSha256Hex.Sha256Hex(usuario?.FirstOrDefault()?.Valor);
                _ContrasenaConectorUt = GeneraSha256Hex.Sha256Hex(contrasena?.FirstOrDefault()?.Valor);

                _configuracionIniciada = true;
            }
            finally
            {
                _semaforoInicializacion.Release();
            }
        }
    }
}

