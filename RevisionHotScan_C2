using Aplicacion.Enums;
using Aplicacion.Interfaces;
using Aplicacion.Modelos;
using Aplicacion.Modelos.Tomi;
using MUFG_T24.Comunes;
using MUFG_T24.Interfaces_utilidades;
using MUFG_T24.Enums_utilidades;
using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading;
using System.Threading.Tasks;

namespace Aplicacion.Servicios
{
    /// <summary>
    /// Ejecuta analizis de operaciones
    /// </summary>
    public class LogicaOrquestador : IOrquestador
    {
        private readonly IRepositorioTomi _repositorioTomi;
        private readonly Dictionary<Analizador, IAnalizador> _analizers;
        private readonly ConfiguracionServicio _configuracion;

        private readonly IControlServicio _controlServicio;

        private int _activationTimeInMin;
        private bool _automaticDesactivation;
        private bool _automaticActivation;

        private readonly SemaphoreSlim _semaforoInicializacion = new SemaphoreSlim(1, 1);
        private bool _configuracionIniciada;

        /// <summary>
        /// Controlador.
        /// </summary>
        public LogicaOrquestador(IRepositorioTomi repositorioTomi, ConfiguracionServicio configuracion, IControlServicio controlServicio, LogicaUtc logicaUtc, LogicaFcm logicaFcm)
        {
            _configuracion = configuracion;
            _repositorioTomi = repositorioTomi;
            _analizers = new Dictionary<Analizador, IAnalizador>()
            {
                { Analizador.FCMConnector, logicaFcm },
                { Analizador.UTConnector, logicaUtc }
            };

            _controlServicio = controlServicio;
        }

        /// <summary>
        /// Actualiza estatus del plan maestro y agrega operacion a pila de tareas
        /// </summary>
        /// <param name="strTipoOperacion"></param>
        /// <param name="strFolio"></param>
        /// <param name="strTablaBase"></param>
        /// <returns>RespuestaOrquestador</returns>
        public async Task<RespuestaOrquestador> EjecutaAnalizadoresAsync(
            string strTipoOperacion, string strFolio, string strTablaBase)
        {
            RespuestaOrquestador resultado = new RespuestaOrquestador();
            string strFechaEjecucion = string.Empty;
            string strFechaTomi = _configuracion.FechaSistema;
            bool boolExitoActualizacion;

            try
            {

                await InicializarConfiguracionAsync();

                //Obtener fecha de ejecucion para validaciones de fecha
                Parametros objParametros = await _repositorioTomi.ObtenerFechaEjecucion(strFolio, strTipoOperacion);
                if (objParametros?.NF_FECHA_EJECUCION == null)
                    throw new Exception($"No se recuperó NF_FECHA_EJECUCION para folio '{strFolio}' y tipo operación '{strTipoOperacion}'.");

                strFechaEjecucion = objParametros.NF_FECHA_EJECUCION.ToString();

                Config.EscribirLog("INFO|ExecuteAnalizersAsync| lsFechaEjecucion: " + strFechaEjecucion, NombreServicio.HotScan.ToString());
                Config.EscribirLog("INFO|ExecuteAnalizersAsync| _gsFechaSistema: " + strFechaTomi, NombreServicio.HotScan.ToString());


                if (!int.TryParse(strFechaEjecucion, out int resultStrFechaEjecucion)) throw new FormatException($"Fecha de ejecución inválida: '{strFechaEjecucion}'.");
                if (!int.TryParse(strFechaTomi, out int resultStrFechaTomi)) throw new FormatException($"Fecha sistema inválida: '{strFechaTomi}'.");


                if (resultStrFechaEjecucion < resultStrFechaTomi)
                {
                    if (!long.TryParse(strFolio, out long folio)) throw new FormatException($"Folio inválido: '{strFolio}'.");

                    await _controlServicio.MarcarErrorFechaPasada(folio);
                    throw new Exception($"Se desea realizar una operación al {strFechaEjecucion} cuando la fecha del sistema es {strFechaTomi}.");
                }

                bool lbFechaFutura = resultStrFechaEjecucion > resultStrFechaTomi;

                // Actualiza plan de trabajo
                if (lbFechaFutura)
                {
                    Config.EscribirLog("AVISO|ExecuteAnalizersAsync|La operacion es fecha futura.", NombreServicio.HotScan.ToString());
                    boolExitoActualizacion = await _repositorioTomi.ActualizaPlanTrabajoMaestro(new AplicacionHotScan.DTOs.PlanTrabajoMaestroDto
                    {
                        TipoActualizacion = 7,
                        NuevoEstatus = string.Empty,
                        Folio = strFolio,
                        FolioMaestro = strFolio,
                        TipoOperacion = strTipoOperacion,
                        EstatusFiltro = EnumComunes.FECHA_FUTURA,
                        NumeroEstatusEspcial = 0,
                        DescripcionError = string.Empty,
                        FechaValor = strFechaEjecucion,
                        BanderaTerminado = false,
                        BanderaCancelado = false
                    });

                    if (boolExitoActualizacion)
                    {
                        resultado.Success = false;
                        return resultado;
                    }
                }
                else
                {
                    await _repositorioTomi.ActualizaPlanTrabajoMaestro(new AplicacionHotScan.DTOs.PlanTrabajoMaestroDto
                    {
                        TipoActualizacion = 7,
                        NuevoEstatus = string.Empty,
                        Folio = strFolio,
                        FolioMaestro = strFolio,
                        TipoOperacion = strTipoOperacion,
                        EstatusFiltro = EnumComunes.HOTSCAN,
                        NumeroEstatusEspcial = 0,
                        DescripcionError = string.Empty,
                        FechaValor = strFechaEjecucion,
                        BanderaTerminado = false,
                        BanderaCancelado = false

                    });
                }

                // Obtenemos las banderas de los screenings de FCM y Sentinel
                ControlEscaneoHotScan controlEscaneoHs = (await _repositorioTomi
                    .ObtenerControlEscaneoHotScan(strFolio, strTipoOperacion))
                    .FirstOrDefault();

                // Obtenemos la configuración de los analizadores
                List<ConfiguracionAnalizadorConector> objConfigAnalizador = await _repositorioTomi.ObtenerConfiguracionAnalizadorHotScan();

                if (objConfigAnalizador?.Count > 0)
                {
                    // Lista para tareas asincrónicas
                    List<Task<bool>> tareas = new List<Task<bool>>();

                    foreach (ConfiguracionAnalizadorConector configConector in objConfigAnalizador)
                    {
                        if (_analizers.ContainsKey((Analizador)configConector.Id))
                        {
                            // Verifica si la bandera correspondiente está activa
                            bool isScreeningActive =
                                (configConector.Id == (int)Analizador.FCMConnector && (!controlEscaneoHs?.Flg_FCM ?? true)) ||
                                (configConector.Id == (int)Analizador.UTConnector && (!controlEscaneoHs?.Flg_Sentinel ?? true));

                            // Si no está activo, salta este analizador
                            if (!isScreeningActive) continue;

                            // La validación del FCM no aplica para SWIFT
                            if (configConector.Id == (int)Analizador.FCMConnector && strTipoOperacion.Contains(TipoOperacion.FXI)) continue;

                            switch ((EstatusAnalizador)configConector.Estatus)
                            {
                                case EstatusAnalizador.Activo:
                                    // Agrega la tarea a la lista
                                    Config.EscribirLog("INFO|ExecuteAnalizersAsync| Analizador " + configConector.Descripcion + " activo. Se coloca en la pila de tareas", NombreServicio.HotScan.ToString());
                                    tareas.Add(MetodoAnalizador(configConector.Id, strTipoOperacion, strFolio, strTablaBase));
                                    break;

                                case EstatusAnalizador.ApagadoAutomatico:
                                    // Lógica de reactivación automática después de cierto tiempo
                                    if (_automaticActivation && configConector.FechaModificacion.AddMinutes(_activationTimeInMin) < DateTime.Now)
                                    {
                                        await _repositorioTomi.ActivaAnalizadorHotScan(configConector.Id);
                                        tareas.Add(MetodoAnalizador(configConector.Id, strTipoOperacion, strFolio, strTablaBase));
                                    }
                                    break;

                                case EstatusAnalizador.Apagado:
                                default:
                                    Config.EscribirLog("INFO|ExecuteAnalizersAsync| Analizador " + configConector.Descripcion + " apagado", NombreServicio.HotScan.ToString());
                                    break;
                            }
                        }
                    }

                    if (tareas.Count > 0)
                    {
                        Config.EscribirLog("INFO|ExecuteAnalizersAsync| tasks.Count > 0: " + tareas.Count.ToString(), NombreServicio.HotScan.ToString());
                        // Ejecutar todas las tareas y esperar su finalización
                        bool[] arrBoolTareas = await Task.WhenAll(tareas);
                        Config.EscribirLog("INFO|ExecuteAnalizersAsync| taskResults.Length: " + arrBoolTareas.Length.ToString(), NombreServicio.HotScan.ToString());
                        // Combina los resultados con un AND lógico
                        resultado.Success = arrBoolTareas.All(r => r);
                        Config.EscribirLog("INFO|ExecuteAnalizersAsync| taskResults.All(r => r): " + resultado.Success.ToString(), NombreServicio.HotScan.ToString());
                    }
                    else
                    {
                        Config.EscribirLog("INFO|ExecuteAnalizersAsync| tasks.Count <= 0", NombreServicio.HotScan.ToString());
                        resultado.Success = true;
                    }
                }
            }
            catch (Exception ex)
            {
                // Manejo de excepciones (log o rethrow, según aplique)
                Config.EscribirLog($"ERROR|ExecuteAnalizersAsync| {ex.Message}", NombreServicio.HotScan.ToString());
                resultado.Success = false;
            }

            // Log final de resultado
            Config.EscribirLog("INFO|ExecuteAnalizersAsync| result.Success: " + resultado.Success.ToString(), NombreServicio.HotScan.ToString());
            return resultado;
        }

        /// <summary>
        /// Analiza operaciones y obtiene datos del proceso
        /// </summary>
        /// <param name="id"></param>
        /// <param name="strTipoOperacion"></param>
        /// <param name="strFolio"></param>
        /// <param name="strTablaBase"></param>
        /// <returns></returns>
        private async Task<bool> MetodoAnalizador(int id, string strTipoOperacion, string strFolio, string strTablaBase)
        {
            bool result = false;
            try
            {
                // Datos del Proceso
                result = await _analizers[(Analizador)id].AnalisisOperacion(strTipoOperacion, strFolio, strTablaBase);
                Config.EscribirLog("INFO|Analize| GetType: " + _analizers[(Analizador)id].GetType() + "| result: " + result.ToString(), NombreServicio.HotScan.ToString());
            }
            catch (Exception ex)
            {
                Config.EscribirLog("ERROR|Analize| Exception: " + ex.Message, NombreServicio.HotScan.ToString());
                if (_automaticDesactivation)
                {
                    await _repositorioTomi.DesactivaAnalizadorHotScan(id);
                }
            }
            return result;
        }

        /// <summary>
        /// Inicializa la configuracion del orquestador.
        /// </summary>
        /// <returns></returns>
        private async Task InicializarConfiguracionAsync()
        {

            if (_configuracionIniciada) return;

            await _semaforoInicializacion.WaitAsync();

            try
            {
                if (_configuracionIniciada) return;

                ConfiguracionGeneral objDesactivacionAutomatica = (await _repositorioTomi.ObtenerConfiguracionGeneralHotScan(ConstantesParametrosSistema.AnalizerAutomaticShutdown))?.FirstOrDefault();
                ConfiguracionGeneral objReactivacionAutomatica = (await _repositorioTomi.ObtenerConfiguracionGeneralHotScan(ConstantesParametrosSistema.AnalizerAutomaticReactivation))?.FirstOrDefault();
                ConfiguracionGeneral objTiempoReactivacion = (await _repositorioTomi.ObtenerConfiguracionGeneralHotScan(ConstantesParametrosSistema.AnalizerAutomaticReactivationTimeSec))?.FirstOrDefault();

                int.TryParse(objTiempoReactivacion?.Valor, out _activationTimeInMin);

                _automaticDesactivation = int.TryParse(objDesactivacionAutomatica?.Valor, out int resultAutomaticDesactivation) && resultAutomaticDesactivation == 1;
                _automaticActivation = int.TryParse(objReactivacionAutomatica?.Valor, out int resultAutomaticActive) && resultAutomaticActive == 1;


                _configuracionIniciada = true;
            }
            finally
            {
                _semaforoInicializacion.Release();
            }
        }
    }
}

