                .Concat(objConversiones.OpCuentaBen).ToArray();
            return objConversiones;
        }

        /// <summary>
        /// Proceso conversion Devoluciones
        /// FechaOperacion + CveInstOrd + CveInstBen + CveRastreo + Monto
        /// </summary>
        /// <param name="objOrderPago"></param>
        /// <param name="objConversiones"></param>
        /// <returns>OrdenPago</returns>
        private static OrdenPago Devoluciones(OrdenPagoValor objOrderPago, OrdenPago objConversiones)
        {
            objConversiones.OpFechaOper = ToDateBytes(objOrderPago.OpFechaOper);
            objConversiones.InsClaveOrd = ToIntBytes(objOrderPago.InsClaveOrd);
            objConversiones.InsClaveBen = ToIntBytes(objOrderPago.InsClaveBen);
