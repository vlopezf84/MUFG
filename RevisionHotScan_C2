using Aplicacion.Modelos.Tomi;
using System;
using System.Collections.Generic;
using System.Threading.Tasks;

namespace Aplicacion.Servicios
{
    /// <summary>
    /// Obtiene cargo y tipo de operacion, motivo de devolucion para procesar analizis de operacion
    /// </summary>
    public class LogicaUtc : IAnalizador
    {
        private readonly IRepositorioTomi _repositorioTomi;
        private readonly IClienteConectorUt _clienteConector;
        private readonly ConfiguracionServicio _configuracion;

        /// <summary>
        /// Controlador.
        /// </summary>
        /// <param name="repositorioTomi"></param>
        /// <param name="clienteConector"></param>
        /// <param name="configuracion"></param>
        public LogicaUtc(IRepositorioTomi repositorioTomi, IClienteConectorUt clienteConector, ConfiguracionServicio configuracion)
        {
            _repositorioTomi = repositorioTomi;
            _clienteConector = clienteConector;
            _configuracion = configuracion;
        }

        /// <summary>
        /// Analiza la operacion e inserta folio en tabla de intercambio
        /// </summary>
        /// <param name="strTipoOperacion"></param>
        /// <param name="strFolio"></param>
        /// <param name="strTablaBase"></param>
        /// <returns>true/false</returns>
        public async Task<bool> AnalisisOperacion(string strTipoOperacion, string strFolio, string strTablaBase)
        {
            bool boolResultado = false;
            try
            {
                bool boolBanderaEncontrado = false;

                // Obtiene tipo operacion
                string _strTipoOperacion = await ObtenerTipoTransaccionAsync(strFolio, strTipoOperacion);


                // Asigna campo y SP a tipo de operacion
                Dictionary<string, (string procedimientoAlmacenado, string campo, int tipoConsulta)> configuraCampoSpTipoOperacion =
                    new Dictionary<string, (string procedimientoAlmacenado, string campo, int tipoConsulta)>
            {
                // Grupo 1
                { TipoOperacion.SPID_Local, (EnumNombresProcedimientosAlmacenados.usp_ConsultaInspeccionTipoOperacionUTC, EnumComunes.CampoFolio, 1) },
                { TipoOperacion.SPID_GPH, (EnumNombresProcedimientosAlmacenados.usp_ConsultaInspeccionTipoOperacionUTC, EnumComunes.CampoFolio, 1) },
                { TipoOperacion.SPID_H2H, (EnumNombresProcedimientosAlmacenados.usp_ConsultaInspeccionTipoOperacionUTC, EnumComunes.CampoFolio, 1) },
                { TipoOperacion.PaP_SPID, (EnumNombresProcedimientosAlmacenados.usp_ConsultaInspeccionTipoOperacionUTC, EnumComunes.CampoFolio, 1) },
                { TipoOperacion.SPID, (EnumNombresProcedimientosAlmacenados.usp_ConsultaInspeccionTipoOperacionUTC, EnumComunes.CampoFolio, 1) },
                { TipoOperacion.TEF, (EnumNombresProcedimientosAlmacenados.usp_ConsultaInspeccionTipoOperacionUTC, EnumComunes.CampoFolio, 1) },
                { TipoOperacion.PaP_TEF, (EnumNombresProcedimientosAlmacenados.usp_ConsultaInspeccionTipoOperacionUTC, EnumComunes.CampoFolio, 1) },
                { TipoOperacion.TEF_GPH, (EnumNombresProcedimientosAlmacenados.usp_ConsultaInspeccionTipoOperacionUTC, EnumComunes.CampoFolio, 1) },
                { TipoOperacion.TEF_H2H, (EnumNombresProcedimientosAlmacenados.usp_ConsultaInspeccionTipoOperacionUTC, EnumComunes.CampoFolio, 1) },
