        /// <summary>
        /// Proceso devoluciones ENT_SPEI, ENT_SPEI1 y ENT_TEF
        /// </summary>
        /// <param name="lngFolio"></param>
        /// <param name="strTipoOperacion"></param>
        /// <param name="strBase"></param>
        /// <returns></returns>
        private async Task Devoluciones(long lngFolio, string strTipoOperacion)
        {
            try
            {
                var fechaActual = DateTime.Now;
                TimeSpan strHoraSistema = new TimeSpan(fechaActual.Hour, fechaActual.Minute, 0);

                // 14: Falta informacion mandatoria para completar el pago
                // 2: Cuenta bloqueada
                int lsCodigoDev = strTipoOperacion.Contains(TipoOperacion.ENT_SPEI) && strHoraSistema //PENDIENTE
                   >= _configuracion.TsHoraHotScanSpeiCancelacion ? 14 : 2;

                switch (strTipoOperacion)
                {
                    case TipoOperacion.ENT_SPEI:
                        await DevolucionesEntSpei(lngFolio, lsCodigoDev, strTipoOperacion);
                        break;
                    case TipoOperacion.ENT_SPEI_2:
                        await DevolucionesEntSpeiDos(lngFolio, lsCodigoDev, strTipoOperacion);
                        break;
                    case TipoOperacion.ENT_TEF:
                        await _repositorioTef.ActualizaEstatusTef(lngFolio, _configuracion.FechaSistema);
                        break;
                    default:
                        // Si se proporciona un tipo de operación no válido
                        throw new ArgumentException("Tipo de operación no válido: " + strTipoOperacion);
                }
            }
            catch (Exception lexRespuesta)
            {
                Config.EscribirLog("ERROR|Devoluciones|Se presenta exception: " + lexRespuesta.Message + ". Trace:" + lexRespuesta.ToString(), NombreServicio.HotScan.ToString());
            }
        }

