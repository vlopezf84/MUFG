            string strTipoOperacion = string.Empty;
            string strFolio = string.Empty;
            string strAliasProceso = string.Empty;
            int? intgpId = _configuracion.Pid;
            string strNombreServicio = _configuracion.NombreServicio;
            string strNombreProceso = _configuracion.NombreProceso;
            try
            {
                // Carga configuracion de parametros
                await ObtenerParametrosHotScanAsync();

                _configuracion.ParametrosSistema = await _parametizacion.ObtenerParametrosSistemaAsync(
                    $"'{ConstantesParametrosSistema.DIGSIG_CERT_NUMSER}','{ConstantesParametrosSistema.HORA_SPEI_CANCELACION}'",
                    $"'{ConstantesParametrosSistema.DIGSIG_CERT_PSW}'");
                _configuracion.FechaSistema = await _parametizacion.ObtenerFechaSistemaAsync();

                // Actualiza estatus servicio
                await _repositorioTomi.ProcesoActualizaEjecucion(strNombreServicio, intgpId, strNombreProceso);

                foreach (var item in SolicitudOperacionDtoList)
                {
                    try
                    {
                        strTipoOperacion = item.TipoOperacion;
                        strFolio = Convert.ToString(item.Folio);
                        //strTipoOperacion = "PaP_FXD";
                        //strFolio = "2402934";
                        Config.EscribirLog($"INFO|EjecutaProcedimientosAsync|***** Procesando folio: {strFolio} *****", NombreServicio.HotScan.ToString());

                        // Verificamos la última operación no realizada (debe ser HotScan)
                        Config.EscribirLog($"INFO|EjecutaProcedimientosAsync|lsFolio: {strFolio} ", NombreServicio.HotScan.ToString());
                        Config.EscribirLog($"INFO|EjecutaProcedimientosAsync|lsTipoOperacion: {strTipoOperacion} ", NombreServicio.HotScan.ToString());
                        Config.EscribirLog($"INFO|EjecutaProcedimientosAsync|NOMBRE_SERVICIO: {strNombreServicio} ", NombreServicio.HotScan.ToString());

                        strAliasProceso = await _repositorioTomi.ObtieneUltimoProceso(strFolio, strNombreServicio, strTipoOperacion);

                        Config.EscribirLog($"INFO|EjecutaProcedimientosAsync|lsAliasProceso: {strAliasProceso} ", NombreServicio.HotScan.ToString());
                        if (string.IsNullOrEmpty(strAliasProceso))
                            return false;

                        //RUTA 1 - Cuando el ultimo proceso pendiente es DATOS_GRAL
                        if (strAliasProceso.Trim().ToUpper() == EnumComunes.DATOS_GRAL)  
                        {
                            Config.EscribirLog($"INFO|EjecutaProcedimientosAsync|***** Subproceso DATOS_GRAL folio: {strFolio} ", 
                                NombreServicio.HotScan.ToString());
                            Config.EscribirLog("INFO|EjecutaProcedimientosAsync|Actualizando los datos del plan de trabajo maestro (estatus).", 
                                NombreServicio.HotScan.ToString());
                            await _repositorioTomi.EjecutaInicioProceso(strFolio, strNombreServicio, strNombreProceso, 
                                strTipoOperacion, intgpId, strAliasProceso);

                            // Actualiza estatus inicio HotScan
                            await _repositorioTomi.ActualizaEstatusInicioHotScan(strFolio, strTipoOperacion);

                            List<string> _lisOperaciones = new List<string>()
                            {
                                TipoOperacion.NOM_FXD, TipoOperacion.PaP_FXD, TipoOperacion.PaP_TEF, TipoOperacion.PaP_FXI
                            };

                            if (_lisOperaciones.Contains(strTipoOperacion))
                            {
                                // Actualizo el maestro general
                                string strFolioMaestro = await _repositorioTomi.ProcesoObtenerFolioMaestro(strFolio, strTipoOperacion);
                                if (await _repositorioTomi.ActualizaEstatusFolioMaestroHotScan(strFolioMaestro, strTipoOperacion) > 0)
                                {
                                    Config.EscribirLog("INFO|EjecutaProcedimientosAsync|Se actualizó el maestro folio_maestro:" + strFolioMaestro + 
                                        ".", NombreServicio.HotScan.ToString());
                                }
                            }

                            // Actualizo el estatus
                            await _repositorioTomi.EjecutaTerminoProceso(strFolio, strNombreServicio, strNombreProceso, strTipoOperacion, intgpId, 
                                strAliasProceso);

                            // Verificamos la última operación no realizada (debe ser a //CMS_A_TOMI//)
                            strAliasProceso = await _repositorioTomi.ObtieneUltimoProceso(strFolio, strNombreServicio, strTipoOperacion);
                        }

                        //RUTA 2 - Cuando el folio está listo para ejecutar analizadores HOTSCAN/FCM [HOT# o CON#]
                        if (strAliasProceso.Trim().ToUpper() == EnumComunes.HOTSCAN || strAliasProceso.Trim().ToUpper() == EnumComunes.FCM) 
                        {
                            Config.EscribirLog($"INFO|EjecutaProcedimientosAsync|***** Subproceso HOTSCAN/FCM/UTConnector folio: {strFolio} ", 
                                NombreServicio.HotScan.ToString());

                            // Actualizo el estatus
                            await _repositorioTomi.EjecutaInicioProceso(strFolio, strNombreServicio, strNombreProceso, 
                                strTipoOperacion, intgpId, strAliasProceso);

                            // Selección del tipo de operacion a escanear
                            Config.EscribirLog("INFO|EjecutaProcedimientosAsync|En disposición para ejecutar el analizador ExecuteAnalizersAsync.", 
                                NombreServicio.HotScan.ToString());
                            switch (strTipoOperacion)
                            {
                                case TipoOperacion.ENT_SPEI:
                                    objOrquestadorRespuesta = await _orquestador.EjecutaAnalizadoresAsync(
                                        strTipoOperacion, strFolio, EnumTablasMW.TablaEntradasSpei);
                                    break;

                                case TipoOperacion.ENT_SPEI_2:
                                    objOrquestadorRespuesta = await _orquestador.EjecutaAnalizadoresAsync(
                                        strTipoOperacion, strFolio, EnumTablasMW.TablaEntradasSpei2);
                                    break;

                                case TipoOperacion.FXD:
                                    objOrquestadorRespuesta = await _orquestador.EjecutaAnalizadoresAsync(
                                        strTipoOperacion, strFolio, EnumTablasMW.TablaFxd);
                                    break;

                                case TipoOperacion.FXD_Local:
                                    objOrquestadorRespuesta = await _orquestador.EjecutaAnalizadoresAsync(
                                        strTipoOperacion, strFolio, EnumTablasMW.TablaFxdLocal);
                                    break;

                                case TipoOperacion.FXD_GPH:
                                    objOrquestadorRespuesta = await _orquestador.EjecutaAnalizadoresAsync(
                                        strTipoOperacion, strFolio, EnumTablasMW.TablaFxdGph);
                                    break;

                                case TipoOperacion.FXD_H2H:
                                    objOrquestadorRespuesta = await _orquestador.EjecutaAnalizadoresAsync(
                                        strTipoOperacion, strFolio, EnumTablasMW.TablaFxdH2h);
                                    break;

                                case TipoOperacion.NOM_FXD:
                                    objOrquestadorRespuesta = await _orquestador.EjecutaAnalizadoresAsync(
                                        strTipoOperacion, strFolio, EnumTablasMW.TablaFxdNominaDetalle);
                                    break;

                                case TipoOperacion.PaP_FXD:
                                    objOrquestadorRespuesta = await _orquestador.EjecutaAnalizadoresAsync(
                                        strTipoOperacion, strFolio, EnumTablasMW.TablaFxdPapDetalle);
                                    break;

                                case TipoOperacion.ENT_SPID:
                                    objOrquestadorRespuesta = await _orquestador.EjecutaAnalizadoresAsync(
                                        strTipoOperacion, strFolio, EnumTablasMW.TablaEntradasSpid);
                                    break;

                                case TipoOperacion.SPID_Local:
                                    objOrquestadorRespuesta = await _orquestador.EjecutaAnalizadoresAsync(
                                        strTipoOperacion, strFolio, EnumTablasMW.TablaSpidLocal);
                                    break;

                                case TipoOperacion.SPID_GPH:
                                    objOrquestadorRespuesta = await _orquestador.EjecutaAnalizadoresAsync(
                                        strTipoOperacion, strFolio, EnumTablasMW.TablaSpidGph);
                                    break;

                                case TipoOperacion.SPID_H2H:
                                    objOrquestadorRespuesta = await _orquestador.EjecutaAnalizadoresAsync(
                                        strTipoOperacion, strFolio, EnumTablasMW.TablaSpidH2h);
                                    break;

                                case TipoOperacion.SPID:
                                    objOrquestadorRespuesta = await _orquestador.EjecutaAnalizadoresAsync(
                                        strTipoOperacion, strFolio, EnumTablasMW.TablaSpid);
                                    break;

                                case TipoOperacion.SPID2:
                                    objOrquestadorRespuesta = await _orquestador.EjecutaAnalizadoresAsync(
                                        strTipoOperacion, strFolio, EnumTablasMW.TablaSpid);
                                    break;

                                case TipoOperacion.PaP_SPID:
                                    objOrquestadorRespuesta = await _orquestador.EjecutaAnalizadoresAsync(
                                        strTipoOperacion, strFolio, EnumTablasMW.TablaSpidPapDetalle);
                                    break;

                                case TipoOperacion.ENT_TEF:
                                    objOrquestadorRespuesta = await _orquestador.EjecutaAnalizadoresAsync(
                                        strTipoOperacion, strFolio, EnumTablasMW.TablaEntradasTef);
                                    break;

                                case TipoOperacion.TEF:
                                    objOrquestadorRespuesta = await _orquestador.EjecutaAnalizadoresAsync(
                                        strTipoOperacion, strFolio, EnumTablasMW.TablaTef);
                                    break;

                                case TipoOperacion.PaP_TEF:
                                    objOrquestadorRespuesta = await _orquestador.EjecutaAnalizadoresAsync(
                                        strTipoOperacion, strFolio, EnumTablasMW.TablaTefPapDetalle);
                                    break;

                                case TipoOperacion.TEF_GPH:
                                    objOrquestadorRespuesta = await _orquestador.EjecutaAnalizadoresAsync(
                                        strTipoOperacion, strFolio, EnumTablasMW.TablaTefGph);
                                    break;

                                case TipoOperacion.TEF_H2H:
                                    objOrquestadorRespuesta = await _orquestador.EjecutaAnalizadoresAsync(
                                        strTipoOperacion, strFolio, EnumTablasMW.TablaTefH2h);
                                    break;

                                case TipoOperacion.SER:
                                    objOrquestadorRespuesta = await _orquestador.EjecutaAnalizadoresAsync(
                                        strTipoOperacion, strFolio, EnumTablasMW.TablaSerPay);
                                    break;

                                case TipoOperacion.TAX:
                                    objOrquestadorRespuesta = await _orquestador.EjecutaAnalizadoresAsync(
                                        strTipoOperacion, strFolio, EnumTablasMW.TablaTaxPay);
                                    break;

                                case TipoOperacion.FXI:
                                    objOrquestadorRespuesta = await _orquestador.EjecutaAnalizadoresAsync(
                                        strTipoOperacion, strFolio, EnumTablasMW.TablaFxi);
                                    break;

                                case TipoOperacion.FXI_GPH:
                                    objOrquestadorRespuesta = await _orquestador.EjecutaAnalizadoresAsync(
                                        strTipoOperacion, strFolio, EnumTablasMW.TablaFxiGph);
                                    break;

                                case TipoOperacion.FXI_H2H:
                                    objOrquestadorRespuesta = await _orquestador.EjecutaAnalizadoresAsync(
                                        strTipoOperacion, strFolio, EnumTablasMW.TablaFxiH2h);
                                    break;

                                case TipoOperacion.FXI_Local:
                                    objOrquestadorRespuesta = await _orquestador.EjecutaAnalizadoresAsync(
                                        strTipoOperacion, strFolio, EnumTablasMW.TablaFxiLocal);
                                    break;

                                case TipoOperacion.PaP_FXI:
                                    objOrquestadorRespuesta = await _orquestador.EjecutaAnalizadoresAsync(
                                        strTipoOperacion, strFolio, EnumTablasMW.TablaFxiPapDetalle);
                                    break;

                                default:
                                    throw new Exception($"Tipo de operación desconocida://{strTipoOperacion}//");
                            }

                            Config.EscribirLog($"INFO|EjecutaProcedimientosAsync| Tipo Operacion: {strTipoOperacion}| folio: " +
                                $"{strFolio}| lbRegreso.Success: {objOrquestadorRespuesta.Success.ToString()}", NombreServicio.HotScan.ToString());
                            if (objOrquestadorRespuesta.Success)
                            {
                                // Marco la operacion como terminada
                                // Actualizo el estatus
                                await _repositorioTomi.EjecutaTerminoProceso(strFolio, strNombreServicio, strNombreProceso, 
                                    strTipoOperacion, intgpId, strAliasProceso);

                                // Verificamos la última operación no realizada (debe ser a ////)
                                strAliasProceso = await _repositorioTomi.ObtieneUltimoProceso(strFolio, strNombreServicio, strTipoOperacion);
                            }
                        }

                        //RUTA 3 - Cuando toca evaluar estatus/respuesta de analizadores.
                        //Para poder ser finalizado de manera correcta necesita ser uno de lo siguiente FCM = [CONP/CONF] SENTINEL = [0000/0004/0005/NA]
                        if (strAliasProceso.Trim().ToUpper() == EnumComunes.HOTSCAN_ESTATUS ||
                            strAliasProceso.Trim().ToUpper() == EnumComunes.FCM_ESTATUS) 
                        {
                            string strTablaBase = string.Empty;
                            string strEstatusOperacion = string.Empty;
                            string strEstatusSentinel = string.Empty;
                            bool boolAnalizadorFcmActivo = false;
                            bool boolEsAnalizadorSentinelActivo = false;
                            bool lbEntrada = false;
                            Config.EscribirLog($"INFO|EjecutaProcedimientosAsync|***** Subproceso FCM_ESTATUS folio: {strFolio} ", NombreServicio.HotScan.ToString());
                            Config.EscribirLog("INFO|EjecutaProcedimientosAsync|Actualizando Estatus FCM:" + strFolio + ".", NombreServicio.HotScan.ToString());
                            // Actualizo el estatus
                            await _repositorioTomi.EjecutaInicioProceso(strFolio, strNombreServicio, strNombreProceso, strTipoOperacion, intgpId, strAliasProceso);

                            // Obtenemos la configuración de los analizadores
                            Config.EscribirLog("INFO|EjecutaProcedimientosAsync|Se obtiene configuración de analizadores para evaluar respuesta de los que están encendidos", NombreServicio.HotScan.ToString());
                            List<ConfiguracionAnalizadorConector> lisConfig = await _repositorioTomi.ObtenerConfiguracionAnalizadorHotScan();

                            if (lisConfig?.Count > 0)
                            {
                                foreach (ConfiguracionAnalizadorConector config in lisConfig)
                                {
                                    if ((EstatusAnalizador)config.Estatus == EstatusAnalizador.Activo)
                                    {
                                        switch (config.Id)
                                        {
                                            case (int)Analizador.FCMConnector:
                                                boolAnalizadorFcmActivo = true;
                                                if (!strTipoOperacion.Contains(TipoOperacion.FXI))
                                                    Config.EscribirLog("INFO|EjecutaProcedimientosAsync|FCMConnector Activo. Se evaluará resultado de FCM para el folio: " + strFolio, NombreServicio.HotScan.ToString());
                                                else
                                                    Config.EscribirLog("INFO|EjecutaProcedimientosAsync|FCMConnector Activo. NO se evaluará resultado de FCM para el folio: " + strFolio + " por ser internacional", 
                                                        NombreServicio.HotScan.ToString());

                                                break;
                                            case (int)Analizador.UTConnector:
                                                boolEsAnalizadorSentinelActivo = true;
                                                Config.EscribirLog("INFO|EjecutaProcedimientosAsync|UTConnector Activo. Se evaluará resultado de Sentinel para el folio: " + strFolio, NombreServicio.HotScan.ToString());
                                                break;
                                        }
                                    }
                                }
                            }

                            // Selección del tipo de operacion a escanear
                            strTablaBase = string.Empty;
                            lbEntrada = false;
                            bool blnGPH = false;
                            bool blnH2H = false;

                            strTablaBase = ObtenerTablaTrabajo(strTipoOperacion);
                            if (strTipoOperacion.Contains(EnumComunes.SubTipoOperacionGPH))
                            {
                                blnGPH = true;
                                Config.EscribirLog("INFO|Ejecuta_ProcedimientosAsync|Se detectó que la operación proviene del canal GPH", NombreServicio.HotScan.ToString());
                            }
                            else if (strTipoOperacion.Contains(EnumComunes.SubTipoOperacionH2H))
                            {
                                blnH2H = true;
                                Config.EscribirLog("INFO|Ejecuta_ProcedimientosAsync|Se detectó que la operación proviene del canal H2H", NombreServicio.HotScan.ToString());
                            }
                            else if (strTipoOperacion.Contains(EnumComunes.SubTipoOperacionENT))
                            {
                                lbEntrada = true;
                                Config.EscribirLog("INFO|Ejecuta_ProcedimientosAsync|Se detectó que la operación es de entrada", NombreServicio.HotScan.ToString());
                            }

                            strEstatusOperacion = string.Empty;
                            OperacionEntGphH2h operacionEntGphH2H;
                            if (lbEntrada)
                            {
                                // Esto se envia como parametro para evaluar el tipo de consulta en el metodo ConsultaOperacionEntGphH2h 
                                // 1 = 'NF_ESTATUS'
                                // 2 = 'NF_ESTATUS'
                                // 3 = 'NF_ESTATUS, NF_FECHA_EJECUCION, NF_NOMBRE_ARCHIVO_GPH, NF_PMT_INF_ID, NF_ID_ARCHIVO'
                                // 4 = 'NF_ESTATUS, NF_FECHA_EJECUCION, NF_NOMBRE_ARCHIVO_H2H'	                           
                                operacionEntGphH2H = strTipoOperacion == TipoOperacion.ENT_SPEI
                                                        || strTipoOperacion == TipoOperacion.ENT_SPEI_2
                                                            ? await _repositorioTomi.ConsultaOperacionEntGphH2h(strFolio, strTablaBase, EnumComunes.CampoClaveOperacion, 1)
                                                            : await _repositorioTomi.ConsultaOperacionEntGphH2h(strFolio, strTablaBase, EnumComunes.CampoFolio, 1);
                                Config.EscribirLog($"Respuesta FCM ESTATUS: {operacionEntGphH2H?.NF_ESTATUS.ToString()}, de la tabla: {strTablaBase}");
                            }
                            else
                            {
                                if (blnGPH)
                                {
                                    operacionEntGphH2H = await _repositorioTomi.ConsultaOperacionEntGphH2h(strFolio, strTablaBase, EnumComunes.CampoFolio, 3);
                                    Config.EscribirLog($"Respuesta FCM ESTATUS: {operacionEntGphH2H?.NF_ESTATUS.ToString()}, de la tabla: {strTablaBase}");
                                }
                                else if (blnH2H)
                                {
                                    operacionEntGphH2H = await _repositorioTomi.ConsultaOperacionEntGphH2h(strFolio, strTablaBase, EnumComunes.CampoFolio, 4);
                                    Config.EscribirLog($"Respuesta FCM ESTATUS: {operacionEntGphH2H?.NF_ESTATUS.ToString()}, de la tabla: {strTablaBase}");
                                }
                                else
                                {
                                    operacionEntGphH2H = await _repositorioTomi.ConsultaOperacionEntGphH2h(strFolio, strTablaBase, EnumComunes.CampoFolio, 1);
                                    Config.EscribirLog($"Respuesta FCM ESTATUS: {operacionEntGphH2H?.NF_ESTATUS.ToString()}, de la tabla: {strTablaBase}");
                                }
                            }

                            if (operacionEntGphH2H != null)
                            {
                                strEstatusOperacion = operacionEntGphH2H.NF_ESTATUS.ToString();
                            }
                            else
                            {
                                Config.EscribirLog($"INFO|EjecutaProcedimientos| No se encontro NF_ESTATUS válido para folio: {strFolio}, tipo operación:{strTipoOperacion} ");
                            }

                                // Paso 1 leer tabla de intercambio sentinel si el analizador se encuentra Activo
                                Parametros objParametros = await _repositorioTomi.ConsultaEstatusSentinel(strFolio, strTipoOperacion);
                            string strSpEstatusSentinel = objParametros?.Status_Sentinel;
                            

                            Config.EscribirLog("INFO|Ejecuta_ProcedimientosAsync|Realiza lectura estatus Sentinel", NombreServicio.HotScan.ToString());

                            if (strEstatusSentinel != null && strSpEstatusSentinel != null)
                            {
                                strEstatusSentinel = strSpEstatusSentinel;

                                Config.EscribirLog("INFO|EjecutaProcedimientosAsync|Estatus Sentinel lsEstatusSentinel: " + strEstatusSentinel, NombreServicio.HotScan.ToString());
                            }
                            else { strEstatusSentinel = EnumComunes.EstatusSentinelNA; }

                            Config.EscribirLog($"Respuesta SENTINEL ESTATUS: {strEstatusSentinel} de la tabla: TBL_SENTINEL_INTERCAMBIO");


                            // Paso 2 Ajustar flujo para integrar respuesta de sentinel y de FCM (con al menos uno de los 2 encendidos)
                            if (boolAnalizadorFcmActivo || boolEsAnalizadorSentinelActivo)
                            {
                                if (
                                    (boolAnalizadorFcmActivo && (strEstatusOperacion == Estatus.RECC.ToString())) 
                                    ||
                                    (boolEsAnalizadorSentinelActivo && strEstatusSentinel == EnumComunes.EstatusSentinel0001)
                                )
                                {
                                    string strAnalizadorRechazo = EnumComunes.AnalizadorRechazo;
                                    if (boolAnalizadorFcmActivo && (strEstatusOperacion == Estatus.RECC.ToString()))
                                    {
                                        strAnalizadorRechazo = EnumComunes.FCM;
                                    }
                                    else if (boolEsAnalizadorSentinelActivo && strEstatusSentinel == EnumComunes.EstatusSentinel0001)
                                    {
                                        strAnalizadorRechazo = EnumComunes.Sentinel;
                                    }

                                    Config.EscribirLog("INFO|Ejecuta_ProcedimientosAsync|Estatus En error por " + strAnalizadorRechazo, NombreServicio.HotScan.ToString());
                                    switch (strTipoOperacion)
                                    {
                                        //Aqui se finaliza el proceso para este tipo de operacion.
                                        case TipoOperacion.NOM_FXD: 
                                            await _repositorioTomi.EjecutaTerminoProceso(strFolio, strNombreServicio, strNombreProceso, strTipoOperacion, intgpId, strAliasProceso);
                                            strAliasProceso = await _repositorioTomi.ObtieneUltimoProceso(strFolio, strNombreServicio, strTipoOperacion);
                                            break;

                                        //Aqui se finaliza el proceso para estos tipo de operaciones.
                                        case TipoOperacion.ENT_SPEI:
                                        case TipoOperacion.ENT_TEF:
                                        case TipoOperacion.ENT_SPEI_2:
                                            
                                            long.TryParse(strFolio, out long lfolio);
                                            await Devoluciones(lfolio, strTipoOperacion);

                                            Config.EscribirLog("INFO|Ejecuta_ProcedimientosAsync|A cancelar la operación de entrada.", NombreServicio.HotScan.ToString());
                                            if (strAnalizadorRechazo == EnumComunes.FCM)
                                            {
                                                await _repositorioTomi.ActualizaEstatusCancelIntercambio(strFolio, strTipoOperacion);
                                            }
                                            await _repositorioTomi.ActualizaPlanDetalle(strFolio, strTipoOperacion);
                                            await _repositorioTomi.ActualizaEstatusCancelPlanMaestro(strFolio, strTipoOperacion, strAnalizadorRechazo);

                                            // Paso y no se bloquea la operación, actualizo el estatus
                                            await _repositorioTomi.EjecutaTerminoProceso(strFolio, strNombreServicio, strNombreProceso, strTipoOperacion, intgpId, strAliasProceso);
                                            break;
                                        case TipoOperacion.ENT_SPID:
                                            
                                            long.TryParse(strFolio, out long lfolioSpd);

                                            if (await DevolucionesSpid(lfolioSpd, strTipoOperacion))
                                            {
                                                //>> Solo puede actualizar el estado de la operacion si puedo generar la actualizar en la tabla de intercambio (Karpay)
                                                Config.EscribirLog("INFO|Ejecuta_ProcedimientosAsync|A cancelar la operación de entrada SPID.", NombreServicio.HotScan.ToString());
                                                if (strAnalizadorRechazo == EnumComunes.FCM)
                                                {
                                                    await _repositorioTomi.ActualizaEstatusCancelIntercambio(strFolio, strTipoOperacion);
                                                }
                                                await _repositorioTomi.ActualizaPlanDetalle(strFolio, strTipoOperacion);
                                                await _repositorioTomi.ActualizaEstatusCancelPlanMaestro(strFolio, strTipoOperacion, strAnalizadorRechazo);
                                            }
                                            else
                                            {
                                                throw new Exception("No es posible generar la devolucion de SPID de entrada");
                                            }
                                            break;

                                        default: //Tipo de operacion no encontrada va directamente a cancelar.
                                            Config.EscribirLog("INFO|Ejecuta_ProcedimientosAsync|A cancelar la operación.", NombreServicio.HotScan.ToString());
                                            if (boolAnalizadorFcmActivo && (strEstatusOperacion == Estatus.RECC.ToString()))
                                            {
                                                await _repositorioTomi.ActualizaEstatusCancelIntercambio(strFolio, strTipoOperacion);
                                            }
                                            // Se cambia el estatus a RECC en la tabla de trabajo si se canceló por Sentinel para seguir el flujo (eso lo hace FCM Conector en FCM)
                                            else if (boolEsAnalizadorSentinelActivo && strEstatusSentinel == EnumComunes.EstatusSentinel0001)
                                            {
                                                await _repositorioTomi.ActualizaEstatusReccTablaOperacion(strFolio, ObtieneCampoFolio(strTipoOperacion), ObtenerTablaTrabajo(strTipoOperacion));
                                            }
                                            await _repositorioTomi.ActualizaPlanDetalleDifActualizaEstatus(strFolio, strTipoOperacion);
                                            await _repositorioTomi.ActualizaEstatusCancelPlanMaestro(strFolio, strTipoOperacion, strAnalizadorRechazo);

                                            // Paso y no se bloquea la operación, actualizo el estatus
                                            await _repositorioTomi.EjecutaTerminoProceso(strFolio, strNombreServicio, strNombreProceso, strTipoOperacion, intgpId, strAliasProceso);
                                            break;
                                    }
                                }
                                else if (
                                    (boolAnalizadorFcmActivo && (strEstatusOperacion == EstatusOperacion.DEF.ToString()
                                    || strEstatusOperacion == EstatusOperacion.ERR.ToString()))
                                    || (boolEsAnalizadorSentinelActivo && strEstatusSentinel == EnumComunes.EstatusSentinel9999)
                                )
                                {
                                    Config.EscribirLog("INFO|Ejecuta_ProcedimientosAsync|Estatus en error <<lsEstatus:" + strEstatusOperacion + ">> <<lsEstatusSentinel: " + 
                                        strEstatusSentinel + ">>", NombreServicio.HotScan.ToString());
                                    if (boolEsAnalizadorSentinelActivo && strEstatusSentinel == EnumComunes.EstatusSentinel9999)
                                    {
                                        throw new Exception("Error desconocido en Sentinel: //" + strEstatusSentinel + "//.");
                                    }
                                    else
                                    {
                                        throw new Exception("Error en la respuesta del Queue: //" + (strEstatusOperacion == EstatusOperacion.DEF.ToString()
                                            ? EstatusOperacion.DEFAULT.ToString()
                                            : EstatusOperacion.ERROR.ToString()) + "//.");
                                    }
                                }
                                else if (
                                    //Ambos activos y ambos cumplen y fue ACEPTADA o (entro en el periodo CUT OF TIME ) o ( fue liberada por el BY PASS)
                                    (boolAnalizadorFcmActivo && (strEstatusOperacion == Estatus.CONP.ToString() || strEstatusOperacion == EstatusOperacion.CONF.ToString())) 
                                    &&
                                    (boolEsAnalizadorSentinelActivo && (strEstatusSentinel == EnumComunes.EstatusSentinel0000 || strEstatusSentinel == EnumComunes.EstatusSentinel0004
                                    || strEstatusSentinel == EnumComunes.EstatusSentinel0005 || strEstatusSentinel == EnumComunes.EstatusSentinelNA)) ||

                                    //FCM encendido y Sentinel fue apagado y actualizo el estatus de las operaciones que estaban en 0002 y las pone en 0003
                                    (boolAnalizadorFcmActivo && (strEstatusOperacion == Estatus.CONP.ToString() || strEstatusOperacion == EstatusOperacion.CONF.ToString()))
                                    && (!boolEsAnalizadorSentinelActivo && strEstatusSentinel == EnumComunes.EstatusSentinel0003) ||
                                    (boolAnalizadorFcmActivo && !boolEsAnalizadorSentinelActivo
                                    && (strEstatusOperacion == Estatus.CONP.ToString() || strEstatusOperacion == EstatusOperacion.CONF.ToString())) || //Solo FCM Activo 
                                    (!boolAnalizadorFcmActivo && boolEsAnalizadorSentinelActivo
                                    && (strEstatusSentinel == EnumComunes.EstatusSentinel0000 || strEstatusSentinel == EnumComunes.EstatusSentinel0004 || strEstatusSentinel == EnumComunes.EstatusSentinel0005
                                    || strEstatusSentinel == EnumComunes.EstatusSentinelNA)) || //Solo Sentinel Activo
                                    (boolEsAnalizadorSentinelActivo && strEstatusSentinel == EnumComunes.EstatusSentinel0000 && strTipoOperacion.Contains(TipoOperacion.FXI)) || //Caso FXI
                                    (!boolEsAnalizadorSentinelActivo && strTipoOperacion.Contains(TipoOperacion.FXI)) //Caso FXI
                                    )
                                {
                                    // Paso y no se bloquea la operación, actualizo el estatus 
                                    //AQUI SE FINALIZA EL ESTATUS DE FCM_ESTATUS si todo esta bien, ahora el nuevo estatus es FCM_TERMINADO
                                    Config.EscribirLog("INFO|Ejecuta_ProcedimientosAsync|Estatus Aprobada", NombreServicio.HotScan.ToString());
                                    await _repositorioTomi.EjecutaTerminoProceso(strFolio, strNombreServicio, strNombreProceso, strTipoOperacion, intgpId, strAliasProceso);
                                    strAliasProceso = await _repositorioTomi.ObtieneUltimoProceso(strFolio, strNombreServicio, strTipoOperacion);
                                }
                                else if ((boolAnalizadorFcmActivo && (strEstatusOperacion == EstatusOperacion.HOTP.ToString() || strEstatusOperacion == EstatusOperacion.HOTF.ToString()))
                                    || (boolEsAnalizadorSentinelActivo
                                    && strEstatusSentinel == EnumComunes.EstatusSentinel0002))
                                {
                                    // La operación está bloqueada (se queda en estatus HOTSCAN)
                                    Config.EscribirLog("INFO|Ejecuta_ProcedimientosAsync|Estatus En validación <<lsEstatus:" + strEstatusOperacion + ">> <<lsEstatusSentinel: " + 
                                        strEstatusSentinel + ">>", NombreServicio.HotScan.ToString());
                                    await _repositorioTomi.ActualizaPlanMaestroEstatusHotscan(strFolio, strTipoOperacion);

                                    var fechaActual = DateTime.Now;
                                    TimeSpan tsHoraSistema = new TimeSpan(fechaActual.Hour, fechaActual.Minute, 0);

                                    string strEstatusFcm = string.Empty;

                                    Config.EscribirLog("INFO|Ejecuta_ProcedimientosAsync|-> Validando si es un HIT en FCM.", NombreServicio.HotScan.ToString());
                                    Parametros objParametrosEstatusFcm = await _repositorioTomi.ConsultaEstatusFCM(strFolio, strTipoOperacion);
                                    string _strEstatusFcm = objParametrosEstatusFcm?.Estatus_FCM ?? string.Empty;

                                    //if (!string.IsNullOrEmpty(_strEstatusFcm))
                                    //{
                                        strEstatusFcm = _strEstatusFcm;
                                        Config.EscribirLog("INFO|Ejecuta_ProcedimientosAsync|-> Estatus en FCM (estatus_FCM): " + strEstatusFcm, NombreServicio.HotScan.ToString());
                                    //}

                                    if (strTipoOperacion.Contains(TipoOperacion.SPID) && tsHoraSistema >= _configuracion.TsHoraSpidCancelacion && strEstatusFcm == EnumComunes.EstatusHit) //PENDIENTE
                                    {
                                        Config.EscribirLog("INFO|EjecutaProcedimientosAsync|-> Se cancela la operación de SPID por horario y por estatus HIT.", NombreServicio.HotScan.ToString());
                                        await _repositorioTomi.ActualizaEstatusReccTablaOperacion(strFolio, EnumComunes.CampoFolio, strTablaBase);
                                        Config.EscribirLog("INFO|EjecutaProcedimientosAsync|-> Se cancela la operacion SPID con folio  " + strFolio + ".", NombreServicio.HotScan.ToString());
                                    }

                                    //Modificacion para cuando los SPEI dieron HIT antes del rango de tiempo (devolucion automatica) estas deben devolverse
                                    if (strEstatusFcm == EnumComunes.EstatusHit)
                                    {
                                        if (strTipoOperacion.Contains(TipoOperacion.ENT_SPEI) && tsHoraSistema >= _configuracion.TsHoraHotScanSpeiCancelacion) //PENDIENTE
                                        {
                                            // Actualiza estatus rechazo/cancelacion
                                            Config.EscribirLog("INFO|Ejecuta_Procedimientos|-> Se cancela y se devuelve la operación ENT_SPEI por horario y por estatus HIT.", NombreServicio.HotScan.ToString());
                                            long.TryParse(strFolio, out long longFolio);
                                            await Devoluciones(longFolio, strTipoOperacion);
                                            await _repositorioTomi.InsertaFolioOpControlDevoluciones(strFolio, strTipoOperacion);
                                            await _repositorioTomi.ActualizaEstatusCancelIntercambio(strFolio, strTipoOperacion);
                                            await _repositorioTomi.ActualizaEstatusReccTablaOperacion(strFolio, EnumComunes.CampoClaveOperacion, strTablaBase);
                                            await _repositorioTomi.ActualizaPlanDetalle(strFolio, strTipoOperacion);
                                            await _repositorioTomi.ActualizaEstatusCancelPlanMaestro(strFolio, strTipoOperacion, EnumComunes.FCM);
                                        }
                                    }
                                }

                            }
                            else
                            {
                                // Paso y no se bloquea la operación, actualizo el estatus
                                Config.EscribirLog("INFO|Ejecuta_ProcedimientosAsync|Analizadores FCM y Sentinel Apagados", NombreServicio.HotScan.ToString());
                                await _repositorioTomi.EjecutaTerminoProceso(strFolio, strNombreServicio, strNombreProceso, strTipoOperacion, intgpId, strAliasProceso);
                                strAliasProceso = await _repositorioTomi.ObtieneUltimoProceso(strFolio, strNombreServicio, strTipoOperacion);
                            }
                        }

                        //RUTA 4 - Cuando toca cerrar el flujo HOTSCAN/FCM
                        if (strAliasProceso.Trim().ToUpper() == EnumComunes.HOTSCAN_TERMINADO || strAliasProceso.Trim().ToUpper() == EnumComunes.FCM_TERMINADO) 
                        {
                            Config.EscribirLog($"INFO|EjecutaProcedimientosAsync|***** Subproceso FCM_TERMINADO folio: {strFolio} ", NombreServicio.HotScan.ToString());
                            switch (strTipoOperacion)
                            {
                                case TipoOperacion.FXD_GPH:
                                case TipoOperacion.SPID_GPH:
                                    break;
                                case TipoOperacion.FXD_H2H:
                                case TipoOperacion.SPID_H2H:
                                    break;
                            }
                            // Actualizo el estatus
                            await _repositorioTomi.EjecutaInicioProceso(strFolio, strNombreServicio, strNombreProceso, strTipoOperacion, intgpId, strAliasProceso);
                            string strFechaTomi = await _repositorioTomi.ObtenerFechaSistema();
                            _configuracion.FechaSistema = strFechaTomi;

                            // Fecha futura
                            Config.EscribirLog("INFO|Ejecuta_ProcedimientosAsync|UPDATE 1:" + "usp_ActualizaPlanTrabajoMaestroEstatusFCMTerminado_HotScan", NombreServicio.HotScan.ToString());
                            await _repositorioTomi.ActualizaEstatusFechaFuturaPlanMaestro(strFolio, strTipoOperacion, _configuracion.FechaSistema);

                            if (strTipoOperacion == TipoOperacion.NOM_FXD || strTipoOperacion == TipoOperacion.PaP_FXD)
                            {
                                // Actualizo el maestro general
                                string strFolioMaestro = await _repositorioTomi.ProcesoObtenerFolioMaestro(strFolio, strTipoOperacion);
                                if (await _repositorioTomi.ActualizaEstatusFechaFuturaPlanMaestroFolioMaestro(strFolioMaestro, strTipoOperacion, _configuracion.FechaSistema) > 0)
                                {
                                    Config.EscribirLog("INFO|Ejecuta_ProcedimientosAsync|Se actualizó el maestro folio_maestro:" + strFolioMaestro + ".", NombreServicio.HotScan.ToString());
                                }
                            }

                            await _repositorioTomi.EjecutaTerminoProceso(strFolio, strNombreServicio, strNombreProceso, strTipoOperacion, intgpId, strAliasProceso);
                        }

                    }
                    catch (Exception ex)
                    {
                        Config.EscribirLog("ERROR|Ejecuta_ProcedimientosAsync|Ocurre exception: " + ex.ToString(), NombreServicio.HotScan.ToString());
                        await _repositorioTomi.EjecutaErrorProceso(strFolio, NombreServicio.HotScan.ToString(), strNombreProceso, strTipoOperacion, intgpId, strAliasProceso, ex);
                        // Inserto la alarma
                        await _repositorioTomi.InsertaAlerta(new MUFG_T24.Modelos.AlertaDTO
                        {
                            Folio = strFolio,
                            TipoOPeracion = strTipoOperacion,
                            Servicio = NombreServicio.HotScan.ToString(),
                            ClaveAviso = EnumComunes.CLAVE_AVISO_CRITICO,
                            Descipcion = ex.Message,
                            PId = (int)intgpId,
                            NombreProceso = strNombreProceso,
                            Exception = ex
                        });
                    }
                    finally
                    {
                        try
                        {
                            // Fin de los procesos a realizar
                            await _repositorioTomi.ProcesoActualizaTerminacion(strNombreServicio, intgpId, strNombreProceso);
                        }
                        catch (Exception exFinally)
                        {
                            Config.EscribirLog($"ERROR|Ejecuta_ProcedimientosAsync|no fue posible maracar el servicio en finalización: {exFinally.ToString()}", NombreServicio.HotScan.ToString());
                        }
                    }
                }

                
                // Regreso los folios procesados
                return true;
            }
            catch (Exception ex)
            {
                Config.EscribirLog("ERROR|Ejecuta_ProcedimientosAsync|Se presenta exception: " + ex.ToString(), NombreServicio.HotScan.ToString());
                // Inserto la alarma
                await _repositorioTomi.InsertaAlerta(new MUFG_T24.Modelos.AlertaDTO
                {
                    Folio = null,
                    TipoOPeracion = null,
                    Servicio = NombreServicio.HotScan.ToString(),
                    ClaveAviso = EnumComunes.CLAVE_AVISO_CRITICO,
                    Descipcion = null,
                    PId = (int)intgpId,
                    NombreProceso = strNombreProceso,
                    Exception = ex
                });
            }
            return false;
        }

