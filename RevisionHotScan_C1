        /// <param name="lngFolio"></param>
        /// <param name="strTipoOperacion"></param>
        /// <returns></returns>
        private async Task<bool> DevolucionesSpid(long lngFolio, string strTipoOperacion)
        {
            bool boolProcesado = false;
            try
            {
                switch (strTipoOperacion)
                {
                    case TipoOperacion.ENT_SPID:
                        await DevolucionesEntSpid(lngFolio);
                        boolProcesado = true;
                        break;
                }
                return boolProcesado;
            }
            catch (Exception lexRespuesta)
            {
                boolProcesado = false;
                Config.EscribirLog("ERROR|Devoluciones SPID|Se presenta exception: " + lexRespuesta.Message + ".Trace:" + lexRespuesta.ToString(), NombreServicio.HotScan.ToString());
                return boolProcesado;
            }
        }

        /// <summary>
        /// Obtiene datos del proceso
        /// </summary>
        /// <returns>Proceso</returns>
        public async Task<Proceso> ObtieneDatosProceso() => await _repositorioTomi.DatosProceso();
    }
